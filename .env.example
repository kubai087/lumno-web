# Copy to .env for local builds. Every variable is optional: leave one empty and
# the site skips that feature (no analytics, no verification tag, and so on).

# Google Analytics 4 measurement ID.
PUBLIC_GA_ID=

# Search engine webmaster verification meta tags.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_BAIDU_SITE_VERIFICATION=
PUBLIC_SOGOU_SITE_VERIFICATION=
PUBLIC_YANDEX_SITE_VERIFICATION=
PUBLIC_NAVER_SITE_VERIFICATION=

# Set to false to disallow AI crawlers in robots.txt (default: true).
PUBLIC_ALLOW_AI_CRAWLERS=

# Account sign-in. Supabase publishable keys and reCAPTCHA site keys are meant
# to ship to browsers; never put a Supabase secret or service_role key here.
# Leave the Supabase pair empty to use the production project's public values.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_RECAPTCHA_SITE_KEY=

# /release reads GitHub Releases from this repository (default: kubai087/lumno-extension).
# A token only raises the API rate limit; a read-only one is enough.
GITHUB_RELEASES_OWNER=
GITHUB_RELEASES_REPO=
GITHUB_RELEASES_TOKEN=

# Store versions shown on the site. CI resolves them with scripts/get-*-store-version.mjs.
PUBLIC_CHROME_STORE_VERSION=
PUBLIC_EDGE_STORE_VERSION=
PUBLIC_FIREFOX_STORE_VERSION=
