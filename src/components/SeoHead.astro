---
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_TWITTER_IMAGE,
  SITE_NAME,
  SITE_URL,
  getOpenGraphLocale,
} from "../lib/seo";

type StructuredData = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  path: string;
  keywords?: string[];
  alternates?: Array<{
    hreflang: string;
    href: string;
  }>;
  image?: string;
  type?: string;
  locale?: string;
  noindex?: boolean;
  i18nTitleKey?: string;
  twitterImage?: string;
  squareImage?: string;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description,
  path,
  keywords = [],
  alternates = [],
  image = DEFAULT_OG_IMAGE,
  type = "website",
  locale = "zh_CN",
  noindex = false,
  i18nTitleKey,
  twitterImage = DEFAULT_TWITTER_IMAGE,
  squareImage = "",
  structuredData = [],
} = Astro.props;

const canonicalUrl = new URL(path, SITE_URL).toString();
const imageUrl = new URL(image, SITE_URL).toString();
const twitterImageUrl = new URL(twitterImage, SITE_URL).toString();
const squareImageUrl = squareImage ? new URL(squareImage, SITE_URL).toString() : "";
const gaId = String(import.meta.env.PUBLIC_GA_ID || "").trim();
const googleSiteVerification = String(import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "").trim();
const bingSiteVerification = String(import.meta.env.PUBLIC_BING_SITE_VERIFICATION || "").trim();
const baiduSiteVerification = String(import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION || "").trim();
const sogouSiteVerification = String(import.meta.env.PUBLIC_SOGOU_SITE_VERIFICATION || "").trim();
const robots = noindex
  ? "noindex, nofollow, noarchive"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const schemaItems = (Array.isArray(structuredData) ? structuredData : [structuredData]).filter(
  (item): item is StructuredData => Boolean(item) && Object.keys(item).length > 0,
);
const keywordContent = keywords.join(", ");
const normalizedCurrentLocale = locale.replace("_", "-").toLowerCase();
const normalizedCurrentHreflang = locale === "en_US" ? "en" : locale.replace("_", "-").toLowerCase();
---

<title data-i18n={i18nTitleKey}>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="author" content="Lumno" />
<meta name="generator" content="Astro" />
<meta http-equiv="content-language" content={normalizedCurrentLocale} />
<meta name="application-name" content={SITE_NAME} />
<meta name="apple-mobile-web-app-title" content={SITE_NAME} />
<meta name="theme-color" content="#fafafa" />
{googleSiteVerification ? <meta name="google-site-verification" content={googleSiteVerification} /> : null}
{bingSiteVerification ? <meta name="msvalidate.01" content={bingSiteVerification} /> : null}
{baiduSiteVerification ? <meta name="baidu-site-verification" content={baiduSiteVerification} /> : null}
{sogouSiteVerification ? <meta name="sogou_site_verification" content={sogouSiteVerification} /> : null}
{keywordContent ? <meta name="keywords" content={keywordContent} /> : null}
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="text/plain" href={new URL("/llms.txt", SITE_URL).toString()} title="Lumno for answer engines" />
{alternates.map((item) => (
  <link rel="alternate" hreflang={item.hreflang} href={item.href} />
))}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />
{squareImageUrl ? (
  <>
    <meta property="og:image" content={squareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
  </>
) : null}
<meta property="og:locale" content={locale} />
{alternates
  .filter((item) => item.hreflang !== "x-default")
  .filter((item) => item.hreflang.toLowerCase() !== normalizedCurrentHreflang)
  .map((item) => (
    <meta property="og:locale:alternate" content={getOpenGraphLocale(item.hreflang)} />
  ))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={twitterImageUrl} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:site" content="@Kubai087" />
<meta name="twitter:creator" content="@Kubai087" />

<script
  is:inline
  defer
  src="https://vibeloft.ai/telemetry/v1.js"
  data-vl-product-id="0e7d5952-e389-4515-9021-ccbea09452ba"
  data-vl-auth-key="vl_web.F7PpXm95_ASgDflv47lpGy6Zy3uFKqLOADrwMHIbJPw"
></script>

{schemaItems.map((item) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
))}

{gaId ? <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script> : null}
{gaId ? (
  <script is:inline define:vars={{ gaId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = window.gtag || gtag;
    window.gtag("js", new Date());
    window.gtag("config", gaId, {
      page_path: window.location.pathname + window.location.search,
      anonymize_ip: true,
    });

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target.closest("[data-analytics-event]") : null;
      if (!target) return;
      const eventName = target.getAttribute("data-analytics-event");
      if (!eventName) return;

      window.gtag("event", eventName, {
        event_category: target.getAttribute("data-analytics-category") || "engagement",
        event_label: target.getAttribute("data-analytics-label") || target.getAttribute("href") || "",
        destination: target.getAttribute("href") || "",
        page_location: window.location.href,
      });
    });
  </script>
) : null}
