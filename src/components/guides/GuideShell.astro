---
import { marked } from "marked";
import "../../styles/guides.css";
import {
  GUIDES_LAST_UPDATED,
  getGuideBanner,
  getGuideContent,
  type GuideLocale,
  type GuideNavKey,
} from "../../lib/guides";
import { buildLocalizedPath } from "../../lib/locales";
import GuideNavList from "./GuideNavList.astro";
import { SettingsIconButton } from "../extension-settings/SettingsKit";
import { getCommunityPanel } from "../../lib/community-panel";
import { COMMUNITY_LINKS } from "../../lib/community";
import { getHomeContent } from "../../lib/home-content";
import { GITHUB_ISSUE_URL } from "../../lib/site-links";
import { communityTriggerAttributes } from "../home/CommunityPanel";
import { createHash } from "node:crypto";
import searchLibSource from "../../scripts/help-center-search.js?raw";

/*
 * The help center's frame, shared by its pages and the privacy policy: search
 * and the page list on the left, the article under its banner, the outline on
 * the right, and the full-size screenshot viewer.
 */
interface Props {
  locale: GuideLocale;
  current: GuideNavKey;
  title: string;
  sections: Array<{ id: string; title: string }>;
  /** ISO date shown under the title; defaults to when the guides were last checked. */
  updated?: string;
  /** Replaces the "updated {date}" line, for pages in a language other than the help center's. */
  updatedText?: string;
}

const { locale, current, title, sections, updated = GUIDES_LAST_UPDATED, updatedText } = Astro.props;
const { ui } = getGuideContent(locale);
// When a page doesn't answer it: the same channels as the community panel, in this language's order.
const { community } = getHomeContent(locale);
const banner = getGuideBanner(current);
const displayUpdated = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(new Date(`${updated}T00:00:00Z`));
// buildLocalizedPath ends paths with "/", so the file name goes after the directory.
const searchIndexHref = `${buildLocalizedPath(locale, "/help/")}search-index.json`;
const searchSynonymsHref = `${buildLocalizedPath(locale, "/help/")}search-synonyms.json`;
// The matching rules, shared with the extension, load with the index on first use; the hash keeps caches honest.
const searchLibHref = `/help/help-center-search.js?v=${createHash("sha256").update(searchLibSource).digest("hex").slice(0, 10)}`;
---

<div class="guide">
  <aside class="guide-side">
    <div
      class="guide-search"
      data-guide-search
      data-index={searchIndexHref}
      data-synonyms={searchSynonymsHref}
      data-lib={searchLibHref}
      data-recommended={ui.searchRecommended}
    >
      <i class="ri-search-line" aria-hidden="true"></i>
      <input
        type="search"
        placeholder={ui.searchPlaceholder}
        aria-label={ui.searchLabel}
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="guide-search-results"
      />
      <kbd class="guide-search__hint" aria-hidden="true">/</kbd>
      <div class="guide-search__results" id="guide-search-results" role="listbox" hidden></div>
      <!-- The passage around a result's match, beside the list while a result is hovered or picked with the arrow keys. -->
      <div class="guide-search__peek" id="guide-search-peek" role="tooltip" hidden></div>
      <!-- Nothing matches: the ways to ask instead, the same channels as the extension's help search. -->
      <template data-guide-search-feedback>
        <p class="guide-search__group">{ui.searchEmpty}</p>
        {community.kind === "group" && (
          <button
            type="button"
            role="option"
            class="guide-search__option"
            aria-haspopup="dialog"
            data-analytics-event="open_community_panel"
            data-analytics-category="cta"
            data-analytics-label="guide_search_community"
            {...communityTriggerAttributes(getCommunityPanel(locale))}
          >
            <i class="ri-wechat-line" aria-hidden="true"></i>
            <span class="guide-search__title">{ui.searchFeedbackGroup}</span>
          </button>
        )}
        <a
          role="option"
          class="guide-search__option"
          href={GITHUB_ISSUE_URL}
          target="_blank"
          rel="noopener"
          data-analytics-event="open_github_issue"
          data-analytics-category="cta"
          data-analytics-label="guide_search_issue"
        >
          <i class="ri-github-line" aria-hidden="true"></i>
          <span class="guide-search__title">{ui.searchFeedbackIssue}</span>
        </a>
        <a
          role="option"
          class="guide-search__option"
          href={COMMUNITY_LINKS.xUrl}
          target="_blank"
          rel="noopener"
          data-analytics-event="open_author_x"
          data-analytics-category="cta"
          data-analytics-label="guide_search_x"
        >
          <i class="ri-twitter-x-line" aria-hidden="true"></i>
          <span class="guide-search__title">{ui.searchFeedbackAuthor}</span>
        </a>
      </template>
    </div>

    <!-- The pages, wiki style; phones open the same list as a sheet from the bottom bar. -->
    <div class="guide-nav-frame">
    <div class="guide-nav">
      <GuideNavList locale={locale} current={current} />
    </div>
    <!-- When the list overflows, these step it up or down; mouse only, since keyboard focus scrolls it anyway. -->
    <button type="button" class="guide-nav-step guide-nav-step--up" data-guide-nav-step="-1" tabindex="-1" aria-hidden="true">
      <i class="ri-arrow-up-s-line"></i>
    </button>
    <button type="button" class="guide-nav-step guide-nav-step--down" data-guide-nav-step="1" tabindex="-1" aria-hidden="true">
      <i class="ri-arrow-down-s-line"></i>
    </button>
    </div>
    <script is:inline>
      // Keep the page list where it was on the previous page, before anything paints.
      try {
        const saved = Number(sessionStorage.getItem("lumno-guide-nav-scroll"));
        if (saved) document.querySelector(".guide-nav").scrollTop = saved;
      } catch (_error) {}
      const nav = document.querySelector(".guide-nav");
      const frame = nav.parentElement;
      const markMore = () => {
        const above = nav.scrollTop > 1;
        const below = nav.scrollTop + nav.clientHeight < nav.scrollHeight - 1;
        nav.toggleAttribute("data-more-above", above);
        nav.toggleAttribute("data-more", below);
        frame.toggleAttribute("data-above", above);
        frame.toggleAttribute("data-below", below);
      };
      markMore();
      frame.querySelectorAll("[data-guide-nav-step]").forEach((button) => {
        button.addEventListener("click", () => {
          nav.scrollBy({ top: Number(button.dataset.guideNavStep) * nav.clientHeight * 0.6, behavior: "smooth" });
        });
      });
      nav.addEventListener("scroll", markMore, { passive: true });
      window.addEventListener("resize", markMore);
    </script>
  </aside>

  <div class="guide__banner" style={`background-color: ${banner.color}`}>
    <img src={banner.src} width={banner.width} height={banner.height} alt="" loading="eager" fetchpriority="high" decoding="async" />
  </div>

  <article class="guide__article">
    <header class="guide__head">
      <h1>{title}</h1>
      <p class="guide__meta">
        <time datetime={updated}>{updatedText ?? ui.updatedLabel.replace("{date}", displayUpdated)}</time>
        <slot name="meta" />
      </p>
      <slot name="note" />
    </header>

    <div class="guide__body">
      <slot />
    </div>

    <aside class="guide__stuck">
      <p>{ui.stuckText}</p>
      <div class="guide__stuck-actions">
        {community.kind === "group" ? (
          <button
            type="button"
            class="guide__stuck-button"
            aria-haspopup="dialog"
            data-analytics-event="open_community_panel"
            data-analytics-category="cta"
            data-analytics-label="guide_stuck_community"
            {...communityTriggerAttributes(getCommunityPanel(locale))}
          >
            <i class="ri-wechat-line" aria-hidden="true"></i>
            {ui.stuckPrimary}
          </button>
        ) : (
          <a
            class="guide__stuck-button"
            href={GITHUB_ISSUE_URL}
            target="_blank"
            rel="noopener"
            data-analytics-event="open_github_issue"
            data-analytics-category="cta"
            data-analytics-label="guide_stuck_issue"
          >
            <i class="ri-github-line" aria-hidden="true"></i>
            {ui.stuckPrimary}
          </a>
        )}
        <a
          class="guide__stuck-button"
          href={community.kind === "group" ? GITHUB_ISSUE_URL : COMMUNITY_LINKS.xUrl}
          target="_blank"
          rel="noopener"
          data-analytics-event={community.kind === "group" ? "open_github_issue" : "open_author_x"}
          data-analytics-category="cta"
          data-analytics-label={community.kind === "group" ? "guide_stuck_issue" : "guide_stuck_x"}
        >
          <i class={community.kind === "group" ? "ri-github-line" : "ri-twitter-x-line"} aria-hidden="true"></i>
          {ui.stuckSecondary}
        </a>
      </div>
    </aside>

    <slot name="footer" />
  </article>

  {sections.length > 0 && (
    <nav class="guide__toc" aria-label={ui.tocLabel}>
      <p class="guide__toc-title">{ui.tocLabel}</p>
      <ol>
        {sections.map((section) => (
          <li>
            <a href={`#${section.id}`} data-guide-toc={section.id} set:html={marked.parseInline(section.title)} />
          </li>
        ))}
      </ol>
    </nav>
  )}
</div>

{/*
  * Narrower screens hide the outline column, and phones the page list too (sspai's pattern):
  * one bar at the bottom opens either as a sheet. The page half shows on phones only.
  */}
<div class={sections.length > 0 ? "guide-dock" : "guide-dock guide-dock--pages-only"}>
  <button type="button" class="guide-dock__button guide-dock__button--pages" data-guide-sheet-open="pages" aria-haspopup="dialog">
    <i class="ri-book-open-line" aria-hidden="true"></i>
    <span class="guide-dock__label">{ui.navToggle}</span>
  </button>
  {sections.length > 0 && (
    <button type="button" class="guide-dock__button guide-dock__button--outline" data-guide-sheet-open="outline" aria-haspopup="dialog">
      <i class="ri-list-check" aria-hidden="true"></i>
      <span class="guide-dock__label">{ui.tocLabel}</span>
      <span class="guide-dock__current" data-guide-outline-current set:html={marked.parseInline(sections[0].title)} />
      <i class="ri-arrow-up-s-line" aria-hidden="true"></i>
    </button>
  )}
</div>
<dialog class="guide-sheet guide-pages-sheet" data-guide-sheet="pages" tabindex="-1" aria-label={ui.navToggle}>
  <div class="guide-sheet__head">
    <p class="guide-sheet__title">{ui.navToggle}</p>
    <SettingsIconButton type="button" className="guide-sheet__close" data-guide-sheet-close="" label={ui.closeLabel} iconClass="ri-close-line" />
  </div>
  <div class="guide-nav guide-nav--sheet">
    <GuideNavList locale={locale} current={current} />
  </div>
  <div class="guide-sheet__floor" aria-hidden="true"></div>
</dialog>
{sections.length > 0 && (
  <dialog class="guide-sheet guide-outline-sheet" data-guide-sheet="outline" tabindex="-1" aria-label={ui.tocLabel}>
    <div class="guide-sheet__head">
      <p class="guide-sheet__title">{ui.tocLabel}</p>
      <SettingsIconButton type="button" className="guide-sheet__close" data-guide-sheet-close="" label={ui.closeLabel} iconClass="ri-close-line" />
    </div>
    <ol>
      {sections.map((section) => (
        <li>
          <a href={`#${section.id}`} data-guide-toc={section.id} set:html={marked.parseInline(section.title)} />
        </li>
      ))}
    </ol>
    <div class="guide-sheet__floor" aria-hidden="true"></div>
  </dialog>
)}

<dialog class="guide-lightbox" tabindex="-1" aria-label={ui.zoomLabel}>
  <img alt="" />
  <SettingsIconButton type="button" className="guide-lightbox__close" label={ui.closeLabel} iconClass="ri-close-line" />
</dialog>

<script is:inline>
  (() => {
    // Arriving from another help page: start where the reader was, then glide to the top.
    let from = 0;
    try {
      from = Number(sessionStorage.getItem("lumno-guide-page-scroll")) || 0;
      sessionStorage.removeItem("lumno-guide-page-scroll");
    } catch (_error) {}
    if (from > 0 && !window.location.hash) {
      // Start at most about a screen down, so even a long page arrives quickly.
      const start = Math.min(from, window.innerHeight, document.documentElement.scrollHeight - window.innerHeight);
      window.scrollTo({ top: start, behavior: "instant" });
      /*
       * The bar must not move during the swap: no morph between the pages and
       * no drop-in on this one. Where the banner is already out of view it
       * shows as the settled glass pill, as it was on the last page; the site
       * header then retracts it while it glides the page up (data-nav-arrival).
       */
      const nav = document.querySelector(".top-nav");
      const banner = document.querySelector(".guide__banner");
      if (nav) {
        nav.style.viewTransitionName = "none";
        window.setTimeout(() => nav.style.removeProperty("view-transition-name"), 1000);
        if (banner && banner.getBoundingClientRect().bottom <= 0) {
          nav.removeAttribute("data-nav-surface");
          document.body.classList.add("has-nav-install", "is-nav-install-settled");
        }
      }
      document.documentElement.dataset.navArrival = "glide";
    }
  })();

  (() => {
    // Mark the section being read in the outline: the last heading above the top fifth of the screen.
    const links = [...document.querySelectorAll("[data-guide-toc]")];
    const headings = links.map((link) => document.getElementById(link.dataset.guideToc)).filter(Boolean);
    if (headings.length) {
      let frame = 0;
      const update = () => {
        frame = 0;
        const line = window.innerHeight * 0.2;
        let current = headings[0];
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= line) current = heading;
        }
        links.forEach((link) => {
          if (link.dataset.guideToc === current.id) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
        const label = document.querySelector("[data-guide-outline-current]");
        const source = links.find((link) => link.dataset.guideToc === current.id);
        if (label && source && label.innerHTML !== source.innerHTML) label.innerHTML = source.innerHTML;
      };
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule);
      update();
    }

    // The bottom bar's sheets: each closes on a link, the close button, a tap on the
    // backdrop or Esc. Section links keep their own jump to the heading.
    document.querySelectorAll("[data-guide-sheet-open]").forEach((button) => {
      const sheet = document.querySelector(`[data-guide-sheet="${button.dataset.guideSheetOpen}"]`);
      if (!sheet || typeof sheet.showModal !== "function") return;
      button.addEventListener("click", () => {
        sheet.showModal();
        // Focus the sheet itself, not its close button, so Safari draws no ring on a tap.
        sheet.focus({ preventScroll: true });
        const here = sheet.querySelector("[aria-current]");
        if (here) here.scrollIntoView({ block: "center" });
      });
      sheet.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;
        if (target === sheet || target.closest("[data-guide-sheet-close]") || target.closest("a")) sheet.close();
      });
    });

    // Screenshots open full size; a click anywhere or Esc closes them.
    const lightbox = document.querySelector(".guide-lightbox");
    const lightboxImage = lightbox && lightbox.querySelector("img");
    if (lightbox && lightboxImage && typeof lightbox.showModal === "function") {
      document.addEventListener("click", (event) => {
        const trigger = event.target instanceof Element ? event.target.closest("[data-guide-zoom]") : null;
        if (!trigger) return;
        const image = trigger.querySelector("img");
        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt;
        lightbox.showModal();
        lightbox.focus({ preventScroll: true });
      });
      lightbox.addEventListener("click", () => lightbox.close());
    }

    // Code blocks copy their whole text; the button says so for a moment.
    document.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest("[data-guide-copy]") : null;
      const code = button && button.parentElement.querySelector("code");
      if (!code || !navigator.clipboard) return;
      navigator.clipboard.writeText(code.textContent).then(() => {
        button.textContent = button.dataset.copiedLabel;
        window.clearTimeout(button.copyTimer);
        button.copyTimer = window.setTimeout(() => {
          button.textContent = button.dataset.copyLabel;
        }, 1600);
      }, () => {});
    });

    // Moving to another page: switch at once, then glide up from where the reader was.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const goTo = (href) => {
      const url = new URL(href, window.location.href);
      const samePage = url.pathname === window.location.pathname && url.search === window.location.search;
      if (samePage) {
        window.location.hash = url.hash;
        return;
      }
      try {
        sessionStorage.setItem("lumno-guide-nav-scroll", String(document.querySelector(".guide-nav").scrollTop));
        if (!url.hash && !reduceMotion) sessionStorage.setItem("lumno-guide-page-scroll", String(Math.round(window.scrollY)));
      } catch (_error) {}
      // Between help pages the bar stays put instead of morphing (see the arrival script).
      const nav = document.querySelector(".top-nav");
      if (nav) nav.style.viewTransitionName = "none";
      window.location.href = url.href;
    };
    document.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest(".guide-nav a, .guide__pager a:not([data-guide-home]), .guide-search__results a") : null;
      if (!link || link.target === "_blank") return;
      event.preventDefault();
      goTo(link.href);
    });

    // Search: the index, synonyms and matching rules (src/scripts/help-center-search.js, the same file the
    // extension's help search runs) load on first focus. "/" focuses the box.
    const box = document.querySelector("[data-guide-search]");
    const input = box && box.querySelector("input");
    const results = box && box.querySelector(".guide-search__results");
    const feedback = box && box.querySelector("template[data-guide-search-feedback]");
    const peek = box && box.querySelector(".guide-search__peek");
    if (!box || !input || !results || !feedback || !peek) return;
    let index = null;
    let synonyms = [];
    let loading = null;
    let active = -1;
    let found = [];
    let terms = [];
    const loadScript = (src) =>
      window.LumnoHelpCenterSearch
        ? Promise.resolve()
        : new Promise((resolve, reject) => {
            const script = document.createElement("script");
            script.src = src;
            script.onload = resolve;
            script.onerror = reject;
            document.head.append(script);
          });
    const loadJson = (href) => fetch(href).then((response) => {
      if (!response.ok) throw new Error(`${href}: ${response.status}`);
      return response.json();
    });
    // A failed load is forgotten so the next keystroke retries; until then nothing is listed,
    // so being offline isn't reported as missing content.
    const load = () => {
      if (!loading) {
        loading = Promise.all([loadJson(box.dataset.index), loadJson(box.dataset.synonyms).catch(() => []), loadScript(box.dataset.lib)])
          .then(([data, groups]) => {
            index = window.LumnoHelpCenterSearch.normalizeIndex(data);
            synonyms = window.LumnoHelpCenterSearch.normalizeSynonyms(groups);
          })
          .catch(() => (loading = null));
      }
      return loading || Promise.resolve();
    };
    const escape = (value) =>
      value.replace(/[&<>"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[char]);
    const highlight = (text, terms) => {
      let html = escape(text);
      terms.forEach((term) => {
        const pattern = new RegExp(escape(term).replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "gi");
        html = html.replace(pattern, (match) => `<mark>${match}</mark>`);
      });
      return html;
    };
    const options = () => [...results.querySelectorAll('[role="option"]')];

    // The hover card: the result's passage laid out as the page has it (heading, paragraphs, lists,
    // table rows), to the right of the list, else to its left, else above or below the row.
    const peekHtml = (blocks) => {
      const html = [];
      blocks.forEach((block, i) => {
        const previous = blocks[i - 1];
        const next = blocks[i + 1];
        const text = block.text ? highlight(block.text, terms) : "";
        if (block.kind === "heading") html.push(`<p class="guide-search__peek-heading">${text}</p>`);
        else if (block.kind === "text") html.push(`<p>${text}</p>`);
        else if (block.kind === "row") {
          if (previous?.kind !== "row") html.push("<table>");
          const tag = block.header ? "th" : "td";
          html.push(`<tr>${block.cells.map((cell) => `<${tag}>${highlight(cell, terms)}</${tag}>`).join("")}</tr>`);
          if (next?.kind !== "row") html.push("</table>");
        } else {
          const list = block.kind === "step" ? "ol" : "ul";
          if (previous?.kind !== block.kind) html.push(list === "ol" ? `<ol start="${parseInt(block.marker, 10) || 1}">` : "<ul>");
          html.push(`<li>${text}</li>`);
          if (next?.kind !== block.kind) html.push(`</${list}>`);
        }
      });
      return html.join("");
    };
    let peekRow = null;
    let peekTimer = 0;
    const hidePeek = () => {
      clearTimeout(peekTimer);
      peekRow?.removeAttribute("aria-describedby");
      peekRow = null;
      peek.hidden = true;
    };
    const placePeek = () => {
      if (!peekRow) return;
      peek.hidden = false;
      const gap = 8;
      const list = results.getBoundingClientRect();
      const row = peekRow.getBoundingClientRect();
      const { innerWidth: width, innerHeight: height } = window;
      const { offsetWidth: w, offsetHeight: h } = peek;
      const clamp = (value, max) => Math.max(gap, Math.min(value, max - gap));
      let placement = "right";
      let x = list.right + gap;
      let y = clamp(row.top, height - h);
      if (x + w > width - gap) {
        placement = "left";
        x = list.left - gap - w;
      }
      // No room beside it: under the whole list, else over the search box, never on top of other results.
      if (x < gap) {
        x = clamp(list.left, width - w);
        if (list.bottom + gap + h <= height - gap) {
          placement = "bottom";
          y = list.bottom + gap;
        } else if (box.getBoundingClientRect().top - gap - h >= gap) {
          placement = "top";
          y = box.getBoundingClientRect().top - gap - h;
        } else {
          peek.hidden = true;
          return;
        }
      }
      peek.dataset.placement = placement;
      peek.style.left = `${Math.round(x)}px`;
      peek.style.top = `${Math.round(y)}px`;
    };
    const showPeek = (row) => {
      clearTimeout(peekTimer);
      const item = found[Number(row?.dataset.result)];
      if (!item?.context?.length) {
        hidePeek();
        return;
      }
      if (row !== peekRow) {
        peekRow?.removeAttribute("aria-describedby");
        peekRow = row;
        peek.innerHTML = peekHtml(item.context);
        row.setAttribute("aria-describedby", peek.id);
      }
      placePeek();
    };
    // The first card waits a moment so passing over the list doesn't flash it; once one is up, the next follows at once.
    const hoverPeek = (row) => {
      clearTimeout(peekTimer);
      if (!peek.hidden) showPeek(row);
      else peekTimer = setTimeout(() => showPeek(row), 250);
    };
    // One row is lit at a time, as in the site's menus: the pointer and the arrow keys move the same highlight.
    let pointerPicked = false;
    const setActive = (next, { byPointer = false } = {}) => {
      const items = options();
      if (!items.length) return;
      active = next < 0 ? -1 : (next + items.length) % items.length;
      pointerPicked = byPointer && active >= 0;
      items.forEach((item, i) => item.setAttribute("aria-selected", i === active ? "true" : "false"));
      if (active < 0) return;
      if (byPointer) {
        hoverPeek(items[active]);
      } else {
        items[active].scrollIntoView({ block: "nearest" });
        showPeek(items[active]);
      }
    };
    if (window.matchMedia("(hover: hover)").matches) {
      // pointermove, not pointerover: rows scrolling under a still pointer don't take the highlight from the keys.
      results.addEventListener("pointermove", (event) => {
        const row = event.target instanceof Element ? event.target.closest('[role="option"]') : null;
        const index = options().indexOf(row);
        if (index >= 0 && index !== active) setActive(index, { byPointer: true });
      });
      results.addEventListener("pointerleave", () => {
        if (!pointerPicked) return;
        setActive(-1);
        hidePeek();
      });
    }
    results.addEventListener("scroll", placePeek, { passive: true });
    window.addEventListener("resize", hidePeek);
    const render = () => {
      const query = input.value.trim();
      active = -1;
      hidePeek();
      if (!query || !index) {
        results.hidden = true;
        found = [];
        input.setAttribute("aria-expanded", "false");
        return;
      }
      const search = window.LumnoHelpCenterSearch;
      found = search.searchIndex(index, query, { synonyms });
      terms = search.getExactTerms(query, synonyms);
      const row = (item) =>
        `<a role="option" href="${escape(item.url)}" data-result="${found.indexOf(item)}"><span class="guide-search__title">${highlight(item.title, terms)}</span><span class="guide-search__detail">${highlight(item.detail, terms)}</span></a>`;
      const exact = found.filter((item) => !item.recommended);
      const recommended = found.filter((item) => item.recommended);
      if (found.length) {
        results.innerHTML = [
          ...exact.map(row),
          ...(recommended.length ? [`<p class="guide-search__group">${escape(box.dataset.recommended)}</p>`] : []),
          ...recommended.map(row),
        ].join("");
      } else {
        results.replaceChildren(feedback.content.cloneNode(true));
      }
      results.hidden = false;
      input.setAttribute("aria-expanded", "true");
    };
    input.addEventListener("focus", () => load().then(render));
    input.addEventListener("input", () => load().then(render));
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(active + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(active - 1);
      } else if (event.key === "Enter") {
        const target = options()[active >= 0 ? active : 0];
        // Help pages open in place; the ways to ask open in a new tab or the group panel.
        if (target && target.matches("a:not([target])")) goTo(target.href);
        else if (target) target.click();
      } else if (event.key === "Escape") {
        input.value = "";
        render();
        input.blur();
      }
    });
    document.addEventListener("click", (event) => {
      if (box.contains(event.target)) return;
      results.hidden = true;
      hidePeek();
    });
    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const typing = target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
      if (event.key === "/" && !typing && !event.metaKey && !event.ctrlKey && !event.altKey) {
        event.preventDefault();
        input.focus();
      }
    });
    // Arriving with ?q= (the extension's Lumno site search): fill the box and list what matches.
    const initialQuery = (new URLSearchParams(window.location.search).get("q") || "").trim();
    if (initialQuery) {
      input.value = initialQuery;
      input.focus({ preventScroll: true });
      load().then(render);
    }
  })();
</script>
