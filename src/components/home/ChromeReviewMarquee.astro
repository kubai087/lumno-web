---
import { DitherShader } from "./DitherShader";
import type { ChromeStoreReview } from "../../lib/chrome-store-reviews";

interface Props {
  eyebrow: string;
  /** Average store rating, already formatted (e.g. "4.8"). */
  rating: string;
  title: string;
  storeUrl: string;
  storeLinkLabel: string;
  ariaLabel: string;
  avatarLabel: string;
  reviews: readonly ChromeStoreReview[];
}

const {
  eyebrow,
  rating,
  title,
  storeUrl,
  storeLinkLabel,
  ariaLabel,
  avatarLabel,
  reviews,
} = Astro.props;

const midpoint = Math.ceil(reviews.length / 2);
const rows = [reviews.slice(0, midpoint), reviews.slice(midpoint)];
---

<section
  id="reviews"
  class="chrome-review-marquee"
  aria-labelledby="reviews-title"
  data-chrome-review-marquee
>
  <header class="home-section__head chrome-review-marquee__header">
    <!-- Eyebrow like the feature sections': where the reviews live, then the rating as a chip. -->
    <a
      class="home-eyebrow chrome-review-marquee__store"
      href={storeUrl}
      target="_blank"
      rel="noreferrer noopener"
      title={storeLinkLabel}
      data-analytics-event="open_chrome_web_store_reviews"
      data-analytics-category="navigation"
      data-analytics-label="home_reviews_store"
    >
      <img src="/assets/browser-logos/chrome.webp" width="18" height="18" alt="" decoding="async" />
      {eyebrow}
      <span class="chrome-review-marquee__rating">
        <i class="ri-star-fill" aria-hidden="true"></i>
        {rating}
      </span>
      <i class="ri-arrow-right-up-line chrome-review-marquee__arrow" aria-hidden="true"></i>
    </a>
    <h2 id="reviews-title" class="home-h2" data-reveal="text"><span>{title}</span></h2>
  </header>

  <div class="chrome-review-marquee__frame home-media" data-reveal>
    <DitherShader
      className="chrome-review-marquee__dither"
      src="/assets/lumno-newtab-monet-coastal-white.webp"
      gridSize={2}
      ditherMode="bayer"
      colorMode="original"
      brightness={0.01}
      contrast={1.08}
      threshold={0.22}
      client:visible
    />

    <div class="chrome-review-marquee__rows" aria-label={ariaLabel}>
      {rows.map((row, rowIndex) => (
        <div class="chrome-review-marquee__lane" data-direction={rowIndex === 0 ? "left" : "right"}>
          <div class="chrome-review-marquee__track" data-review-track={rowIndex + 1}>
            {[false, true].map((duplicate) => (
              <div
                class="chrome-review-marquee__group"
                role={duplicate ? undefined : "list"}
                aria-hidden={duplicate ? "true" : undefined}
              >
                {row.map((review) => (
                  <article class="chrome-review-card" role={duplicate ? undefined : "listitem"}>
                    <p class="chrome-review-card__quote">“{review.review}”</p>
                    <div class="chrome-review-card__meta">
                      <span class="chrome-review-card__avatar" data-initial={Array.from(review.reviewerId)[0]?.toUpperCase()}>
                        {/* Google avatars are unreachable in some regions; fall back to the initial. */}
                        <img
                          src={review.avatarUrl}
                          width="32"
                          height="32"
                          alt={`${review.reviewerId} ${avatarLabel}`}
                          loading="lazy"
                          decoding="async"
                          referrerpolicy="no-referrer"
                          onerror="this.remove()"
                        />
                      </span>
                      <div class="chrome-review-card__identity">
                        <strong>{review.reviewerId}</strong>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const HOVER_PAUSE_DELAY_MS = 600;

  const fillTrack = (track: HTMLElement) => {
    const lane = track.closest<HTMLElement>(".chrome-review-marquee__lane");
    const baseGroup = track.querySelector<HTMLElement>(".chrome-review-marquee__group");
    const duplicateTemplate = track.querySelector<HTMLElement>(
      '.chrome-review-marquee__group[aria-hidden="true"]',
    );
    if (!lane || !baseGroup || !duplicateTemplate) return;

    const gap = Number.parseFloat(window.getComputedStyle(track).columnGap) || 0;
    const shiftDistance = baseGroup.getBoundingClientRect().width + gap;
    if (shiftDistance <= gap) return;

    track.style.setProperty("--chrome-review-group-shift", `${shiftDistance}px`);

    const minimumGroupCount = Math.max(
      2,
      1 + Math.ceil((lane.clientWidth + gap) / shiftDistance),
    );

    while (track.children.length < minimumGroupCount) {
      const duplicate = duplicateTemplate.cloneNode(true) as HTMLElement;
      duplicate.dataset.reviewGroupCopy = "true";
      track.append(duplicate);
    }

    while (track.children.length > minimumGroupCount) {
      const lastGroup = track.lastElementChild as HTMLElement | null;
      if (!lastGroup?.hasAttribute("data-review-group-copy")) break;
      lastGroup.remove();
    }
  };

  document.querySelectorAll<HTMLElement>("[data-chrome-review-marquee]").forEach((marquee) => {
    let hoverPauseTimer: number | undefined;
    let isPointerInside = false;
    const tracks = Array.from(
      marquee.querySelectorAll<HTMLElement>(".chrome-review-marquee__track"),
    );

    const fillTracks = () => {
      tracks.forEach(fillTrack);
      marquee.dataset.marqueeReady = "true";
    };

    fillTracks();

    const resizeObserver = new ResizeObserver(fillTracks);
    marquee.querySelectorAll<HTMLElement>(".chrome-review-marquee__lane").forEach((lane) => {
      resizeObserver.observe(lane);
    });

    const clearHoverPauseTimer = () => {
      if (hoverPauseTimer === undefined) return;
      window.clearTimeout(hoverPauseTimer);
      hoverPauseTimer = undefined;
    };

    const scheduleHoverPauseAfterIdle = () => {
      clearHoverPauseTimer();
      delete marquee.dataset.hoverPaused;
      hoverPauseTimer = window.setTimeout(() => {
        marquee.dataset.hoverPaused = "true";
        hoverPauseTimer = undefined;
      }, HOVER_PAUSE_DELAY_MS);
    };

    const handlePointerEnter = (event: PointerEvent) => {
      if (event.pointerType !== "mouse") return;
      isPointerInside = true;
      scheduleHoverPauseAfterIdle();
    };

    const handlePointerMove = (event: PointerEvent) => {
      if (event.pointerType !== "mouse" || !isPointerInside) return;
      scheduleHoverPauseAfterIdle();
    };

    const handleScrollActivity = () => {
      if (!isPointerInside) return;
      scheduleHoverPauseAfterIdle();
    };

    marquee.addEventListener("pointerenter", handlePointerEnter);
    marquee.addEventListener("pointermove", handlePointerMove);

    marquee.addEventListener("pointerleave", () => {
      isPointerInside = false;
      clearHoverPauseTimer();
      delete marquee.dataset.hoverPaused;
    });

    window.addEventListener("scroll", handleScrollActivity, { passive: true });
  });
</script>

<style>
  .chrome-review-marquee {
    position: relative;
    z-index: var(--home-z-content);
    width: 100%;
    margin-top: 0;
    padding: var(--home-section-space) 0;
  }

  .chrome-review-marquee__frame {
    position: relative;
    isolation: isolate;
    width: var(--home-column);
    margin: 0 auto;
    padding: var(--home-card-pad) 0;
    overflow: hidden;
    border-radius: var(--home-radius-xl);
    background: #f7f8ef;
    box-shadow: none;
  }

  .chrome-review-marquee__frame::after {
    display: none;
  }

  :global(.chrome-review-marquee__dither) {
    z-index: 0;
    border-radius: inherit;
    background: url("/assets/lumno-newtab-monet-coastal-white.webp") center / cover no-repeat;
    pointer-events: none;
  }

  :global(.chrome-review-marquee__dither canvas) {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .chrome-review-marquee__rows {
    position: relative;
    z-index: 1;
  }

  .chrome-review-marquee__header {
    width: min(calc(100% - var(--home-gutter) * 2), 720px);
  }

  .chrome-review-marquee__store {
    gap: 8px;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .chrome-review-marquee__store:hover {
    color: var(--home-ink);
  }

  .chrome-review-marquee__store img {
    flex: none;
    width: 18px;
    height: 18px;
  }

  /* Sits in the eyebrow the way keycaps do in the feature sections. */
  .chrome-review-marquee__rating {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 22px;
    padding: 0 7px 0 6px;
    border: 1px solid var(--home-card-border);
    border-radius: var(--home-radius-xs);
    background: var(--home-card);
    color: var(--home-ink);
    font-family: "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    font-style: normal;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .chrome-review-marquee__rating i {
    color: #e0a526;
    font-size: 13px;
  }

  .chrome-review-marquee__arrow {
    margin-left: -2px;
    font-size: 14px;
    transition: transform 160ms ease;
  }

  .chrome-review-marquee__store:hover .chrome-review-marquee__arrow {
    transform: translate(2px, -2px);
  }

  .chrome-review-marquee__rows {
    display: grid;
    gap: var(--home-grid-gap);
  }

  .chrome-review-marquee__lane {
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .chrome-review-marquee__track {
    width: max-content;
    display: flex;
    gap: var(--home-grid-gap);
    will-change: transform;
  }

  .chrome-review-marquee[data-marquee-ready="true"] .chrome-review-marquee__track {
    animation: chrome-review-scroll-left 38s linear infinite;
  }

  .chrome-review-marquee[data-marquee-ready="true"]
    [data-direction="right"]
    .chrome-review-marquee__track {
    animation-name: chrome-review-scroll-right;
    animation-duration: 44s;
  }

  .chrome-review-marquee[data-hover-paused="true"] .chrome-review-marquee__track,
  .chrome-review-marquee:focus-within .chrome-review-marquee__track {
    animation-play-state: paused;
  }

  .chrome-review-marquee__group {
    display: flex;
    flex: none;
    gap: var(--home-grid-gap);
  }

  .chrome-review-card {
    width: clamp(310px, 29vw, 400px);
    min-height: 172px;
    padding: var(--home-space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--home-space-5);
    border-radius: var(--home-radius-lg);
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .chrome-review-card__quote {
    margin: 0;
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-main, #15171a);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .chrome-review-card__meta {
    min-width: 0;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: center;
    gap: 9px;
  }

  .chrome-review-card__avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--home-olive-soft, #eef2ea);
    box-shadow: inset 0 0 0 1px var(--home-card-border);
  }

  .chrome-review-card__avatar::before {
    content: attr(data-initial);
    color: var(--home-olive, #6d7f63);
    font-size: 13px;
    font-weight: 700;
  }

  .chrome-review-card__avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .chrome-review-card__identity {
    min-width: 0;
  }

  .chrome-review-card__identity strong {
    display: block;
    overflow: hidden;
    color: var(--text-main, #15171a);
    font-size: 12px;
    line-height: 1.35;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @keyframes chrome-review-scroll-left {
    to { transform: translateX(calc(-1 * var(--chrome-review-group-shift))); }
  }

  @keyframes chrome-review-scroll-right {
    from { transform: translateX(calc(-1 * var(--chrome-review-group-shift))); }
    to { transform: translateX(0); }
  }

  /*
   * Phones: two moving lanes over the dithered painting read as noise at this
   * width, with every card cut by the edge. Instead the reviews sit in one
   * row of plain white cards on the page, swiped by hand, the next card
   * peeking in from the edge. The lanes, tracks and groups step aside
   * (display: contents) so the cards line up in the row; the marquee's
   * duplicate groups are dropped.
   */
  @media (max-width: 760px) {
    .chrome-review-marquee__frame {
      width: 100%;
      padding: 0;
      border-radius: 0;
      background: none;
    }

    :global(.chrome-review-marquee__dither) {
      display: none;
    }

    .chrome-review-marquee__rows {
      display: flex;
      gap: 12px;
      padding: 4px var(--home-gutter) 24px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-padding-inline: var(--home-gutter);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .chrome-review-marquee__rows::-webkit-scrollbar {
      display: none;
    }

    .chrome-review-marquee__lane,
    .chrome-review-marquee__track,
    .chrome-review-marquee__group {
      display: contents;
    }

    .chrome-review-marquee__group[aria-hidden="true"] {
      display: none;
    }

    .chrome-review-card {
      flex: none;
      width: min(80vw, 320px);
      min-height: 0;
      padding: var(--home-space-5);
      gap: var(--home-space-4);
      border: 1px solid var(--home-card-border);
      background: var(--home-card);
      box-shadow: var(--home-shadow-card);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      scroll-snap-align: start;
    }

    .chrome-review-card__quote {
      font-size: 15px;
      -webkit-line-clamp: 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chrome-review-marquee__lane {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .chrome-review-marquee__lane::-webkit-scrollbar {
      display: none;
    }

    .chrome-review-marquee__track {
      animation: none;
      will-change: auto;
    }
  }
</style>
