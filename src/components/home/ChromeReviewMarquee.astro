---
import { SettingsButton } from "../extension-settings/SettingsKit";
import { DitherShader } from "./DitherShader";
import type { SupportedLocale } from "../../lib/locales";
import type { ChromeStoreReview } from "../../lib/chrome-store-reviews";

interface Props {
  title: string;
  summary: string;
  sourceLabel: string;
  ariaLabel: string;
  avatarLabel: string;
  ratingLabel: string;
  reviewUrl: string;
  locale: SupportedLocale;
  reviews: readonly ChromeStoreReview[];
}

const {
  title,
  summary,
  sourceLabel,
  ariaLabel,
  avatarLabel,
  ratingLabel,
  reviewUrl,
  locale,
  reviews,
} = Astro.props;

const midpoint = Math.ceil(reviews.length / 2);
const rows = [reviews.slice(0, midpoint), reviews.slice(midpoint)];
const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<section class="chrome-review-marquee" aria-label={ariaLabel} data-chrome-review-marquee>
  <div class="chrome-review-marquee__header">
    <div class="chrome-review-marquee__heading">
      <h2>{title}</h2>
      <div class="chrome-review-marquee__proof">
        <p>
          <span class="chrome-review-marquee__stars" aria-hidden="true">
            {Array.from({ length: 5 }, (_, index) => <i class="ri-star-fill" data-star-index={index}></i>)}
          </span>
          <span>{summary}</span>
        </p>
        <SettingsButton
          as="a"
          variant="ghost"
          className="chrome-review-marquee__source"
          href={reviewUrl}
          target="_blank"
          rel="noreferrer noopener"
          aria-label={sourceLabel}
          iconClass="ri-arrow-right-up-line"
          iconPosition="end"
          data-analytics-event="open_chrome_web_store_reviews"
          data-analytics-category="social-proof"
          data-analytics-label="home_review_marquee"
        >
          {sourceLabel}
        </SettingsButton>
      </div>
    </div>
  </div>

  <div class="chrome-review-marquee__frame">
    <DitherShader
      className="chrome-review-marquee__dither"
      src="/assets/lumno-newtab-monet-coastal-white.webp"
      gridSize={2}
      ditherMode="bayer"
      colorMode="original"
      brightness={0.01}
      contrast={1.08}
      threshold={0.22}
      client:visible
    />

    <div class="chrome-review-marquee__rows">
      {rows.map((row, rowIndex) => (
        <div class="chrome-review-marquee__lane" data-direction={rowIndex === 0 ? "left" : "right"}>
          <div class="chrome-review-marquee__track" data-review-track={rowIndex + 1}>
            {[false, true].map((duplicate) => (
              <div
                class="chrome-review-marquee__group"
                role={duplicate ? undefined : "list"}
                aria-hidden={duplicate ? "true" : undefined}
              >
                {row.map((review) => (
                  <article class="chrome-review-card" role={duplicate ? undefined : "listitem"}>
                    <p class="chrome-review-card__quote">“{review.review}”</p>
                    <div class="chrome-review-card__meta">
                      <img
                        src={review.avatarUrl}
                        width="40"
                        height="40"
                        alt={`${review.reviewerId} ${avatarLabel}`}
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                      <div class="chrome-review-card__identity">
                        <strong>{review.reviewerId}</strong>
                        <time datetime={review.publishedAt}>
                          {dateFormatter.format(new Date(`${review.publishedAt}T00:00:00Z`))}
                        </time>
                      </div>
                      <span class="chrome-review-card__rating" aria-label={`${review.rating} ${ratingLabel}`}>
                        <i class="ri-star-fill" aria-hidden="true"></i>
                        {review.rating.toFixed(1)}
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const HOVER_PAUSE_DELAY_MS = 600;

  const fillTrack = (track: HTMLElement) => {
    const lane = track.closest<HTMLElement>(".chrome-review-marquee__lane");
    const baseGroup = track.querySelector<HTMLElement>(".chrome-review-marquee__group");
    const duplicateTemplate = track.querySelector<HTMLElement>(
      '.chrome-review-marquee__group[aria-hidden="true"]',
    );
    if (!lane || !baseGroup || !duplicateTemplate) return;

    const gap = Number.parseFloat(window.getComputedStyle(track).columnGap) || 0;
    const shiftDistance = baseGroup.getBoundingClientRect().width + gap;
    if (shiftDistance <= gap) return;

    track.style.setProperty("--chrome-review-group-shift", `${shiftDistance}px`);

    const minimumGroupCount = Math.max(
      2,
      1 + Math.ceil((lane.clientWidth + gap) / shiftDistance),
    );

    while (track.children.length < minimumGroupCount) {
      const duplicate = duplicateTemplate.cloneNode(true) as HTMLElement;
      duplicate.dataset.reviewGroupCopy = "true";
      track.append(duplicate);
    }

    while (track.children.length > minimumGroupCount) {
      const lastGroup = track.lastElementChild as HTMLElement | null;
      if (!lastGroup?.hasAttribute("data-review-group-copy")) break;
      lastGroup.remove();
    }
  };

  document.querySelectorAll<HTMLElement>("[data-chrome-review-marquee]").forEach((marquee) => {
    let hoverPauseTimer: number | undefined;
    let isPointerInside = false;
    const tracks = Array.from(
      marquee.querySelectorAll<HTMLElement>(".chrome-review-marquee__track"),
    );

    const fillTracks = () => {
      tracks.forEach(fillTrack);
      marquee.dataset.marqueeReady = "true";
    };

    fillTracks();

    const resizeObserver = new ResizeObserver(fillTracks);
    marquee.querySelectorAll<HTMLElement>(".chrome-review-marquee__lane").forEach((lane) => {
      resizeObserver.observe(lane);
    });

    const clearHoverPauseTimer = () => {
      if (hoverPauseTimer === undefined) return;
      window.clearTimeout(hoverPauseTimer);
      hoverPauseTimer = undefined;
    };

    const scheduleHoverPauseAfterIdle = () => {
      clearHoverPauseTimer();
      delete marquee.dataset.hoverPaused;
      hoverPauseTimer = window.setTimeout(() => {
        marquee.dataset.hoverPaused = "true";
        hoverPauseTimer = undefined;
      }, HOVER_PAUSE_DELAY_MS);
    };

    const handlePointerEnter = (event: PointerEvent) => {
      if (event.pointerType !== "mouse") return;
      isPointerInside = true;
      scheduleHoverPauseAfterIdle();
    };

    const handlePointerMove = (event: PointerEvent) => {
      if (event.pointerType !== "mouse" || !isPointerInside) return;
      scheduleHoverPauseAfterIdle();
    };

    const handleScrollActivity = () => {
      if (!isPointerInside) return;
      scheduleHoverPauseAfterIdle();
    };

    marquee.addEventListener("pointerenter", handlePointerEnter);
    marquee.addEventListener("pointermove", handlePointerMove);

    marquee.addEventListener("pointerleave", () => {
      isPointerInside = false;
      clearHoverPauseTimer();
      delete marquee.dataset.hoverPaused;
    });

    window.addEventListener("scroll", handleScrollActivity, { passive: true });
  });
</script>

<style>
  .chrome-review-marquee {
    position: relative;
    z-index: 3;
    width: 100%;
    margin-top: 0;
    padding: clamp(80px, 7vw, 104px) 0 clamp(72px, 6vw, 92px);
  }

  .chrome-review-marquee__frame {
    position: relative;
    isolation: isolate;
    width: min(calc(100% - 48px), var(--content-width, 1360px));
    margin: 0 auto;
    padding: clamp(24px, 2.5vw, 36px) 0;
    overflow: hidden;
    border-radius: 16px;
    background: #f7f8ef;
  }

  :global(.chrome-review-marquee__dither) {
    z-index: 0;
    border-radius: inherit;
    background: url("/assets/lumno-newtab-monet-coastal-white.webp") center / cover no-repeat;
    pointer-events: none;
  }

  :global(.chrome-review-marquee__dither canvas) {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .chrome-review-marquee__rows {
    position: relative;
    z-index: 1;
  }

  .chrome-review-marquee__header {
    width: min(calc(100% - 24px), 1180px);
    min-height: 82px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .chrome-review-marquee__heading {
    display: grid;
    justify-items: center;
  }

  .chrome-review-marquee__header h2 {
    margin: 0;
    color: var(--text-main, #15171a);
    font-size: clamp(36px, 3.6vw, 48px);
    line-height: 1.2;
    letter-spacing: -0.035em;
    font-weight: 570;
  }

  .chrome-review-marquee__proof {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .chrome-review-marquee__header p {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--text-soft, #89919a);
    font-size: 14px;
    line-height: 1.4;
  }

  .chrome-review-marquee__stars {
    display: inline-flex;
    gap: 1px;
    color: #f3a928;
    font-size: 14px;
  }

  :global(.chrome-review-marquee__source) {
    min-height: 34px;
    padding: 6px 10px;
    color: var(--text-sub, #626870);
    font-size: 13px;
    font-weight: 500;
  }

  .chrome-review-marquee__rows {
    display: grid;
    gap: 12px;
  }

  .chrome-review-marquee__lane {
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .chrome-review-marquee__track {
    width: max-content;
    display: flex;
    gap: 12px;
    will-change: transform;
  }

  .chrome-review-marquee[data-marquee-ready="true"] .chrome-review-marquee__track {
    animation: chrome-review-scroll-left 38s linear infinite;
  }

  .chrome-review-marquee[data-marquee-ready="true"]
    [data-direction="right"]
    .chrome-review-marquee__track {
    animation-name: chrome-review-scroll-right;
    animation-duration: 44s;
  }

  .chrome-review-marquee[data-hover-paused="true"] .chrome-review-marquee__track,
  .chrome-review-marquee:focus-within .chrome-review-marquee__track {
    animation-play-state: paused;
  }

  .chrome-review-marquee__group {
    display: flex;
    flex: none;
    gap: 12px;
  }

  .chrome-review-card {
    width: clamp(310px, 29vw, 400px);
    min-height: 172px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid rgba(211, 217, 226, 0.78);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .chrome-review-card__quote {
    margin: 0;
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-main, #15171a);
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .chrome-review-card__meta {
    min-width: 0;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 11px;
  }

  .chrome-review-card__meta img {
    width: 40px;
    height: 40px;
    display: block;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-soft, #f4f6f8);
    box-shadow: inset 0 0 0 1px rgba(17, 24, 39, 0.08);
  }

  .chrome-review-card__identity {
    min-width: 0;
  }

  .chrome-review-card__identity strong,
  .chrome-review-card__identity time {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chrome-review-card__identity strong {
    color: var(--text-main, #15171a);
    font-size: 13px;
    line-height: 1.35;
    font-weight: 500;
  }

  .chrome-review-card__identity time {
    margin-top: 3px;
    color: var(--text-soft, #89919a);
    font-size: 12px;
    line-height: 1.35;
  }

  .chrome-review-card__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #bd7610;
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .chrome-review-card__rating i {
    color: #f3a928;
    font-size: 13px;
  }

  @keyframes chrome-review-scroll-left {
    to { transform: translateX(calc(-1 * var(--chrome-review-group-shift))); }
  }

  @keyframes chrome-review-scroll-right {
    from { transform: translateX(calc(-1 * var(--chrome-review-group-shift))); }
    to { transform: translateX(0); }
  }

  @media (max-width: 760px) {
    .chrome-review-marquee {
      padding: 72px 0 64px;
    }

    .chrome-review-marquee__frame {
      width: calc(100% - 32px);
      padding: 20px 0;
    }

    .chrome-review-marquee__header {
      width: calc(100% - 16px);
      min-height: 0;
      margin-bottom: 16px;
    }

    .chrome-review-marquee__header h2 {
      max-width: 320px;
      font-size: clamp(34px, 10vw, 44px);
    }

    .chrome-review-marquee__proof {
      margin-top: 8px;
      gap: 4px;
    }

    :global(.chrome-review-marquee__source) {
      padding-inline: 8px;
      font-size: 12.5px;
    }

    .chrome-review-marquee__lane {
      -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    }

    .chrome-review-card {
      width: min(86vw, 330px);
      min-height: 150px;
      padding: 18px;
      gap: 16px;
      border-radius: 14px;
    }

    .chrome-review-card__quote {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chrome-review-marquee__lane {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .chrome-review-marquee__lane::-webkit-scrollbar {
      display: none;
    }

    .chrome-review-marquee__track {
      animation: none;
      will-change: auto;
    }
  }
</style>
