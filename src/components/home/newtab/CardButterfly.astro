---
import { WING_OPEN, WING_REST } from "../../../lib/butterfly-wing";

/*
 * The Lumno butterfly (the logo's wing, as on the install buttons), for the
 * tool cards' hover: a quiet accent, not a show. It drifts down a short way
 * onto the top of the browser window, opens its wings once and rests; leaving
 * the card lifts it off and it fades. On phones it lands once the card has
 * been in view a moment, and stays. The flight is Web Animations so a
 * take-off mid-flight starts from wherever it is; wing beats are SMIL morphs
 * between the logo's two shapes.
 */
// One beat is closed, open, closed: quick in the air, a single slow one once landed.
const BEAT = `${WING_REST};${WING_OPEN};${WING_REST}`;
const SPLINES = "0.42 0 0.58 1;0.42 0 0.58 1";
---

<span class="ntf-fly" data-ntf-fly aria-hidden="true">
  {["back", "front"].map((wing) => (
    <span class={`ntf-fly__wing ntf-fly__wing--${wing}`}>
      <svg viewBox="0 0 23 25" fill="none" focusable="false">
        <path fill="currentColor" d={WING_REST}>
          <animate data-beat="fly" attributeName="d" begin="indefinite" dur="420ms" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.5;1" keySplines={SPLINES} values={BEAT} />
          <animate data-beat="rest" attributeName="d" begin="indefinite" dur="2400ms" calcMode="spline" keyTimes="0;0.5;1" keySplines={SPLINES} values={BEAT} />
        </path>
      </svg>
    </span>
  ))}
</span>

<style>
  /* Perched on the window's top edge, over the empty right end of the toolbar. */
  .ntf-fly {
    position: absolute;
    top: 6px;
    right: calc(var(--pad) + 28px);
    z-index: 2;
    width: 18px;
    height: 20px;
    /* The card's own ink, faint, so it reads like the hairlines around it. */
    color: rgb(var(--edge));
    opacity: 0;
    pointer-events: none;
  }

  .ntf-fly__wing {
    position: absolute;
    inset: 0;
    transform-origin: 24% 77%;
  }

  .ntf-fly__wing svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    shape-rendering: geometricPrecision;
  }

  /* The two wings of the logo: the far one fainter and turned out a little. */
  .ntf-fly__wing--back {
    opacity: 0.12;
    transform: rotate(12deg) scale(0.97);
  }

  .ntf-fly__wing--front {
    opacity: 0.3;
    transform: rotate(-8deg);
  }

  /* No flight with reduced motion: it simply appears on its perch. */
  @media (prefers-reduced-motion: reduce) {
    .ntf-fly {
      transition: opacity 200ms ease;
    }

    .ntf-fly[data-perched] {
      opacity: 1;
    }
  }
</style>

<script>
  import { isPhone, onPhoneChange } from "../../../scripts/home-phone";
  import { prefersReducedMotion } from "./scene-runtime";

  // Offsets from the perch, in px: a short glide down from above right, and a
  // short lift when it leaves. Kept small so the eye stays on the illustration.
  const FLY_IN: Keyframe[] = [
    { transform: "translate(28px, -26px) rotate(-10deg)", opacity: 0 },
    { transform: "translate(8px, -12px) rotate(4deg)", opacity: 1, offset: 0.6 },
    { transform: "translate(0, 0) rotate(0deg)", opacity: 1 },
  ];
  const FLY_OUT_TO: Keyframe[] = [{ transform: "translate(-8px, -24px) rotate(-6deg)", opacity: 0 }];

  // Phones (home-phone) have no hover: there it lands once, a little after the
  // card is mostly on screen, and stays perched. Resizing the window across
  // the phone width switches live: to desktop, it lifts off and waits for hover.
  const LAND_DELAY = 1200;
  const reduceMotion = prefersReducedMotion();

  document.querySelectorAll<HTMLElement>("[data-ntf-fly]").forEach((fly) => {
    const card = fly.closest("article");
    if (!card) return;
    const beats = (name: string) =>
      Array.from(fly.querySelectorAll<SVGAnimateElement>(`[data-beat="${name}"]`));
    const fast = beats("fly");
    const slow = beats("rest");
    // The far wing beats a hair behind the near one.
    const begin = (list: SVGAnimateElement[]) => list.forEach((beat, index) => beat.beginElementAt(index * 0.04));
    const end = (list: SVGAnimateElement[]) => list.forEach((beat) => beat.endElement());
    let flight: Animation | null = null;
    let perched = false;

    // No flight with reduced motion: it simply appears on its perch and goes.
    const land = () => {
      perched = true;
      if (reduceMotion) {
        fly.dataset.perched = "";
        return;
      }
      flight?.cancel();
      end(slow);
      begin(fast);
      flight = fly.animate(FLY_IN, { duration: 900, easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "forwards" });
      flight.onfinish = () => {
        end(fast);
        begin(slow);
      };
    };

    const takeOff = () => {
      if (!perched) return;
      perched = false;
      if (reduceMotion) {
        delete fly.dataset.perched;
        return;
      }
      if (!flight) return;
      // Take off from wherever it is, perched or still on its way in.
      const { transform } = getComputedStyle(fly);
      flight.cancel();
      end(slow);
      begin(fast);
      flight = fly.animate([{ transform, opacity: 1 }, ...FLY_OUT_TO], {
        duration: 520,
        easing: "cubic-bezier(0.4, 0, 0.7, 1)",
        fill: "forwards",
      });
      flight.onfinish = () => end(fast);
    };

    let inView = false;
    let timer: number | undefined;
    const landSoon = () => {
      window.clearTimeout(timer);
      if (!inView || perched || !isPhone()) return;
      timer = window.setTimeout(() => {
        if (inView && isPhone()) land();
      }, LAND_DELAY);
    };

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        landSoon();
      },
      { threshold: 0.6 },
    ).observe(card);
    onPhoneChange((phone) => (phone ? landSoon() : takeOff()));

    card.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse" && !isPhone()) land();
    });

    card.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse" && !isPhone()) takeOff();
    });
  });
</script>
