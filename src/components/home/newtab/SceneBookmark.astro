---
import SceneFolderIcon from "./SceneFolderIcon.astro";
import type { BookmarkLink } from "./scene-data";

/** One bookmark card, or one menu row when `row` is set. */
interface Props {
  name: string;
  link?: BookmarkLink;
  row?: boolean;
  [attribute: `data-${string}`]: string | undefined;
}

const { name, link, row = false, ...data } = Astro.props;
---

{row ? (
  <span class="nts-menu__item" {...data}>
    {link ? <span class="nts-fav" style={`--c: ${link.color}`}><i class={link.icon}></i></span> : <SceneFolderIcon />}
    {name}
    {!link && <i class="ri-arrow-right-s-line nts-menu__chevron"></i>}
  </span>
) : (
  <span class="nts-card" {...data}>
    {link ? <span class="nts-fav" style={`--c: ${link.color}`}><i class={link.icon}></i></span> : <SceneFolderIcon />}
    <span class="nts-card__title">{name}</span>
  </span>
)}
