---
import type { HomeNewTabScene } from "../../../lib/home-content";
import SceneBookmark from "./SceneBookmark.astro";
import SceneSearch from "./SceneSearch.astro";
import SceneShortcuts from "./SceneShortcuts.astro";
import { ROOT_LINKS } from "./scene-data";

interface Props {
  scene: HomeNewTabScene;
  alt: string;
}

const { scene, alt } = Astro.props;
---

<!--
  /zen typed into the search box: shortcuts, bookmarks and their buttons tuck
  away until it is typed again. The resting frame is the Zen state the copy describes.
-->
<div class="nts-scene zen" data-zen-scene data-zen="on" role="img" aria-label={alt}>
  <div class="zen-page" aria-hidden="true">
    <div class="zen-search" data-badge-on={scene.zenOn} data-badge-off={scene.zenOff}>
      <SceneSearch placeholder={scene.searchPlaceholder} />
    </div>
    <div class="zen-tuck zen-tiles" style="--order: 0"><SceneShortcuts /></div>
    <div class="zen-tuck zen-bookmarks" style="--order: 1">
      <div class="zen-head">
        <span>{scene.bookmarksHeading}</span>
        <span class="zen-pager"><i class="ri-arrow-left-s-line"></i><i class="ri-arrow-right-s-line"></i></span>
      </div>
      <div class="zen-cards">
        <SceneBookmark name={scene.folders[0]} />
        <SceneBookmark name={ROOT_LINKS[0].name} link={ROOT_LINKS[0]} />
      </div>
    </div>
  </div>
</div>

<style>
  .zen-page {
    position: absolute;
    inset: 0;
  }

  /* Same order as the new tab: search, then shortcuts under it, then bookmarks. */
  .zen-tiles {
    position: absolute;
    top: 102px;
    right: 0;
    left: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  /* The search box drifts to the middle once everything else has gone. */
  .zen-search {
    position: absolute;
    top: 34px;
    left: 50%;
    width: min(324px, calc(100% - 40px));
    translate: -50% 0;
    transition: top 700ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .zen[data-zen="on"] .zen-search {
    top: calc(50% - 28px);
  }

  .zen-bookmarks {
    position: absolute;
    top: 184px;
    right: 22px;
    left: 22px;
  }

  /* newtab.css bookmarks header: 14px heading, 24px pager buttons. */
  .zen-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 24px;
    margin-bottom: 10px;
    padding-left: 2px;
    font-size: 14px;
    font-weight: 500;
  }

  .zen-pager {
    display: flex;
    gap: 4px;
  }

  .zen-pager i {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    color: #000;
    font-size: 16px;
  }

  .zen-pager i:first-child {
    opacity: 0.34;
  }

  .zen-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  /* Tuck away: each group fades and drifts toward its nearest edge, a beat apart. */
  .zen-tuck {
    transition:
      opacity 420ms ease calc(var(--order) * 70ms),
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--order) * 70ms),
      filter 420ms ease calc(var(--order) * 70ms);
  }

  .zen[data-zen="on"] .zen-tuck {
    opacity: 0;
    filter: blur(4px);
  }

  .zen[data-zen="on"] .zen-tiles {
    transform: translateY(12px);
  }

  .zen[data-zen="on"] .zen-bookmarks {
    transform: translateY(18px);
  }

  @media (prefers-reduced-motion: reduce) {
    .zen-tuck,
    .zen-search {
      transition: none;
    }
  }
</style>

<script>
  import { Timeline, playOnView, typeText } from "./scene-runtime";

  document.querySelectorAll<HTMLElement>("[data-zen-scene]").forEach((root) => {
    const holder = root.querySelector<HTMLElement>(".zen-search")!;
    const search = holder.querySelector<HTMLElement>("[data-search]")!;
    const text = holder.querySelector<HTMLElement>("[data-search-text]")!;
    const badge = holder.querySelector<HTMLElement>("[data-search-badge]")!;

    /** Types /zen, shows the extension's mode badge, then presses Enter. */
    const toggle = (timeline: Timeline, start: number, turnOn: boolean) => {
      timeline.at(start, () => (search.dataset.focus = "true"));
      const typed = typeText(timeline, text, "/zen", start + 300, 150);
      timeline.at(typed + 160, () => {
        // The badge names the current state, so it reads "off" right before turning on.
        badge.textContent = (turnOn ? holder.dataset.badgeOff : holder.dataset.badgeOn) || "";
        badge.hidden = false;
      });
      timeline.at(typed + 900, () => (badge.dataset.pressed = "true"));
      timeline.at(typed + 1040, () => {
        badge.dataset.pressed = "false";
        badge.hidden = true;
        text.textContent = "";
        search.dataset.focus = "false";
        root.dataset.zen = turnOn ? "on" : "off";
      });
      return typed + 1040;
    };

    playOnView(root, {
      reset() {
        root.dataset.zen = "off";
        text.textContent = "";
        badge.hidden = true;
        search.dataset.focus = "false";
      },
      play(timeline) {
        return toggle(timeline, 700, true) + 800;
      },
    });
  });
</script>
