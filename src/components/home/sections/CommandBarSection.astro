---
import { LUMNO_SITE_SEARCH_ICON_ROOT } from "../../../lib/lumno-search-providers";
import type { HOME_CONTENT } from "../../../lib/home-content";

type Content = (typeof HOME_CONTENT)["en"]["commandBar"];

interface Props {
  content: Content;
  locale: string;
}

const { content, locale } = Astro.props;
const isChinese = locale.startsWith("zh");
const tile = (key: string) => `${LUMNO_SITE_SEARCH_ICON_ROOT}/tile-${key}.png`;

// Every stage sits on one of the wallpapers the extension ships for its new tab.
const STAGE = {
  search: "/assets/bento/monet-field-white.webp",
  site: "/assets/bento/seurat-park-white.webp",
  ai: "/assets/bento/impressionist-orchard-white.webp",
  aggregate: "/assets/bento/pointillist-lakeside-white.webp",
  commands: "/assets/bento/monet-lily-pond-white.webp",
};

const RESULT_ICONS = [
  { icon: "ri-figma-fill", color: "#f24e1e" },
  { icon: "ri-notion-fill", color: "#111827" },
  { icon: "ri-google-fill", color: "#4285f4" },
];

// Keys and aliases come from lumno-extension/assets/data/site-search.json.
const SCOPE_MENU = isChinese
  ? [
      { key: "yt", name: "YouTube" },
      { key: "bb", name: "Bilibili" },
      { key: "zh", name: "知乎" },
      { key: "xhs", name: "小红书" },
    ]
  : [
      { key: "yt", name: "YouTube" },
      { key: "rd", name: "Reddit" },
      { key: "wk", name: "Wikipedia" },
      { key: "sf", name: "Stack Overflow" },
    ];

const AI_PROVIDERS = isChinese
  ? [
      { key: "gpt", name: "ChatGPT" },
      { key: "ds", name: "DeepSeek" },
      { key: "kimi", name: "Kimi" },
      { key: "dbai", name: "豆包" },
    ]
  : [
      { key: "gpt", name: "ChatGPT" },
      { key: "gm", name: "Gemini" },
      { key: "pplx", name: "Perplexity" },
      { key: "ds", name: "DeepSeek" },
    ];

const AGGREGATE_TILE_BY_SOURCE: Record<string, string> = {
  淘宝: "tb",
  京东: "jd",
  小红书: "xhs",
  Google: "gg",
  YouTube: "yt",
  Reddit: "rd",
  "Google Scholar": "gs",
  GitHub: "gh",
};
---

<section id="features" class="home-section command-bar" aria-labelledby="command-bar-title">
  <header class="home-section__head">
    <p class="home-eyebrow">{content.eyebrow}</p>
    <h2 id="command-bar-title" class="home-h2"><span>{content.title}</span></h2>
    <p class="home-lead">{content.description}</p>
  </header>

  <div class="home-sheet bento">
    <article class="bento-cell bento-cell--search">
      <p class="bento-label"><i class="ri-search-line" aria-hidden="true"></i>{content.search.label}</p>
      <h3>{content.search.title}</h3>
      <p class="bento-text">{content.search.description}</p>
      <div class="stage" aria-hidden="true">
        <img class="stage__art" src={STAGE.search} alt="" width="1200" height="675" loading="lazy" decoding="async" />
        <span class="lx-note stage__note">{content.search.hint}</span>
        <div class="lx-panel stage__panel stage__panel--float">
          <div class="lx-input">
            <i class="ri-search-line"></i>
            <span>{content.search.query}</span>
            <span class="lx-caret"></span>
          </div>
          <ul class="lx-rows">
            {content.search.results.map((result, index) => (
              <li class:list={["lx-row", { "is-active": index === 0 }]}>
                <span class="lx-favicon" style={`color:${RESULT_ICONS[index].color}`}>
                  <i class={RESULT_ICONS[index].icon}></i>
                </span>
                <span class="lx-row__text">
                  <strong>{result.title}</strong>
                  <small>{result.url}</small>
                </span>
                {index === 0 ? (
                  <span class="lx-tag lx-tag--action">
                    {content.search.switchLabel}
                    <span class="lx-tag__key">↵</span>
                  </span>
                ) : (
                  <span class="lx-tag">{result.source}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>

    <article class="bento-cell bento-cell--site">
      <p class="bento-label"><i class="ri-global-line" aria-hidden="true"></i>{content.siteSearch.label}</p>
      <h3>{content.siteSearch.title}</h3>
      <p class="bento-text">{content.siteSearch.description}</p>
      <div class="stage" aria-hidden="true">
        <img class="stage__art" src={STAGE.site} alt="" width="1200" height="675" loading="lazy" decoding="async" />
        <div class="stage__column">
          <div class="lx-panel lx-panel--pill">
            <div class="lx-input lx-input--pill">
              <span class="lx-scope">
                <img src={tile("gh")} width="18" height="18" alt="" loading="lazy" decoding="async" />
                {content.siteSearch.target}
              </span>
              <span class="lx-caret"></span>
              <span class="lx-tag lx-tag--key">Tab</span>
            </div>
          </div>
          <ul class="lx-menu">
            {SCOPE_MENU.map((provider, index) => (
              <li class:list={{ "is-active": index === 0 }}>
                <img src={tile(provider.key)} width="20" height="20" alt="" loading="lazy" decoding="async" />
                <span>{provider.name}</span>
                <kbd>{provider.key}</kbd>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>

    <article class="bento-cell bento-cell--ai">
      <p class="bento-label"><i class="ri-sparkling-2-line" aria-hidden="true"></i>{content.ai.label}</p>
      <h3>{content.ai.title}</h3>
      <p class="bento-text">{content.ai.description}</p>
      <div class="stage" aria-hidden="true">
        <img class="stage__art" src={STAGE.ai} alt="" width="1200" height="675" loading="lazy" decoding="async" />
        <div class="stage__column">
          <div class="lx-panel lx-panel--pill">
            <div class="lx-input lx-input--pill">
              <span class="lx-scope">
                <img src={tile(AI_PROVIDERS[1].key)} width="18" height="18" alt="" loading="lazy" decoding="async" />
                {AI_PROVIDERS[1].name}
              </span>
              <span class="lx-input__query">{content.ai.prompt}</span>
            </div>
          </div>
          <ul class="lx-menu">
            {AI_PROVIDERS.map((provider, index) => (
              <li class:list={{ "is-active": index === 1 }}>
                <img src={tile(provider.key)} width="20" height="20" alt="" loading="lazy" decoding="async" />
                <span>{provider.name}</span>
                {index === 1 && <kbd>↵</kbd>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>

    <article class="bento-cell bento-cell--aggregate">
      <p class="bento-label"><i class="ri-stack-line" aria-hidden="true"></i>{content.aggregate.label}</p>
      <h3>{content.aggregate.title}</h3>
      <p class="bento-text">{content.aggregate.description}</p>
      <div class="stage" aria-hidden="true">
        <img class="stage__art" src={STAGE.aggregate} alt="" width="1200" height="675" loading="lazy" decoding="async" />
        <div class="lx-browser">
          <div class="lx-browser__strip">
            <span class="lx-browser__lights"><i></i><i></i><i></i></span>
            <span class="lx-browser__group">{content.aggregate.groupLabel}</span>
            {content.aggregate.sources.map((source, index) => (
              <span class:list={["lx-browser__tab", { "is-active": index === 0 }]}>
                <img
                  src={tile(AGGREGATE_TILE_BY_SOURCE[source] || "gg")}
                  width="16"
                  height="16"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span>{source}</span>
              </span>
            ))}
          </div>
          <div class="lx-browser__toolbar">
            <i class="ri-arrow-left-s-line"></i>
            <i class="ri-arrow-right-s-line"></i>
            <i class="ri-refresh-line"></i>
            <span class="lx-browser__omnibox">{content.aggregate.query}</span>
          </div>
          <div class="lx-browser__page">
            {[0, 1, 2].map((index) => (
              <div class="lx-result">
                <span class:list={["lx-result__thumb", `lx-result__thumb--${index}`]}></span>
                <span class="lx-result__lines">
                  <span class="lx-skeleton lx-skeleton--title"></span>
                  <span class="lx-skeleton"></span>
                  <span class="lx-skeleton lx-skeleton--short"></span>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </article>

    <article class="bento-cell bento-cell--commands">
      <div class="bento-cell__copy">
        <p class="bento-label"><i class="ri-slash-commands-2" aria-hidden="true"></i>{content.commands.label}</p>
        <h3>{content.commands.title}</h3>
        <p class="bento-text">{content.commands.description}</p>
      </div>
      <div class="stage" aria-hidden="true">
        <img class="stage__art" src={STAGE.commands} alt="" width="1200" height="675" loading="lazy" decoding="async" />
        <div class="lx-panel stage__panel stage__panel--bleed">
          <div class="lx-input">
            <i class="ri-search-line"></i>
            <span>/</span>
            <span class="lx-caret"></span>
          </div>
          <ul class="lx-rows">
            {content.commands.items.map((item, index) => (
              <li class:list={["lx-row lx-row--command", { "is-active": index === 0 }]}>
                <code>{item.command}</code>
                <span class="lx-row__text"><strong>{item.label}</strong></span>
                {index === 0 && <span class="lx-tag lx-tag--action"><span class="lx-tag__key">↵</span></span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  /*
   * One framed sheet split by hairlines (cells share borders), in the restrained
   * spirit of the rest of the page. Each stage is a crop of a Lumno wallpaper with
   * the extension's real overlay UI on top, using the extension's own tokens.
   */
  .bento {
    --lx-text: #111827;
    --lx-muted: #6b7280;
    --lx-icon: #9ca3af;
    --lx-divider: #e5e7eb;
    --lx-active: #e4edfa;
    --lx-action: #d2e0f6;
    --lx-action-key: #eef3fc;
    --lx-tag: #f3f4f6;
    --lx-panel-bg: linear-gradient(135deg, rgba(255, 255, 255, 0.97) 0%, rgba(255, 255, 255, 0.95) 100%);
    --lx-panel-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 2px 6px -1px rgba(15, 23, 42, 0.11),
      0 20px 48px -8px rgba(15, 23, 42, 0.15);
    --lx-menu-shadow: 0 0 0 1px rgba(15, 23, 42, 0.06), 0 10px 24px rgba(15, 23, 42, 0.12);

    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .bento-cell {
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3vw, 40px);
  }

  .bento-cell--search,
  .bento-cell--aggregate {
    grid-column: span 7;
  }

  .bento-cell--site,
  .bento-cell--ai {
    grid-column: span 5;
  }

  .bento-cell--commands {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
  }

  .bento-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    color: var(--text-soft, #89919a);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .bento-label i {
    font-size: 15px;
  }

  h3 {
    margin: 0;
    color: var(--home-ink);
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .bento-text {
    max-width: 460px;
    margin: 10px 0 0;
    color: var(--text-sub, #626870);
    font-size: 15px;
    line-height: 1.68;
    text-wrap: pretty;
  }

  /* ---------- Stage: a wallpaper crop that frames one piece of real UI ---------- */

  .stage {
    position: relative;
    isolation: isolate;
    height: 320px;
    margin-top: auto;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px rgba(32, 38, 46, 0.06);
  }

  .bento-cell:not(.bento-cell--commands) .stage {
    margin-top: 28px;
  }

  .stage__art {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage__panel {
    position: absolute;
    left: 50%;
    width: min(88%, 520px);
    transform: translateX(-50%);
  }

  /* The panel runs past the bottom edge, so the UI reads as live rather than boxed. */
  .stage__panel--bleed {
    top: 44px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .stage__panel--float {
    top: 50%;
    transform: translate(-50%, -46%);
  }

  .stage__note {
    position: absolute;
    top: 14px;
    right: 16px;
    z-index: 2;
  }

  .stage__column {
    position: absolute;
    inset: 32px 0 auto;
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 0 20px;
  }

  /* ---------- Extension surfaces (values taken from the overlay stylesheet) ---------- */

  .lx-panel {
    overflow: hidden;
    border-radius: 28px;
    background: var(--lx-panel-bg);
    box-shadow: var(--lx-panel-shadow);
    color: var(--lx-text);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .lx-panel--pill {
    width: min(100%, 380px);
    border-radius: 999px;
  }

  .lx-input {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 22px;
    border-bottom: 1px solid var(--lx-divider);
    font-size: 16px;
  }

  .lx-input--pill {
    height: 52px;
    padding: 0 10px 0 8px;
    border-bottom: 0;
  }

  .lx-input i {
    color: var(--lx-icon);
    font-size: 19px;
  }

  .lx-input__query {
    min-width: 0;
    overflow: hidden;
    color: var(--lx-text);
    font-size: 14px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lx-caret {
    width: 1.5px;
    height: 19px;
    margin-left: -7px;
    border-radius: 1px;
    background: #7db7ff;
    animation: lx-caret 1.1s steps(1) infinite;
  }

  .lx-scope {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px 0 8px;
    border-radius: 999px;
    background: var(--lx-active);
    font-size: 14px;
    font-weight: 600;
  }

  .lx-scope img,
  .lx-menu img,
  .lx-browser__tab img {
    display: block;
    border-radius: 5px;
  }

  .lx-rows {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 10px;
    list-style: none;
  }

  .lx-row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    height: 50px;
    padding: 0 12px;
    border-radius: 16px;
  }

  .lx-row.is-active {
    background: var(--lx-active);
  }

  .lx-favicon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.08);
    font-size: 16px;
  }

  .lx-row__text {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .lx-row__text strong,
  .lx-row__text small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lx-row__text strong {
    flex: none;
    max-width: 70%;
    font-size: 15px;
    font-weight: 500;
  }

  .lx-row__text small {
    color: var(--lx-muted);
    font-size: 13px;
  }

  .lx-row--command {
    grid-template-columns: 64px minmax(0, 1fr) auto;
  }

  .lx-row--command code {
    color: var(--lx-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 14px;
    font-weight: 600;
  }

  .lx-row--command .lx-row__text strong {
    max-width: 100%;
    color: var(--lx-muted);
    font-weight: 400;
  }

  .lx-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 25px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--lx-tag);
    color: var(--lx-muted);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }

  .lx-tag--action {
    padding-right: 4px;
    background: var(--lx-action);
    color: var(--lx-text);
  }

  .lx-tag__key {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 17px;
    padding: 0 4px;
    border-radius: 6px;
    background: var(--lx-action-key);
  }

  .lx-tag--key {
    margin-left: auto;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: #fff;
    color: var(--lx-text);
  }

  .lx-note {
    padding: 8px 12px;
    border: 1px solid rgba(214, 219, 227, 0.95);
    border-radius: 12px;
    background: linear-gradient(180deg, #ffffff, #f7f9fc);
    box-shadow: 0 16px 36px rgba(17, 24, 39, 0.08), 0 3px 10px rgba(17, 24, 39, 0.05);
    color: #1f2937;
    font-size: 13px;
    white-space: nowrap;
  }

  .lx-menu {
    width: min(100%, 300px);
    margin: 0;
    padding: 6px;
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--lx-menu-shadow);
    list-style: none;
  }

  .lx-menu li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 10px;
    border-radius: 10px;
    color: var(--lx-text);
    font-size: 14px;
  }

  .lx-menu li.is-active {
    background: var(--lx-active);
  }

  .lx-menu kbd {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    height: 20px;
    padding: 0 6px;
    border-radius: 6px;
    background: var(--lx-tag);
    color: var(--lx-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
  }

  .lx-menu li.is-active kbd {
    background: var(--lx-action);
    color: var(--lx-text);
  }

  /* Browser chrome for aggregate search: cropped at the right and bottom edges. */
  .lx-browser {
    position: absolute;
    top: 36px;
    left: 36px;
    right: -24px;
    bottom: -24px;
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
    box-shadow: var(--lx-panel-shadow);
  }

  .lx-browser__strip {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 44px;
    padding: 0 12px;
    background: #e8eaed;
  }

  .lx-browser__lights {
    display: inline-flex;
    align-self: center;
    gap: 7px;
    margin-right: 10px;
  }

  .lx-browser__lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lx-browser__lights i:nth-child(2) {
    background: #febc2e;
  }

  .lx-browser__lights i:nth-child(3) {
    background: #28c840;
  }

  .lx-browser__group {
    flex: none;
    align-self: center;
    padding: 3px 9px;
    border-radius: 6px;
    background: #8ab4f8;
    color: #0b2a5b;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .lx-browser__tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 150px;
    height: 34px;
    padding: 0 12px;
    border-radius: 10px 10px 0 0;
    box-shadow: inset 0 -2px 0 #8ab4f8;
    color: #3c4043;
    font-size: 12px;
  }

  .lx-browser__tab.is-active {
    background: #fff;
    box-shadow: none;
  }

  .lx-browser__tab span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lx-browser__toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 42px;
    padding: 0 14px;
    border-bottom: 1px solid #eceef1;
    color: #5f6368;
    font-size: 16px;
  }

  .lx-browser__omnibox {
    flex: 1;
    height: 28px;
    padding: 0 14px;
    border-radius: 999px;
    background: #f1f3f4;
    color: #3c4043;
    font-size: 13px;
    line-height: 28px;
  }

  .lx-browser__page {
    display: grid;
    gap: 14px;
    padding: 20px 28px;
  }

  .lx-result {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }

  .lx-result__thumb {
    width: 64px;
    height: 48px;
    border-radius: 10px;
    background: linear-gradient(135deg, #f3e7dc, #e9edf2);
  }

  .lx-result__thumb--1 {
    background: linear-gradient(135deg, #e6eef8, #f1ece6);
  }

  .lx-result__thumb--2 {
    background: linear-gradient(135deg, #ecefe6, #f4ece8);
  }

  .lx-result__lines {
    display: grid;
    gap: 8px;
  }

  .lx-skeleton {
    display: block;
    height: 9px;
    border-radius: 999px;
    background: #eef0f3;
  }

  .lx-skeleton--title {
    width: 38%;
    height: 13px;
    background: #dbe5f6;
  }

  .lx-skeleton--short {
    width: 62%;
  }

  @keyframes lx-caret {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 980px) {
