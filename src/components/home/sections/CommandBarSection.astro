---
import { LUMNO_SITE_SEARCH_ICON_ROOT } from "../../../lib/lumno-search-providers";
import type { HOME_CONTENT } from "../../../lib/home-content";

type Content = (typeof HOME_CONTENT)["en"]["commandBar"];

interface Props {
  content: Content;
  locale: string;
}

const { content, locale } = Astro.props;
const isChinese = locale.startsWith("zh");
const tile = (key: string) => `${LUMNO_SITE_SEARCH_ICON_ROOT}/tile-${key}.png`;

// Keys come from lumno-extension/assets/data/site-search.json.
const SITE_TILES = isChinese
  ? ["yt", "bb", "zh", "xhs", "gs", "sf", "wk", "rd", "npm", "mdn", "db", "tw"]
  : ["yt", "rd", "wk", "sf", "gs", "hf", "npm", "mdn", "maps", "tw", "ddg", "kg"];
const AI_TILES = [
  { key: "gpt", name: "ChatGPT" },
  { key: "gm", name: "Gemini" },
  { key: "ds", name: "DeepSeek" },
  { key: "kimi", name: "Kimi" },
  { key: "pplx", name: "Perplexity" },
  { key: "dbai", name: "豆包", latinName: "Doubao" },
  { key: "qw", name: "千问", latinName: "Qwen" },
  { key: "yb", name: "元宝", latinName: "Yuanbao" },
] as Array<{ key: string; name: string; latinName?: string }>;
const AGGREGATE_TILE_BY_SOURCE: Record<string, string> = {
  淘宝: "tb",
  京东: "jd",
  小红书: "xhs",
  Google: "gg",
  YouTube: "yt",
  Reddit: "rd",
  "Google Scholar": "gs",
  GitHub: "gh",
};
const RESULT_ICONS = ["ri-window-2-line", "ri-bookmark-line", "ri-history-line"];
---

<section id="features" class="home-section command-bar" aria-labelledby="command-bar-title">
  <header class="home-section__head">
    <p class="home-eyebrow">{content.eyebrow}</p>
    <h2 id="command-bar-title" class="home-h2"><span>{content.title}</span></h2>
    <p class="home-lead">{content.description}</p>
  </header>

  <div class="command-bar__grid">
    <article class="home-card command-bar__card command-bar__card--search">
      <div class="command-bar__copy">
        <h3>{content.search.title}</h3>
        <p>{content.search.description}</p>
      </div>
      <div class="command-bar__visual" aria-hidden="true">
        <div class="mock-panel">
          <div class="mock-input">
            <i class="ri-search-line"></i>
            <span class="mock-input__text">{content.search.query}</span>
            <span class="mock-caret"></span>
          </div>
          <ul class="mock-results">
            {content.search.results.map((result, index) => (
              <li class:list={["mock-result", { "is-selected": index === 0 }]}>
                <span class="mock-result__icon"><i class={RESULT_ICONS[index]}></i></span>
                <span class="mock-result__text">
                  <strong>{result.title}</strong>
                  <small>{result.url}</small>
                </span>
                <span class="mock-result__source">{result.source}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>

    <article class="home-card command-bar__card command-bar__card--site">
      <div class="command-bar__copy">
        <h3>{content.siteSearch.title}</h3>
        <p>{content.siteSearch.description}</p>
      </div>
      <div class="command-bar__visual" aria-hidden="true">
        <div class="mock-input mock-input--floating">
          <span class="mock-scope">
            <img src={tile("gh")} width="18" height="18" alt="" loading="lazy" decoding="async" />
            {content.siteSearch.target}
          </span>
          <span class="mock-caret"></span>
          <span class="mock-input__hint">
            <span class="home-kbd">Tab</span>
            {content.siteSearch.hint}
          </span>
        </div>
        <ul class="tile-cloud">
          {SITE_TILES.map((key) => (
            <li><img src={tile(key)} width="40" height="40" alt="" loading="lazy" decoding="async" /></li>
          ))}
        </ul>
      </div>
    </article>

    <article class="home-card command-bar__card command-bar__card--ai">
      <div class="command-bar__copy">
        <h3>{content.ai.title}</h3>
        <p>{content.ai.description}</p>
      </div>
      <ul class="ai-tiles">
        {AI_TILES.map((provider) => (
          <li>
            <img src={tile(provider.key)} width="44" height="44" alt="" loading="lazy" decoding="async" />
            <span>{isChinese ? provider.name : provider.latinName || provider.name}</span>
          </li>
        ))}
      </ul>
    </article>

    <article class="home-card command-bar__card command-bar__card--aggregate">
      <div class="command-bar__copy">
        <h3>{content.aggregate.title}</h3>
        <p>{content.aggregate.description}</p>
      </div>
      <div class="command-bar__visual mock-window" aria-hidden="true">
        <div class="mock-window__chrome">
          <span class="mock-window__dots"><i></i><i></i><i></i></span>
        </div>
        <div class="mock-tabstrip">
          <span class="mock-tabgroup">{content.aggregate.groupLabel}</span>
          {content.aggregate.sources.map((source, index) => (
            <span class:list={["mock-tab", { "is-active": index === 0 }]}>
              <img
                src={tile(AGGREGATE_TILE_BY_SOURCE[source] || "gg")}
                width="16"
                height="16"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span>{content.aggregate.query} - {source}</span>
            </span>
          ))}
        </div>
        <div class="mock-window__body">
          <span class="mock-window__url"></span>
          <span class="mock-window__line mock-window__line--title"></span>
          <span class="mock-window__line"></span>
          <span class="mock-window__line mock-window__line--short"></span>
        </div>
      </div>
    </article>

    <article class="home-card command-bar__card command-bar__card--commands">
      <div class="command-bar__copy">
        <h3>{content.commands.title}</h3>
        <p>{content.commands.description}</p>
      </div>
      <ul class="mock-commands">
        {content.commands.items.map((item) => (
          <li>
            <code>{item.command}</code>
            <span>{item.label}</span>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>

<style>
  .command-bar__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
  }

  .command-bar__card {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(24px, 2.6vw, 36px);
  }

  .command-bar__card--search {
    grid-column: span 7;
  }

  .command-bar__card--site {
    grid-column: span 5;
  }

  .command-bar__card--ai {
    grid-column: span 5;
  }

  .command-bar__card--aggregate {
    grid-column: span 7;
  }

  .command-bar__card--commands {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .command-bar__copy {
    max-width: 460px;
  }

  .command-bar__visual {
    margin-top: auto;
  }

  /* Mock command bar, modeled on the extension overlay. */
  .mock-panel {
    overflow: hidden;
    border: 1px solid var(--home-card-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 18px 40px -24px rgba(32, 38, 46, 0.35);
  }

  .mock-input {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 16px;
    color: var(--home-ink);
    font-size: 15px;
  }

  .mock-panel .mock-input {
    border-bottom: 1px solid var(--home-card-border);
  }

  .mock-input i {
    color: var(--text-soft, #89919a);
    font-size: 18px;
  }

  .mock-input--floating {
    border: 1px solid var(--home-card-border);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 14px 32px -22px rgba(32, 38, 46, 0.4);
  }

  .mock-caret {
    width: 1.5px;
    height: 18px;
    margin-left: -6px;
    background: var(--home-select-ink);
    animation: mock-caret-blink 1.1s steps(1) infinite;
  }

  .mock-input__hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    color: var(--text-soft, #89919a);
    font-size: 13px;
    white-space: nowrap;
  }

  .mock-scope {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 5px;
    border-radius: 999px;
    background: var(--home-select);
    color: var(--home-select-ink);
    font-size: 14px;
    font-weight: 650;
  }

  .mock-scope img {
    border-radius: 5px;
  }

  .mock-results {
    margin: 0;
    padding: 6px;
    list-style: none;
  }

  .mock-result {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 10px;
  }

  .mock-result.is-selected {
    background: var(--home-select);
  }

  .mock-result__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--surface-soft, #f4f6f8);
    color: var(--home-ink-soft);
    font-size: 16px;
  }

  .mock-result__text {
    min-width: 0;
    display: grid;
  }

  .mock-result__text strong,
  .mock-result__text small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mock-result__text strong {
    color: var(--home-ink);
    font-size: 14px;
    font-weight: 600;
  }

  .mock-result__text small {
    color: var(--text-soft, #89919a);
    font-size: 12px;
  }

  .mock-result__source {
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(32, 38, 46, 0.05);
    color: var(--home-ink-soft);
    font-size: 12px;
    font-weight: 600;
  }

  .mock-result.is-selected .mock-result__source {
    background: rgba(31, 95, 191, 0.1);
    color: var(--home-select-ink);
  }

  .tile-cloud {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent);
    mask-image: linear-gradient(to bottom, #000 45%, transparent);
  }

  .tile-cloud li {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 14px;
    background: var(--surface-soft, #f4f6f8);
  }

  .tile-cloud img,
  .ai-tiles img {
    display: block;
    border-radius: 10px;
  }

  .ai-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px 12px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .ai-tiles li {
    display: grid;
    justify-items: center;
    gap: 8px;
    color: var(--home-ink-soft);
    font-size: 12px;
    font-weight: 600;
    text-align: center;
  }

  .mock-window {
    overflow: hidden;
    border: 1px solid var(--home-card-border);
    border-radius: 16px;
    background: #e9ecef;
    box-shadow: 0 18px 40px -26px rgba(32, 38, 46, 0.4);
  }

  .mock-window__chrome {
    padding: 10px 12px 0;
  }

  .mock-window__dots {
    display: inline-flex;
    gap: 6px;
  }

  .mock-window__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(32, 38, 46, 0.16);
  }

  .mock-tabstrip {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    padding: 8px 8px 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
    mask-image: linear-gradient(to right, #000 85%, transparent);
  }

  .mock-window__body {
    display: grid;
    gap: 10px;
    padding: 16px 18px 22px;
    background: #fff;
  }

  .mock-window__url {
    height: 26px;
    margin-bottom: 6px;
    border-radius: 999px;
    background: var(--surface-soft, #f4f6f8);
  }

  .mock-window__line {
    height: 9px;
    border-radius: 999px;
    background: rgba(32, 38, 46, 0.08);
  }

  .mock-window__line--title {
    width: 46%;
    height: 12px;
    background: rgba(31, 95, 191, 0.18);
  }

  .mock-window__line--short {
    width: 64%;
  }

  .mock-tabgroup {
    flex: none;
    align-self: center;
    margin-bottom: 4px;
    padding: 5px 10px;
    border-radius: 8px;
    background: #8ab4f8;
    color: #0b2a5b;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .mock-tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 210px;
    padding: 8px 12px;
    border-bottom: 2px solid #8ab4f8;
    border-radius: 9px 9px 0 0;
    color: var(--home-ink-soft);
    font-size: 13px;
  }

  .mock-tab.is-active {
    border-bottom-color: #fff;
    background: #fff;
    color: var(--home-ink);
  }

  .mock-tab img {
    flex: none;
    border-radius: 4px;
  }

  .mock-tab span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mock-commands {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mock-commands li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid var(--home-card-border);
    border-radius: 14px;
    background: var(--surface-soft, #f4f6f8);
  }

  .mock-commands code {
    flex: none;
    min-width: 62px;
    color: var(--home-select-ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 14px;
    font-weight: 600;
  }

  .mock-commands span {
    min-width: 0;
    color: var(--home-ink-soft);
    font-size: 14px;
  }

  @keyframes mock-caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 980px) {
    .command-bar__card--search,
    .command-bar__card--site,
    .command-bar__card--ai,
    .command-bar__card--aggregate {
      grid-column: 1 / -1;
    }

    .command-bar__card--commands {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .mock-input__hint {
      display: none;
    }

    .tile-cloud {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mock-commands {
      grid-template-columns: minmax(0, 1fr);
    }

    .mock-result__source {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mock-caret {
      animation: none;
    }
  }
</style>
