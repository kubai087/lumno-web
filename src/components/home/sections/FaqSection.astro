---
import type { HomeFaqItem } from "../../../lib/home-content";
import TitlePair from "../TitlePair.astro";
import { CommunityQrDialog } from "../CommunityQrDialog";
import { SettingsButton } from "../../extension-settings/SettingsKit";
import githubIcon from "../../../assets/home-icons/github-line.svg?raw";
import wechatIcon from "../../../assets/home-icons/wechat-line.svg?raw";

interface Props {
  title: string;
  askLabel: string;
  askHref: string;
  /** With `qr` the button opens the WeChat QR dialog; otherwise it links to `href` (Discord). */
  author: {
    label: string;
    ariaLabel: string;
    href: string;
    iconSvg: string;
    qr?: { title: string; imageSrc: string; imageAlt: string; closeLabel: string };
  };
  items: HomeFaqItem[];
}

const { title, askLabel, askHref, author, items } = Astro.props;

/*
 * Answers are plain strings with two bits of inline markup: `code` for URLs and
 * setting paths, and Mac shortcut runs like "⌘ ⇧ K", which render as keycaps.
 */
type AnswerPart = { kind: "text" | "code"; value: string } | { kind: "keys"; value: string[] };

const SHORTCUT = /((?:[⌘⇧⌥⌃] )+[A-Z])/;

function parseAnswer(answer: string): AnswerPart[] {
  return answer.split(/`([^`]+)`/).flatMap((chunk, index): AnswerPart[] => {
    if (index % 2 === 1) return [{ kind: "code", value: chunk }];
    return chunk
      .split(SHORTCUT)
      .map((part, partIndex): AnswerPart =>
        partIndex % 2 === 1 ? { kind: "keys", value: part.split(" ") } : { kind: "text", value: part },
      )
      .filter((part) => part.value.length > 0);
  });
}
---

<section id="faq" class="home-section faq" aria-labelledby="faq-title">
  <div class="faq__layout">
    <header class="faq__head">
      <h2 id="faq-title" class="home-h2" data-reveal="text"><TitlePair title={title} /></h2>
      <div class="faq__actions" data-reveal>
        <SettingsButton
          as="a"
          variant="secondary"
          className="hero-actions-button"
          iconSvg={githubIcon}
          href={askHref}
          target="_blank"
          rel="noreferrer noopener"
          data-analytics-event="open_github_repo"
          data-analytics-category="cta"
          data-analytics-label="home_faq_ask"
        >
          {askLabel}
        </SettingsButton>
        {author.qr ? (
          <CommunityQrDialog
            analyticsLabel="home_faq_author"
            triggerLabel={author.label}
            triggerAriaLabel={author.ariaLabel}
            triggerIconSvg={wechatIcon}
            title={author.qr.title}
            qrImageSrc={author.qr.imageSrc}
            qrImageAlt={author.qr.imageAlt}
            closeLabel={author.qr.closeLabel}
            triggerVariant="hero"
            client:visible
          />
        ) : (
          <SettingsButton
            as="a"
            variant="secondary"
            className="hero-actions-button"
            iconSvg={author.iconSvg}
            href={author.href}
            target="_blank"
            rel="noreferrer noopener"
            aria-label={author.ariaLabel}
            data-analytics-event="open_discord"
            data-analytics-category="cta"
            data-analytics-label="home_faq_author"
          >
            {author.label}
          </SettingsButton>
        )}
      </div>
    </header>

    <div class="faq__list" data-faq>
      {items.map((item, index) => (
        <details class="faq__item" open={index === 0} data-reveal data-faq-item>
          <summary>
            <span class="faq__question">{item.question}</span>
            <span class="faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer">
            <p>
              {parseAnswer(item.answer).map((part) =>
                part.kind === "code" ? (
                  <code>{part.value}</code>
                ) : part.kind === "keys" ? (
                  <span class="faq__keys">
                    {part.value.map((key) => <kbd class="home-kbd">{key}</kbd>)}
                  </span>
                ) : (
                  part.value
                ),
              )}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--home-split-gap);
    align-items: start;
  }

  /* The intro stays in view while the list scrolls past it. */
  .faq__head {
    position: sticky;
    top: 120px;
  }

  .faq__head .home-h2 {
    margin-bottom: var(--home-space-6);
  }

  .faq__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--home-space-3);
  }

  /*
   * Rows are separated by an inset hairline. The open row lifts into a paper
   * card, so the hairlines on both of its edges step aside.
   */
  .faq__list {
    --faq-pad: var(--home-space-6);
  }

  .faq__item {
    position: relative;
    border-radius: var(--home-radius-lg);
    transition: background-color 280ms ease;
  }

  .faq__item + .faq__item::before {
    content: "";
    position: absolute;
    top: 0;
    inset-inline: var(--faq-pad);
    height: 1px;
    background: var(--home-hairline);
    transition: opacity 280ms ease;
  }

  /* data-expanded is set by the script below; [open] covers the page without JS. */
  .faq__list:not([data-enhanced]) .faq__item[open],
  .faq__item[data-expanded="true"] {
    background: var(--home-paper);
  }

  .faq__list:not([data-enhanced]) .faq__item[open]::before,
  .faq__list:not([data-enhanced]) .faq__item[open] + .faq__item::before,
  .faq__item[data-expanded="true"]::before,
  .faq__item[data-expanded="true"] + .faq__item::before {
    opacity: 0;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--home-space-6);
    padding: 22px var(--faq-pad);
    color: var(--home-ink);
    font-size: var(--home-title-sm);
    font-weight: 650;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--blue, #4ba7dd);
    outline-offset: -2px;
    border-radius: var(--home-radius-lg);
  }

  /* A question that runs to two lines splits evenly instead of leaving its last word alone. */
  .faq__question {
    text-wrap: balance;
  }

  /* data-script lives on <body>, outside this component, so it must be :global to match. */
  :global([data-script="cjk"]) .faq__question {
    word-break: var(--cjk-word-break);
    overflow-wrap: anywhere;
    letter-spacing: 0.01em;
  }

  /* A plus whose upright bar turns flat to become a minus. */
  .faq__toggle {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    --lumno-corner-shape: round;
    background: transparent;
    color: var(--text-soft, #89919a);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease;
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: "";
    position: absolute;
    top: 14px;
    left: 9px;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 360ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .faq__toggle::after {
    transform: rotate(90deg);
  }

  .faq__list:not([data-enhanced]) .faq__item[open] .faq__toggle::after,
  .faq__item[data-expanded="true"] .faq__toggle::after {
    transform: rotate(0deg);
  }

  .faq__list:not([data-enhanced]) .faq__item[open] .faq__toggle,
  .faq__item[data-expanded="true"] .faq__toggle {
    background: var(--home-card);
    color: var(--home-ink);
    box-shadow: var(--home-shadow-chip), inset 0 0 0 1px var(--home-hairline-control);
  }

  @media (hover: hover) {
    summary:hover .faq__toggle {
      background: var(--home-card);
      color: var(--home-ink);
      box-shadow: var(--home-shadow-chip), inset 0 0 0 1px var(--home-hairline-control);
    }
  }

  /*
   * The panel, not the text, tucks up into the summary's bottom padding, so
   * overflow: hidden never shaves the top of the first line.
   */
  .faq__answer {
    --faq-tuck: -8px;
    margin-top: var(--faq-tuck);
    overflow: hidden;
  }

  .faq__answer p {
    margin: 0;
    padding: 0 calc(var(--faq-pad) + 54px) 26px var(--faq-pad);
    color: var(--text-sub, #626870);
    font-size: var(--home-body);
    line-height: 1.8;
    text-wrap: pretty;
  }

  :global([data-script="cjk"]) .faq__answer p {
    letter-spacing: 0.01em;
    line-break: strict;
  }

  .faq__answer code {
    padding: 2px 6px;
    border-radius: var(--home-radius-xs);
    background: var(--home-card);
    box-shadow: inset 0 0 0 1px var(--home-hairline);
    color: var(--home-ink-soft);
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86em;
    white-space: nowrap;
  }

  .faq__keys {
    display: inline-flex;
    gap: 3px;
    margin-inline: 2px;
    vertical-align: 1px;
  }

  .faq__keys .home-kbd {
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .faq__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--home-head-gap);
    }

    .faq__head {
      position: static;
    }
  }

  @media (max-width: 620px) {
    /* Bleed the rows halfway into the gutter so the open card has room to breathe. */
    .faq__list {
      --faq-pad: var(--home-space-4);
      margin-inline: -8px;
    }

    summary {
      padding-block: 18px;
      font-size: 16px;
    }

    .faq__answer p {
      padding-right: var(--faq-pad);
    }

    .faq__answer code {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
</style>

<script>
  /*
   * One answer open at a time. Opening grows the answer to its measured height
   * while the text eases in; closing runs the same motion back and only then
   * drops [open], so the content stays readable until it has folded away.
   * A click mid-animation reverses from wherever the panel is.
   */
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLDetailsElement>("[data-faq-item]"));
    const running = new WeakMap<HTMLDetailsElement, Animation[]>();

    list.dataset.enhanced = "";
    items.forEach((item) => {
      item.dataset.expanded = String(item.open);
    });

    const settle = (item: HTMLDetailsElement) => {
      running.get(item)?.forEach((animation) => animation.cancel());
      running.delete(item);
    };

    const toggle = (item: HTMLDetailsElement, expand: boolean) => {
      const panel = item.querySelector<HTMLElement>(".faq__answer");
      const text = panel?.firstElementChild as HTMLElement | null;
      if (!panel || !text) return;

      const from = item.open ? panel.getBoundingClientRect().height : 0;
      const tuck = getComputedStyle(panel).getPropertyValue("--faq-tuck").trim() || "0px";
      const fromTuck = item.open ? getComputedStyle(panel).marginTop : "0px";
      const fromOpacity = item.open ? Number(getComputedStyle(text).opacity) : 0;
      settle(item);
      item.dataset.expanded = String(expand);

      if (reduceMotion.matches) {
        item.open = expand;
        return;
      }

      item.open = true;
      const to = expand ? panel.scrollHeight : 0;
      const duration = Math.min(420, 220 + Math.abs(to - from) * 0.9);
      const easing = expand ? "cubic-bezier(0.22, 1, 0.36, 1)" : "cubic-bezier(0.4, 0, 0.2, 1)";

      // The tuck eases in with the height so the row doesn't jump 8px on the first frame.
      const height = panel.animate(
        { height: [`${from}px`, `${to}px`], marginTop: [fromTuck, expand ? tuck : "0px"] },
        { duration, easing },
      );
      const fade = text.animate(
        expand
          ? { opacity: [fromOpacity, 1], transform: ["translateY(-6px)", "translateY(0)"] }
          : { opacity: [fromOpacity, 0], transform: ["translateY(0)", "translateY(-4px)"] },
        { duration: expand ? duration + 80 : duration * 0.7, delay: expand ? 60 : 0, easing, fill: "both" },
      );
      running.set(item, [height, fade]);

      height.onfinish = () => {
        settle(item);
        item.open = expand;
      };
    };

    items.forEach((item) => {
      item.querySelector("summary")?.addEventListener("click", (event) => {
        event.preventDefault();
        const expand = item.dataset.expanded !== "true";
        if (expand) {
          items.forEach((other) => {
            if (other !== item && other.dataset.expanded === "true") toggle(other, false);
          });
        }
        toggle(item, expand);
      });

      // Find-in-page can open a closed answer on its own; keep the row state in step.
      item.addEventListener("toggle", () => {
        if (item.open && item.dataset.expanded !== "true" && !running.has(item)) {
          item.dataset.expanded = "true";
        }
      });
    });
  });
</script>
