---
import { DitherShader } from "../DitherShader";

interface Props {
  /** The hero's title, so the page closes on the pitch it opened with, and a one-line description. */
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/*
 * The closing callback: the hero's dithered meadow in the same media frame,
 * with the hero's title and its two buttons (passed in as the default slot)
 * centred on it. Before the shader hydrates, its container shows the plain
 * wallpaper (hero-safari-demo.css).
 */
---

<section class="home-section final-cta" aria-labelledby="final-title">
  <div class="final-cta__panel home-media">
    <DitherShader
      className="final-cta__wallpaper"
      src="/assets/settings-bg-light-monet-newtab.webp"
      gridSize={2}
      ditherMode="bayer"
      colorMode="original"
      brightness={0.01}
      contrast={1.08}
      threshold={0.22}
      client:visible
    />
    <div class="final-cta__copy">
      <h2 id="final-title" class="home-h2"><span>{title}</span></h2>
      <p class="home-lead">{description}</p>
      <div class="final-cta__actions">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta__panel {
    position: relative;
    display: grid;
    min-height: clamp(460px, 44vw, 620px);
    overflow: hidden;
    padding: clamp(48px, 6vw, 80px) clamp(24px, 6vw, 80px);
    background: #f7f8ef;
    place-items: center;
    text-align: center;
  }

  /* Soft light behind the copy, so it reads on any part of the painting. */
  .final-cta__panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(ellipse 52% 42% at 50% 50%, rgba(250, 250, 246, 0.78), rgba(250, 250, 246, 0) 100%);
    pointer-events: none;
  }

  .final-cta__copy {
    position: relative;
    z-index: 3;
  }

  .final-cta .home-lead {
    margin-top: 16px;
    color: var(--home-ink-soft);
  }

  /* Same row as the hero's buttons. */
  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  @media (max-width: 620px) {
    .final-cta__panel {
      min-height: 480px;
      padding-inline: 16px;
    }

    .final-cta__actions {
      gap: 10px;
      margin-top: 24px;
    }
  }
</style>
