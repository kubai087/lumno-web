---
import "../../extension-settings/settings-kit.css";
import { NewTabMock } from "../NewTabMock";
import type { HOME_CONTENT, HomeNewTabFilterId } from "../../../lib/home-content";
import NewTabCarousel from "../newtab/NewTabCarousel.astro";
import NewTabFeatureCard from "../newtab/NewTabFeatureCard.astro";
import NewTabPartHead from "../newtab/NewTabPartHead.astro";

type Content = (typeof HOME_CONTENT)["en"]["newTab"];

interface Props {
  content: Content;
  locale: string;
}

// `locale` stays in Props for the page; every image here is now shared across locales.
const { content } = Astro.props;

// Filter renders are wallpaper only (the chrome on top is NewTabMock), so all locales share them.
const fxShot = (id: HomeNewTabFilterId) => `/assets/feature-newtab/fx/fx-${id}.webp`;

// "none" is the left half of the comparison, so it is not a tab.
const FILTERS: Exclude<HomeNewTabFilterId, "none">[] = ["blur", "grain", "blocks", "halftone", "dither", "ascii", "crt"];
// Open on a filter whose texture reads at a glance.
const START_FILTER = "blocks";
---

<!--
  Same card language as the command bar section: a near-neutral grey card with a hairline
  that is the same strength all round, the picture on top and the copy underneath.
  Switches use the extension's settings tabs (extension-settings/settings-kit.css).
-->
<div class="nt-features">
  <!-- Part one: wallpapers. The filter lab, then the daily and night pictures. -->
  <div class="nt-part">
    <NewTabPartHead title={content.wallpaperPart.title} lead={content.wallpaperPart.lead} />
  </div>

  <article class="nt-showcase" data-reveal data-nt-switcher data-autoplay="2600" data-start={FILTERS.indexOf(START_FILTER)}>
    <!-- Before/after: the original underneath, the picked filter clipped to the right of the divider. -->
    <div class="nt-stage nt-compare" data-nt-compare>
      <div class="nt-screen nt-screen--lab" id="nt-filter-panel" role="tabpanel" aria-label={content.filters.alt}>
        <div class="nt-compare__layer">
          <img
            src={fxShot("none")}
            alt={`${content.filters.items.none.name} · ${content.filters.alt}`}
            width="1600"
            height="1000"
            loading="lazy"
            decoding="async"
          />
        </div>
        <!-- Slides behind the first one yield to the pictures on screen on a slow connection. -->
        <div class="nt-compare__layer nt-compare__layer--fx">
          {FILTERS.map((id) => (
            <img
              class="nt-slide"
              src={fxShot(id)}
              alt={`${content.filters.items[id].name} · ${content.filters.alt}`}
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
              fetchpriority={id === START_FILTER ? undefined : "low"}
              data-nt-slide
              data-active={id === START_FILTER ? "true" : "false"}
              aria-hidden={id === START_FILTER ? undefined : "true"}
            />
          ))}
        </div>
        <NewTabMock placeholder={content.filters.searchPlaceholder} />
        <div
          class="nt-compare__divider"
          role="slider"
          tabindex="0"
          aria-label={content.filters.compareLabel}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          aria-controls="nt-filter-panel"
          data-nt-divider
        >
          <span class="nt-compare__knob"><i class="ri-arrow-left-right-line" aria-hidden="true"></i></span>
        </div>
      </div>
    </div>

    <!-- The part heading above already names this card, so the footer is only the switch:
         tabs on the left, the active filter's line on the right. -->
    <div class="nt-copy nt-switch">
      <div class="lumno-settings-kit lumno-settings-tabs nt-tabs" role="tablist" aria-label={content.filters.tablistLabel}>
        {FILTERS.map((id) => (
          <button
            type="button"
            class="lumno-settings-tab"
            role="tab"
            id={`nt-filter-tab-${id}`}
            aria-selected={id === START_FILTER ? "true" : "false"}
            aria-controls="nt-filter-panel"
            tabindex={id === START_FILTER ? 0 : -1}
            data-active={id === START_FILTER ? "true" : "false"}
            data-nt-tab
          >
            {content.filters.items[id].name}
          </button>
        ))}
      </div>
      {FILTERS.map((id) => (
        <p class="nt-caption" data-nt-caption hidden={id !== START_FILTER}>{content.filters.items[id].note}</p>
      ))}
    </div>
  </article>

  <div class="nt-pair" data-reveal><NewTabFeatureCard id="wallpapers" content={content} /></div>
  <div class="nt-pair" data-reveal><NewTabFeatureCard id="dark" content={content} /></div>

  <!-- Part two: everyday tools, as a carousel of animated cards (components/home/newtab). -->
  <NewTabCarousel content={content} />
</div>

<style>
  .nt-features {
    --card-edge: var(--home-edge);
    position: relative;
    z-index: var(--home-z-content);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--home-grid-gap);
    width: var(--home-column);
    /* The parallax stage settles 300px above its layout box (plus the md:py-40 padding);
       pull the cards up into that empty space, leaving a clear gap under the last row. */
    margin: -400px auto 0;
    padding-bottom: var(--home-section-space);
  }

  /* ---------- Showcase: the filter lab, frameless ----------
     The feature cards below are paper cards; this one is not a card at all, just
     the screen on the page with its switch underneath, so it reads as the lead
     picture of the part rather than a third card in the row. */

  .nt-showcase {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    /* The lead picture sets off the pair of cards like a heading: head-gap in all, grid gap included. */
    margin-bottom: calc(var(--home-head-gap) - var(--home-grid-gap));
  }

  .nt-part {
    grid-column: 1 / -1;
    /* Clear air under the parallax windows that settle just above. */
    margin-top: var(--home-head-gap);
  }

  .nt-pair {
    display: flex;
    grid-column: span 3;
  }

  .nt-copy {
    margin-top: var(--home-space-4);
    padding-inline: var(--home-space-1);
  }

  /* ---------- Switch: Lumno settings tabs plus the active tab's line ---------- */

  .nt-switch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--home-space-3) var(--home-space-6);
    min-width: 0;
  }

  .nt-tabs {
    flex: none;
    max-width: 100%;
    margin-bottom: 0;
    background: rgba(var(--card-edge), 0.05);
  }

  .nt-caption {
    margin: 0;
    color: var(--text-soft, #89919a);
    font-size: 14px;
    line-height: 1.5;
    text-align: right;
    text-wrap: pretty;
  }

  .nt-caption[hidden] {
    display: none;
  }

  /* ---------- Stage: crops of real new tab renders ---------- */

  .nt-stage {
    position: relative;
  }

  .nt-screen {
    position: relative;
    overflow: hidden;
    height: 340px;
    border-radius: var(--home-radius-xl);
    background: #e8eaee;
  }

  .nt-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
  }

  /* Hairline over the image, so light wallpapers keep an edge on the paper card. */
  .nt-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    box-shadow: var(--home-media-ring);
    pointer-events: none;
  }

  .nt-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 520ms ease;
  }

  .nt-slide[data-active="true"] {
    opacity: 1;
  }

  /* ---------- Filter compare ---------- */

  .nt-compare {
    --split: 50%;
  }

  .nt-screen--lab {
    box-shadow: var(--home-shadow-card);
    /* NewTabMock sizes itself against this width. */
    container-type: inline-size;
    height: auto;
    aspect-ratio: 16 / 10;
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
  }

  .nt-compare__layer {
    position: absolute;
    inset: 0;
  }

  .nt-compare__layer--fx {
    clip-path: inset(0 0 0 var(--split));
  }

  .nt-compare[data-intro="running"] .nt-compare__layer--fx,
  .nt-compare[data-intro="running"] .nt-compare__divider {
    transition: clip-path 1100ms cubic-bezier(0.22, 1, 0.36, 1), left 1100ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nt-compare__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    z-index: 2;
    width: 2px;
    margin-left: -1px;
    background: #fff;
    /* Pale wallpapers: a soft shadow keeps the white line visible. */
    box-shadow: 0 0 0 0.5px rgba(32, 38, 46, 0.14), 0 0 12px rgba(60, 72, 96, 0.22);
    outline: none;
  }

  .nt-compare__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    --lumno-corner-shape: round;
    background: #fff;
    color: var(--home-ink);
    font-size: 18px;
    box-shadow: 0 4px 14px rgba(20, 22, 26, 0.18), 0 0 0 1px rgba(20, 22, 26, 0.06);
    transform: translate(-50%, -50%);
    transition: transform 160ms ease;
  }

  .nt-screen--lab:active .nt-compare__knob,
  .nt-compare__divider:hover .nt-compare__knob {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .nt-compare__divider:focus-visible .nt-compare__knob {
    outline: 2px solid var(--home-select-ink);
    outline-offset: 2px;
  }

  @media (max-width: 980px) {
    .nt-pair {
      grid-column: 1 / -1;
    }

    .nt-switch {
      flex-direction: column;
      align-items: flex-start;
    }

    .nt-caption {
      padding-inline: var(--home-space-1);
      text-align: left;
    }
  }

  @media (max-width: 760px) {
    .nt-features {
      margin-top: -340px;
    }
  }

  @media (max-width: 620px) {
    .nt-compare__knob {
      width: 34px;
      height: 34px;
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nt-slide {
      transition: none;
    }
  }
</style>

<script>
  import { attachTabsIndicator } from "../../extension-settings/tabs-indicator";

  /*
   * Tabbed screens: a tab picks the slide at the same index. While on screen they
   * advance on their own until the visitor picks one; reduced motion never autoplays.
   */
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-nt-switcher]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-nt-tab]"));
    root.querySelectorAll<HTMLElement>(".lumno-settings-tabs").forEach(attachTabsIndicator);
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-nt-slide]"));
    const captions = Array.from(root.querySelectorAll<HTMLElement>("[data-nt-caption]"));
    const interval = Number(root.dataset.autoplay) || 0;
    let current = Number(root.dataset.start) || 0;
    let timer = 0;
    let stopped = reduceMotion || !interval;

    const select = (index: number, focus = false) => {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === current;
        tab.setAttribute("aria-selected", String(active));
        tab.dataset.active = String(active);
        tab.tabIndex = active ? 0 : -1;
      });
      captions.forEach((caption, captionIndex) => {
        caption.hidden = captionIndex !== current;
      });
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === current;
        slide.dataset.active = String(active);
        if (active) {
          slide.removeAttribute("aria-hidden");
        } else {
          slide.setAttribute("aria-hidden", "true");
        }
      });
      // Keep the active tab visible when the tab bar scrolls sideways (phones).
      const bar = tabs[current].parentElement;
      if (bar && bar.scrollWidth > bar.clientWidth) {
        const tabRect = tabs[current].getBoundingClientRect();
        const barRect = bar.getBoundingClientRect();
        const offset = tabRect.left - barRect.left - (barRect.width - tabRect.width) / 2;
        bar.scrollBy({ left: offset, behavior: reduceMotion ? "auto" : "smooth" });
      }
      if (focus) tabs[current].focus();
    };

    const pause = () => window.clearInterval(timer);
    const play = () => {
      pause();
      if (!stopped) timer = window.setInterval(() => select(current + 1), interval);
    };
    const stop = () => {
      stopped = true;
      pause();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        stop();
        select(index);
      });
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
        if (event.key === "Home" || event.key === "End") {
          event.preventDefault();
          stop();
          select(event.key === "Home" ? 0 : tabs.length - 1, true);
        } else if (step) {
          event.preventDefault();
          stop();
          select(current + step, true);
        }
      });
    });

    // Only cycle while the screen is visible.
    new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? play() : pause()),
      { threshold: 0.35 },
    ).observe(root);
  });

  /*
   * Before/after divider: drag anywhere on the screen (or use the arrow keys on the
   * knob). On first view it sweeps in from the right edge to show what it does.
   */
  document.querySelectorAll<HTMLElement>("[data-nt-compare]").forEach((root) => {
    const screen = root.querySelector<HTMLElement>(".nt-screen--lab");
    const divider = root.querySelector<HTMLElement>("[data-nt-divider]");
    if (!screen || !divider) return;

    let split = 50;
    const setSplit = (value: number) => {
      split = Math.min(100, Math.max(0, value));
      root.style.setProperty("--split", `${split}%`);
      divider.setAttribute("aria-valuenow", String(Math.round(split)));
    };
    const fromPointer = (event: PointerEvent) => {
      const rect = screen.getBoundingClientRect();
      setSplit(((event.clientX - rect.left) / rect.width) * 100);
    };

    screen.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      root.dataset.intro = "done";
      screen.setPointerCapture(event.pointerId);
      fromPointer(event);
    });
    screen.addEventListener("pointermove", (event) => {
      if (screen.hasPointerCapture(event.pointerId)) fromPointer(event);
    });

    divider.addEventListener("keydown", (event) => {
      const step = { ArrowRight: 5, ArrowUp: 5, ArrowLeft: -5, ArrowDown: -5 }[event.key];
      if (step) setSplit(split + step);
      else if (event.key === "Home") setSplit(0);
      else if (event.key === "End") setSplit(100);
      else return;
      event.preventDefault();
      root.dataset.intro = "done";
    });

    if (reduceMotion) return;
    root.dataset.intro = "pending";
    root.style.setProperty("--split", "100%");
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting || root.dataset.intro !== "pending") return;
        observer.disconnect();
        root.dataset.intro = "running";
        requestAnimationFrame(() => setSplit(50));
        window.setTimeout(() => {
          if (root.dataset.intro === "running") root.dataset.intro = "done";
        }, 1200);
      },
      { threshold: 0.5 },
    );
    observer.observe(root);
  });
</script>
