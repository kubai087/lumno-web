---
import type { HOME_CONTENT, HomeTrustId } from "../../../lib/home-content";
import { SettingsButton } from "../../extension-settings/SettingsKit";
import TitlePair from "../TitlePair.astro";
import { PrivacyListArt, SourceTerminalArt, SyncFileArt } from "../OpenSourceArt";

type Content = (typeof HOME_CONTENT)["en"]["openSource"];

interface Props {
  content: Content;
  githubUrl: string;
}

const { content, githubUrl } = Astro.props;

const POINTS: HomeTrustId[] = ["local", "source", "optional"];

// Logos we ship (see HeroInstallTooltip); the caption covers the rest.
const BROWSER_LOGOS: Record<string, string> = {
  Chrome: "/assets/browser-logos/chrome.webp",
  Edge: "/assets/browser-logos/edge.webp",
  Dia: "/assets/browser-logos/dia.webp",
  Brave: "/assets/browser-logos/brave.webp",
  Comet: "/assets/browser-logos/comet.webp",
  Helium: "/assets/browser-logos/helium.webp",
};
const browsersWithLogo = content.browserNames.filter((name) => BROWSER_LOGOS[name]);
---

<section id="open-source" class="home-section open-source" aria-labelledby="open-source-title">
  <header class="open-source__head">
    <div class="open-source__intro">
      <h2 id="open-source-title" class="home-h2" data-reveal="text"><TitlePair title={content.title} /></h2>
      <!-- Under the heading: which browsers it runs in, logos then caption. -->
      <div class="open-source__browsers" data-reveal="text">
        <p>{content.browsersLabel}</p>
        <ul class="os-logos" aria-label={content.browserNames.join(", ")}>
          {browsersWithLogo.map((name) => (
            <li data-name={name}>
              <img src={BROWSER_LOGOS[name]} width="20" height="20" alt={name} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </div>
    <SettingsButton
      as="a"
      variant="secondary"
      className="hero-actions-button open-source__github"
      iconClass="ri-github-fill"
      href={githubUrl}
      target="_blank"
      rel="noreferrer noopener"
      data-analytics-event="open_github_repo"
      data-analytics-category="cta"
      data-analytics-label="home_open_source_github"
      data-reveal
    >
      {content.githubLabel}
    </SettingsButton>
  </header>

  <!--
    Three cards in the feature cards' material: copy on top, an illustration
    in a white panel inset from the top and sides and running off the bottom.
  -->
  <ul class="open-source__cards">
    {POINTS.map((id) => (
      <li class="os-card" data-reveal data-os-card data-point={id}>
        <h3>{content.points[id]}</h3>
        <div class="os-card__art" aria-hidden="true">
          <div class="os-card__panel">
            {id === "local" && (
              <PrivacyListArt
                client:visible
                title={content.art.privacy.title}
                status={content.art.privacy.status}
                items={content.art.privacy.items}
              />
            )}
            {id === "source" && <SourceTerminalArt client:visible />}
            {id === "optional" && <SyncFileArt client:visible channels={content.art.sync} />}
          </div>
        </div>
      </li>
    ))}
  </ul>

</section>

<script>
  /*
   * Phones (home-phone) have no hover to show a logo's name with, so a tap
   * shows it for a moment instead; tapping another logo moves it there.
   */
  import { isPhone } from "../../../scripts/home-phone";

  const logos = Array.from(document.querySelectorAll<HTMLElement>(".os-logos li"));
  let timer: number | undefined;
  const hide = () => logos.forEach((logo) => delete logo.dataset.tip);

  logos.forEach((logo) => {
    logo.addEventListener("click", () => {
      if (!isPhone()) return;
      hide();
      logo.dataset.tip = "";
      window.clearTimeout(timer);
      timer = window.setTimeout(hide, 1800);
    });
  });
</script>

<style>
  .open-source__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--home-space-6) var(--home-space-12);
    margin-bottom: var(--home-head-gap);
  }

  .open-source__head :global(.open-source__github) {
    margin-bottom: var(--home-space-1);
  }

  .open-source__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--home-grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The feature cards' paper material (NewTabFeatureCard): ring, white rim, lift. */
  .os-card {
    --pad: calc(var(--home-card-pad) - 1px);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--home-radius-xl);
    background:
      linear-gradient(var(--home-paper), var(--home-paper)) padding-box,
      var(--home-ring) border-box;
    box-shadow: var(--home-highlight), var(--home-shadow-card);
    transition:
      box-shadow 240ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Dense, faint diagonal lines, absent behind the copy and full behind the panel. */
  .os-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(-45deg, rgba(var(--home-edge), 0.075) 0 1px, transparent 1px 7px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 22%, #000 64%);
    mask-image: linear-gradient(to bottom, transparent 22%, #000 64%);
    pointer-events: none;
  }

  @media (hover: hover) {
    .os-card:hover {
      box-shadow: var(--home-highlight), var(--home-shadow-card-hover);
      transform: translateY(-3px);
    }
  }

  .os-card h3 {
    margin: 0;
    padding: var(--pad) var(--pad) 0;
    color: var(--home-ink);
    font-size: var(--home-title-md);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* CJK copy breaks at punctuation, never inside a word (same rule as home.css). */
  :global([data-script="cjk"]) .os-card h3 {
    word-break: var(--cjk-word-break);
    overflow-wrap: anywhere;
    letter-spacing: 0;
  }

  .os-card__art {
    position: relative;
    flex: none;
    height: 264px;
    margin-top: auto;
    padding-top: var(--home-art-gap);
  }

  /* The same window as the new tab feature cards: art-gap under the copy, its sides on the copy's edges. */
  .os-card__panel {
    position: absolute;
    inset: var(--home-art-gap) var(--pad) 0;
    overflow: hidden;
    border-radius: var(--home-radius-md) var(--home-radius-md) 0 0;
    background: #fff;
    container-type: inline-size;
    box-shadow:
      0 0 0 1px rgba(var(--home-edge), 0.12),
      0 16px 40px -18px rgba(var(--home-edge), 0.32);
  }

  /* A quiet line under the heading: small logos and a caption, no container. */
  .open-source__browsers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--home-space-2) var(--home-space-3);
    margin-top: var(--home-lead-gap);
  }

  .open-source__browsers p {
    order: 2;
    margin: 0;
    color: var(--text-sub, #626870);
    font-size: 14px;
  }

  .os-logos {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .os-logos li {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .os-logos img {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    object-fit: contain;
  }

  /* Name tag above each logo on hover, or for a moment after a tap on touch screens. */
  .os-logos li::after {
    content: attr(data-name);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    padding: 4px 8px;
    border-radius: var(--home-radius-xs);
    background: #1f2328;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: -50% 4px;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      translate 160ms ease;
  }

  @media (hover: hover) {
    .os-logos li:hover {
      z-index: 1;
      transform: translateY(-3px);
    }

    .os-logos li:hover::after {
      opacity: 1;
      translate: -50% 0;
    }
  }

  .os-logos li[data-tip] {
    z-index: 1;
    transform: translateY(-3px);
  }

  .os-logos li[data-tip]::after {
    opacity: 1;
    translate: -50% 0;
  }

  /* On a phone the first tag hangs right from its logo, so it never runs past the page edge. */
  @media (max-width: 760px) {
    .os-logos li:first-child::after {
      left: 0;
      translate: 0 4px;
    }

    .os-logos li:first-child:is(:hover, [data-tip])::after {
      translate: 0 0;
    }
  }

  /* Too narrow for three across: one card per row, copy beside its panel. */
  @media (max-width: 1280px) {
    .open-source__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .os-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
      column-gap: var(--home-space-2);
    }

    .os-card h3 {
      padding-block: var(--pad);
    }

    .os-card::before {
      -webkit-mask-image: linear-gradient(to right, transparent 30%, #000 70%);
      mask-image: linear-gradient(to right, transparent 30%, #000 70%);
    }

    .os-card__panel {
      left: 0;
    }
  }

  @media (max-width: 720px) {
    .os-card {
      display: flex;
      /* Undo the row layout's centring, or the art (absolute content only) shrinks to nothing. */
      align-items: stretch;
    }

    .os-card h3 {
      padding-bottom: 0;
    }

    .os-card::before {
      -webkit-mask-image: linear-gradient(to bottom, transparent 22%, #000 64%);
      mask-image: linear-gradient(to bottom, transparent 22%, #000 64%);
    }

    .os-card__panel {
      left: var(--pad);
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .os-card,
    .os-logos li {
      transition: none;
    }

    .os-card:hover {
      transform: none;
    }
  }
</style>
