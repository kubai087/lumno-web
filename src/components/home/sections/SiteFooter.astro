---
import logoIconSvg from "../../../assets/onboarding/logo.svg?raw";
import { CommunityQrDialog } from "../CommunityQrDialog";

type Link = { label: string; href: string; external?: boolean };
/** A Remix icon class, or raw inline SVG for brands Remix doesn't cover. */
type Social = { label: string; href: string; iconClass?: string; iconSvg?: string; analyticsEvent: string; analyticsLabel: string };
type Store = { label: string; href: string; logoSrc: string; analyticsEvent: string; analyticsLabel: string };

interface Props {
  homeHref: string;
  tagline: string;
  /** Store buttons under the tagline; the final CTA above already carries the big Chrome button. */
  storesLabel: string;
  stores: Store[];
  socialAria: string;
  socials: Social[];
  /** The feedback entry leads the last column, ahead of that column's links. */
  columns: Array<{ title: string; links: Link[] }>;
  feedback: {
    label: string;
    ariaLabel: string;
    qrTitle: string;
    qrImageSrc: string;
    qrImageAlt: string;
    closeLabel: string;
    externalHref?: string;
  };
  copyright: string;
  licenseHref: string;
  languages: Array<{ code: string; label: string; href: string; current: boolean }>;
}

const { homeHref, tagline, storesLabel, stores, socialAria, socials, columns, feedback, copyright, licenseHref, languages } = Astro.props;
// A narrow (centred) tagline may only wrap between Chinese phrases, never inside a word.
const taglinePhrases = tagline.split(/(?<=、)/);
---

<footer class="site-footer">
  <div class="site-footer__main" data-reveal>
    <div class="site-footer__brand">
      <a class="site-footer__logo" href={homeHref} aria-label="Lumno">
        <span class="site-footer__icon" aria-hidden="true" set:html={logoIconSvg}></span>
        <img src="/assets/textlogo.svg" width="165" height="43" alt="Lumno" loading="lazy" />
      </a>
      <p>{taglinePhrases.map((phrase) => <span class="site-footer__phrase">{phrase}</span>)}</p>
      <ul class="site-footer__stores" aria-label={storesLabel}>
        {stores.map((store) => (
          <li>
            <a
              href={store.href}
              target="_blank"
              rel="noreferrer noopener"
              data-analytics-event={store.analyticsEvent}
              data-analytics-category="conversion"
              data-analytics-label={store.analyticsLabel}
            >
              <img src={store.logoSrc} width="18" height="18" alt="" loading="lazy" decoding="async" />
              {store.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="site-footer__socials" aria-label={socialAria}>
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={social.label}
              title={social.label}
              data-analytics-event={social.analyticsEvent}
              data-analytics-category="cta"
              data-analytics-label={social.analyticsLabel}
            >
              {social.iconSvg ? (
                <span class="site-footer__social-svg" aria-hidden="true" set:html={social.iconSvg}></span>
              ) : (
                <i class={social.iconClass} aria-hidden="true"></i>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <nav class="site-footer__columns">
      {columns.map((column, columnIndex) => (
        <div>
          <h2>{column.title}</h2>
          <ul>
            {columnIndex === columns.length - 1 && (
              <li>
                <CommunityQrDialog
                  triggerLabel={feedback.label}
                  triggerAriaLabel={feedback.ariaLabel}
                  title={feedback.qrTitle}
                  qrImageSrc={feedback.qrImageSrc}
                  qrImageAlt={feedback.qrImageAlt}
                  closeLabel={feedback.closeLabel}
                  triggerVariant="footer"
                  externalHref={feedback.externalHref}
                />
              </li>
            )}
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer noopener" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="site-footer__meta">
    <p>
      <span>© {new Date().getFullYear()} {copyright}</span>
      <a href={licenseHref} target="_blank" rel="noreferrer noopener">GPL-3.0</a>
    </p>
    <ul class="site-footer__languages">
      {languages.map((language) => (
        <li>
          <a
            href={language.href}
            hreflang={language.code}
            lang={language.code}
            aria-current={language.current ? "page" : undefined}
          >
            {language.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--home-card-border);
    background: rgba(255, 255, 255, 0.6);
  }

  .site-footer__main,
  .site-footer__meta {
    width: var(--home-column);
    margin-inline: auto;
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--home-space-16);
    padding: var(--home-space-16) 0 56px;
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .site-footer__icon {
    display: block;
    width: 34px;
    height: 34px;
    overflow: visible;
  }

  .site-footer__icon :global(svg) {
    width: 44px;
    height: 48px;
    display: block;
    transform: translate(-8px, -1px);
    shape-rendering: geometricPrecision;
  }

  .site-footer__logo img {
    width: 82px;
    height: auto;
    display: block;
  }

  .site-footer__brand p {
    max-width: 340px;
    margin: var(--home-space-4) 0 0;
    color: var(--text-sub, #626870);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-footer__phrase {
    display: inline-block;
  }

  /* White store pills, a quieter echo of the final CTA's install button. */
  .site-footer__stores {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: var(--home-space-5);
  }

  .site-footer .site-footer__stores a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px 0 12px;
    border: 1px solid var(--home-hairline-control);
    border-radius: var(--home-radius-pill);
    --lumno-corner-shape: round;
    background: var(--home-card);
    box-shadow: var(--home-shadow-chip);
    color: var(--home-ink, #2f2a22);
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .site-footer .site-footer__stores a:hover {
    border-color: rgba(var(--home-edge), 0.16);
    background: #f8fafc;
    color: var(--home-ink, #2f2a22);
  }

  .site-footer__stores img {
    flex: none;
    width: 18px;
    height: 18px;
  }

  /* Icon buttons sit flush with the tagline: the first glyph lines up with the text edge. */
  .site-footer__socials {
    display: flex;
    gap: 4px;
    margin: var(--home-space-4) 0 0 -7px;
  }

  .site-footer .site-footer__socials a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--home-radius-sm);
    font-size: 18px;
    line-height: 1;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .site-footer__social-svg :global(svg) {
    display: block;
    width: 18px;
    height: 18px;
    shape-rendering: geometricPrecision;
  }

  .site-footer .site-footer__socials a:hover {
    background: rgba(47, 42, 34, 0.06);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(140px, max-content));
    column-gap: clamp(48px, 8vw, 112px);
  }

  h2 {
    margin: 0 0 14px;
    color: var(--home-ink, #2f2a22);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a,
  .site-footer :global(.community-footer-trigger) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-sub, #626870);
    font: inherit;
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    transition: color 160ms ease;
  }

  .site-footer a:hover,
  .site-footer :global(.community-footer-trigger:hover) {
    color: var(--home-ink, #2f2a22);
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--home-space-3) var(--home-space-6);
    padding: var(--home-space-6) 0 var(--home-space-8);
    border-top: 1px solid var(--home-card-border);
    color: var(--text-soft, #89919a);
    font-size: 13px;
  }

  .site-footer__meta p {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
  }

  .site-footer__meta p > * + *::before {
    content: "·";
    margin-inline: 8px;
    color: var(--text-soft, #89919a);
  }

  .site-footer__meta p a {
    font-size: 13px;
  }

  /*
   * The languages share the copyright's row and only wrap (from the right
   * edge) once that row is genuinely too narrow, never at a fixed width.
   * When they drop below the copyright, the auto margin keeps them right-aligned.
   */
  .site-footer__languages {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 16px;
    margin-left: auto;
  }

  .site-footer__languages a {
    font-size: 13px;
    white-space: nowrap;
  }

  .site-footer__languages a[aria-current="page"] {
    color: var(--home-ink, #2f2a22);
    font-weight: 650;
  }

  @media (max-width: 860px) {
    .site-footer__main {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--home-space-10);
    }
  }

  /*
   * Phones: with five links, two short headed columns left a lopsided gap and
   * crowded the copyright and languages onto one row. Like product footers
   * with few links (Zen, The Browser Company), everything centres in a single
   * column: brand, socials, the links as one wrapping block (headings kept for
   * screen readers only), then languages and copyright on their own lines.
   */
  @media (max-width: 600px) {
    .site-footer__main {
      justify-items: center;
      gap: var(--home-space-8);
      padding: var(--home-space-12) 0 var(--home-space-8);
      text-align: center;
    }

    .site-footer__brand {
      display: grid;
      justify-items: center;
    }

    .site-footer__brand p {
      max-width: 300px;
      margin-top: var(--home-space-3);
      text-wrap: balance;
    }


    /* Stacked at one shared width rather than wrapping into two odd lengths. */
    .site-footer__stores {
      display: grid;
      width: min(100%, 260px);
    }

    .site-footer .site-footer__stores a {
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
    }

    .site-footer__socials {
      gap: 8px;
      margin: var(--home-space-5) 0 0;
    }

    .site-footer .site-footer__socials a {
      width: 40px;
      height: 40px;
      border-radius: var(--home-radius-pill);
      --lumno-corner-shape: round;
      background: rgba(47, 42, 34, 0.04);
    }

    /* One wrapping block of links; the width breaks five links into 3 + 2. */
    .site-footer__columns {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 24px;
      max-width: 290px;
    }

    .site-footer__columns > div,
    .site-footer__columns ul {
      display: contents;
    }

    .site-footer__columns h2 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .site-footer__columns a,
    .site-footer__columns :global(.community-footer-trigger) {
      font-size: 15px;
      line-height: 1.6;
    }

    .site-footer__meta {
      flex-direction: column;
      gap: var(--home-space-4);
      padding: var(--home-space-6) 0 calc(var(--home-space-10) + env(safe-area-inset-bottom, 0px));
    }

    .site-footer__meta p {
      justify-content: center;
    }

    /* The languages wrap as one centred block of small pills, the current one filled. */
    .site-footer__languages {
      order: -1;
      justify-content: center;
      margin-left: 0;
      gap: 4px;
      max-width: 340px;
    }

    .site-footer__languages a {
      display: block;
      padding: 5px 10px;
      border-radius: var(--home-radius-pill);
      --lumno-corner-shape: round;
    }

    .site-footer__languages a[aria-current="page"] {
      background: rgba(47, 42, 34, 0.06);
    }
  }
</style>
