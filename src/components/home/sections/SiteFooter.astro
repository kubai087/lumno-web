---
import logoIconSvg from "../../../assets/onboarding/logo.svg?raw";
import { CommunityTrigger } from "../CommunityTrigger";
import type { CommunityPanel } from "../../../lib/community-panel";

type Link = { label: string; href: string; external?: boolean };
/** A Remix icon class, or raw inline SVG for brands Remix doesn't cover. */
type Social = { label: string; href: string; iconClass?: string; iconSvg?: string; analyticsEvent: string; analyticsLabel: string };
type Store = { label: string; href: string; logoSrc: string; analyticsEvent: string; analyticsLabel: string };

interface Props {
  homeHref: string;
  tagline: string;
  /** Store buttons under the tagline; the final CTA above already carries the big Chrome button. */
  storesLabel: string;
  stores: Store[];
  socialAria: string;
  socials: Social[];
  /** The community entry leads the last column, ahead of that column's links. */
  columns: Array<{ title: string; links: Link[] }>;
  community: { label: string; panel: CommunityPanel; analyticsLabel: string };
  copyright: string;
  licenseHref: string;
  languages: Array<{ code: string; label: string; href: string; current: boolean }>;
}

const { homeHref, tagline, storesLabel, stores, socialAria, socials, columns, community, copyright, licenseHref, languages } = Astro.props;
// A narrow (centred) tagline may only wrap between Chinese phrases, never inside a word.
const taglinePhrases = tagline.split(/(?<=、)/);
---

<footer class="site-footer">
  <div class="site-footer__art" aria-hidden="true">
    <img src="/assets/footer-seurat-coast.webp" width="2048" height="569" alt="" loading="lazy" decoding="async" />
  </div>
  <div class="site-footer__main">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href={homeHref} aria-label="Lumno">
        <span class="site-footer__icon" aria-hidden="true" set:html={logoIconSvg}></span>
        <img class="site-footer__wordmark" src="/assets/textlogo.svg" width="165" height="43" alt="Lumno" loading="lazy" />
        {/* Light ink for pages in dark mode (/design); hidden otherwise. */}
        <img class="site-footer__wordmark site-footer__wordmark--dark" src="/assets/textlogo-dark.svg" width="165" height="43" alt="" loading="lazy" />
      </a>
      <p>{taglinePhrases.map((phrase) => <span class="site-footer__phrase">{phrase}</span>)}</p>
      <ul class="site-footer__stores" aria-label={storesLabel}>
        {stores.map((store) => (
          <li>
            <a
              href={store.href}
              target="_blank"
              rel="noreferrer noopener"
              data-analytics-event={store.analyticsEvent}
              data-analytics-category="conversion"
              data-analytics-label={store.analyticsLabel}
            >
              <img src={store.logoSrc} width="18" height="18" alt="" loading="lazy" decoding="async" />
              {store.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="site-footer__socials" aria-label={socialAria}>
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={social.label}
              title={social.label}
              data-analytics-event={social.analyticsEvent}
              data-analytics-category="cta"
              data-analytics-label={social.analyticsLabel}
            >
              {social.iconSvg ? (
                <span class="site-footer__social-svg" aria-hidden="true" set:html={social.iconSvg}></span>
              ) : (
                <i class={social.iconClass} aria-hidden="true"></i>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <nav class="site-footer__columns">
      {columns.map((column, columnIndex) => (
        <div>
          <h2>{column.title}</h2>
          <ul>
            {columnIndex === columns.length - 1 && (
              <li>
                <CommunityTrigger
                  panel={community.panel}
                  label={community.label}
                  variant="footer"
                  analyticsLabel={community.analyticsLabel}
                />
              </li>
            )}
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer noopener" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="site-footer__meta">
    <p>
      <span>© {new Date().getFullYear()} {copyright}</span>
      <a href={licenseHref} target="_blank" rel="noreferrer noopener">GPL-3.0</a>
    </p>
    <ul class="site-footer__languages">
      {languages.map((language) => (
        <li>
          <a
            href={language.href}
            hreflang={language.code}
            lang={language.code}
            aria-current={language.current ? "page" : undefined}
          >
            {language.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  /*
   * The painting's sea (below the horizon) is 45% of its 2048x569 height,
   * so 12.5% of the footer width. The footer grows by that much under the
   * copyright row, and the sea sits in that strip rather than behind the text.
   * Phones keep at least 160px of painting so the strip still reads as sea.
   */
  .site-footer {
    --site-footer-art-height: max(calc(100cqw * 569 / 2048), 160px);
    --site-footer-sea-height: calc(var(--site-footer-art-height) * 0.45);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    container-type: inline-size;
    border-top: 1px solid var(--home-card-border);
    background: #fff;
  }

  /* A child, so its 100cqw is the footer's own width. */
  .site-footer::after {
    content: "";
    display: block;
    height: var(--site-footer-sea-height);
  }

  /*
   * A 3.6:1 band (sea and shore) of the extension's built-in "seurat-coast-white"
   * wallpaper, pinned to the footer's bottom: its pale sky lies behind the links
   * under a near-solid white veil, and the veil thins over the sea below them.
   */
  .site-footer__art {
    position: absolute;
    inset: auto 0 0;
    height: var(--site-footer-art-height);
    z-index: -1;
    pointer-events: none;
  }

  .site-footer__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    /*
     * The page reserves a scrollbar gutter (site.css) that always shows the
     * white page background, so the painting fades out at both sides rather
     * than stopping in a hard edge beside the scrollbar.
     */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 72px, #000 calc(100% - 72px), transparent);
    mask-image: linear-gradient(to right, transparent, #000 72px, #000 calc(100% - 72px), transparent);
  }

  .site-footer__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.96) 0%,
      rgba(255, 255, 255, 0.88) 50%,
      rgba(255, 255, 255, 0.55) 60%,
      rgba(255, 255, 255, 0.5) 100%
    );
  }

  .site-footer__main,
  .site-footer__meta {
    width: var(--home-column);
    margin-inline: auto;
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--home-space-16);
    padding: var(--home-space-16) 0 56px;
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .site-footer__icon {
    display: block;
    width: 34px;
    height: 34px;
    overflow: visible;
  }

  .site-footer__icon :global(svg) {
    width: 44px;
    height: 48px;
    display: block;
    transform: translate(-8px, -1px);
    shape-rendering: geometricPrecision;
  }

  .site-footer__logo img {
    width: 82px;
    height: auto;
    display: block;
  }

  .site-footer__brand p {
    max-width: 340px;
    margin: var(--home-space-4) 0 0;
    color: var(--text-sub, #626870);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-footer__phrase {
    display: inline-block;
  }

  /* White store pills, a quieter echo of the final CTA's install button. */
  .site-footer__stores {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: var(--home-space-5);
  }

  .site-footer .site-footer__stores a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px 0 12px;
    border: 1px solid var(--home-hairline-control);
    border-radius: var(--home-radius-pill);
    --lumno-corner-shape: round;
    background: var(--home-card);
    box-shadow: var(--home-shadow-chip);
    color: var(--home-ink, #2f2a22);
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .site-footer .site-footer__stores a:hover {
    border-color: rgba(var(--home-edge), 0.16);
    background: #f8fafc;
    color: var(--home-ink, #2f2a22);
  }

  .site-footer__stores img {
    flex: none;
    width: 18px;
    height: 18px;
  }

  /* Round icon buttons on a faint fill, their edge flush with the tagline and store buttons above. */
  .site-footer__socials {
    display: flex;
    gap: 6px;
    margin: var(--home-space-4) 0 0;
  }

  .site-footer .site-footer__socials a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--home-radius-pill);
    --lumno-corner-shape: round;
    background: rgba(47, 42, 34, 0.04);
    font-size: 18px;
    line-height: 1;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .site-footer__social-svg :global(svg) {
    display: block;
    width: 18px;
    height: 18px;
    shape-rendering: geometricPrecision;
  }

  .site-footer .site-footer__socials a:hover {
    background: rgba(47, 42, 34, 0.08);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(140px, max-content));
    column-gap: clamp(48px, 8vw, 112px);
  }

  h2 {
    margin: 0 0 14px;
    color: var(--home-ink, #2f2a22);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a,
  .site-footer :global(.community-footer-trigger) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-sub, #626870);
    font: inherit;
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    transition: color 160ms ease;
  }

  .site-footer a:hover,
  .site-footer :global(.community-footer-trigger:hover) {
    color: var(--home-ink, #2f2a22);
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--home-space-3) var(--home-space-6);
    padding: var(--home-space-6) 0 var(--home-space-8);
    border-top: 1px solid var(--home-card-border);
    color: var(--text-soft, #89919a);
    font-size: 13px;
  }

  .site-footer__meta p {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
  }

  .site-footer__meta p > * + *::before {
    content: "·";
    margin-inline: 8px;
    color: var(--text-soft, #89919a);
  }

  .site-footer__meta p a {
    font-size: 13px;
  }

  /*
   * The languages share the copyright's row and only wrap (from the right
   * edge) once that row is genuinely too narrow, never at a fixed width.
   * When they drop below the copyright, the auto margin keeps them right-aligned.
   */
  .site-footer__languages {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 16px;
    margin-left: auto;
  }

  .site-footer__languages a {
    font-size: 13px;
    white-space: nowrap;
  }

  .site-footer__languages a[aria-current="page"] {
    color: var(--home-ink, #2f2a22);
    font-weight: 650;
  }

  /*
   * Below the two-column width: with five links, two short headed columns left
   * a lopsided gap, and the languages, pushed right of the copyright, wrapped
   * into a ragged block with one language stranded on its own line. Like
   * product footers with few links (Zen, The Browser Company), everything
   * centres in a single column instead: brand, socials, the links as one
   * wrapping block (headings kept for screen readers only), then languages and
   * copyright on their own lines.
   *
   * The two columns need the store buttons on one row beside the links;
   * French has the longest labels and fits from about 1310px, so every
   * language switches at the same width rather than some wrapping 2 + 1.
   */
  @media (max-width: 1320px) {
    .site-footer__main {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: var(--home-space-8);
      padding: var(--home-space-12) 0 var(--home-space-8);
      text-align: center;
    }

    .site-footer__brand {
      display: grid;
      justify-items: center;
    }

    .site-footer__brand p {
      margin-top: var(--home-space-3);
      text-wrap: balance;
    }

    .site-footer__stores {
      justify-content: center;
    }

    .site-footer__socials {
      justify-content: center;
      gap: 8px;
      margin: var(--home-space-5) 0 0;
    }

    /* One wrapping block of links. */
    .site-footer__columns {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 24px;
    }

    .site-footer__columns > div,
    .site-footer__columns ul {
      display: contents;
    }

    .site-footer__columns h2 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .site-footer__meta {
      flex-direction: column;
      gap: var(--home-space-4);
      padding: var(--home-space-6) 0 calc(var(--home-space-10) + env(safe-area-inset-bottom, 0px));
    }

    .site-footer__meta p {
      justify-content: center;
    }

    /*
     * The languages wrap as one centred block of small pills, the current one
     * filled; the width splits the ten into two even rows.
     */
    .site-footer__languages {
      order: -1;
      justify-content: center;
      margin-left: 0;
      gap: 4px;
      max-width: 480px;
    }

    .site-footer__languages a {
      display: block;
      padding: 5px 10px;
      border-radius: var(--home-radius-pill);
      --lumno-corner-shape: round;
    }

    .site-footer__languages a[aria-current="page"] {
      background: rgba(47, 42, 34, 0.06);
    }
  }

  @media (max-width: 600px) {
    .site-footer__brand p {
      max-width: 300px;
    }

    /* Stacked at one shared width rather than wrapping into two odd lengths. */
    .site-footer__stores {
      display: grid;
      width: min(100%, 260px);
    }

    .site-footer .site-footer__stores a {
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
    }

    .site-footer .site-footer__socials a {
      width: 40px;
      height: 40px;
    }

    /* The width breaks five links into 3 + 2. */
    .site-footer__columns {
      max-width: 290px;
    }

    .site-footer__columns a,
    .site-footer__columns :global(.community-footer-trigger) {
      font-size: 15px;
      line-height: 1.6;
    }

    .site-footer__languages {
      max-width: 340px;
    }
  }

  /*
   * Dark: pages that offer a dark mode (/design) set html[data-design-theme="dark"].
   * The painted sea dims under a dark veil instead of the white one.
   */
  .site-footer__wordmark--dark {
    display: none;
  }

  :global(html[data-design-theme="dark"]) .site-footer {
    --text-sub: #a1a1aa;
    --text-soft: #71717a;
    --home-ink: #f3f4f6;
    --home-card: #1c1d20;
    --home-card-border: rgba(255, 255, 255, 0.08);
    --home-hairline-control: rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.08);
    background: #0e0e10;
  }

  :global(html[data-design-theme="dark"]) .site-footer__wordmark {
    display: none;
  }

  :global(html[data-design-theme="dark"]) .site-footer__wordmark--dark {
    display: block;
  }

  :global(html[data-design-theme="dark"]) .site-footer__art img {
    filter: invert(1) hue-rotate(180deg) brightness(0.6) saturate(0.7);
  }

  :global(html[data-design-theme="dark"]) .site-footer__art::after {
    background: linear-gradient(
      to bottom,
      rgba(14, 14, 16, 0.96) 0%,
      rgba(14, 14, 16, 0.9) 50%,
      rgba(14, 14, 16, 0.62) 60%,
      rgba(14, 14, 16, 0.55) 100%
    );
  }

  :global(html[data-design-theme="dark"]) .site-footer .site-footer__stores a {
    box-shadow: none;
  }

  :global(html[data-design-theme="dark"]) .site-footer .site-footer__stores a:hover {
    border-color: rgba(255, 255, 255, 0.16);
    background: #26272b;
  }

  :global(html[data-design-theme="dark"]) .site-footer .site-footer__socials a {
    background: rgba(255, 255, 255, 0.06);
  }

  :global(html[data-design-theme="dark"]) .site-footer .site-footer__socials a:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  :global(html[data-design-theme="dark"]) .site-footer .site-footer__languages a[aria-current="page"] {
    background: rgba(255, 255, 255, 0.08);
  }
</style>
