---
import type { HOME_CONTENT, HomeUtilityId } from "../../../lib/home-content";
import HomeCellIcon, { type HomeCellIconName } from "../HomeCellIcon.astro";
import UtilityArt from "../UtilityArt.astro";

type Content = (typeof HOME_CONTENT)["en"]["utilities"];

interface Props {
  content: Content;
}

const { content } = Astro.props;

const UTILITY_ORDER: Array<{ id: HomeUtilityId; icon: HomeCellIconName }> = [
  { id: "clip", icon: "screenshot-2-line" },
  { id: "autoPip", icon: "picture-in-picture-2-line" },
  { id: "progress", icon: "play-list-2-line" },
  { id: "sync", icon: "cloud-line" },
  { id: "pinned", icon: "pushpin-line" },
  { id: "languages", icon: "translate-2" },
];
---

<!--
  A section of its own, not a part of the new tab section above it: these
  features have nothing to do with the new tab, so a part head here would
  read as that section's third group. No eyebrow, since there is no single
  trigger to show (eyebrows show how a feature is triggered).
-->
<section class="home-section utilities" aria-labelledby="utilities-title">
  <header class="home-section__head">
    <h2 id="utilities-title" class="home-h2"><span>{content.title}</span></h2>
    <p class="home-lead">{content.description}</p>
  </header>

  <ul class="home-sheet utilities__grid">
    {UTILITY_ORDER.map(({ id, icon }) => (
      <li>
        <HomeCellIcon name={icon} />
        <h3 class="home-cell__title">{content.items[id].title}</h3>
        <p class="home-cell__text">{content.items[id].description}</p>
        <UtilityArt id={id} />
      </li>
    ))}
  </ul>
</section>

<style>
  .utilities__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* Each cell is a container so its hover art (UtilityArt) shows only when
     there is room beside the text: 144px tile + 10px inset, 14px gap. */
  .utilities__grid > li {
    position: relative;
    container: utility / inline-size;
  }

  .utilities__grid :global(.home-cell__icon) {
    margin-bottom: 20px;
  }

  @container utility (min-width: 316px) {
    .home-cell__title,
    .home-cell__text {
      max-width: calc(100% - 136px);
    }
  }

  @media (max-width: 980px) {
    .utilities__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .utilities__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
