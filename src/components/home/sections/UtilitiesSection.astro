---
import type { HOME_CONTENT, HomeUtilityId } from "../../../lib/home-content";
import { getGuidePath, type GuideSlug } from "../../../lib/guides";
import type { SupportedLocale } from "../../../lib/locales";
import HomeCellIcon, { type HomeCellIconName } from "../HomeCellIcon.astro";
import UtilityArt from "../UtilityArt.astro";
import TitlePair from "../TitlePair.astro";

type Content = (typeof HOME_CONTENT)["en"]["utilities"];

interface Props {
  content: Content;
  locale: SupportedLocale;
}

const { content, locale } = Astro.props;

const UTILITY_ORDER: Array<{ id: HomeUtilityId; icon: HomeCellIconName }> = [
  { id: "clip", icon: "screenshot-2-line" },
  { id: "autoPip", icon: "picture-in-picture-2-line" },
  { id: "linkPreview", icon: "eye-line" },
  { id: "tabSwitcher", icon: "arrow-left-right-line" },
  { id: "progress", icon: "play-list-2-line" },
  { id: "sync", icon: "cloud-line" },
  { id: "pinned", icon: "pushpin-line" },
  { id: "languages", icon: "translate-2" },
];

// The help center section that explains each one; the titles link there.
// One with no page yet shows a plain title.
const UTILITY_GUIDES: Partial<Record<HomeUtilityId, { slug: GuideSlug; anchor?: string }>> = {
  linkPreview: { slug: "link-preview" },
  clip: { slug: "web-clip" },
  autoPip: { slug: "auto-pip" },
  tabSwitcher: { slug: "tab-switcher" },
  progress: { slug: "newtab-frequent-sites", anchor: "progress" },
  sync: { slug: "sync", anchor: "webdav" },
  pinned: { slug: "arc-command-bar", anchor: "mapping" },
  languages: { slug: "browser-compatibility", anchor: "languages" },
};
const guideHref = (id: HomeUtilityId) => {
  const guide = UTILITY_GUIDES[id];
  return guide && `${getGuidePath(locale, guide.slug)}${guide.anchor ? `#${guide.anchor}` : ""}`;
};
---

<!--
  A section of its own, not a part of the new tab section above it: these
  features have nothing to do with the new tab, so a part head here would
  read as that section's third group. No eyebrow, since there is no single
  trigger to show (eyebrows show how a feature is triggered).
-->
<section class="home-section utilities" aria-labelledby="utilities-title">
  <header class="home-section__head">
    <h2 id="utilities-title" class="home-h2" data-reveal="text"><TitlePair title={content.title} /></h2>
    <p class="home-lead" data-reveal="text">{content.description}</p>
  </header>

  <ul class="home-sheet utilities__grid" data-reveal>
    {UTILITY_ORDER.map(({ id, icon }) => {
      const href = guideHref(id);
      return (
        <li>
          <HomeCellIcon name={icon} />
          <h3 class="home-cell__title">
            {href ? (
              <a class="utilities__link" href={href}>{content.items[id].title}<i class="ri-arrow-right-s-line" aria-hidden="true"></i></a>
            ) : (
              content.items[id].title
            )}
          </h3>
          <p class="home-cell__text">{content.items[id].description}</p>
          <UtilityArt id={id} />
        </li>
      );
    })}
  </ul>
</section>

<script>
  /*
   * Each cell plays its icon and art once, a moment after it is mostly on
   * screen, then rests on the finished frame like the other homepage demos.
   * Cells that arrive together go a beat apart, in reading order.
   *
   * A cell is one link to its help page (the title's link covers it). The
   * pointer entering it, or keyboard focus reaching it, replays its icon and
   * art together; on phones a tap follows the link, so only a cell with no
   * page replays on a tap. The icon's mark ([data-played]) is on the cell
   * (home.css), the art's on its tile (UtilityArt). A replay first blurs the
   * finished frame away ([data-rewind]) and restarts under the blur, which
   * then clears, so the scene never snaps back.
   */
  const cells = Array.from(document.querySelectorAll<HTMLElement>(".utilities__grid > li"));
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The elements a cell's play marks: the cell itself (its icon) and its art tile.
  const marks = (cell: HTMLElement) =>
    [cell, cell.querySelector<HTMLElement>(".util-art")].filter((element): element is HTMLElement => Boolean(element));

  if (reduceMotion) {
    // No motion: show every art tile on its finished frame.
    cells.forEach((cell) => marks(cell).forEach((element) => (element.dataset.played = "")));
  } else if (cells.length) {
    const DELAY = 200;
    const STAGGER = 260;
    // Matches the [data-rewind] fade-out in home.css and UtilityArt.
    const REWIND = 160;
    // The longest scene; a replay sooner would cut it short.
    const PLAY_LENGTH = 2900;
    const timers = new Map<HTMLElement, number>();
    const playedAt = new Map<HTMLElement, number>();
    const rewinding = new Set<HTMLElement>();
    let nextStart = 0;

    // Dropping the mark for one style pass restarts every animation it drives.
    const play = (cell: HTMLElement) => {
      marks(cell).forEach((element) => {
        delete element.dataset.played;
        void element.offsetWidth;
        element.dataset.played = "";
      });
      playedAt.set(cell, performance.now());
    };

    // A replay before the cell's turn takes the place of its first play.
    const playNow = (cell: HTMLElement) => {
      window.clearTimeout(timers.get(cell));
      timers.delete(cell);
      observer.unobserve(cell);
      play(cell);
    };

    const replay = (cell: HTMLElement) => {
      if (!("played" in cell.dataset)) {
        playNow(cell);
        return;
      }
      if (rewinding.has(cell) || performance.now() - (playedAt.get(cell) ?? -Infinity) < PLAY_LENGTH) return;
      rewinding.add(cell);
      marks(cell).forEach((element) => (element.dataset.rewind = ""));
      window.setTimeout(() => {
        play(cell);
        marks(cell).forEach((element) => delete element.dataset.rewind);
        rewinding.delete(cell);
      }, REWIND);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        [...entries]
          .sort((a, b) => cells.indexOf(a.target as HTMLElement) - cells.indexOf(b.target as HTMLElement))
          .forEach((entry) => {
            const cell = entry.target as HTMLElement;
            if (!entry.isIntersecting) {
              // Scrolled past before it started: wait until it comes back.
              window.clearTimeout(timers.get(cell));
              timers.delete(cell);
              return;
            }
            if (timers.has(cell)) return;
            const now = performance.now();
            const at = Math.max(now + DELAY, nextStart);
            nextStart = at + STAGGER;
            timers.set(
              cell,
              window.setTimeout(() => {
                timers.delete(cell);
                play(cell);
                observer.unobserve(cell);
              }, at - now),
            );
          });
      },
      { threshold: 0.7 },
    );

    cells.forEach((cell) => {
      observer.observe(cell);
      // Not over a first play that is about to start.
      cell.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse" && !timers.has(cell)) replay(cell);
      });
      cell.addEventListener("focusin", (event) => {
        if ((event.target as Element).matches(":focus-visible") && !timers.has(cell)) replay(cell);
      });
      cell.addEventListener("click", (event) => {
        // A mouse already replayed it on the way in; elsewhere a cell with a page follows its link.
        if ((event as PointerEvent).pointerType === "mouse" || cell.querySelector("a")) return;
        replay(cell);
      });
    });
  }
</script>

<style>
  /* Eight cells: four by two where each cell still has room for its art,
     otherwise two by four, so no row is left half empty. */
  .utilities__grid {
    /* White cells, so the patterned art tiles read as panels set into them;
       the sheet keeps its hairline ring and card shadow. */
    --home-paper: var(--home-card);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  /* Each cell is a container so its art (UtilityArt) shows only when there
     is room beside the text: 144px tile + the card inset, then a 16px gap.
     300px keeps it on today's common phones (390px and up). */
  .utilities__grid > li {
    position: relative;
    container: utility / inline-size;
    transition: background-color 200ms ease;
  }

  /* Under the pointer (or keyboard focus) the cell takes a faint grey tint,
     and its art tile (UtilityArt) deepens with it so the two stay apart. */
  @media (hover: hover) {
    .utilities__grid > li:hover {
      background-color: color-mix(in srgb, rgb(var(--home-edge)) 2.5%, var(--home-card));
    }
  }

  .utilities__grid > li:has(.utilities__link:focus-visible) {
    background-color: color-mix(in srgb, rgb(var(--home-edge)) 2.5%, var(--home-card));
  }

  .utilities__link {
    color: inherit;
    text-decoration: none;
  }

  /* The title's link covers the whole cell, so the cell is the link. */
  .utilities__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .utilities__link:focus-visible {
    outline: none;
  }

  .utilities__link:focus-visible::after {
    outline: 2px solid var(--home-select-ink);
    outline-offset: -4px;
    border-radius: var(--home-radius-inner);
  }

  /* A box one line tall, centring the chevron on the line it ends, for CJK and Latin titles alike. */
  .utilities__link i {
    display: inline-flex;
    align-items: center;
    height: 1lh;
    margin-left: 2px;
    color: var(--text-soft, #89919a);
    font-weight: 400;
    vertical-align: top;
    transition: transform 180ms ease, color 180ms ease;
  }

  .utilities__grid > li:hover .utilities__link i,
  .utilities__link:focus-visible i {
    color: inherit;
    transform: translateX(2px);
  }

  .utilities__grid :global(.home-cell__icon) {
    margin-bottom: var(--home-space-5);
  }

  @container utility (min-width: 300px) {
    .home-cell__title,
    .home-cell__text {
      max-width: calc(100% - 136px);
    }
  }

  /* Four across leaves no room beside the text, so each cell's art moves
     below it (UtilityArt), and the text takes the cell's full width. The
     narrower cells take a smaller padding too; the art's inset follows it. */
  @media (min-width: 1280px) {
    .utilities__grid > li {
      --home-card-pad: var(--home-space-6);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .home-cell__title,
    .home-cell__text {
      max-width: none;
    }

    .home-cell__text {
      margin-bottom: var(--home-space-6);
    }
  }

  @media (max-width: 1279px) {
    .utilities__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .utilities__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
