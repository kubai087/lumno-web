---
import type { HOME_CONTENT, HomeUtilityId } from "../../../lib/home-content";
import HomeCellIcon, { type HomeCellIconName } from "../HomeCellIcon.astro";
import UtilityArt from "../UtilityArt.astro";

type Content = (typeof HOME_CONTENT)["en"]["utilities"];

interface Props {
  content: Content;
}

const { content } = Astro.props;

const UTILITY_ORDER: Array<{ id: HomeUtilityId; icon: HomeCellIconName }> = [
  { id: "clip", icon: "screenshot-2-line" },
  { id: "autoPip", icon: "picture-in-picture-2-line" },
  { id: "progress", icon: "play-list-2-line" },
  { id: "sync", icon: "cloud-line" },
  { id: "pinned", icon: "pushpin-line" },
  { id: "languages", icon: "translate-2" },
];
---

<!--
  A section of its own, not a part of the new tab section above it: these
  features have nothing to do with the new tab, so a part head here would
  read as that section's third group. No eyebrow, since there is no single
  trigger to show (eyebrows show how a feature is triggered).
-->
<section class="home-section utilities" aria-labelledby="utilities-title">
  <header class="home-section__head">
    <h2 id="utilities-title" class="home-h2" data-reveal="text"><span>{content.title}</span></h2>
    <p class="home-lead" data-reveal="text">{content.description}</p>
  </header>

  <ul class="home-sheet utilities__grid" data-reveal>
    {UTILITY_ORDER.map(({ id, icon }) => (
      <li>
        <HomeCellIcon name={icon} />
        <h3 class="home-cell__title">{content.items[id].title}</h3>
        <p class="home-cell__text">{content.items[id].description}</p>
        <UtilityArt id={id} />
      </li>
    ))}
  </ul>
</section>

<script>
  /*
   * Phones (home-phone) have no hover to play a cell's icon and art with, so
   * there the grid is marked [data-phone] and each cell plays once, a moment
   * after it is mostly on screen, then rests on the finished frame like the
   * other homepage demos; a tap replays it. Cells that arrive together go a
   * beat apart, in reading order. Desktop keeps the hover. Resizing the
   * window across the phone width switches between the two live.
   */
  import { isPhone, onPhoneChange } from "../../../scripts/home-phone";

  const grid = document.querySelector<HTMLElement>(".utilities__grid");
  const cells = Array.from(document.querySelectorAll<HTMLElement>(".utilities__grid > li"));
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (grid && cells.length) {
    const DELAY = 300;
    const STAGGER = 500;
    const timers = new Map<HTMLElement, number>();
    let nextStart = 0;

    // Dropping the mark for one style pass restarts every animation it drives.
    const play = (cell: HTMLElement) => {
      delete cell.dataset.played;
      void cell.offsetWidth;
      cell.dataset.played = "";
    };

    const observer = new IntersectionObserver(
      (entries) => {
        [...entries]
          .sort((a, b) => cells.indexOf(a.target as HTMLElement) - cells.indexOf(b.target as HTMLElement))
          .forEach((entry) => {
            const cell = entry.target as HTMLElement;
            if (!entry.isIntersecting) {
              // Scrolled past before it started: wait until it comes back.
              window.clearTimeout(timers.get(cell));
              timers.delete(cell);
              return;
            }
            if (timers.has(cell)) return;
            const now = performance.now();
            const at = Math.max(now + DELAY, nextStart);
            nextStart = at + STAGGER;
            timers.set(
              cell,
              window.setTimeout(() => {
                play(cell);
                observer.unobserve(cell);
              }, at - now),
            );
          });
      },
      { threshold: 0.7 },
    );

    const setMode = (phone: boolean) => {
      observer.disconnect();
      timers.forEach((timer) => window.clearTimeout(timer));
      timers.clear();
      if (!phone) {
        // Back to hover: tiles hide until the pointer comes.
        delete grid.dataset.phone;
        cells.forEach((cell) => delete cell.dataset.played);
        return;
      }
      grid.dataset.phone = "";
      // No motion: show every art tile on its finished frame.
      if (reduceMotion) cells.forEach((cell) => (cell.dataset.played = ""));
      else cells.filter((cell) => !("played" in cell.dataset)).forEach((cell) => observer.observe(cell));
    };

    cells.forEach((cell) => {
      cell.addEventListener("click", () => {
        if (!isPhone() || reduceMotion) return;
        // A tap before its turn takes the place of the first play.
        window.clearTimeout(timers.get(cell));
        timers.delete(cell);
        observer.unobserve(cell);
        play(cell);
      });
    });

    setMode(isPhone());
    onPhoneChange(setMode);
  }
</script>

<style>
  .utilities__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* Each cell is a container so its art (UtilityArt) shows only when there
     is room beside the text: 144px tile + the card inset, then a 16px gap.
     300px keeps it on today's common phones (390px and up). */
  .utilities__grid > li {
    position: relative;
    container: utility / inline-size;
  }

  .utilities__grid :global(.home-cell__icon) {
    margin-bottom: var(--home-space-5);
  }

  @container utility (min-width: 300px) {
    .home-cell__title,
    .home-cell__text {
      max-width: calc(100% - 136px);
    }
  }

  @media (max-width: 980px) {
    .utilities__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .utilities__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
