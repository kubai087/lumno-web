---
interface Props {
  feedbackKey: string;
  href: string;
  iconClass: string;
  label: string;
}

const { feedbackKey, href, iconClass, label } = Astro.props;
---

<a
  class="_x_extension_feedback_support_link_2026_unique_"
  data-feedback-support={feedbackKey}
  href={href}
  rel="noreferrer noopener"
  target="_blank"
>
  <i class={`ri-icon ri-size-20 ${iconClass}`} aria-hidden="true"></i>
  <span>{label}</span>
  <i class="ri-icon ri-size-14 ri-external-link-line" aria-hidden="true"></i>
</a>

<style>
  ._x_extension_feedback_support_link_2026_unique_ {
    box-sizing: border-box;
    min-height: 30px;
    padding: 6px 10px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: rgba(107, 114, 128, 0.86);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    font-size: var(--privacy-type-small, 14px);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  ._x_extension_feedback_support_link_2026_unique_ > .ri-external-link-line {
    color: inherit;
  }

  ._x_extension_feedback_support_link_2026_unique_:hover {
    background: rgba(15, 23, 42, 0.045);
    color: #111827;
  }

  ._x_extension_feedback_support_link_2026_unique_:focus-visible {
    outline: 2px solid rgba(59, 130, 246, 0.65);
    outline-offset: 2px;
  }
</style>
