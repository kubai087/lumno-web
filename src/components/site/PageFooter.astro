---
import SiteFooter from "../home/sections/SiteFooter.astro";
import xiaohongshuIconSvg from "../../assets/home-icons/xiaohongshu-line.svg?raw";
import { COMMUNITY_LINKS, getCommunityExternalHref } from "../../lib/community";
import { getHomeContent } from "../../lib/home-content";
import { LOCALE_CONFIG, buildLocalizedPath, type SupportedLocale } from "../../lib/locales";
import { CHROME_STORE_URL, EDGE_STORE_URL, GITHUB_ISSUE_URL, GITHUB_URL, LICENSE_URL } from "../../lib/site-links";

interface Props {
  locale: SupportedLocale;
  /** Localized URL of the current page for each language. */
  routeLanguageMap: Record<string, string>;
  /** Prefix for the store and social analytics labels, e.g. "release" → release_footer_github. */
  analyticsScope?: string;
}

/* The site footer with every page's shared links, copy and language switch. */
const { locale, routeLanguageMap, analyticsScope = "home" } = Astro.props;
const content = getHomeContent(locale);
---

<SiteFooter
  homeHref={buildLocalizedPath(locale, "/")}
  tagline={content.footerTagline}
  storesLabel={content.installLabel}
  stores={[
    {
      label: content.installChromeStoreLabel,
      href: CHROME_STORE_URL,
      logoSrc: "/assets/browser-logos/chrome.webp",
      analyticsEvent: "open_chrome_web_store",
      analyticsLabel: `${analyticsScope}_footer_chrome_install`,
    },
    {
      label: content.installEdgeStoreLabel,
      href: EDGE_STORE_URL,
      logoSrc: "/assets/browser-logos/edge.webp",
      analyticsEvent: "open_edge_addons",
      analyticsLabel: `${analyticsScope}_footer_edge_install`,
    },
  ]}
  socialAria={content.footerSocialAria}
  socials={[
    {
      label: content.footerGithub,
      href: GITHUB_URL,
      iconClass: "ri-github-line",
      analyticsEvent: "open_github_repo",
      analyticsLabel: `${analyticsScope}_footer_github`,
    },
    {
      label: content.navContactX,
      href: COMMUNITY_LINKS.xUrl,
      iconClass: "ri-twitter-x-line",
      analyticsEvent: "open_author_x",
      analyticsLabel: `${analyticsScope}_footer_author_x`,
    },
    {
      label: content.navContactXiaohongshu,
      href: COMMUNITY_LINKS.xiaohongshuUrl,
      iconSvg: xiaohongshuIconSvg,
      analyticsEvent: "open_author_xiaohongshu",
      analyticsLabel: `${analyticsScope}_footer_author_xiaohongshu`,
    },
  ]}
  columns={[
    {
      title: content.footerProduct,
      links: [
        { label: content.footerRelease, href: buildLocalizedPath(locale, "/release/") },
      ],
    },
    {
      title: content.footerSupport,
      links: [
        { label: content.footerReportIssue, href: GITHUB_ISSUE_URL, external: true },
        { label: content.footerPrivacy, href: buildLocalizedPath(locale, "/privacy/") },
      ],
    },
  ]}
  feedback={{
    label: content.footerFeedback,
    ariaLabel: content.heroCommunityAria,
    qrTitle: content.qrcodeTitle,
    qrImageSrc: COMMUNITY_LINKS.wechatQrImagePath,
    qrImageAlt: content.qrcodeImageAlt,
    closeLabel: content.qrcodeCloseAria,
    externalHref: getCommunityExternalHref(locale),
  }}
  copyright={content.footerCopyright}
  licenseHref={LICENSE_URL}
  languages={LOCALE_CONFIG.map((language) => ({
    code: language.code,
    label: language.label,
    href: routeLanguageMap[language.code],
    current: language.code === locale,
  }))}
/>
