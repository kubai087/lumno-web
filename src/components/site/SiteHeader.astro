---
import { getDesignPageContent } from "../../lib/design-content";
import { getGuideContent, getGuidePath } from "../../lib/guides";
import HomeNavGhostLinks from "../navigation/HomeNavGhostLinks";
import InstallMenu from "../navigation/InstallMenu";
import LanguageMenu from "../onboarding/LanguageMenu";
import { COMMUNITY_LINKS } from "../../lib/community";
import { getCommunityPanel } from "../../lib/community-panel";
import { getHomeContent } from "../../lib/home-content";
import { buildLocalizedPath, getLocaleLabel, type SupportedLocale } from "../../lib/locales";
import { CHROME_STORE_URL, EDGE_STORE_URL, FIREFOX_STORE_URL, getSiteStoreVersions } from "../../lib/site-links";

interface Props {
  locale: SupportedLocale;
  /** Localized URL of the current page for each language. */
  routeLanguageMap: Record<string, string>;
  /** Prefix for the brand link's analytics label, e.g. "release" → release_header_brand. */
  analyticsScope?: string;
  /**
   * Selector for the page's opening (the hero's install button, a page title).
   * The bar rests clear at the top and scrolls away with it; once it has left
   * the screen, the bar comes back as the fixed glass pill.
   */
  handoff: string;
  /**
   * Keep the install button in the bar all the time. Pages without a hero
   * install button use this; the homepage hands its own button over instead.
   */
  keepInstall?: boolean;
}

/*
 * The site's top bar, the same on every page: it rests clear at the top and
 * scrolls away with the page's opening, then drops back in as the fixed glass
 * pill once that opening has left the screen (script below).
 *
 * The menus are React components rendered to static HTML and never hydrated,
 * so pages without other islands ship no React: settings-select-runtime.ts
 * drives them and community-panel.ts loads the community panel on first use.
 *
 * State: body.has-nav-install shows the install button and the glass surface;
 * .top-nav[data-nav-surface="hero"] overrides the surface back to the clear,
 * in-flow bar. The homepage toggles has-nav-install, handing its hero button
 * over to the bar; keepInstall pages hold has-nav-install and toggle the
 * surface attribute only.
 */
const { locale, routeLanguageMap, analyticsScope = "home", handoff, keepInstall = false } = Astro.props;
const content = getHomeContent(locale);
const homeHref = buildLocalizedPath(locale, "/");
const releaseHref = buildLocalizedPath(locale, "/release/");
const helpHref = getGuidePath(locale);
const helpLabel = getGuideContent(locale).ui.navLabel;
const designHref = buildLocalizedPath(locale, "/design/");
const designLabel = getDesignPageContent(locale).navLabel;
// The author's profiles: Xiaohongshu first for Chinese readers, X everywhere.
const { community } = content;
const contactItems = [
  ...(community.kind === "group"
    ? [{ value: "author_xiaohongshu", label: community.xiaohongshuLabel, href: COMMUNITY_LINKS.xiaohongshuUrl, iconClass: "ri-book-open-line", analyticsEvent: "open_author_xiaohongshu" }]
    : []),
  { value: "author_x", label: "X", href: COMMUNITY_LINKS.xUrl, iconClass: "ri-twitter-x-line", analyticsEvent: "open_author_x" },
];
const {
  chrome: chromeStoreVersion,
  edge: edgeStoreVersion,
  firefox: firefoxStoreVersion,
} = await getSiteStoreVersions();
---

<header
  class="top-nav"
  data-nav-handoff={handoff}
  data-nav-keep-install={keepInstall ? "" : undefined}
  data-nav-surface={keepInstall ? "hero" : undefined}
>
  <a
    class="top-nav-brand"
    href={homeHref}
    aria-label="Lumno"
    data-analytics-event="select_home_brand"
    data-analytics-category="navigation"
    data-analytics-label={`${analyticsScope}_header_brand`}
  >
    <img src="/assets/lumno-title-figma.svg" width="70" height="17" alt="Lumno" />
  </a>
  <nav class="top-nav-actions" aria-label={content.navigationAria}>
    <HomeNavGhostLinks
      releaseHref={releaseHref}
      releaseLabel={content.navRelease}
      helpHref={helpHref}
      helpLabel={helpLabel}
      designHref={designHref}
      designLabel={designLabel}
      communityLabel={content.community.label}
      communityPanel={getCommunityPanel(locale)}
      contactLabel={content.community.contactLabel}
      contactMenuLabel={content.community.contactMenuAria}
      contactItems={contactItems}
      menuLabel={content.navMoreMenuAria}
    />
    <div class="top-nav-tools">
      <LanguageMenu
        currentLabel={getLocaleLabel(locale)}
        toggleAriaLabel={content.languageSelectAria}
        hrefs={routeLanguageMap}
        iconOnly
      />
      <div class="top-nav-install-slot">
        <InstallMenu
          label={content.installLabel}
          shortLabel={content.installLabelShort}
          ariaLabel={content.installAria}
          chromeUrl={CHROME_STORE_URL}
          edgeUrl={EDGE_STORE_URL}
          firefoxUrl={FIREFOX_STORE_URL}
          chromeLabel={content.installChromeStoreLabel}
          edgeLabel={content.installEdgeStoreLabel}
          firefoxLabel={content.installFirefoxStoreLabel}
          chromeVersion={chromeStoreVersion}
          edgeVersion={edgeStoreVersion}
          firefoxVersion={firefoxStoreVersion}
          chromeRecommendation={content.installChromeRecommendation}
          chromeRecommendationNote={content.installChromeRecommendationNote}
        />
      </div>
    </div>
  </nav>
</header>

<script>
  import "../../scripts/community-panel";
  import { enhanceSettingsSelect } from "../../scripts/settings-select-runtime";

  /*
   * Switching language: remember the section being read and how far into it,
   * so the page in the other language opens at the same spot
   * (LanguageScrollRestore.astro). Capture phase, because the language runtime
   * handles the menu's clicks itself.
   */
  document.addEventListener(
    "click",
    (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest("#language-menu [data-lang-value], .site-footer__languages a[hreflang]");
      if (!link || window.scrollY < 8) return;
      const line = window.scrollY + 96;
      const anchors = [...document.querySelectorAll<HTMLElement>("main section[id], main h2[id], main h3[id]")].filter(
        (element) => /^[a-z][a-z0-9-]*$/.test(element.id),
      );
      const top = (element: HTMLElement) => element.getBoundingClientRect().top + window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      let anchor = "";
      let progress = 0;
      anchors.forEach((element, index) => {
        if (top(element) > line) return;
        const start = top(element);
        const next = anchors[index + 1];
        const end = next ? top(next) : maxScroll + 96;
        anchor = element.id;
        progress = end > start ? Math.min(1, (line - start) / (end - start)) : 0;
      });
      try {
        sessionStorage.setItem(
          "lumno-language-scroll",
          JSON.stringify({ at: Date.now(), anchor, progress, ratio: maxScroll > 0 ? window.scrollY / maxScroll : 0 }),
        );
      } catch (_error) {}
    },
    true,
  );

  document.querySelectorAll<HTMLElement>(".top-nav .lumno-settings-select").forEach(enhanceSettingsSelect);

  /*
   * The community entry only joins the bar once it is the glass pill
   * (body.has-nav-install); until then it stays out of view, focus and the menu.
   */
  const syncPrimaryNavigation = () => {
    const primary = document.body.classList.contains("has-nav-install");
    document.querySelectorAll<HTMLElement>(".top-nav [data-nav-primary-only]").forEach((entry) => {
      if (entry.classList.contains("lumno-settings-select-option")) {
        entry.hidden = !primary;
        return;
      }
      entry.dataset.visible = String(primary);
      entry.setAttribute("aria-hidden", String(!primary));
      entry.querySelectorAll<HTMLElement>("a, button").forEach((control) => {
        if (control instanceof HTMLButtonElement) control.disabled = !primary;
        else control.tabIndex = primary ? 0 : -1;
      });
    });
  };
  syncPrimaryNavigation();
  new MutationObserver(syncPrimaryNavigation).observe(document.body, { attributes: true, attributeFilter: ["class"] });

  /*
   * The bar rests clear at the top and scrolls away with the page's opening
   * (data-nav-handoff); once the opening has left the screen it drops back in
   * as the fixed glass pill, and leaves again when the reader scrolls back.
   */
  const topNav = document.querySelector<HTMLElement>(".top-nav");
  const handoffSelector = topNav?.dataset.navHandoff;
  const handoff = handoffSelector ? document.querySelector<HTMLElement>(handoffSelector) : null;

  if (topNav && handoff) {
    const body = document.body;
    const keepInstall = topNav.hasAttribute("data-nav-keep-install");
    const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let navFrame = 0;
    let navEntryTimeout = 0;
    let navExitTimeout = 0;

    // The homepage hands its install button over; other pages only swap the surface.
    const isSurfaced = () =>
      keepInstall ? !topNav.hasAttribute("data-nav-surface") : body.classList.contains("has-nav-install");
    const settleNav = () => {
      navEntryTimeout = 0;
      body.classList.add("is-nav-install-settled");
    };
    const finishNavExit = () => {
      navExitTimeout = 0;
      topNav.dataset.navSurface = "hero";
      body.classList.remove("is-nav-install-exiting");
      if (keepInstall) {
        body.classList.add("is-nav-install-settled");
      } else {
        body.classList.remove("has-nav-install", "is-nav-install-settled");
      }
    };
    const enterNav = () => {
      topNav.removeAttribute("data-nav-surface");
      body.classList.remove("is-nav-install-exiting", "is-nav-install-settled");
      body.classList.add("has-nav-install");
      if (reduceMotion()) {
        settleNav();
        return;
      }
      navEntryTimeout = window.setTimeout(settleNav, 320);
    };
    const exitNav = () => {
      if (navEntryTimeout) {
        window.clearTimeout(navEntryTimeout);
        navEntryTimeout = 0;
      }
      body.classList.add("is-nav-install-exiting");
      if (reduceMotion()) {
        finishNavExit();
        return;
      }
      navExitTimeout = window.setTimeout(finishNavExit, 120);
    };
    // Set while a same-page link carries the reader back to the top: the pill stays away until then.
    let returningToTop = false;
    const updateNav = () => {
      navFrame = 0;
      if (returningToTop && window.scrollY <= 0) returningToTop = false;
      const shouldSurface = !returningToTop && window.scrollY > 0 && handoff.getBoundingClientRect().bottom <= 0;

      if (shouldSurface) {
        // Coming straight back down: cancel the exit and keep the settled pill without replaying entry.
        if (navExitTimeout) {
          window.clearTimeout(navExitTimeout);
          navExitTimeout = 0;
          body.classList.remove("is-nav-install-exiting");
          body.classList.add("is-nav-install-settled");
          return;
        }
        if (!isSurfaced()) enterNav();
        return;
      }

      if (isSurfaced() && !body.classList.contains("is-nav-install-exiting")) {
        exitNav();
      }
    };
    const scheduleNavUpdate = () => {
      if (navFrame) return;
      navFrame = window.requestAnimationFrame(updateNav);
    };
    updateNav();

    /*
     * A bar link to the page already open (the wordmark on the homepage, the
     * release notes on the release page…) doesn't reload: the pill retracts and
     * the page glides back to its top, starting at most a screen down so a long
     * page still arrives quickly. Touching the page hands control back.
     */
    const samePath = (href: string) => {
      const url = new URL(href, window.location.href);
      const trim = (path: string) => path.replace(/\/$/, "");
      return url.origin === window.location.origin && trim(url.pathname) === trim(window.location.pathname);
    };
    const returnToTop = () => {
      if (window.scrollY <= 0) return;
      returningToTop = true;
      if (isSurfaced() && !body.classList.contains("is-nav-install-exiting")) exitNav();
      if (reduceMotion()) {
        window.scrollTo({ top: 0, behavior: "instant" });
        return;
      }
      if (window.scrollY > window.innerHeight) window.scrollTo({ top: window.innerHeight, behavior: "instant" });
      window.scrollTo({ top: 0, behavior: "smooth" });
    };
    topNav.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href]") : null;
      if (!link || link.target === "_blank" || !samePath(link.href)) return;
      event.preventDefault();
      link.blur();
      returnToTop();
    });
    // Arriving from another help page (GuideShell.astro): retract the bar and glide up as one motion.
    if (document.documentElement.dataset.navArrival === "glide") {
      delete document.documentElement.dataset.navArrival;
      returnToTop();
    }
    for (const type of ["wheel", "touchstart", "keydown"] as const) {
      window.addEventListener(type, () => {
        if (!returningToTop) return;
        returningToTop = false;
        scheduleNavUpdate();
      }, { passive: true });
    }

    window.addEventListener("scroll", scheduleNavUpdate, { passive: true });
    window.addEventListener("resize", scheduleNavUpdate);
    const navResizeObserver = new ResizeObserver(scheduleNavUpdate);
    navResizeObserver.observe(topNav);
    navResizeObserver.observe(handoff);
  }
</script>

<style is:global>
  /*
   * Moving between pages: the new page appears at once (no fade), and only the
   * bar morphs from where it was (the glass pill, or scrolled out of view) to
   * where it rests on the new page, so the switch reads as one motion even
   * from halfway down the old page.
   */
  @view-transition {
    navigation: auto;
  }

  .top-nav {
    view-transition-name: site-nav;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  ::view-transition-group(site-nav) {
    animation-duration: 320ms;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  ::view-transition-old(site-nav),
  ::view-transition-new(site-nav) {
    height: 100%;
    animation-duration: 200ms;
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }

  .top-nav {
    position: absolute;
    top: 18px;
    left: 0;
    right: var(--removed-body-scroll-bar-size, 0px);
    z-index: var(--home-z-nav);
    /* The page column, less the scrollbar a modal hides while it is open. */
    width: min(
      calc(100% - var(--home-gutter) * 2 - var(--removed-body-scroll-bar-size, 0px)),
      var(--home-section-width)
    );
    margin-inline: auto;
    min-height: 58px;
    padding: 6px 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border: 1px solid transparent;
    border-radius: var(--home-radius-pill);
    --lumno-corner-shape: round;
    overflow: clip;
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: blur(0);
    backdrop-filter: blur(0);
    opacity: 1;
    translate: 0 0;
    transform: translateY(0);
    contain: layout;
    transition:
      opacity 480ms ease,
      translate 620ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      backdrop-filter 180ms ease;
  }

  .top-nav:has(.lumno-settings-select[data-open="true"]) {
    overflow: visible;
  }

  body.has-nav-install .top-nav {
    position: fixed;
    top: 6px;
    border-color: rgba(211, 217, 226, 0.78);
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 10px 32px rgba(35, 43, 52, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  /* Also beats body.has-nav-install .top-nav on pages that keep the install button. */
  .top-nav[data-nav-surface="hero"],
  body.has-nav-install .top-nav[data-nav-surface="hero"] {
    position: absolute;
    top: 18px;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    opacity: 1;
    translate: 0 0;
    transform: translateY(0);
    filter: none;
    transition: none;
  }



  body.has-nav-install:not(.is-nav-install-settled) .top-nav {
    animation: top-nav-surface-enter 320ms ease-out both;
  }

  body.has-nav-install.is-nav-install-exiting .top-nav {
    animation: top-nav-surface-exit 120ms cubic-bezier(0.4, 0, 1, 1) both;
  }

  @keyframes top-nav-surface-enter {
    from {
      opacity: 0;
      transform: translateY(-24px);
      filter: blur(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes top-nav-surface-exit {
    from {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }

    to {
      opacity: 0;
      transform: translateY(-28px);
      filter: blur(8px);
    }
  }

  .top-nav-brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    /* The wordmark starts as far in as the install button's label ends on the right. */
    padding: 5px 10px 5px 14px;
    text-decoration: none;
  }

  .top-nav-brand img {
    width: 70px;
    height: 17px;
    display: block;
    object-fit: contain;
  }

  .top-nav-actions {
    --top-nav-action-gap: 8px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    /*
     * The 42px install button sits 8px below the bar's top edge (1px border,
     * 6px padding, 1px centring). The bar's side padding is 8px, so pull the
     * actions 1px right to leave the same 8px on that side.
     */
    margin-right: -1px;
  }

  body:not(.has-nav-install) .top-nav-actions {
    margin-right: 1px;
  }

  .top-nav-tools {
    display: flex;
    align-items: center;
    gap: var(--top-nav-action-gap);
  }

  .top-nav-ghost-links {
    --lumno-panel-text: var(--text-main);
    --lumno-panel-subtext: #68717c;
    --lumno-control-hover-bg: rgba(29, 32, 36, 0.06);
    display: flex;
    position: absolute;
    top: 50%;
    left: 50%;
    /* Centred from the middle, so without this its width would stop at half the bar and squeeze the first link. */
    width: max-content;
    align-items: center;
    gap: 2px;
    transform: translate(-50%, -50%);
  }

  .top-nav-ghost-button {
    min-height: 34px;
    padding: 0 12px;
    color: var(--lumno-panel-subtext);
    font-size: 14px;
    white-space: nowrap;
  }

  .top-nav .lumno-settings-select-option,
  .top-nav-install {
    font-size: 14px;
  }

  .top-nav-more-menu {
    display: none;
  }

  .top-nav-more-dropdown {
    min-width: 168px;
  }

  .top-nav-more-option {
    white-space: nowrap;
  }

  .install-menu {
    z-index: 1;
  }

  .top-nav-install-slot {
    display: grid;
    grid-template-columns: 0fr;
    min-width: 0;
    margin-left: calc(var(--top-nav-action-gap) * -1);
    overflow: clip;
    border-radius: var(--home-radius-pill);
    --lumno-corner-shape: round;
    clip-path: inset(0 round var(--home-radius-pill));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .top-nav-install-slot .install-menu {
    min-width: 0;
  }

  .top-nav-install-slot .top-nav-install {
    white-space: nowrap;
  }

  body.has-nav-install .top-nav-install-slot {
    grid-template-columns: 1fr;
    margin-left: 0;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .top-nav-install-slot:has(.install-menu[data-open="true"]) {
    overflow: visible;
    clip-path: none;
  }

  /*
   * The clip only masks the button while it grows in. Once it has settled,
   * let the primary button's drop shadow show, as it does on the hero.
   */
  body.has-nav-install.is-nav-install-settled:not(.is-nav-install-exiting) .top-nav,
  body.has-nav-install.is-nav-install-settled:not(.is-nav-install-exiting) .top-nav-install-slot {
    overflow: visible;
    clip-path: none;
  }

  .lang-control {
    position: relative;
    z-index: 1;
  }

  .lang-control .lumno-settings-select-menu {
    min-width: 180px;
  }

  /*
   * The glass pill only needs room for what it holds, so it hugs its content
   * instead of spanning the page column. Three columns: the wordmark and the
   * tools sit in two equal outer tracks (each as wide as the wider of the two),
   * so the links stay on the page's centre line, where they were while the bar
   * rested at the top. A narrow window simply caps it at the column.
   */
  @media (min-width: 981px) {
    body.has-nav-install .top-nav:not([data-nav-surface="hero"]) {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      column-gap: 40px;
      width: fit-content;
      max-width: min(
        calc(100% - var(--home-gutter) * 2 - var(--removed-body-scroll-bar-size, 0px)),
        var(--home-section-width)
      );
    }

    body.has-nav-install .top-nav:not([data-nav-surface="hero"]) .top-nav-brand {
      justify-self: start;
    }

    body.has-nav-install .top-nav:not([data-nav-surface="hero"]) .top-nav-actions {
      grid-column: 2 / 4;
      display: grid;
      grid-template-columns: subgrid;
      /* Take the bar's gap; the actions' own 8px would push the links off centre. */
      column-gap: normal;
      align-items: center;
    }

    body.has-nav-install .top-nav:not([data-nav-surface="hero"]) .top-nav-ghost-links {
      position: static;
      grid-column: 1;
      transform: none;
    }

    body.has-nav-install .top-nav:not([data-nav-surface="hero"]) .top-nav-tools {
      grid-column: 2;
      justify-self: end;
    }
  }

  /* Below this the five entries (longest in English) would run into the language and install buttons. */
  @media (min-width: 761px) and (max-width: 980px) {
    body.has-nav-install .top-nav-ghost-links {
      display: none;
    }

    body.has-nav-install .top-nav-more-shell {
      display: block;
      position: relative;
    }

    body.has-nav-install .top-nav-more-menu {
      display: block;
      position: static;
    }
  }

  @media (max-width: 760px) {
    /* Back at the top the bar rests where it first loaded. */
    .top-nav[data-nav-surface="hero"],
    body.has-nav-install .top-nav[data-nav-surface="hero"] {
      top: max(10px, env(safe-area-inset-top));
    }

    .top-nav {
      top: max(10px, env(safe-area-inset-top));
      min-height: 58px;
      padding: 5px;
      gap: 10px;
    }

    /* The bar's gap already separates the wordmark; its own right padding would only crowd the actions. */
    .top-nav-brand {
      padding-left: 17px;
      padding-right: 0;
    }

    .top-nav-brand img {
      width: 64px;
      height: 15px;
    }

    /*
     * The last button keeps the inset it has above and below: 8px beside the
     * install button (42px, its chevron sets the height) and 10px beside the
     * 38px language button while the bar rests clear. The bar's side is 6px
     * (1px border, 5px padding).
     */
    .top-nav-actions {
      --top-nav-action-gap: 6px;
      gap: 6px;
      margin-right: 2px;
    }

    body:not(.has-nav-install) .top-nav-actions {
      margin-right: 4px;
    }

    .top-nav-ghost-links {
      display: none;
    }

    .top-nav-more-menu {
      display: block;
      position: static;
    }

    /*
     * Every header menu opens as the same full-width sheet under the bar:
     * unpositioning the controls anchors their menus to .top-nav itself.
     */
    .top-nav .lang-control,
    .top-nav .lang-select,
    .top-nav .install-menu {
