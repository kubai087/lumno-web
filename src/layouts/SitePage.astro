---
import LocaleNormalizer from "../components/LocaleNormalizer.astro";
import SeoHead from "../components/SeoHead.astro";
import PageFooter from "../components/site/PageFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import "../styles/globals.css";
import "../styles/home.css";
import "../styles/site.css";
import "../styles/locale-fonts.css";
import { buildAlternateLinks, getOpenGraphLocale } from "../lib/seo";
import { getLocaleScript, type SupportedLocale } from "../lib/locales";

type StructuredData = Record<string, unknown>;

interface Props {
  locale: SupportedLocale;
  /** Set on explicit locale routes (/en/…, /ja/…); null on the default route. */
  forcedLocale: SupportedLocale | null;
  /** The page's unlocalized path, e.g. "/privacy/". */
  basePath: string;
  seoPath: string;
  routeLanguageMap: Record<string, string>;
  title: string;
  description: string;
  keywords?: string[];
  type?: string;
  structuredData?: StructuredData[];
  /** Prefix for analytics labels in the shared header. */
  analyticsScope: string;
  /** Selector for the page's opening; the top bar turns to glass once it has scrolled away. */
  navHandoff: string;
}

const {
  locale,
  forcedLocale,
  basePath,
  seoPath,
  routeLanguageMap,
  title,
  description,
  keywords = [],
  type = "website",
  structuredData = [],
  analyticsScope,
  navHandoff,
} = Astro.props;
const alternateLinks = buildAlternateLinks(routeLanguageMap, basePath);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <LocaleNormalizer />
    {
      !forcedLocale && (
        <script is:inline define:vars={{ routeLanguageMap }}>
          (() => {
            // The default route stays stable for first-time visitors and crawlers; a saved
            // language choice moves the visitor to their localized route before anything paints.
            let storedMode = "";
            try {
              storedMode = String(window.localStorage.getItem("_x_extension_language_2024_unique_") || "").trim();
            } catch (_error) {
              // Private browsing or blocked storage keeps the default route.
            }

            if (!storedMode) return;

            const browserLanguage = (Array.isArray(navigator.languages) && navigator.languages[0]) || navigator.language || "en";
            const mode = storedMode.toLowerCase() !== "system" ? storedMode : browserLanguage;
            const targetPath = routeLanguageMap[window.__lumnoNormalizeLocale(mode, "en")];
            if (targetPath && window.location.pathname !== targetPath) {
              window.location.replace(`${targetPath}${window.location.search}${window.location.hash}`);
            }
          })();
        </script>
      )
    }
    <script is:inline>
      // Shortcut keycaps render both spellings; show Ctrl/Shift instead of ⌘/⇧ off Apple platforms.
      const platformHint = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || "";
      document.documentElement.setAttribute("data-platform", /mac|iphone|ipad|ios/i.test(platformHint) ? "mac" : "other");
    </script>
    <SeoHead
      title={title}
      description={description}
      path={seoPath}
      keywords={keywords}
      alternates={alternateLinks}
      locale={getOpenGraphLocale(locale)}
      type={type}
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/assets/remixicon.css" />
    <slot name="head" />
  </head>
  <!-- No hero install button here, so the bar keeps its own from the start (keepInstall). -->
  <body class="has-nav-install is-nav-install-settled" data-locale={locale} data-script={getLocaleScript(locale)}>
    <SiteHeader
      locale={locale}
      routeLanguageMap={routeLanguageMap}
      analyticsScope={analyticsScope}
      handoff={navHandoff}
      keepInstall
    />

    <main class="site-page">
      <slot />
    </main>

    <!-- The homepage footer: crawlable links to every page and language. -->
    <PageFooter locale={locale} routeLanguageMap={routeLanguageMap} analyticsScope={analyticsScope} />

    <script>
      import "../scripts/language-preference";
      import "../scripts/language-runtime";
    </script>
    <script is:inline define:vars={{ pageLocale: locale, routeLanguageMap }}>
      // The head script has already settled the route, so the page's own locale is the
      // language; the runtime only drives the language menu (persist, then navigate).
      function getSystemLocale() {
        return window.__lumnoNormalizeLocale((navigator.languages && navigator.languages[0]) || navigator.language, pageLocale);
      }

      function normalizeLanguageMode(mode) {
        const raw = String(mode || "").trim();
        if (!raw || raw.toLowerCase() === "system") return getSystemLocale();
        return window.__lumnoNormalizeLocale(raw, pageLocale);
      }

      function applyResolvedLanguage(locale) {
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const active = node.getAttribute("data-lang-value") === locale;
          node.setAttribute("aria-checked", active ? "true" : "false");
          node.classList.toggle("is-active", active);
        });
      }

      function setupPageLanguageRuntime() {
        if (!window.__lumnoLanguagePreference || !window.__lumnoLanguageRuntime) return false;
        const languageRuntime = window.__lumnoLanguageRuntime.setupLanguageRuntime({
          forcedLocale: pageLocale,
          getSystemLocale,
          normalizeLanguageMode,
          routeLanguageMap,
          languageStorageKey: "_x_extension_language_2024_unique_",
          applyResolvedLanguage,
        });
        languageRuntime.applyLanguageMode(languageRuntime.getInitialLanguageMode());
        return true;
      }

      if (!setupPageLanguageRuntime()) {
        const retry = () => {
          if (!setupPageLanguageRuntime()) return;
          window.removeEventListener("lumno:language-runtime-ready", retry);
          window.removeEventListener("lumno:language-preference-ready", retry);
        };
        window.addEventListener("lumno:language-runtime-ready", retry);
        window.addEventListener("lumno:language-preference-ready", retry);
      }
    </script>

    <style is:global>
      main.site-page {
        overflow-x: clip;
      }
    </style>
  </body>
</html>
