---
import Page from "../../design/index.astro";
import {
  buildLocalizedPath,
  buildRouteLanguageMap,
  getNonDefaultLocales,
  resolveLocaleFromSegment,
} from "../../../lib/locales";

export function getStaticPaths() {
  return getNonDefaultLocales().map((locale) => ({
    params: {
      locale: buildLocalizedPath(locale, "/").replaceAll("/", "") || locale.toLowerCase(),
    },
  }));
}

const locale = resolveLocaleFromSegment(Astro.params.locale || "");

if (!locale) {
  throw new Error(`Unsupported locale: ${Astro.params.locale}`);
}
---

<Page
  forcedLocale={locale}
  seoPath={buildLocalizedPath(locale, "/design/")}
  routeLanguageMap={buildRouteLanguageMap("/design/")}
/>
