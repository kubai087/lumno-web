---
import GuideArticle from "../../../components/guides/GuideArticle.astro";
import { GUIDE_LOCALES, GUIDE_SLUGS, isGuideLocale, type GuideSlug } from "../../../lib/guides";
import { DEFAULT_LOCALE, buildLocalizedPath, resolveLocaleFromSegment } from "../../../lib/locales";

export function getStaticPaths() {
  return GUIDE_LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).flatMap((locale) =>
    GUIDE_SLUGS.map((slug) => ({
      params: { locale: buildLocalizedPath(locale, "/").replaceAll("/", ""), slug },
    })),
  );
}

const locale = resolveLocaleFromSegment(Astro.params.locale || "");
if (!locale || !isGuideLocale(locale)) {
  throw new Error(`Unsupported guide locale: ${Astro.params.locale}`);
}
const slug = Astro.params.slug as GuideSlug;
---

<GuideArticle locale={locale} slug={slug} />
