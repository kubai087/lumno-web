---
import Page from "../../onboarding/index.astro";
import {
  SUPPORTED_ONBOARDING_LANGUAGES,
  buildLocalizedPath,
  buildScopedRouteLanguageMap,
  getScopedNonDefaultLocales,
  resolveLocaleFromSegment,
} from "../../../lib/locales";

export function getStaticPaths() {
  return getScopedNonDefaultLocales(SUPPORTED_ONBOARDING_LANGUAGES).map((locale) => ({
    params: {
      locale: buildLocalizedPath(locale, "/").replaceAll("/", "") || locale.toLowerCase(),
    },
  }));
}

const locale = resolveLocaleFromSegment(Astro.params.locale || "");

if (!locale || !SUPPORTED_ONBOARDING_LANGUAGES.includes(locale)) {
  throw new Error(`Unsupported locale: ${Astro.params.locale}`);
}
---

<Page
  forcedLocale={locale}
  seoPath={buildLocalizedPath(locale, "/onboarding/")}
  routeLanguageMap={buildScopedRouteLanguageMap("/onboarding/", SUPPORTED_ONBOARDING_LANGUAGES)}
/>
