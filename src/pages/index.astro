---
import SeoHead from "../components/SeoHead.astro";
import ChromeReviewMarquee from "../components/home/ChromeReviewMarquee.astro";
import CommandBarSection from "../components/home/sections/CommandBarSection.astro";
import FaqSection from "../components/home/sections/FaqSection.astro";
import FinalCta from "../components/home/sections/FinalCta.astro";
import OpenSourceSection from "../components/home/sections/OpenSourceSection.astro";
import SiteFooter from "../components/home/sections/SiteFooter.astro";
import NewTabSection from "../components/home/sections/NewTabSection.astro";
import UtilitiesSection from "../components/home/sections/UtilitiesSection.astro";
import { CommunityQrDialog } from "../components/home/CommunityQrDialog";
import { HeroInstallTooltip } from "../components/home/HeroInstallTooltip";
import { AiIntentDemo } from "../components/home/AiIntentDemo";
import { HeroSafariDemo } from "../components/home/HeroSafariDemo";
import LanguageMenu from "../components/onboarding/LanguageMenu";
import HomeNavGhostLinks from "../components/navigation/HomeNavGhostLinks";
import InstallMenu from "../components/navigation/InstallMenu";
import { HeroParallax } from "../components/ui/hero-parallax";
import logoIconSvg from "../assets/onboarding/logo.svg?raw";
import "@fontsource/eb-garamond/600.css";
import "@fontsource/eb-garamond/500-italic.css";
import ebGaramondLatin600 from "@fontsource/eb-garamond/files/eb-garamond-latin-600-normal.woff2?url";
import ebGaramondLatin500Italic from "@fontsource/eb-garamond/files/eb-garamond-latin-500-italic.woff2?url";
import "../styles/globals.css";
import "../styles/home.css";
import { getChromeStoreReviews, selectShowcaseReviews } from "../lib/chrome-store-reviews";
import { COMMUNITY_LINKS } from "../lib/community";
import { getHomeContent } from "../lib/home-content";
import { NEW_TAB_SHORTCUT } from "../lib/shortcut-keys";
import { getLumnoBuiltinSiteSearchProviders } from "../lib/lumno-search-providers";
import { DEFAULT_LOCALE, buildLocalizedPath, buildRouteLanguageMap, type SupportedLocale } from "../lib/locales";
import { getStoreVersions } from "../lib/store-versions";
import {
  CHROME_STORE_URL,
  buildAlternateLinks,
  buildBreadcrumbListSchema,
  buildKeywords,
  buildOrganizationSchema,
  buildSoftwareApplicationSchema,
  buildWebPageSchema,
  buildWebSiteSchema,
  getOpenGraphLocale,
} from "../lib/seo";

interface Props {
  forcedLocale?: SupportedLocale | null;
  seoPath?: string;
  routeLanguageMap?: Record<string, string>;
}

const EDGE_STORE_URL = "https://microsoftedge.microsoft.com/addons/detail/pfbklkaefmfamjpibfiapaiihlddhchc";
const GITHUB_URL = "https://github.com/kubai087/lumno-extension";
const GITHUB_ISSUE_URL = `${GITHUB_URL}/issues/new/choose`;
const GITHUB_PULL_REQUEST_URL = `${GITHUB_URL}/compare`;
// Real renders of the extension's new tab per locale (see NewTabSection.astro).
const FEATURE_PARALLAX_COUNT = 15;
const { chrome: chromeStoreVersion, edge: edgeStoreVersion } = await getStoreVersions({
  chrome:
    import.meta.env.PUBLIC_CHROME_STORE_VERSION ||
    import.meta.env.CHROME_STORE_VERSION,
  edge:
    import.meta.env.PUBLIC_EDGE_STORE_VERSION ||
    import.meta.env.EDGE_STORE_VERSION,
});
const chromeStoreReviews = await getChromeStoreReviews();
const builtinSiteSearchProviders = await getLumnoBuiltinSiteSearchProviders();
const forcedLocale = Astro.props.forcedLocale ?? null;
const seoPath = Astro.props.seoPath || "/";
const routeLanguageMap = Astro.props.routeLanguageMap || buildRouteLanguageMap("/");
const uiLocale = forcedLocale || DEFAULT_LOCALE;
const content = getHomeContent(uiLocale);
// CJK titles break after the full-width comma on narrow screens.
const heroTitleCommaIndex = uiLocale.startsWith("zh") ? content.heroTitle.indexOf("，") : -1;
const heroTitleSeparator = heroTitleCommaIndex >= 0 ? content.heroTitle[heroTitleCommaIndex] : "";
const heroTitleSegments = heroTitleCommaIndex >= 0
  ? [
      content.heroTitle.slice(0, heroTitleCommaIndex),
      content.heroTitle.slice(heroTitleCommaIndex + 1).trimStart(),
    ]
  : [content.heroTitle];
const heroDescriptionLines = content.heroDescription.split("\n");
const homeHref = buildLocalizedPath(uiLocale, "/");
const featuresHref = buildLocalizedPath(uiLocale, "/features/");
const onboardingHref = buildLocalizedPath(uiLocale, "/onboarding/");
const releaseHref = buildLocalizedPath(uiLocale, "/release/");
const privacyHref = buildLocalizedPath(uiLocale, "/privacy/");
const newTabParallaxProducts = Array.from({ length: FEATURE_PARALLAX_COUNT }, (_, index) => ({
  title: content.newTab.screenshotAlt,
  link: featuresHref,
  thumbnail: `/assets/feature-newtab/${uiLocale}/parallax-${String(index + 1).padStart(2, "0")}.webp`,
}));
const showcaseReviews = selectShowcaseReviews(chromeStoreReviews.reviews);
const reviewSummary = content.reviews.summary
  .replace("{rating}", chromeStoreReviews.averageRating.toFixed(1))
  .replace("{count}", String(chromeStoreReviews.ratingCount));
const FOOTER_LANGUAGES = [
  { code: "zh-CN", label: "简体中文" },
  { code: "zh-TW", label: "繁體中文" },
  { code: "en", label: "English" },
] as const;
const alternateLinks = buildAlternateLinks(routeLanguageMap, "/");
const ogLocale = getOpenGraphLocale(uiLocale);
const pageTitleByLocale = {
  "zh-CN": "Lumno｜浏览器命令栏、聚焦搜索与极简新标签页",
  "zh-TW": "Lumno｜瀏覽器命令欄、聚焦搜尋與極簡新分頁",
  en: "Lumno | Focus Search, Browser Command Bar & Minimal New Tab",
};
const pageDescriptionByLocale = {
  "zh-CN":
    "Lumno 是一款开源浏览器命令栏与快捷命令浮层，支持搜索标签页、书签、历史记录和站内内容，并提供极简新标签页，适用于 Chrome、Edge、Dia 等 Chromium 浏览器。",
  "zh-TW":
    "Lumno 是一款開源瀏覽器命令欄與快捷命令浮層，支援搜尋分頁、書籤、瀏覽紀錄與站內內容，並提供極簡新分頁，適用於 Chrome、Edge、Dia 等 Chromium 瀏覽器。",
  en:
    "Lumno is an open-source browser command bar for tabs, bookmarks, history, and site search, plus a minimalist new tab for Chrome, Edge, Dia, and other Chromium browsers.",
};
const pageTitle = pageTitleByLocale[uiLocale];
const pageDescription = pageDescriptionByLocale[uiLocale];
const pageKeywords = buildKeywords([
  "浏览器快捷启动器",
  "Arc 浏览器迁移",
  "Arc 替代",
  "command palette",
  "tab search",
  "bookmark search",
  "history search",
]);
const structuredData = [
  buildOrganizationSchema(),
  buildWebSiteSchema(),
  buildSoftwareApplicationSchema({ description: pageDescription }),
  buildWebPageSchema({
    name: pageTitle,
    description: pageDescription,
    path: seoPath,
    language: uiLocale,
  }),
  buildBreadcrumbListSchema({ items: [{ name: "Lumno", path: seoPath }] }),
];
---

<!doctype html>
<html lang={uiLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      path={seoPath}
      keywords={pageKeywords}
      alternates={alternateLinks}
      locale={ogLocale}
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/assets/remixicon.css" />
    <script is:inline>
      // The hero intro hides the page until the demo hydrates. Gate that on JS so crawlers and
      // no-JS visitors always get visible content, and lift it if hydration never finishes.
      document.documentElement.setAttribute("data-home-intro-js", "");
      // Shortcut keycaps render both spellings; show Ctrl/Shift instead of ⌘/⇧ off Apple platforms.
      const platformHint = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || "";
      document.documentElement.setAttribute("data-platform", /mac|iphone|ipad|ios/i.test(platformHint) ? "mac" : "other");
      const liftStalledHomeIntro = () => {
        // Background tabs legitimately pause the intro; only intervene once the page is visible.
        if (document.visibilityState !== "visible") {
          document.addEventListener("visibilitychange", () => window.setTimeout(liftStalledHomeIntro, 8000), { once: true });
          return;
        }
        if (document.body && document.body.dataset.homeIntro === "pending") {
          document.documentElement.removeAttribute("data-home-intro-js");
        }
      };
      window.setTimeout(liftStalledHomeIntro, 8000);
    </script>
    {content.heroTitleSerif && (
      <>
        <link rel="preload" as="font" type="font/woff2" href={ebGaramondLatin600} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={ebGaramondLatin500Italic} crossorigin />
      </>
    )}
  </head>
  <body data-home-intro="pending" data-locale={uiLocale}>
    <header class="top-nav">
      <a
        class="top-nav-brand"
        href={homeHref}
        aria-label="Lumno"
        data-analytics-event="select_home_brand"
        data-analytics-category="navigation"
        data-analytics-label="home_header_brand"
      >
        <img src="/assets/lumno-title-figma.svg" width="70" height="17" alt="Lumno" />
      </a>
      <nav class="top-nav-actions" aria-label={content.navigationAria}>
        <HomeNavGhostLinks
          releaseHref={releaseHref}
          repositoryHref={GITHUB_URL}
          repositoryIssueHref={GITHUB_ISSUE_URL}
          repositoryPullRequestHref={GITHUB_PULL_REQUEST_URL}
          contactXHref={COMMUNITY_LINKS.xUrl}
          contactXiaohongshuHref={COMMUNITY_LINKS.xiaohongshuUrl}
          releaseLabel={content.navRelease}
          repositoryLabel={content.navRepository}
          repositoryMenuLabel={content.navRepositoryMenuAria}
          repositoryHomeLabel={content.navRepositoryHome}
          repositoryIssueLabel={content.navRepositoryIssue}
          repositoryPullRequestLabel={content.navRepositoryPullRequest}
          communityLabel={content.navCommunity}
          contactLabel={content.navContact}
          contactMenuLabel={content.navContactMenuAria}
          contactXLabel={content.navContactX}
          contactXiaohongshuLabel={content.navContactXiaohongshu}
          menuLabel={content.navMoreMenuAria}
          panelTitle={content.qrcodeTitle}
          qrImageSrc={COMMUNITY_LINKS.wechatQrImagePath}
          qrImageAlt={content.qrcodeImageAlt}
          qrCloseLabel={content.qrcodeCloseAria}
          client:load
        />
        <LanguageMenu
          currentLabel={content.languageLabel}
          toggleAriaLabel={content.languageSelectAria}
          hrefs={routeLanguageMap}
          iconOnly
          client:load
        />
        <div class="top-nav-install-slot">
          <InstallMenu
            label={content.installLabel}
            ariaLabel={content.installAria}
            chromeUrl={CHROME_STORE_URL}
            edgeUrl={EDGE_STORE_URL}
            chromeLabel={content.installChromeStoreLabel}
            edgeLabel={content.installEdgeStoreLabel}
            chromeVersion={chromeStoreVersion}
            edgeVersion={edgeStoreVersion}
            chromeRecommendation={content.installChromeRecommendation}
            client:load
          />
        </div>
      </nav>
    </header>

    <main>
      <section class="hero-section" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1
            id="hero-title"
            class:list={{
              "hero-title-has-break": heroTitleSegments.length > 1,
              "hero-title-serif": Boolean(content.heroTitleSerif),
            }}
            aria-label={content.heroTitle}
          >
            {content.heroTitleSerif ? (
              <>
                <span class="hero-title-line hero-title-serif-lead">
                  <span class="hero-title-segment">{content.heroTitleSerif.lead}</span>
                  <span class="hero-title-app-icon" aria-hidden="true" set:html={logoIconSvg}></span>
                </span>
                <span class="hero-title-line hero-title-serif-accent">
                  <span class="hero-title-segment">{content.heroTitleSerif.accent}</span>
                </span>
              </>
            ) : (
            <span class="hero-title-line">
              {heroTitleSegments.map((segment, index) => (
                <span class="hero-title-segment">
                  {segment}
                  {index === 0 && heroTitleSeparator && (
                    <span class="hero-title-separator">{heroTitleSeparator}</span>
                  )}
                  {index === heroTitleSegments.length - 1 && (
                    <span class="hero-title-app-icon" aria-hidden="true" set:html={logoIconSvg}></span>
                  )}
                </span>
              ))}
            </span>
            )}
          </h1>
          <p class="hero-description">
            {heroDescriptionLines.map((line) => <span class="hero-description-line">{line}</span>)}
          </p>
          <div class="hero-actions">
            <HeroInstallTooltip
              label={content.heroInstallLabel}
              ariaLabel={content.heroInstallAria}
              href={CHROME_STORE_URL}
              tooltipLabel={content.heroBrowserTooltipLabel}
              client:load
            />
            <CommunityQrDialog
              triggerLabel={content.heroCommunityLabel}
              triggerAriaLabel={content.heroCommunityAria}
              title={content.qrcodeTitle}
              qrImageSrc={COMMUNITY_LINKS.wechatQrImagePath}
              qrImageAlt={content.qrcodeImageAlt}
              closeLabel={content.qrcodeCloseAria}
              triggerVariant="hero"
              client:load
            />
          </div>
        </div>
        <div class="hero-demo-slot">
          <HeroSafariDemo
            ariaLabel={content.heroDemoAria}
            builtinSiteSearchProviders={builtinSiteSearchProviders}
            locale={uiLocale}
            client:load
          />
        </div>
      </section>

      <CommandBarSection content={content.commandBar} locale={uiLocale} />

      <section id="ai-intent" class="home-section ai-intent-section" aria-labelledby="ai-intent-title">
        <header class="home-section__head home-section__head--start ai-intent-copy">
          <p class="home-eyebrow"><mark class="home-eyebrow__selection">{content.aiIntent.eyebrow}</mark></p>
          <h2 id="ai-intent-title" class="home-h2"><span>{content.aiIntent.title}</span></h2>
          <p class="home-lead home-lead--lines">{content.aiIntent.description}</p>
        </header>
        <div class="ai-intent-demo-slot">
          <AiIntentDemo locale={uiLocale} client:visible />
        </div>
      </section>

      <section id="new-tab" class="feature-intro" aria-labelledby="new-tab-title">
        <HeroParallax
          products={newTabParallaxProducts}
          eyebrow={content.newTab.eyebrow}
          eyebrowKeys={NEW_TAB_SHORTCUT}
          title={content.newTab.title}
          description={content.newTab.description}
          headingId="new-tab-title"
          client:visible
        />
        <NewTabSection content={content.newTab} locale={uiLocale} />
      </section>

      <UtilitiesSection content={content.utilities} />

      <ChromeReviewMarquee
        title={content.reviews.title}
        summary={reviewSummary}
        storeUrl={chromeStoreReviews.sourceUrl}
        storeLinkLabel={content.reviews.storeLinkLabel}
        ariaLabel={content.reviews.ariaLabel}
        avatarLabel={content.reviews.avatarLabel}
        reviews={showcaseReviews}
      />

      <OpenSourceSection content={content.openSource} githubUrl={GITHUB_URL} privacyHref={privacyHref} />

      <FaqSection title={content.faqTitle} items={content.faqItems} />

      <FinalCta
        title={content.finalTitle}
        description={content.finalDescription}
        chromeLabel={content.heroInstallLabel}
        chromeUrl={CHROME_STORE_URL}
        edgeLabel={content.installEdgeStoreLabel}
        edgeUrl={EDGE_STORE_URL}
        sourceLabel={content.viewSourceLabel}
        sourceAria={content.viewSourceAria}
        githubUrl={GITHUB_URL}
      />
    </main>

    <SiteFooter
      homeHref={homeHref}
      tagline={content.footerTagline}
      columns={[
        {
          title: content.footerProduct,
          links: [
            { label: content.footerFeatures, href: featuresHref },
            { label: content.footerQuickStart, href: onboardingHref },
            { label: content.installChromeStoreLabel, href: CHROME_STORE_URL, external: true },
            { label: content.installEdgeStoreLabel, href: EDGE_STORE_URL, external: true },
          ],
        },
        {
          title: content.footerResources,
          links: [
            { label: content.footerRelease, href: releaseHref },
            { label: content.footerPrivacy, href: privacyHref },
            { label: content.footerGithub, href: GITHUB_URL, external: true },
          ],
        },
        {
          title: content.footerCommunity,
          links: [
            { label: content.navContactX, href: COMMUNITY_LINKS.xUrl, external: true },
            { label: content.navContactXiaohongshu, href: COMMUNITY_LINKS.xiaohongshuUrl, external: true },
          ],
        },
      ]}
      feedback={{
        label: content.footerFeedback,
        ariaLabel: content.heroCommunityAria,
        qrTitle: content.qrcodeTitle,
        qrImageSrc: COMMUNITY_LINKS.wechatQrImagePath,
        qrImageAlt: content.qrcodeImageAlt,
        closeLabel: content.qrcodeCloseAria,
        externalHref: uiLocale === "zh-CN" ? undefined : COMMUNITY_LINKS.discordUrl,
      }}
      copyright={content.footerCopyright}
      languages={FOOTER_LANGUAGES.map((language) => ({
        ...language,
        href: routeLanguageMap[language.code],
        current: language.code === uiLocale,
      }))}
    />

    <script>
      import "../scripts/language-preference";
      import "../scripts/language-runtime";
    </script>
    <script define:vars={{ forcedLocale, routeLanguageMap }}>
      const FORCED_LOCALE = forcedLocale;
      const ROUTE_LANGUAGE_MAP = routeLanguageMap;
      const LANGUAGE_STORAGE_KEY = "_x_extension_language_2024_unique_";

      function normalizeLanguageMode(mode) {
        const normalized = String(mode || "").trim().toLowerCase().replaceAll("_", "-");
        if (normalized === "zh-tw" || normalized === "zh-hk" || normalized === "zh-hant") return "zh-TW";
        if (normalized === "zh" || normalized === "zh-cn" || normalized === "zh-sg" || normalized === "zh-hans") return "zh-CN";
        if (normalized === "en" || normalized.startsWith("en-")) return "en";
        return "zh-CN";
      }

      function getSystemLocale() {
        const browserLanguage = navigator.languages?.[0] || navigator.language || "zh-CN";
        return normalizeLanguageMode(browserLanguage);
      }

      function applyResolvedLanguage(normalizedMode) {
        document.documentElement.lang = normalizedMode;
        document.body.dataset.locale = normalizedMode;
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const active = node.getAttribute("data-lang-value") === normalizedMode;
          node.setAttribute("aria-checked", active ? "true" : "false");
          node.classList.toggle("is-active", active);
        });
      }

      function setupHomeLanguageRuntime() {
        if (!window.__lumnoLanguagePreference || !window.__lumnoLanguageRuntime) return false;
        const storedMode = window.__lumnoLanguagePreference.getStoredLanguageMode(LANGUAGE_STORAGE_KEY);
        // Keep the default canonical page stable for first visits, regardless of
        // browser language. Explicit routes and saved user choices still win.
        const initialForcedLocale = FORCED_LOCALE || (!storedMode ? "zh-CN" : null);
        const languageRuntime = window.__lumnoLanguageRuntime.setupLanguageRuntime({
          forcedLocale: initialForcedLocale,
          getSystemLocale,
          normalizeLanguageMode,
          routeLanguageMap: ROUTE_LANGUAGE_MAP,
          languageStorageKey: LANGUAGE_STORAGE_KEY,
          applyResolvedLanguage,
        });
        languageRuntime.applyLanguageMode(languageRuntime.getInitialLanguageMode());
        return true;
      }

      if (!setupHomeLanguageRuntime()) {
        const retry = () => {
          if (!setupHomeLanguageRuntime()) return;
          window.removeEventListener("lumno:language-runtime-ready", retry);
          window.removeEventListener("lumno:language-preference-ready", retry);
        };
        window.addEventListener("lumno:language-runtime-ready", retry);
        window.addEventListener("lumno:language-preference-ready", retry);
      }

      const topNav = document.querySelector(".top-nav");
      const heroInstallPrimary = document.getElementById("hero-install-primary");
      if (topNav instanceof HTMLElement && heroInstallPrimary instanceof HTMLElement) {
        let navInstallFrame = 0;
        let navInstallEntryTimeout = 0;
        let navInstallExitTimeout = 0;
        const finishNavInstallExit = () => {
          navInstallExitTimeout = 0;
          topNav.dataset.navSurface = "hero";
          document.body.classList.remove(
            "has-nav-install",
            "is-nav-install-exiting",
            "is-nav-install-settled",
          );
        };
        const settleNavInstall = () => {
          navInstallEntryTimeout = 0;
          document.body.classList.add("is-nav-install-settled");
        };
        const enterNavInstall = () => {
          topNav.removeAttribute("data-nav-surface");
          document.body.classList.remove("is-nav-install-exiting", "is-nav-install-settled");
          document.body.classList.add("has-nav-install");
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            settleNavInstall();
            return;
          }
          navInstallEntryTimeout = window.setTimeout(settleNavInstall, 320);
        };
        const exitNavInstall = () => {
          if (navInstallEntryTimeout) {
            window.clearTimeout(navInstallEntryTimeout);
            navInstallEntryTimeout = 0;
          }
          document.body.classList.add("is-nav-install-exiting");
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            finishNavInstallExit();
            return;
          }
          navInstallExitTimeout = window.setTimeout(finishNavInstallExit, 120);
        };
        const updateNavInstall = () => {
          navInstallFrame = 0;
          const heroInstallBottom = heroInstallPrimary.getBoundingClientRect().bottom;
          const shouldShowNavInstall = window.scrollY > 0 && heroInstallBottom <= 0;

          if (shouldShowNavInstall) {
            if (navInstallExitTimeout) {
              window.clearTimeout(navInstallExitTimeout);
              navInstallExitTimeout = 0;
              document.body.classList.remove("is-nav-install-exiting");
              document.body.classList.add("is-nav-install-settled");
              return;
            }
            if (!document.body.classList.contains("has-nav-install")) {
              enterNavInstall();
              return;
            }
            return;
          }

          if (
            document.body.classList.contains("has-nav-install")
            && !document.body.classList.contains("is-nav-install-exiting")
          ) {
            exitNavInstall();
          }
        };
        const scheduleNavInstallUpdate = () => {
          if (navInstallFrame) return;
          navInstallFrame = window.requestAnimationFrame(updateNavInstall);
        };
        updateNavInstall();
        window.addEventListener("scroll", scheduleNavInstallUpdate, { passive: true });
        window.addEventListener("resize", scheduleNavInstallUpdate);
        const navResizeObserver = new ResizeObserver(scheduleNavInstallUpdate);
        navResizeObserver.observe(topNav);
        navResizeObserver.observe(heroInstallPrimary);
      }

    </script>

    <style is:global>
      @font-face {
        font-family: "Open Sans";
        src: url("/assets/OpenSans-VariableFont-wdth-wght.ttf") format("truetype");
        font-style: normal;
        font-weight: 300 800;
        font-display: swap;
      }

      :root {
        --bg: #fafafa;
        --surface: #ffffff;
        --surface-soft: #f4f6f8;
        --surface-blue: #eef6fb;
        --text-main: #15171a;
        --text-sub: #626870;
        --text-soft: #89919a;
        --line: #e2e6e9;
        --line-strong: #d4dade;
        --blue: #4ba7dd;
        --blue-dark: #1e729f;
        --green-soft: #e9f2e8;
        --green-ink: #4d6653;
        --shadow-soft: rgba(45, 54, 62, 0.08);
        --shadow-card: rgba(45, 54, 62, 0.12);
        --content-width: 1360px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        position: relative;
        scroll-behavior: smooth;
        scroll-padding-top: 88px;
        overscroll-behavior-y: none;
        background: var(--bg);
        scrollbar-gutter: stable;
      }

      body {
        margin: 0;
        min-width: 320px;
        color: var(--text-main);
        background-color: var(--bg);
        font-family: "Open Sans", "PingFang SC", "Microsoft JhengHei", "Microsoft YaHei", sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      body[data-scroll-locked] {
        --removed-body-scroll-bar-size: 0px !important;
        margin-right: 0 !important;
      }

      button,
      a {
        font: inherit;
      }

      a {
        color: inherit;
      }

      .top-nav {
        position: absolute;
        top: 18px;
        left: 0;
        right: var(--removed-body-scroll-bar-size, 0px);
        z-index: 50;
        width: min(calc(100% - 48px - var(--removed-body-scroll-bar-size, 0px)), var(--content-width));
        margin-inline: auto;
        min-height: 58px;
        padding: 6px 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        border: 1px solid transparent;
        border-radius: 999px;
        overflow: clip;
        background: transparent;
        box-shadow: none;
        backdrop-filter: blur(0);
        -webkit-backdrop-filter: blur(0);
        opacity: 1;
        translate: 0 0;
        transform: translateY(0);
        contain: layout;
        transition:
          opacity 480ms ease,
          translate 620ms cubic-bezier(0.22, 1, 0.36, 1),
          background-color 180ms ease,
          border-color 180ms ease,
          box-shadow 180ms ease,
          backdrop-filter 180ms ease;
      }

      .top-nav:has(.lumno-settings-select[data-open="true"]) {
        overflow: visible;
      }

      body.has-nav-install .top-nav {
        position: fixed;
        top: 6px;
        border-color: rgba(211, 217, 226, 0.78);
        background: rgba(255, 255, 255, 0.84);
        box-shadow: 0 10px 32px rgba(35, 43, 52, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .top-nav[data-nav-surface="hero"] {
        position: absolute;
        top: 18px;
        border-color: transparent;
        background: transparent;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        opacity: 1;
        translate: 0 0;
        transform: translateY(0);
        filter: none;
        transition: none;
      }

      body.has-nav-install:not(.is-nav-install-settled) .top-nav {
        animation: top-nav-surface-enter 320ms ease-out both;
      }

      body.has-nav-install.is-nav-install-exiting .top-nav {
        animation: top-nav-surface-exit 120ms cubic-bezier(0.4, 0, 1, 1) both;
      }

      @keyframes top-nav-surface-enter {
        from {
          opacity: 0;
          transform: translateY(-24px);
          filter: blur(8px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @keyframes top-nav-surface-exit {
        from {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }

        to {
          opacity: 0;
          transform: translateY(-28px);
          filter: blur(8px);
        }
      }

      .top-nav-brand {
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;
        padding: 5px 10px 5px 22px;
        text-decoration: none;
      }

      .top-nav-brand img {
        width: 70px;
        height: 17px;
        display: block;
        object-fit: contain;
      }

      .top-nav-actions {
        --top-nav-action-gap: 8px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        margin-right: 2.5px;
      }

      body:not(.has-nav-install) .top-nav-actions {
        margin-right: 1px;
      }

      .top-nav-ghost-links {
        --lumno-panel-text: var(--text-main);
        --lumno-panel-subtext: #68717c;
        --lumno-control-hover-bg: rgba(29, 32, 36, 0.06);
