---
const target = "/onboarding/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to onboarding</title>
    <link rel="canonical" href={target} />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
    <style>
      body {
        margin: 0;
        font-family: "Open Sans", "Segoe UI", system-ui, sans-serif;
        min-height: 100vh;
        display: grid;
        place-items: center;
        color: #3c4455;
        background: #fafafa;
      }
      a {
        color: #0c63ff;
      }
    </style>
  </head>
  <body>
    <p>Redirecting to onboarding. <a href={target}>Continue</a></p>
  </body>
</html>
