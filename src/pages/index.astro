      .top-nav-install-slot {
        display: grid;
        grid-template-columns: 0fr;
        min-width: 0;
        margin-left: calc(var(--top-nav-action-gap) * -1);
        overflow: clip;
        border-radius: 999px;
        clip-path: inset(0 round 999px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .top-nav-install-slot .install-menu {
        min-width: 0;
