---
import heroArtPlaceholder from "../assets/hero-art-placeholder.png?inline";
import LocaleNormalizer from "../components/LocaleNormalizer.astro";
import SeoHead from "../components/SeoHead.astro";
import ChromeReviewMarquee from "../components/home/ChromeReviewMarquee.astro";
import CommandBarSection from "../components/home/sections/CommandBarSection.astro";
import FaqSection from "../components/home/sections/FaqSection.astro";
import FinalCta from "../components/home/sections/FinalCta.astro";
import ReleasePopover from "../components/home/ReleasePopover.astro";
import OpenSourceSection from "../components/home/sections/OpenSourceSection.astro";
import NewTabSection from "../components/home/sections/NewTabSection.astro";
import UtilitiesSection from "../components/home/sections/UtilitiesSection.astro";
import PageFooter from "../components/site/PageFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import { CommunityTrigger } from "../components/home/CommunityTrigger";
import { SettingsButton } from "../components/extension-settings/SettingsKit";
import { HeroInstallTooltip } from "../components/home/HeroInstallTooltip";
import { AiIntentDemo } from "../components/home/AiIntentDemo";
import { HeroSafariDemo } from "../components/home/HeroSafariDemo";
import { HeroParallax } from "../components/ui/hero-parallax";
import TitlePair from "../components/home/TitlePair.astro";
import CopyLines from "../components/home/CopyLines.astro";
import logoIconSvg from "../assets/onboarding/logo.svg?raw";
import "@fontsource/eb-garamond/600.css";
import ebGaramondLatin600 from "@fontsource/eb-garamond/files/eb-garamond-latin-600-normal.woff2?url";
import "@fontsource/cormorant-garamond/600-italic.css";
import cormorantGaramondLatin600Italic from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-italic.woff2?url";
import "../styles/globals.css";
import "../styles/home.css";
import "../styles/site.css";
import "../styles/locale-fonts.css";
import { localizeShowcaseReviews } from "../lib/chrome-store-review-translations";
import { getChromeStoreReviews, selectShowcaseReviews } from "../lib/chrome-store-reviews";
import { getCommunityPanel } from "../lib/community-panel";
import githubIcon from "../assets/home-icons/github-line.svg?raw";
import { getHomeContent } from "../lib/home-content";
import { getLumnoBuiltinSiteSearchProviders } from "../lib/lumno-search-providers";
import {
  DEFAULT_LOCALE,
  buildLocalizedPath,
  buildRouteLanguageMap,
  getLocaleScript,
  getScreenshotLocale,
  type SupportedLocale,
} from "../lib/locales";
import { GITHUB_ISSUE_URL, GITHUB_URL, getSiteStoreVersions } from "../lib/site-links";
import {
  CHROME_STORE_URL,
  buildAlternateLinks,
  buildBreadcrumbListSchema,
  buildFAQPageSchema,
  buildKeywords,
  buildOrganizationSchema,
  buildSoftwareApplicationSchema,
  buildWebPageSchema,
  buildWebSiteSchema,
  getOpenGraphLocale,
} from "../lib/seo";

interface Props {
  forcedLocale?: SupportedLocale | null;
  seoPath?: string;
  routeLanguageMap?: Record<string, string>;
}

// Real renders of the extension's new tab per locale (see NewTabSection.astro).
const FEATURE_PARALLAX_COUNT = 15;
const chromeStoreReviews = await getChromeStoreReviews();
const builtinSiteSearchProviders = await getLumnoBuiltinSiteSearchProviders();
const forcedLocale = Astro.props.forcedLocale ?? null;
const seoPath = Astro.props.seoPath || "/";
const routeLanguageMap = Astro.props.routeLanguageMap || buildRouteLanguageMap("/");
const uiLocale = forcedLocale || DEFAULT_LOCALE;
// Firefox wording stays hidden until Firefox Add-ons lists Lumno.
const { firefox: firefoxStoreVersion } = await getSiteStoreVersions();
const firefoxListed = Boolean(firefoxStoreVersion);
const content = getHomeContent(uiLocale, { firefoxListed });
const localeScript = getLocaleScript(uiLocale);
// Chinese pages lead to the WeChat group; every other locale to GitHub and X (lib/community-panel.ts).
const community = content.community;
const communityPanel = getCommunityPanel(uiLocale);
// CJK titles break after their first comma (，、 or Korean ,) on narrow screens.
const heroTitleCommaIndex = localeScript === "cjk" ? content.heroTitle.search(/[，、,]/) : -1;
const heroTitleSeparator = heroTitleCommaIndex >= 0 ? content.heroTitle[heroTitleCommaIndex] : "";
const heroTitleSegments = heroTitleCommaIndex >= 0
  ? [
      content.heroTitle.slice(0, heroTitleCommaIndex),
      content.heroTitle.slice(heroTitleCommaIndex + 1).trimStart(),
    ]
  : [content.heroTitle];
// Accents over the italic line (ó, à, й) climb into the lead's descenders, so those locales get more leading.
const heroSerifAccentHasMarks = Boolean(content.heroTitleSerif && /\p{M}/u.test(content.heroTitleSerif.accent.normalize("NFD")));
const newTabParallaxProducts = Array.from({ length: FEATURE_PARALLAX_COUNT }, (_, index) => ({
  title: content.newTab.screenshotAlt,
  thumbnail: `/assets/feature-newtab/${getScreenshotLocale(uiLocale)}/parallax-${String(index + 1).padStart(2, "0")}.webp`,
}));
const showcaseReviews = localizeShowcaseReviews(selectShowcaseReviews(chromeStoreReviews.reviews), uiLocale);
const alternateLinks = buildAlternateLinks(routeLanguageMap, "/");
const ogLocale = getOpenGraphLocale(uiLocale);
// SEO copy stays separate from the hero copy (AGENTS.md): it targets search intents.
const pageTitleByLocale: Record<SupportedLocale, string> = {
  "zh-CN": "Lumno｜浏览器命令栏、聚焦搜索与极简新标签页",
  "zh-TW": "Lumno｜瀏覽器命令列、聚焦搜尋與極簡新分頁",
  en: "Lumno | Focus Search, Browser Command Bar & Minimal New Tab",
  ja: "Lumno｜ブラウザのコマンドバー・タブ検索・シンプルな新しいタブ",
  ko: "Lumno | 브라우저 커맨드 바, 탭 검색, 미니멀 새 탭",
  de: "Lumno | Befehlsleiste & minimalistischer neuer Tab für Chrome",
  fr: "Lumno | Barre de commande et nouvel onglet minimaliste pour Chrome",
  es: "Lumno | Barra de comandos y nueva pestaña minimalista para Chrome",
  "pt-BR": "Lumno | Barra de comandos e nova aba minimalista para o Chrome",
  ru: "Lumno — командная панель и минималистичная новая вкладка для Chrome",
};
const pageDescriptionByLocale: Record<SupportedLocale, string> = {
  "zh-CN":
    "Lumno 是一款开源浏览器命令栏，一个快捷键即可搜索标签页、书签、历史记录和站内内容，并提供极简新标签页，适用于 Chrome、Edge、Dia 等 Chromium 浏览器。",
  "zh-TW":
    "Lumno 是開源的瀏覽器命令列，一個快捷鍵就能搜尋分頁、書籤、瀏覽紀錄與站內內容，還有極簡新分頁，適用於 Chrome、Edge、Dia 等 Chromium 瀏覽器。",
  en:
    "Lumno is an open-source browser command bar for tabs, bookmarks, history, and site search, plus a minimalist new tab for Chrome, Edge, Dia, and other Chromium browsers.",
  ja:
    "Lumno はオープンソースのブラウザ拡張機能。どのページからでもコマンドバーを開き、タブ・ブックマーク・履歴・サイト内をまとめて検索できます。シンプルな新しいタブ付きで、Chrome、Edge、Dia などに対応。",
  ko:
    "Lumno는 오픈 소스 브라우저 커맨드 바입니다. 단축키 하나로 탭, 북마크, 방문 기록, 사이트 내 검색을 한곳에서 하고, 미니멀한 새 탭도 함께 씁니다. Chrome, Edge, Dia 등 Chromium 브라우저 지원.",
  de:
    "Lumno ist eine Open-Source-Befehlsleiste für den Browser: Tabs, Lesezeichen, Verlauf und Websites mit einem Kürzel durchsuchen – dazu ein minimalistischer neuer Tab für Chrome, Edge und Dia.",
  fr:
    "Lumno est une barre de commande open source pour votre navigateur\u00A0: onglets, favoris, historique et sites en un seul raccourci, avec un nouvel onglet minimaliste pour Chrome, Edge et Dia.",
  es:
    "Lumno es una barra de comandos de código abierto para tu navegador: busca pestañas, marcadores, historial y sitios con un solo atajo, y estrena una nueva pestaña minimalista en Chrome, Edge y Dia.",
  "pt-BR":
    "Lumno é uma barra de comandos de código aberto para o seu navegador: pesquise abas, favoritos, histórico e sites com um só atalho, além de uma nova aba minimalista para Chrome, Edge e Dia.",
  ru:
    "Lumno — командная панель с открытым исходным кодом: ищите по вкладкам, закладкам, истории и сайтам одним сочетанием клавиш. А ещё — минималистичная новая вкладка для Chrome, Edge и Dia.",
};
// The same descriptions, naming Firefox once Firefox Add-ons lists Lumno.
const pageDescriptionWithFirefoxByLocale: Record<SupportedLocale, string> = {
  "zh-CN":
    "Lumno 是一款开源浏览器命令栏，一个快捷键即可搜索标签页、书签、历史记录和站内内容，并提供极简新标签页，适用于 Chrome、Edge、Dia 等 Chromium 浏览器和 Firefox。",
  "zh-TW":
    "Lumno 是開源的瀏覽器命令列，一個快捷鍵就能搜尋分頁、書籤、瀏覽紀錄與站內內容，還有極簡新分頁，適用於 Chrome、Edge、Dia 等 Chromium 瀏覽器與 Firefox。",
  en:
    "Lumno is an open-source browser command bar for tabs, bookmarks, history, and site search, plus a minimalist new tab for Chrome, Edge, Dia, other Chromium browsers, and Firefox.",
  ja:
    "Lumno はオープンソースのブラウザ拡張機能。どのページからでもコマンドバーを開き、タブ・ブックマーク・履歴・サイト内をまとめて検索できます。シンプルな新しいタブ付きで、Chrome、Edge、Dia、Firefox などに対応。",
  ko:
    "Lumno는 오픈 소스 브라우저 커맨드 바입니다. 단축키 하나로 탭, 북마크, 방문 기록, 사이트 내 검색을 한곳에서 하고, 미니멀한 새 탭도 함께 씁니다. Chrome, Edge, Dia 등 Chromium 브라우저와 Firefox 지원.",
  de:
    "Lumno ist eine Open-Source-Befehlsleiste für den Browser: Tabs, Lesezeichen, Verlauf und Websites mit einem Kürzel durchsuchen – dazu ein minimalistischer neuer Tab für Chrome, Edge, Dia und Firefox.",
  fr:
    "Lumno est une barre de commande open source pour votre navigateur\u00A0: onglets, favoris, historique et sites en un seul raccourci, avec un nouvel onglet minimaliste pour Chrome, Edge, Dia et Firefox.",
  es:
    "Lumno es una barra de comandos de código abierto para tu navegador: busca pestañas, marcadores, historial y sitios con un solo atajo, y estrena una nueva pestaña minimalista en Chrome, Edge, Dia y Firefox.",
  "pt-BR":
    "Lumno é uma barra de comandos de código aberto para o seu navegador: pesquise abas, favoritos, histórico e sites com um só atalho, além de uma nova aba minimalista para Chrome, Edge, Dia e Firefox.",
  ru:
    "Lumno — командная панель с открытым исходным кодом: ищите по вкладкам, закладкам, истории и сайтам одним сочетанием клавиш. А ещё — минималистичная новая вкладка для Chrome, Edge, Dia и Firefox.",
};
const pageTitle = pageTitleByLocale[uiLocale];
const pageDescription = (firefoxListed ? pageDescriptionWithFirefoxByLocale : pageDescriptionByLocale)[uiLocale];
const pageKeywords = buildKeywords(
  ["浏览器快捷启动器", "Arc 浏览器迁移", "Arc 替代", "command palette", "tab search", "bookmark search", "history search"],
  uiLocale,
);
const structuredData = [
  buildOrganizationSchema(),
  buildWebSiteSchema(),
  buildSoftwareApplicationSchema({
    description: pageDescription,
    rating: { value: chromeStoreReviews.averageRating, count: chromeStoreReviews.ratingCount },
    firefoxListed,
  }),
  buildWebPageSchema({
    name: pageTitle,
    description: pageDescription,
    path: seoPath,
    language: uiLocale,
  }),
  buildBreadcrumbListSchema({ items: [{ name: "Lumno", path: seoPath }] }),
  // Mirrors the visible FAQ section; inline code marks are dropped from the plain-text answers.
  buildFAQPageSchema({
    items: content.faqItems.map((item) => ({ question: item.question, answer: item.answer.replaceAll("`", "") })),
    language: uiLocale,
  }),
];
import LanguageScrollRestore from "../components/LanguageScrollRestore.astro";
---

<!doctype html>
<html lang={uiLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <LocaleNormalizer />
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      path={seoPath}
      keywords={pageKeywords}
      alternates={alternateLinks}
      locale={ogLocale}
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/assets/remixicon.css" />
    <script is:inline>
      // The hero intro hides the page until the demo hydrates. Gate that on JS so crawlers and
      // no-JS visitors always get visible content, and lift it if hydration never finishes.
      // The intro greets a visit, not a page view: it plays when the homepage hasn't been seen
      // for a while, and a refresh or quick return within that window (any language) renders
      // straight into the settled page. Every view restarts the window; ?intro forces a replay.
      const HOME_INTRO_SEEN_KEY = "lumno:home-intro-seen-at";
      const HOME_INTRO_QUIET_MS = 30 * 60 * 1000;
      let playHomeIntro = true;
      try {
        const seenAt = Number(localStorage.getItem(HOME_INTRO_SEEN_KEY)) || 0;
        const forced = new URLSearchParams(location.search).has("intro");
        playHomeIntro = forced || Date.now() - seenAt > HOME_INTRO_QUIET_MS;
        localStorage.setItem(HOME_INTRO_SEEN_KEY, String(Date.now()));
        localStorage.removeItem("lumno:home-intro-played-at");
      } catch {}
      document.documentElement.setAttribute(playHomeIntro ? "data-home-intro-js" : "data-home-intro-skip", "");
      // Shortcut keycaps render both spellings; show Ctrl/Shift instead of ⌘/⇧ off Apple platforms.
      const platformHint = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || "";
      document.documentElement.setAttribute("data-platform", /mac|iphone|ipad|ios/i.test(platformHint) ? "mac" : "other");
      const liftStalledHomeIntro = () => {
        // Background tabs legitimately pause the intro; only intervene once the page is visible.
        if (document.visibilityState !== "visible") {
          document.addEventListener("visibilitychange", () => window.setTimeout(liftStalledHomeIntro, 8000), { once: true });
          return;
        }
        // Only a demo that never hydrated is stalled; a playing one finishes on its own timers.
        if (
          document.body
          && document.body.dataset.homeIntro === "pending"
          && !document.querySelector(".hero-safari-demo[data-intro-ready]")
        ) {
          // Settle into the page as a skipped intro would, so the hero card shows from the server HTML.
          document.documentElement.removeAttribute("data-home-intro-js");
          document.documentElement.setAttribute("data-home-intro-skip", "");
        }
      };
      window.setTimeout(liftStalledHomeIntro, 8000);
    </script>
    {/* The hero painting is the intro's whole first frame: fetch it first, ahead of the demo's JS. */}
    <link rel="preload" as="image" href="/assets/settings-bg-light-monet-newtab.webp" type="image/webp" fetchpriority="high" />
    {/* Its 32px stand-in paints the intro's first frame with the CSS (hero-safari-demo.css). Inline style: Vite's url() rewriting chokes on long data URIs. */}
    <style is:inline set:html={`:root{--hero-art-placeholder:url("${heroArtPlaceholder}")}`} />
    {content.heroTitleSerif && (
      <>
        <link rel="preload" as="font" type="font/woff2" href={ebGaramondLatin600} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={cormorantGaramondLatin600Italic} crossorigin />
      </>
    )}
  </head>
  <body data-home-intro="pending" data-locale={uiLocale} data-script={localeScript}>
    <SiteHeader locale={uiLocale} routeLanguageMap={routeLanguageMap} handoff="#hero-install-primary" />

    <main>
      <section class="hero-section" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1
            id="hero-title"
            class:list={{
              "hero-title-has-break": heroTitleSegments.length > 1,
              "hero-title-serif": Boolean(content.heroTitleSerif),
              "hero-title-serif-marked": heroSerifAccentHasMarks,
            }}
            aria-label={content.heroTitle}
          >
            {content.heroTitleSerif ? (
              <>
                <span class="hero-title-line hero-title-serif-lead">
                  <span class="hero-title-segment">{content.heroTitleSerif.lead}</span>
                </span>
                <span class="hero-title-line hero-title-serif-accent">
                  <span class="hero-title-segment">{content.heroTitleSerif.accent}</span>
                  <span class="hero-title-app-icon" aria-hidden="true" set:html={logoIconSvg}></span>
                </span>
              </>
            ) : (
            <span class="hero-title-line">
              {heroTitleSegments.map((segment, index) => (
                <span class="hero-title-segment">
                  {segment}
                  {index === 0 && heroTitleSeparator && (
                    <span class="hero-title-separator">{heroTitleSeparator}</span>
                  )}
                  {index === heroTitleSegments.length - 1 && (
                    <span class="hero-title-app-icon" aria-hidden="true" set:html={logoIconSvg}></span>
                  )}
                </span>
              ))}
            </span>
            )}
          </h1>
          <p class="hero-description">
            <CopyLines text={content.heroDescription} />
          </p>
          <div class="hero-actions">
            <HeroInstallTooltip
              label={content.heroInstallLabel}
              ariaLabel={content.heroInstallAria}
              href={CHROME_STORE_URL}
              tooltipLabel={content.heroBrowserTooltipLabel}
              showFirefox={firefoxListed}
              client:idle
            />
            {community.kind === "group" ? (
              <CommunityTrigger
                panel={communityPanel}
                label={community.cta}
                ariaLabel={community.ctaAria}
                variant="hero"
                analyticsLabel="home_hero_community"
              />
            ) : (
              <SettingsButton
                as="a"
                variant="secondary"
                className="hero-actions-button hero-community-button"
                iconSvg={githubIcon}
                href={GITHUB_URL}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={community.heroAria}
                data-analytics-event="open_github_repo"
                data-analytics-category="cta"
                data-analytics-label="home_hero_github"
              >
                {community.heroLabel}
              </SettingsButton>
            )}
          </div>
        </div>
        <div class="hero-demo-slot">
          <HeroSafariDemo
            ariaLabel={content.heroDemoAria}
            builtinSiteSearchProviders={builtinSiteSearchProviders}
            locale={uiLocale}
            client:load
          />
        </div>
      </section>
      <script is:inline>
        // Size the intro artwork before first paint, exactly as HeroSafariDemo's
        // syncHomeIntroTargetGeometry does: the viewport, stretched to the demo
        // card's far edges. The server-rendered painting then keeps its crop when
        // React takes over (hero-safari-demo.css, "Before the demo hydrates").
        (() => {
          const slot = document.querySelector(".hero-demo-slot");
          const visual = slot && slot.querySelector(".hero-safari-visual");
          if (!visual || !document.documentElement.hasAttribute("data-home-intro-js")) return;
          const sizeArt = () => {
            const demo = visual.closest(".hero-safari-demo");
            if (!demo || demo.dataset.introReady || demo.dataset.homeIntro !== "pending") return;
            const rect = slot.getBoundingClientRect();
            visual.style.setProperty("--hero-intro-art-width", `${Math.max(innerWidth, rect.right).toFixed(2)}px`);
            visual.style.setProperty("--hero-intro-art-height", `${Math.max(innerHeight, rect.bottom).toFixed(2)}px`);
          };
          sizeArt();
          if (document.fonts) document.fonts.ready.then(sizeArt);
          addEventListener("resize", sizeArt);
        })();
      </script>

      <CommandBarSection content={content.commandBar} locale={uiLocale} />

      <section id="ai-intent" class="home-section ai-intent-section" aria-labelledby="ai-intent-title">
        <header class="home-section__head home-section__head--start ai-intent-copy">
          <h2 id="ai-intent-title" class="home-h2" data-reveal="text"><TitlePair title={content.aiIntent.title} /></h2>
          <p class="home-lead" data-reveal="text"><CopyLines text={content.aiIntent.description} /></p>
        </header>
        <div class="ai-intent-demo-slot" data-reveal>
          <AiIntentDemo locale={uiLocale} client:visible />
        </div>
      </section>

      <section id="new-tab" class="feature-intro" aria-labelledby="new-tab-title">
        <HeroParallax
          products={newTabParallaxProducts}
          eyebrow={content.newTab.eyebrow}
          title={content.newTab.title}
          description={content.newTab.description}
          headingId="new-tab-title"
          openLabel={content.newTab.screenshotOpenLabel}
          closeLabel={content.newTab.screenshotCloseLabel}
          client:visible={{ rootMargin: "100% 0px" }}
        />
        <NewTabSection content={content.newTab} locale={uiLocale} />
      </section>

      <UtilitiesSection content={content.utilities} />

      <ChromeReviewMarquee
        eyebrow={content.reviews.eyebrow}
        rating={chromeStoreReviews.averageRating.toFixed(1)}
        title={content.reviews.title}
        storeUrl={chromeStoreReviews.sourceUrl}
        storeLinkLabel={content.reviews.storeLinkLabel}
        press={content.reviews.press}
        ariaLabel={content.reviews.ariaLabel}
        avatarLabel={content.reviews.avatarLabel}
        quotes={content.reviews.quotes}
        reviews={showcaseReviews}
      />

      <OpenSourceSection content={content.openSource} githubUrl={GITHUB_URL} />

      <FaqSection
        title={content.faqTitle}
        askLabel={content.faqAskLabel}
        askHref={GITHUB_ISSUE_URL}
        group={community.kind === "group"
          ? { label: community.askLabel, ariaLabel: community.askAria, panel: communityPanel }
          : undefined}
        items={content.faqItems}
      />

      <FinalCta
        title={content.heroTitleSerif ? `${content.heroTitleSerif.lead}\n${content.heroTitleSerif.accent}` : content.heroTitle}
        description={content.finalDescription}>
        <HeroInstallTooltip
          id="final-install-primary"
          analyticsLabel="home_final_install"
          label={content.heroInstallLabel}
          ariaLabel={content.heroInstallAria}
          href={CHROME_STORE_URL}
          tooltipLabel={content.heroBrowserTooltipLabel}
          showFirefox={firefoxListed}
          client:visible
        />
      </FinalCta>
    </main>

    <PageFooter locale={uiLocale} routeLanguageMap={routeLanguageMap} />
    <LanguageScrollRestore />

    <ReleasePopover locale={uiLocale} />

    <script>
      import "../scripts/language-preference";
      import "../scripts/language-runtime";
      import "../scripts/home-reveal";
    </script>
    <script define:vars={{ forcedLocale, routeLanguageMap }}>
      const FORCED_LOCALE = forcedLocale;
      const ROUTE_LANGUAGE_MAP = routeLanguageMap;
      const LANGUAGE_STORAGE_KEY = "_x_extension_language_2024_unique_";

      function getSystemLocale() {
        return window.__lumnoNormalizeLocale(navigator.languages?.[0] || navigator.language, "en");
      }

      function normalizeLanguageMode(mode) {
        const raw = String(mode || "").trim();
        if (!raw || raw.toLowerCase() === "system") return getSystemLocale();
        return window.__lumnoNormalizeLocale(raw, "en");
      }

      function applyResolvedLanguage(normalizedMode) {
        document.documentElement.lang = normalizedMode;
        document.body.dataset.locale = normalizedMode;
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const active = node.getAttribute("data-lang-value") === normalizedMode;
          node.setAttribute("aria-checked", active ? "true" : "false");
          node.classList.toggle("is-active", active);
        });
      }

      function setupHomeLanguageRuntime() {
        if (!window.__lumnoLanguagePreference || !window.__lumnoLanguageRuntime) return false;
        const storedMode = window.__lumnoLanguagePreference.getStoredLanguageMode(LANGUAGE_STORAGE_KEY);
        // Keep the default canonical page stable for first visits, regardless of
        // browser language. Explicit routes and saved user choices still win.
        const initialForcedLocale = FORCED_LOCALE || (!storedMode ? "zh-CN" : null);
        const languageRuntime = window.__lumnoLanguageRuntime.setupLanguageRuntime({
          forcedLocale: initialForcedLocale,
          getSystemLocale,
          normalizeLanguageMode,
          routeLanguageMap: ROUTE_LANGUAGE_MAP,
          languageStorageKey: LANGUAGE_STORAGE_KEY,
          applyResolvedLanguage,
        });
        languageRuntime.applyLanguageMode(languageRuntime.getInitialLanguageMode());
        return true;
      }

      if (!setupHomeLanguageRuntime()) {
        const retry = () => {
          if (!setupHomeLanguageRuntime()) return;
          window.removeEventListener("lumno:language-runtime-ready", retry);
          window.removeEventListener("lumno:language-preference-ready", retry);
        };
        window.addEventListener("lumno:language-runtime-ready", retry);
        window.addEventListener("lumno:language-preference-ready", retry);
      }
    </script>

    <style is:global>
      main {
        /* clip (not hidden) keeps position: sticky working inside sections. */
        overflow-x: clip;
      }

      .hero-section {
        position: relative;
        width: var(--home-column);
        margin-inline: auto;
        /*
         * svh, not dvh: on phones the hero is often shorter than the screen, so
         * this sets its height, and dvh tracks Safari's toolbar as it collapses
         * and expands mid-scroll. Everything below then shifted by the toolbar's
         * height, and Safari has no scroll anchoring to hide the jump.
         */
        min-height: 100svh;
        padding: 120px 0 80px;
        display: grid;
        grid-template-columns: 1fr;
        /* Only kicks in when the demo is width-capped (portrait screens). */
        align-content: center;
        justify-items: center;
        isolation: isolate;
        /* Lets the demo slot cap its height by the section width (cqw). */
        container-type: inline-size;
      }

      .hero-copy {
        position: relative;
        z-index: var(--home-z-content);
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        text-align: center;
      }

      .hero-copy > * {
        transition:
          opacity 600ms ease-out,
          translate 680ms cubic-bezier(0.22, 1, 0.36, 1),
          filter 680ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .hero-copy h1 {
        margin: 0 auto;
        max-width: 760px;
        font-size: clamp(36px, 3.6vw, 48px);
        line-height: 1.2;
        letter-spacing: -0.045em;
        font-weight: 620;
      }

      .hero-title-line {
        display: block;
        padding-block: 0.1em;
        font-weight: 620;
      }

      .hero-title-segment {
        background: linear-gradient(180deg, #3a342b 0%, #5a5247 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
      }

      .hero-title-has-break .hero-title-line {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
      }

      .hero-title-has-break .hero-title-segment {
        display: inline-block;
        white-space: nowrap;
      }

      .hero-title-app-icon {
        --hero-icon-box: clamp(40px, 3.5vw, 48px);
        position: relative;
        display: inline-block;
        width: var(--hero-icon-box);
        height: var(--hero-icon-box);
        margin-left: clamp(12px, 1.6vw, 20px);
        vertical-align: -0.11em;
        overflow: visible;
        transform: rotate(4deg);
        transform-origin: 24% 77%;
      }

      /*
       * Editorial slogan for alphabetic languages (Figma P1): EB Garamond roman
       * lead + Cormorant Garamond italic gradient accent. On wide screens it
       * reads on one line, closed by the app icon as the Chinese title is; it
       * wraps into two lines where it can't fit (phones, the longer French).
       * The title may run wider than the copy column below it.
       */
      .hero-copy h1.hero-title-serif {
        --hero-serif-width: min(1080px, calc(100vw - var(--home-gutter) * 2));
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: baseline;
        column-gap: 0.26em;
        width: var(--hero-serif-width);
        max-width: none;
        margin-inline: calc((100% - var(--hero-serif-width)) / 2);
        font-family: "EB Garamond", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
        font-size: clamp(44px, 4.4vw, 62px);
        line-height: 1.02;
        letter-spacing: -0.05em;
      }

      .hero-title-serif .hero-title-line {
        display: inline-block;
        padding-block: 0;
        white-space: nowrap;
      }

      .hero-title-serif-lead {
        font-weight: 600;
      }

      /*
       * The -5% tracking pulls the clipped gradient box in past the last glyph
       * (the comma); pad the box out and cancel it with negative margins.
       */
      .hero-title-serif .hero-title-segment {
        padding: 0.1em 0.12em 0.2em 0.04em;
        margin-inline: -0.04em -0.12em;
      }

      /*
       * Cormorant's small x-height needs a larger size to balance the roman lead.
       * The slight pull-up still leaves the italic ascenders ("d") clear of the
       * lead's comma tail and descenders ("y", "g").
       */
      .hero-title-serif-accent {
        margin-top: -0.02em;
        font-family: "Cormorant Garamond", "EB Garamond", "Iowan Old Style", Georgia, serif;
        font-size: 1.2em;
        font-style: italic;
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.02em;
      }

      .hero-title-serif-marked .hero-title-serif-accent {
        margin-top: 0.1em;
      }

      .hero-title-serif-accent .hero-title-segment {
        /*
         * Italic overhang and tall ascenders: grow the clipped gradient box so
         * the leaning "d" isn't cut; the negative margin keeps the line centred.
         */
        padding: 0.2em 0.2em 0.1em 0.04em;
        margin-right: -0.08em;
        background-image: linear-gradient(180deg, #4f4839 0%, #8a7f68 60%, #b2a68d 100%);
      }

      .hero-title-app-icon svg {
        position: absolute;
        width: calc(var(--hero-icon-box) * 63 / 48);
        height: calc(var(--hero-icon-box) * 69 / 48);
        left: calc(var(--hero-icon-box) * -13 / 48);
        top: calc(var(--hero-icon-box) * -1 / 48);
        display: block;
        shape-rendering: geometricPrecision;
      }

      .hero-copy > p {
        max-width: 660px;
        margin: var(--home-lead-gap) auto 0;
        color: var(--text-sub);
        font-size: clamp(16px, 1.35vw, 18px);
        line-height: 1.72;
        text-wrap: balance;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--home-control-gap);
        margin-top: var(--home-actions-gap);
      }

      .hero-demo-slot {
        position: relative;
        z-index: var(--home-z-content);
        width: 100%;
        height: max(300px, calc(100svh - 500px));
        /* Portrait screens: don't stretch past the demo's native ratio. */
        max-height: calc(100cqw * 753 / 1203);
        margin-top: clamp(44px, 4vw, 64px);
      }

      .hero-demo-slot .hero-safari-demo {
        width: 100%;
        height: 100%;
        aspect-ratio: auto;
        margin: 0;
      }

      html[data-home-intro-js] body[data-home-intro="pending"],
      html[data-home-intro-js] body[data-home-intro="revealing"] {
        overflow: hidden;
      }

      html[data-home-intro-js] body[data-home-intro="pending"] main > :not(.hero-section),
      html[data-home-intro-js] body[data-home-intro="revealing"] main > :not(.hero-section),
      html[data-home-intro-js] body[data-home-intro="pending"] .site-footer,
      html[data-home-intro-js] body[data-home-intro="revealing"] .site-footer {
        visibility: hidden;
        opacity: 0;
      }

      html[data-home-intro-js] body[data-home-intro="pending"] .top-nav,
      html[data-home-intro-js] body[data-home-intro="pending"] .hero-copy > * {
        visibility: hidden;
        opacity: 0;
        translate: 0 -16px;
        pointer-events: none;
      }

      html[data-home-intro-js] body[data-home-intro="pending"] .hero-copy > * {
        translate: 0 22px;
        filter: blur(10px);
      }

      html[data-home-intro-js] body[data-home-intro="revealing"] .top-nav {
        transition-delay: 80ms;
      }

      html[data-home-intro-js] body[data-home-intro="revealing"] .hero-copy h1 {
        transition-delay: 200ms;
      }

      html[data-home-intro-js] body[data-home-intro="revealing"] .hero-description {
        transition-delay: 300ms;
      }

      html[data-home-intro-js] body[data-home-intro="revealing"] .hero-actions {
        transition-delay: 400ms;
      }

      /*
       * The paintings behind sections further down wait for the intro to end: while the
       * page is hidden they would only take bandwidth from the hero's own painting.
       */
      html[data-home-intro-js] body:not([data-home-intro="complete"]) .ai-intent-demo__wallpaper,
      html[data-home-intro-js] body:not([data-home-intro="complete"]) .chrome-review-marquee__dither {
        background-image: none;
      }

      html[data-home-intro-js] body[data-home-intro="pending"] .hero-demo-page-switcher,
      html[data-home-intro-js] body[data-home-intro="revealing"] .hero-demo-page-switcher {
        pointer-events: none;
      }

      /*
       * Page rules that refine shared components carry the component's class
       * too: in production the shared stylesheets load after this page's, so
       * an equally specific rule here would lose.
       */
      .lumno-settings-button.hero-actions-button {
        min-height: 44px;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 650;
        line-height: 1.4;
        white-space: nowrap;
      }

      .lumno-settings-button.hero-actions-button .lumno-settings-button-icon {
        width: 18px;
        height: 18px;
      }

      .hero-parallax {
        --hero-parallax-row-loop-offset: -175rem;
      }

      .hero-parallax__header {
        isolation: isolate;
      }

      /* Veil behind the copy so cards sliding up never sit under the text. */
      .hero-parallax__header::before {
        position: absolute;
        /* Also cover the section's top padding, where rotated cards first fly in. */
        top: -240px;
        right: -50vw;
        bottom: -96px;
        left: -50vw;
        z-index: -1;
        pointer-events: none;
        content: "";
        background: linear-gradient(
          to bottom,
          var(--bg) 0%,
          var(--bg) 78%,
          color-mix(in srgb, var(--bg) 70%, transparent) 90%,
          transparent 100%
        );
      }

      .hero-parallax__row--reverse {
        margin-left: var(--hero-parallax-row-loop-offset);
      }

      .ai-intent-section {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: var(--home-split-gap);
        align-items: center;
      }

      /* Center the copy on the browser frame, not frame + scenario switcher:
         reserve the switcher's height (40px) and the demo's gap (16px) below it. */
      .home-section__head.ai-intent-copy {
        margin-bottom: 0;
        padding-bottom: 56px;
      }

      .ai-intent-demo-slot {
        width: 100%;
        min-width: 0;
      }

      .feature-intro {
        position: relative;
        width: 100%;
        overflow: clip;
      }

      .home-h2.hero-parallax__title {
        max-width: 760px;
        margin: 0 auto;
      }

      .hero-parallax__description {
        max-width: 620px;
        margin: var(--home-lead-gap) auto 0;
        color: var(--text-sub);
        font-size: clamp(16px, 1.3vw, 18px);
        line-height: 1.72;
        text-wrap: balance;
      }

      @media (max-width: 1080px) {
        .hero-section {
          grid-template-columns: 1fr;
          padding-top: 120px;
          gap: 0;
        }

        .hero-copy {
          max-width: 760px;
        }

        .ai-intent-section {
          grid-template-columns: minmax(0, 1fr);
          gap: var(--home-head-gap);
        }

        .home-section__head.ai-intent-copy {
          padding-bottom: 0;
        }
      }

      @media (max-width: 760px) {
        .hero-parallax {
          /* One copy of a row: 5 cards of 14rem plus 1.5rem gaps (hero-parallax.tsx). */
          --hero-parallax-row-loop-offset: -77.5rem;
        }

        .hero-section {
          padding: 120px 0 52px;
          gap: 0;
        }

        /*
         * Phones: a fixed height sized to the tallest scene (the 5-result
         * panel at --home-ui-scale, 16px in from the top, with the meadow
         * showing below), not to the viewport. A 100svh-based height swung
         * from 220px to 380px across phones and toolbar states, clipping the
         * panel on short screens and leaving empty canvas on tall ones.
         */
        .hero-demo-slot {
          height: 320px;
          max-height: none;
          margin-top: 36px;
          /* The scene switcher hangs below the card here: 16px gap + 40px bar. */
          margin-bottom: 56px;
        }

        .hero-copy h1 {
          max-width: 620px;
          font-size: clamp(34px, 10vw, 44px);
          letter-spacing: -0.048em;
        }

        .hero-copy h1.hero-title-serif {
          font-size: clamp(42px, 12.4vw, 54px);
        }

        .hero-copy {
          padding-left: max(8px, env(safe-area-inset-left));
          padding-right: max(8px, env(safe-area-inset-right));
        }

        .hero-title-has-break .hero-title-line {
          flex-direction: column;
          align-items: center;
        }

        .hero-title-separator {
          display: none;
        }

        /* The new tab heading is short enough to hold one line on a phone. */
        .hero-parallax__title.hero-title-has-break {
          font-size: min(32px, 8.5vw);
        }

        .hero-parallax__title.hero-title-has-break .hero-title-line {
          flex-direction: row;
          flex-wrap: nowrap;
        }

        .hero-copy > p {
          max-width: 330px;
          font-size: 15px;
          line-height: 1.7;
        }

        .hero-parallax__description {
          max-width: 330px;
          font-size: 15px;
          line-height: 1.7;
          text-wrap: balance;
        }

        .hero-description .home-copy-line + .home-copy-line {
          margin-top: 8px;
        }

        .lumno-settings-button.hero-actions-button {
          min-height: 42px;
          padding: 7px 14px;
          font-size: 13px;
        }
      }

      @media (min-width: 761px) and (max-height: 740px) {
        .hero-section {
          padding-top: 80px;
        }

        .hero-demo-slot {
          margin-top: 40px;
        }
      }

      @media (max-width: 760px) and (max-height: 740px) {
        .hero-section {
          padding-top: 80px;
        }

        .hero-copy > p {
          margin-top: 12px;
          line-height: 1.55;
        }

        .hero-actions {
          margin-top: 16px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-parallax {
          height: auto;
        }

        html[data-home-intro-js] body[data-home-intro="pending"] {
          overflow: auto;
        }

        html[data-home-intro-js] body[data-home-intro="pending"] main > :not(.hero-section),
        html[data-home-intro-js] body[data-home-intro="pending"] .site-footer,
        html[data-home-intro-js] body[data-home-intro="pending"] .top-nav,
        html[data-home-intro-js] body[data-home-intro="pending"] .hero-copy > * {
          visibility: visible;
          opacity: 1;
          translate: 0 0;
          filter: none;
          pointer-events: auto;
        }
      }
    </style>
  </body>
</html>
