      /* English editorial slogan (Figma P1): EB Garamond roman lead + italic gradient accent. */
      .hero-copy h1.hero-title-serif {
        max-width: none;
        font-family: "EB Garamond", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
        font-size: clamp(48px, 5vw, 72px);
