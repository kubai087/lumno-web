        overflow-x: clip;
      }

      .hero-section {
        width: min(calc(100% - 48px), var(--content-width));
        margin-left: auto;
        margin-right: auto;
      }

      .hero-section {
        position: relative;
        min-height: 100svh;
        min-height: 100dvh;
        padding: 120px 0 80px;
        display: grid;
        grid-template-columns: 1fr;
        max-width: var(--content-width);
        /* Only kicks in when the demo is width-capped (portrait screens). */
        align-content: center;
        justify-items: center;
        isolation: isolate;
        /* Lets the demo slot cap its height by the section width (cqw). */
        container-type: inline-size;
