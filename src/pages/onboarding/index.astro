          shortcut_step_1: "Copy the address above, paste it into the address bar, and open it.",
          shortcut_step_2: "Find Lumno.",
          shortcut_step_3_prefix: "Set or update the shortcut for ",
          shortcut_command_label: "Open command bar",
          shortcut_step_3_suffix: ".",
          shortcut_step_4: "Use that shortcut to open Lumno and start focus search on the page.",
          shortcut_tip_dia_prefix: "If you're using Dia and the shortcut still doesn't work after setting it, change ",
          shortcut_browser_scope_label: "In Dia",
          shortcut_tip_dia_middle: " to ",
          shortcut_global_scope_label: "Global",
          shortcut_tip_dia_suffix: ".",
          shortcut_tip_file_prefix: "If you want to use Focus Search in PDF or HTML files, open the extension details page at ",
          shortcut_extension_page_label: "chrome://extensions/?id=nggfkkbmogmadfoikakkfegkoilfcfao",
          shortcut_tip_file_middle: " and manually enable ",
          shortcut_allow_file_urls_label: "Allow access to file URLs",
          shortcut_tip_file_suffix: ".",
          language_select_aria: "Language",
          language_system: "Follow browser language",
          language_zh_cn: "简体中文",
          language_zh_tw: "繁體中文",
          language_en: "English",
          join_discord: "Feedback & Requests",
          go_settings: "View on GitHub",
          discord_aria: "Feedback and requests",
          qrcode_title: "WeChat Group QR Code",
          qrcode_image_alt: "Lumno WeChat group QR code",
          qrcode_close_aria: "Close QR code dialog",
          settings_aria: "Open Lumno GitHub repository",
          release_aria: "Open release notes page",
          view_release: "Release Notes",
          cws_badge_aria: "Install Lumno from Chrome Web Store",
          cws_badge_alt: "Get it from Chrome Web Store",
          feature_search_title: "Search any page in your browser",
          feature_search_desc: "Search bookmarks, history, open pages, and frequently visited sites",
          feature_sitesearch_title: "Custom site search",
          feature_sitesearch_desc: "Built-in site engines for instant site search with Tab",
          feature_newtab_title: "Minimalist new tab",
          feature_newtab_desc: "Keep bookmarks and frequently used pages in clean card layouts",
          feature_labs_title: "Labs features",
          feature_labs_title_strong: "& refined UI",
          feature_labs_desc: "More experiments are on the way",
          beta_alt: "Beta",
          logo_icon_alt: "Lumno icon"
        }
      };
      function updateLanguageOptionState(mode) {
        let activeLabel = "";
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const value = node.getAttribute("data-lang-value") || getSystemLocale();
          const isActive = value === mode;
          node.classList.toggle("is-active", isActive);
          node.setAttribute("aria-checked", isActive ? "true" : "false");
          if (isActive) {
            activeLabel = (node.textContent || "").trim();
          }
        });
        const currentLabel = document.getElementById("language-current-label");
        if (currentLabel && activeLabel) {
          currentLabel.textContent = activeLabel;
        }
      }

      function normalizeLocale(locale) {
        const raw = String(locale || "").trim();
        if (!raw) {
          return "en";
        }
        const lower = raw.toLowerCase();
        if (lower.startsWith("zh")) {
          if (lower.includes("hk")) {
            return "zh-TW";
          }
          if (lower.includes("tw") || lower.includes("mo") || lower.includes("hant")) {
            return "zh-TW";
          }
          return "zh-CN";
        }
        return "en";
      }

      function normalizeLanguageMode(mode) {
        const raw = String(mode || "").trim();
        if (!raw) return getSystemLocale();
        const lower = raw.toLowerCase();
        if (lower === "system") return getSystemLocale();
        if (lower === "en" || lower.startsWith("en-") || lower.startsWith("en_")) return "en";
        if (lower === "zh-hk" || lower === "zh_hk") return "zh-TW";
        if (lower === "zh-tw" || lower === "zh_tw" || lower === "zh-mo" || lower === "zh_mo" || lower.includes("hant")) {
          return "zh-TW";
        }
        if (lower === "zh-cn" || lower === "zh_cn" || lower === "zh-hans" || lower === "zh_hans" || lower.startsWith("zh")) {
          return "zh-CN";
        }
        return "en";
      }

      function getSystemLocale() {
        const firstPreferred = Array.isArray(navigator.languages) && navigator.languages.length ? navigator.languages[0] : navigator.language;
        return normalizeLocale(firstPreferred || "en");
      }

      function getMessage(locale, key) {
        return (
          (I18N_MESSAGES[locale] && I18N_MESSAGES[locale][key]) ||
          (I18N_MESSAGES[FALLBACK_LOCALE] && I18N_MESSAGES[FALLBACK_LOCALE][key]) ||
          key
        );
      }

      function getEntryContext() {
        const params = new URLSearchParams(window.location.search);
        const entry = (params.get("entry") || "").trim().toLowerCase();
        const reason = (params.get("reason") || "").trim().toLowerCase();
        const version = (params.get("version") || "").trim();
        const source = (params.get("source") || "").trim().toLowerCase();
        const hasExtensionEntryKey = ENTRY_CONTEXT_CONFIG.extensionEntryKeys.some((key) => params.has(key));
        const isExtensionEntry =
          ENTRY_CONTEXT_CONFIG.extensionEntryValues.includes(entry) ||
          ENTRY_CONTEXT_CONFIG.extensionEntryValues.includes(source) ||
          Boolean(reason) ||
          Boolean(version) ||
          hasExtensionEntryKey;
        return { isExtensionEntry };
      }

      const INITIAL_ENTRY_CONTEXT = getEntryContext();

      function applyI18n(locale) {
        const resolvedLocale = I18N_MESSAGES[locale] ? locale : FALLBACK_LOCALE;
        document.title = pageTitleByLocale[resolvedLocale] || pageTitleByLocale[FALLBACK_LOCALE];
        document.documentElement.lang = resolvedLocale;
        document.body.setAttribute("data-locale", resolvedLocale);
        document.body.classList.toggle("is-locale-en", resolvedLocale === "en");
        document.querySelectorAll("[data-i18n]:not([data-lang-value])").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (!key) return;
          const value = getMessage(resolvedLocale, key);
          if (node.tagName === "TITLE") {
            document.title = value;
            return;
          }
          node.textContent = value;
          if (node.classList && node.classList.contains("text-shimmer")) {
            node.setAttribute("data-shimmer-text", value);
          }
        });
        document.querySelectorAll("[data-i18n-aria-label]").forEach((node) => {
          const key = node.getAttribute("data-i18n-aria-label");
          if (!key) return;
          node.setAttribute("aria-label", getMessage(resolvedLocale, key));
        });
        document.querySelectorAll("[data-i18n-alt]").forEach((node) => {
          const key = node.getAttribute("data-i18n-alt");
          if (!key) return;
          node.setAttribute("alt", getMessage(resolvedLocale, key));
        });
      }

      function syncCommunityAction(locale) {
        const entry = document.querySelector("[data-community-entry]");
        if (!(entry instanceof HTMLAnchorElement)) return;
        const icon = entry.querySelector("[data-community-icon]");
        const discordHref = entry.dataset.discordHref || COMMUNITY_LINKS.discordUrl || "#";
        const isZhCn = locale === ZH_CN_LOCALE;

        entry.href = isZhCn ? "#" : discordHref;
        if (isZhCn) {
          entry.removeAttribute("target");
          entry.removeAttribute("rel");
        } else {
          entry.setAttribute("target", "_blank");
          entry.setAttribute("rel", "noreferrer noopener");
        }

        if (icon instanceof HTMLElement) {
          icon.classList.toggle("ri-wechat-fill", isZhCn);
          icon.classList.toggle("ri-discord-fill", !isZhCn);
        }
      }

      function applyResolvedLanguage(normalizedMode) {
        if (!I18N_MESSAGES[normalizedMode]) {
          document.documentElement.lang = normalizedMode;
          syncCommunityAction(normalizedMode);
          syncShortcutGuide(normalizedMode);
          updateLanguageOptionState(normalizedMode);
          return;
        }
        applyI18n(normalizedMode);
        syncCommunityAction(normalizedMode);
        syncShortcutGuide(normalizedMode);
        updateLanguageOptionState(normalizedMode);
      }

      function initLanguageRuntime() {
        if (!window.__lumnoLanguagePreference || !window.__lumnoLanguageRuntime) return null;
        const storedMode = window.__lumnoLanguagePreference.getStoredLanguageMode(LANGUAGE_STORAGE_KEY);
        // Public canonical routes stay stable; extension entries still use browser language.
        const initialForcedLocale = FORCED_LOCALE ||
          (!INITIAL_ENTRY_CONTEXT.isExtensionEntry && !storedMode ? FALLBACK_LOCALE : null);
        return window.__lumnoLanguageRuntime.setupLanguageRuntime({
          forcedLocale: initialForcedLocale,
          getSystemLocale,
          normalizeLanguageMode,
          routeLanguageMap: ROUTE_LANGUAGE_MAP,
          languageStorageKey: LANGUAGE_STORAGE_KEY,
          shouldRedirect: () => !INITIAL_ENTRY_CONTEXT.isExtensionEntry,
          applyResolvedLanguage,
        });
      }

      function setupQrcodeModal() {
        const entry = document.querySelector("[data-community-entry]");
        const modal = document.getElementById("community-qrcode-modal");
        if (!(entry instanceof HTMLAnchorElement) || !(modal instanceof HTMLDivElement)) return;

        const close = () => {
          modal.hidden = true;
          document.body.style.removeProperty("overflow");
        };

        const open = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
        };

        entry.addEventListener("click", (event) => {
          const currentLocale = document.body.getAttribute("data-locale") || FALLBACK_LOCALE;
          if (currentLocale !== ZH_CN_LOCALE) return;
          event.preventDefault();
          open();
        });

        modal.addEventListener("click", (event) => {
          const target = event.target instanceof HTMLElement ? event.target.closest("[data-close-qrcode-modal]") : null;
          if (target) close();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) close();
        });
      }

      function isSafariBrowser() {
        const ua = navigator.userAgent;
        return /Safari/i.test(ua) && !/Chrome|CriOS|Edg|OPR|Android/i.test(ua);
      }

      function applySafariBrowserClass() {
        const isSafari = isSafariBrowser();
        document.documentElement.classList.toggle("is-safari", isSafari);
      }

      document.addEventListener("dragstart", (event) => {
        if (event.target instanceof HTMLImageElement && event.target.classList.contains("mark-svg")) {
          event.preventDefault();
        }
      });

      function bootLanguageRuntime() {
        const languageRuntime = initLanguageRuntime();
        if (!languageRuntime) return false;
        languageRuntime.applyLanguageMode(languageRuntime.getInitialLanguageMode());
        window.addEventListener("load", () => {
          languageRuntime.applyLanguageMode(languageRuntime.getInitialLanguageMode());
        }, { once: true });
        return true;
      }

      if (!bootLanguageRuntime()) {
        const retryBootLanguageRuntime = () => {
          if (bootLanguageRuntime()) {
            window.removeEventListener("lumno:language-runtime-ready", retryBootLanguageRuntime);
            window.removeEventListener("lumno:language-preference-ready", retryBootLanguageRuntime);
          }
        };
        window.addEventListener("lumno:language-runtime-ready", retryBootLanguageRuntime);
        window.addEventListener("lumno:language-preference-ready", retryBootLanguageRuntime);
      }

      setupQrcodeModal();
      applySafariBrowserClass();

      function syncViewportInsets() {
        const viewport = window.visualViewport;
        const isTwitterInAppBrowser = navigator.userAgent.toLowerCase().includes("twitter");
        const rawBottomInset = viewport
          ? window.innerHeight - viewport.height - viewport.offsetTop
          : 0;
        const embeddedBrowserInset = isTwitterInAppBrowser
          ? Math.min(280, Math.max(216, Math.round(window.innerHeight * 0.26)))
          : 0;
        const bottomInset = Math.min(320, Math.max(embeddedBrowserInset, Math.round(rawBottomInset)));
        document.documentElement.style.setProperty(
          "--mobile-top-clearance",
          isTwitterInAppBrowser ? "0px" : "var(--safe-area-top-capped)"
        );
        document.documentElement.classList.toggle("is-twitter-in-app-browser", isTwitterInAppBrowser);
        document.documentElement.style.setProperty("--browser-chrome-bottom", `${bottomInset}px`);
        const languageControl = document.querySelector(".lang-control");
        if (languageControl instanceof HTMLElement) {
          if (isTwitterInAppBrowser) {
            languageControl.style.marginBottom = `${bottomInset}px`;
          } else {
            languageControl.style.removeProperty("margin-bottom");
          }
        }
      }

      syncViewportInsets();
      window.visualViewport?.addEventListener("resize", syncViewportInsets, { passive: true });
      window.visualViewport?.addEventListener("scroll", syncViewportInsets, { passive: true });
      window.addEventListener("resize", syncViewportInsets, { passive: true });
      window.addEventListener("orientationchange", syncViewportInsets);

      function syncTopNavOverlapState() {
        const shouldApply = window.matchMedia("(max-width: 1080px)").matches;
        const topNav = document.querySelector(".top-nav");
        const mainContent = document.querySelector(".onboarding");
        if (!shouldApply || !(topNav instanceof HTMLElement) || !(mainContent instanceof HTMLElement)) {
          document.body.classList.remove("has-nav-overlap");
          return;
        }
        const navBottom = topNav.getBoundingClientRect().bottom;
        const contentTop = mainContent.getBoundingClientRect().top;
        document.body.classList.toggle("has-nav-overlap", contentTop < navBottom - 1);
      }

      syncTopNavOverlapState();
      window.addEventListener("scroll", syncTopNavOverlapState, { passive: true });
      window.addEventListener("resize", syncTopNavOverlapState, { passive: true });

      function getBrowserShortcutSettingsUrl() {
        const userAgent = navigator.userAgent.toLowerCase();
        const userAgentBrands = Array.isArray(navigator.userAgentData?.brands)
          ? navigator.userAgentData.brands.map((brand) => brand.brand.toLowerCase()).join(" ")
          : "";

        let scheme = "chrome";
        if (userAgent.includes("edg/") || userAgentBrands.includes("edge")) {
          scheme = "edge";
        } else if (userAgent.includes("opr/") || userAgent.includes("opera") || userAgentBrands.includes("opera")) {
          scheme = "opera";
        } else if (userAgent.includes("vivaldi") || userAgentBrands.includes("vivaldi")) {
          scheme = "vivaldi";
        } else if (userAgent.includes("arc/") || userAgentBrands.includes("arc")) {
          scheme = "arc";
        } else if (userAgent.includes("dia/") || userAgentBrands.includes("dia")) {
          scheme = "dia";
        } else if (userAgent.includes("brave") || userAgentBrands.includes("brave") || "brave" in navigator) {
          scheme = "brave";
        }

        return `${scheme}://extensions/shortcuts`;
      }

      function syncShortcutGuide(locale) {
        const urlNode = document.getElementById("shortcut-settings-url");
        if (urlNode) {
          urlNode.textContent = getBrowserShortcutSettingsUrl();
        }

        const copyButton = document.querySelector("[data-shortcut-copy-button]");
        const copyLabel = document.querySelector("[data-shortcut-copy-label]");
        const copyIcon = document.querySelector("[data-shortcut-copy-icon]");
        if (copyButton instanceof HTMLButtonElement) {
          copyButton.classList.remove("is-copied");
        }
        if (copyLabel) {
          copyLabel.textContent = getMessage(locale, "shortcut_copy");
        }
        if (copyIcon instanceof HTMLElement) {
          copyIcon.className = "ri-file-copy-line";
          copyIcon.setAttribute("aria-hidden", "true");
        }

        const extensionCopyButton = document.querySelector("[data-extension-copy-button]");
        const extensionCopyIcon = document.querySelector("[data-extension-copy-icon]");
        if (extensionCopyButton instanceof HTMLButtonElement) {
          extensionCopyButton.classList.remove("is-copied");
        }
        if (extensionCopyIcon instanceof HTMLElement) {
          extensionCopyIcon.className = "ri-file-copy-line";
          extensionCopyIcon.setAttribute("aria-hidden", "true");
        }
      }

      async function copyShortcutSettingsUrl() {
        const url = getBrowserShortcutSettingsUrl();
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(url);
          return;
        }

        const helper = document.createElement("textarea");
        helper.value = url;
        helper.setAttribute("readonly", "");
        helper.style.position = "absolute";
        helper.style.opacity = "0";
        helper.style.pointerEvents = "none";
        document.body.appendChild(helper);
        helper.select();
        document.execCommand("copy");
        helper.remove();
      }

      async function copyTextValue(value) {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(value);
          return;
        }

        const helper = document.createElement("textarea");
        helper.value = value;
        helper.setAttribute("readonly", "");
        helper.style.position = "absolute";
        helper.style.opacity = "0";
        helper.style.pointerEvents = "none";
        document.body.appendChild(helper);
        helper.select();
        document.execCommand("copy");
        helper.remove();
      }

      const shortcutCopyButton = document.querySelector("[data-shortcut-copy-button]");
      const shortcutCopyLabel = document.querySelector("[data-shortcut-copy-label]");
      const shortcutCopyIcon = document.querySelector("[data-shortcut-copy-icon]");
      let shortcutCopyResetTimer = 0;
      if (shortcutCopyButton instanceof HTMLButtonElement) {
        shortcutCopyButton.addEventListener("click", async () => {
          try {
            await copyShortcutSettingsUrl();
            const currentLocale = document.body.getAttribute("data-locale") || FALLBACK_LOCALE;
            shortcutCopyButton.classList.add("is-copied");
            if (shortcutCopyLabel) {
              shortcutCopyLabel.textContent = getMessage(currentLocale, "shortcut_copied");
            }
            if (shortcutCopyIcon instanceof HTMLElement) {
              shortcutCopyIcon.className = "ri-check-line";
              shortcutCopyIcon.setAttribute("aria-hidden", "true");
            }
            window.clearTimeout(shortcutCopyResetTimer);
            shortcutCopyResetTimer = window.setTimeout(() => {
              syncShortcutGuide(document.body.getAttribute("data-locale") || FALLBACK_LOCALE);
            }, 1800);
          } catch (error) {
            console.error("Failed to copy shortcut settings URL.", error);
          }
        });
      }

      const extensionCopyButton = document.querySelector("[data-extension-copy-button]");
      const extensionCopyIcon = document.querySelector("[data-extension-copy-icon]");
      let extensionCopyResetTimer = 0;
      if (extensionCopyButton instanceof HTMLButtonElement) {
        extensionCopyButton.addEventListener("click", async () => {
          try {
            await copyTextValue("chrome://extensions/?id=nggfkkbmogmadfoikakkfegkoilfcfao");
            extensionCopyButton.classList.add("is-copied");
            if (extensionCopyIcon instanceof HTMLElement) {
              extensionCopyIcon.className = "ri-check-line";
              extensionCopyIcon.setAttribute("aria-hidden", "true");
            }
            window.clearTimeout(extensionCopyResetTimer);
            extensionCopyResetTimer = window.setTimeout(() => {
              syncShortcutGuide(document.body.getAttribute("data-locale") || FALLBACK_LOCALE);
            }, 1800);
          } catch (error) {
            console.error("Failed to copy extension details URL.", error);
          }
        });
      }

      window.setTimeout(() => {
        document.body.classList.add("is-entered");
      }, 1000);

    </script>
  </body>
