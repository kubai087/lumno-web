    shortcutTipFileSuffix: "。",
    languageLabel: "繁體中文",
    languageSelectAria: "語言",
  },
  en: {
    viewRelease: "Release Notes",
    joinDiscord: "Feedback & Requests",
    shortcutGuideTitle: "🦋 Quickly enable Lumno Focus Search",
    shortcutHowToName: "How to enable the Lumno browser command bar shortcut",
    shortcutHowToDescription: "Set the Lumno extension shortcut, then open focus search from any page to search tabs, bookmarks, history, and site content.",
    shortcutStepName1: "Open extension shortcut settings",
    shortcutStepName2: "Find the Lumno extension",
    shortcutStepName3: "Set the Open command bar shortcut",
    shortcutStepName4: "Use the shortcut to open Lumno",
    shortcutCopy: "Copy",
    shortcutCopied: "Copied",
    titleWelcome: "Meet",
    subtitle: "An open-source browser extension for focus search and a minimalist new tab.",
    settingsAria: "Open the Lumno GitHub repository",
    shortcutCopyAria: "Copy the extension shortcut settings address",
    shortcutCopyExtensionAria: "Copy the extension details page URL",
    releaseAria: "Open the release notes page",
    discordAria: "Feedback and requests",
    qrcodeTitle: "WeChat group QR code",
    qrcodeImageAlt: "Lumno WeChat group QR code",
    qrcodeCloseAria: "Close QR code dialog",
    logoIconAlt: "Lumno icon",
    shortcutStep1: "Copy the address above, paste it into the address bar, and open it.",
    shortcutStep2: "Find Lumno.",
    shortcutStep3Prefix: "Set or update the shortcut for ",
    shortcutCommandLabel: "Open command bar",
    shortcutStep3Suffix: ".",
    shortcutStep4: "Use that shortcut to open Lumno and start focus search on the page.",
    shortcutTipDiaPrefix: "If you're using Dia and the shortcut still doesn't work after setting it, change ",
    shortcutBrowserScopeLabel: "In Dia",
    shortcutTipDiaMiddle: " to ",
    shortcutGlobalScopeLabel: "Global",
    shortcutTipDiaSuffix: ".",
    shortcutTipFilePrefix: "If you want to use Focus Search in PDF or HTML files, open the extension details page at ",
    shortcutExtensionPageLabel: "chrome://extensions/?id=nggfkkbmogmadfoikakkfegkoilfcfao",
    shortcutTipFileMiddle: " and manually enable ",
    shortcutAllowFileUrlsLabel: "Allow access to file URLs",
    shortcutTipFileSuffix: ".",
    languageLabel: "English",
    languageSelectAria: "Language",
  },
}[uiLocale];
const featureMessages = {
  "zh-CN": {
    searchTitle: "搜索浏览器中的任意页面",
    searchDesc: "支持书签、历史记录、已打开页面和最常访问",
    siteSearchTitle: "自定义站内搜索",
    siteSearchDesc: "内置常用站点，按 Tab 一键发起站内搜索",
    newTabTitle: "极简新标签页",
    newTabDesc: "展示书签与常用网页卡片",
    labsTitle: "实验室功能",
    labsTitleStrong: "& 精美 UI",
    labsDesc: "更多玩法，敬请期待",
    betaAlt: "Beta",
  },
  "zh-TW": {
    searchTitle: "搜尋瀏覽器中的任意頁面",
    searchDesc: "支援書籤、歷史紀錄、已開啟頁面與最常造訪",
    siteSearchTitle: "自訂站內搜尋",
    siteSearchDesc: "內建常用站點，按 Tab 一鍵發起站內搜尋",
    newTabTitle: "極簡新分頁",
    newTabDesc: "展示書籤與常用網頁卡片",
    labsTitle: "實驗室功能",
    labsTitleStrong: "& 精緻 UI",
    labsDesc: "更多玩法，敬請期待",
    betaAlt: "Beta",
  },
  en: {
    searchTitle: "Search any page in your browser",
    searchDesc: "Search bookmarks, history, open pages, and frequently visited sites",
    siteSearchTitle: "Custom site search",
    siteSearchDesc: "Built-in site search shortcuts. Press Tab to search instantly",
    newTabTitle: "Minimalist new tab",
    newTabDesc: "Keep bookmarks and frequently used pages in clean card layouts",
    labsTitle: "Labs features",
    labsTitleStrong: "& refined UI",
    labsDesc: "More experiments are on the way",
    betaAlt: "Beta",
  },
}[uiLocale];
const shortcutHowToSchema = buildHowToSchema({
  name: initialUi.shortcutHowToName,
  description: initialUi.shortcutHowToDescription,
  path: seoPath,
  language: uiLocale,
  steps: [
    {
      name: initialUi.shortcutStepName1,
      text: initialUi.shortcutStep1,
      anchor: "#shortcut-guide-title",
    },
    {
      name: initialUi.shortcutStepName2,
      text: initialUi.shortcutStep2,
      anchor: "#shortcut-guide-title",
    },
    {
      name: initialUi.shortcutStepName3,
      text: `${initialUi.shortcutStep3Prefix}${initialUi.shortcutCommandLabel}${initialUi.shortcutStep3Suffix}`,
      anchor: "#shortcut-guide-title",
    },
    {
      name: initialUi.shortcutStepName4,
      text: initialUi.shortcutStep4,
      anchor: "#shortcut-guide-title",
    },
  ],
});
const structuredData = [
  buildSoftwareApplicationSchema({
    description: pageDescription,
  }),
  buildWebPageSchema({
    name: pageTitle,
    description: pageDescription,
    path: seoPath,
    language: uiLocale,
    mainEntity: shortcutHowToSchema,
  }),
  shortcutHowToSchema,
  buildBreadcrumbListSchema({
    items: [
      { name: SITE_NAME, path: homeHref },
      { name: pageTitle, path: seoPath },
    ],
  }),
];
---

<!doctype html>
<html lang={uiLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      path={seoPath}
      keywords={pageKeywords}
      alternates={alternateLinks}
      locale={ogLocale}
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="image"
      href="/assets/frame234-bg-1920.webp"
      imagesrcset="/assets/frame234-bg-1280.webp 1280w, /assets/frame234-bg-1920.webp 1920w"
      imagesizes="100vw"
      type="image/webp"
    />
    <link rel="stylesheet" href="/assets/remixicon.css" />
    <style is:global>
      @font-face {
        font-family: "Open Sans";
        src: url("/assets/OpenSans-VariableFont-wdth-wght.ttf") format("truetype");
        font-style: normal;
        font-weight: 300 800;
        font-display: swap;
      }

      :root {
        --bg: #fafafa;
        --text-main: #2d3138;
        --text-sub: #898989;
        --card-text-sub: rgba(0, 0, 0, 0.6);
        --card-grad-start: oklch(99.8% 0.001 255);
        --card-grad-mid: oklch(99.3% 0.002 255);
        --card-grad-end: oklch(98.6% 0.003 255);
        --card-rim: oklch(78% 0.012 250 / 0.46);
        --card-highlight: rgba(255, 255, 255, 0.98);
        --card-highlight-soft: rgba(255, 255, 255, 0.74);
        --card-merge-glow: rgba(255, 255, 255, 0.9);
        --card-edge-glow: rgba(255, 255, 255, 0.8);
        --card-white-clear: rgba(255, 255, 255, 0);
        --card-bottom-line: oklch(52% 0.012 250 / 0.18);
        --card-shadow: oklch(44% 0.018 250 / 0.08);
        --card-shadow-soft: oklch(70% 0.012 250 / 0.14);
        --lang-ink: #5e7064;
        --lang-border: oklch(82% 0.018 145 / 0.58);
        --lang-surface: oklch(99.2% 0.004 115 / 0.84);
        --lang-surface-hover: oklch(97.4% 0.016 145 / 0.9);
        --lang-surface-active: oklch(94.2% 0.03 145 / 0.92);
        --lang-active-ink: oklch(39% 0.054 145);
        --lang-shadow: oklch(42% 0.02 145 / 0.12);
        --border-soft: #e2e2e2;
        --producthunt-badge-width: 250px;
        --safe-area-top: 0px;
        --safe-area-top: env(safe-area-inset-top, 0px);
        --safe-area-top-capped: min(var(--safe-area-top), 72px);
        --mobile-top-clearance: var(--safe-area-top-capped);
        --safe-area-bottom: 0px;
        --safe-area-bottom: env(safe-area-inset-bottom, 0px);
        --browser-chrome-bottom: 0px;
        --mobile-bottom-clearance: max(var(--safe-area-bottom), var(--browser-chrome-bottom));
        --mobile-flow-bottom-clearance: var(--safe-area-bottom);
        --mobile-status-cover-height: var(--mobile-top-clearance);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text-main);
        font-family: "Open Sans", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
      }

      .onboarding {
        min-height: 100vh;
        min-height: 100svh;
        min-height: 100dvh;
        display: flex;
        overflow: hidden;
      }

      .left-pane {
        position: relative;
        width: clamp(560px, 44vw, 760px);
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        padding-left: clamp(56px, 9vw, 132px);
        padding-right: 48px;
      }

      .left-main {
        position: relative;
        width: min(100%, 668px);
        display: flex;
        flex-direction: column;
        gap: 112px;
      }

      .hero {
        width: 100%;
        opacity: 0;
        transform: translateX(-24px);
        filter: blur(6px);
        animation: x-hero-enter 620ms cubic-bezier(0.22, 1, 0.36, 1) 100ms forwards;
      }

      .title-row {
        display: flex;
        align-items: center;
        gap: clamp(10px, 1.8vw, 24px);
      }

      .title {
        margin: 0;
        font-size: clamp(38px, 3.6vw, 44px);
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: 0.2px;
        white-space: nowrap;
        background: linear-gradient(180deg, #000000 0%, #666666 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .logo-lockup {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transform: translateY(-2px);
      }

      .logo-icon-wrap {
        --logo-box: 54px;
        position: relative;
        width: var(--logo-box);
        height: var(--logo-box);
        flex: none;
        overflow: visible;
      }

      .logo-icon {
        position: absolute;
        width: calc(var(--logo-box) * 63 / 48);
        height: calc(var(--logo-box) * 69 / 48);
        left: calc(var(--logo-box) * -13 / 48);
        top: calc(var(--logo-box) * -1 / 48);
        display: block;
        max-width: none;
        transform: translateZ(0);
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
      }

      .logo-icon svg {
        width: 100%;
        height: 100%;
        display: block;
        shape-rendering: geometricPrecision;
      }

      .logo-wordmark-wrap {
        --wordmark-width: 182px;
        position: relative;
        width: var(--wordmark-width);
        height: calc(var(--wordmark-width) * 47 / 165);
        flex: none;
        overflow: visible;
      }

      .logo-wordmark {
        width: 100%;
        height: 100%;
        display: block;
      }

      .logo-butterfly-stage {
        position: absolute;
        left: calc(var(--wordmark-width) * 152 / 165);
        top: 6px;
        width: calc(var(--wordmark-width) * 20 / 165);
        height: calc(var(--wordmark-width) * 22 / 165);
        overflow: visible;
        transform: rotate(-4deg);
        transform-origin: 24% 77%;
      }

      .logo-butterfly {
        position: absolute;
        inset: 0;
        display: block;
      }

      .logo-butterfly-wing {
        transform-origin: 24% 77%;
      }

      .logo-butterfly-wing-back {
        opacity: 0.22;
        transform: translate(0.6px, 0.2px) rotate(12deg) scale(0.97);
        filter: blur(0.1px);
      }

      .logo-butterfly-wing-front {
        opacity: 0.34;
        transform: translate(-0.2px, 0.1px) rotate(-8deg) scale(1.01);
      }

      .logo-butterfly-path {
        opacity: 1;
      }

      .mark-svg {
        -webkit-user-drag: none;
        user-drag: none;
        user-select: none;
        -webkit-user-select: none;
        pointer-events: none;
      }

      .seo-wordmark-text {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .subtitle {
        margin: 8px 0 0;
        color: #9b9b9b;
        font-size: 17px;
        line-height: 1.45;
        letter-spacing: 0.1px;
        font-weight: 400;
      }

      .is-locale-en .subtitle {
        white-space: normal;
        overflow-wrap: anywhere;
        font-size: 15px;
        letter-spacing: 0;
      }

      .is-locale-en .title {
        letter-spacing: -1px;
      }

      .shortcut-line {
        margin-top: 0;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        width: 100%;
        max-width: 668px;
        opacity: 0;
        transform: translateX(-24px);
        filter: blur(6px);
        animation: x-hero-enter 620ms cubic-bezier(0.22, 1, 0.36, 1) 300ms forwards;
      }

      .shortcut-guide {
        width: 100%;
        padding: 18px;
        border: 1px solid rgba(36, 40, 47, 0.08);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.76);
        box-shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
        backdrop-filter: blur(18px);
      }

      .shortcut-guide-title {
        margin: 0 0 12px;
        color: #111827;
        font-size: 17px;
        line-height: 1.4;
        font-weight: 600;
      }

      .shortcut-code-block {
        position: relative;
        margin: 0;
        padding: 14px 54px 14px 16px;
        border: 1px solid #d0d7de;
        border-radius: 12px;
        background: #f6f8fa;
        color: #24292f;
        overflow: hidden;
      }

