      @keyframes x-kbd-press-modifier {
        0%,
        24.5%,
        100% {
          transform: translateY(0);
          background: linear-gradient(180deg, #ededed 0%, #ffffff 100%);
          box-shadow: 0 5px 0 #000, inset 0 -2px 5px rgba(255, 255, 255, 0.34);
