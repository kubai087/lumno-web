        <span class="top-nav-brand-mark" role="img" aria-label="Lumno" set:html={topWordmarkSvg}></span>
      </a>
      <div class="top-actions">
        <div class="actions" data-node-id="3358:77">
          <a class="pill-btn pill-btn-selected pill-btn-icon-only" href="https://github.com/kubai087/lumno-extension" target="_blank" rel="noreferrer noopener" aria-label={initialUi.settingsAria} data-i18n-aria-label="settings_aria" data-analytics-event="open_github_repo" data-analytics-category="cta" data-analytics-label="onboarding_header_github">
