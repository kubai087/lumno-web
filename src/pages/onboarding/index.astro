    qrcodeCloseAria: "关闭二维码弹窗",
    logoIconAlt: "Lumno 图标",
    shortcutStep1: "复制上方浏览器快捷键设置页地址，粘贴到地址栏并回车访问。",
    shortcutStep2: "在网页中找到 Lumno。",
    shortcutStep3Prefix: "设置/修改「",
    shortcutCommandLabel: "唤起聚焦搜索窗口",
    shortcutStep3Suffix: "」一栏的快捷键。",
