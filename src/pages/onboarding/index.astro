---
import SeoHead from "../../components/SeoHead.astro";
import FeatureGrid from "../../components/onboarding/FeatureGrid";
import LanguageMenu from "../../components/onboarding/LanguageMenu";
import logoIconSvg from "../../assets/onboarding/logo.svg?raw";
import topWordmarkSvg from "../../assets/lumno-title-figma.svg?raw";
import {
  SITE_NAME,
  buildAlternateLinks,
  buildBreadcrumbListSchema,
  buildHowToSchema,
  buildKeywords,
  buildSoftwareApplicationSchema,
  buildWebPageSchema,
  getOpenGraphLocale,
} from "../../lib/seo";
import { buildEntryContextConfig } from "../../lib/entry-context";
import {
  DEFAULT_LOCALE,
  SUPPORTED_ONBOARDING_LANGUAGES,
  buildLocalizedPath,
  buildScopedRouteLanguageMap,
  type SupportedLocale,
} from "../../lib/locales";
import { COMMUNITY_LINKS } from "../../lib/community";

interface Props {
  forcedLocale?: SupportedLocale | null;
  seoPath?: string;
  routeLanguageMap?: Record<string, string>;
}

const forcedLocale = Astro.props.forcedLocale ?? null;
const seoPath = Astro.props.seoPath || "/onboarding/";
const routeLanguageMap = Astro.props.routeLanguageMap || buildScopedRouteLanguageMap("/onboarding/", SUPPORTED_ONBOARDING_LANGUAGES);
const entryContextConfig = buildEntryContextConfig();
const uiLocale = forcedLocale || DEFAULT_LOCALE;
const homeHref = buildLocalizedPath(uiLocale, "/");
const releaseHref = buildLocalizedPath(uiLocale, "/release/");
const WORDMARK_TEXT = "Lumno";
const alternateLinks = buildAlternateLinks(routeLanguageMap, "/onboarding/");
const ogLocale = getOpenGraphLocale(uiLocale);
const pageTitleByLocale = {
  "zh-CN": "Lumno 安装引导｜浏览器命令栏与新标签页快速开始",
  "zh-TW": "Lumno 安裝引導｜瀏覽器命令欄與新分頁快速開始",
  en: "Lumno Onboarding | Browser Command Bar Quick Start",
};
const pageDescriptionByLocale = {
  "zh-CN":
    "了解如何使用 Lumno 浏览器命令栏与快捷命令浮层，快速搜索标签页、书签、历史记录和站内内容，并在 Chrome、Edge、Dia 中延续熟悉的高效搜索体验。",
  "zh-TW":
    "了解如何使用 Lumno 瀏覽器命令欄與快捷命令浮層，快速搜尋分頁、書籤、歷史紀錄與站內內容，並在 Chrome、Edge、Dia 中延續熟悉的高效率搜尋體驗。",
  en:
    "Learn how to use Lumno's focus search and command-bar workflow to search tabs, bookmarks, history, and site content more efficiently on Chrome, Edge, and Dia.",
};
const pageTitle = pageTitleByLocale[uiLocale] || pageTitleByLocale[DEFAULT_LOCALE];
const pageDescription = pageDescriptionByLocale[uiLocale] || pageDescriptionByLocale[DEFAULT_LOCALE];
const pageKeywords = buildKeywords([
  "Lumno 安装引导",
  "Lumno 使用教程",
  "Arc 浏览器迁移",
  "Arc 风格命令栏",
  "浏览器命令栏教程",
]);
const initialUi = {
  "zh-CN": {
    viewRelease: "更新日志",
    joinDiscord: "反馈 & 提需",
    shortcutGuideTitle: "🦋 快速启用 Lumno 聚焦搜索",
    shortcutHowToName: "如何启用 Lumno 浏览器命令栏快捷键",
    shortcutHowToDescription: "设置 Lumno 扩展快捷键后，即可从任意网页唤起聚焦搜索，搜索标签页、书签、历史记录和站内内容。",
    shortcutStepName1: "打开扩展快捷键设置页",
    shortcutStepName2: "找到 Lumno 扩展",
