---
import { marked } from "marked";
import SeoHead from "../../components/SeoHead.astro";
import privacyPolicySource from "../../content/privacy-policy.md?raw";
import {
  SITE_NAME,
  SITE_URL,
  buildBreadcrumbListSchema,
  buildKeywords,
  buildSoftwareApplicationSchema,
  buildWebPageSchema,
} from "../../lib/seo";

const seoPath = "/privacy/";
const pageTitle = "Lumno Privacy Policy | 隐私政策";
const pageDescription =
  "Lumno 隐私政策：说明扩展的本地处理、账号登录、配置与媒体同步、可选账号关联使用统计，以及第三方服务请求。";
const pageKeywords = buildKeywords([
  "Lumno 隐私政策",
  "Lumno privacy policy",
  "Chrome 扩展隐私政策",
  "浏览器扩展隐私声明",
]);
const structuredData = [
  buildSoftwareApplicationSchema({
    description: pageDescription,
  }),
  buildWebPageSchema({
    name: pageTitle,
    description: pageDescription,
    path: seoPath,
  }),
  buildBreadcrumbListSchema({
    items: [
      { name: SITE_NAME, path: "/" },
      { name: "Privacy Policy", path: seoPath },
    ],
  }),
];

// Only repository-owned static Markdown is rendered here. User-provided input
// must never be passed to this renderer without an explicit sanitization step.
const privacyPolicyHtml = marked.parse(privacyPolicySource, {
  async: false,
  gfm: true,
});
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      path={seoPath}
      keywords={pageKeywords}
      locale="zh_CN"
      i18nTitleKey="page_title_ui"
      type="article"
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/onboarding/assets/remixicon.css" />
    <link rel="stylesheet" href="/onboarding/assets/fonts/open-sans/open-sans.css" />
    <style is:global>
      :root {
        --privacy-bg: #ffffff;
        --privacy-text: #17211b;
        --privacy-muted: #667069;
        --privacy-line: #e5e9e6;
        --privacy-line-strong: #d6ddd8;
        --privacy-green: #45634f;
        --privacy-green-soft: #f0f5f1;
        --privacy-paper: #ffffff;
        --safe-area-bottom: 0px;
        --safe-area-bottom: env(safe-area-inset-bottom, 0px);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--privacy-bg);
      }

      body {
        margin: 0;
        min-height: 100%;
        background: var(--privacy-bg);
        color: var(--privacy-text);
        font-family: "Open Sans", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      .privacy-container {
        width: min(1024px, 100%);
        margin: 0 auto;
      }

      .privacy-header {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid color-mix(in srgb, var(--privacy-line) 74%, transparent);
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      }

      .privacy-header-inner {
        min-height: 64px;
        padding: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .privacy-brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }

      .privacy-brand img {
        display: block;
        width: 136px;
        height: auto;
      }

      .privacy-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .privacy-header-link {
        min-height: 36px;
        padding: 0 14px;
        border: 1px solid var(--privacy-line-strong);
        border-radius: 999px;
        background: linear-gradient(180deg, #ffffff 0%, #f1f3f1 100%);
        color: #4f5b53;
        box-shadow: 0 1px 2px rgba(23, 33, 27, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
      }

      .privacy-header-link:focus-visible,
      .privacy-markdown a:focus-visible,
      .privacy-aside-link:focus-visible {
        outline: 2px solid rgba(69, 99, 79, 0.42);
        outline-offset: 3px;
      }

      @media (hover: hover) and (pointer: fine) {
        .privacy-header-link:hover {
          transform: translateY(-1px);
          border-color: #c4cec7;
          box-shadow: 0 8px 18px rgba(23, 33, 27, 0.07);
        }
      }

      .privacy-main {
        padding: 30px 24px max(72px, var(--safe-area-bottom));
      }

      .privacy-banner {
        position: relative;
        width: 100%;
        min-height: 248px;
        margin: 0 0 44px;
        overflow: hidden;
        border-radius: 16px;
        background: #eef3ec;
        aspect-ratio: 2200 / 586;
      }

      .privacy-banner::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(247, 249, 245, 0.96) 0%, rgba(247, 249, 245, 0.84) 38%, rgba(247, 249, 245, 0.16) 72%);
      }

      .privacy-banner img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .privacy-banner-copy {
        position: relative;
        z-index: 1;
        width: min(740px, 76%);
        min-height: 100%;
        padding: clamp(26px, 4vw, 42px);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .privacy-eyebrow {
        margin: 0 0 12px;
        color: #617365;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .privacy-banner h1 {
        margin: 0;
        max-width: 640px;
        font-size: clamp(34px, 4.8vw, 48px);
        font-weight: 520;
        line-height: 1.04;
        letter-spacing: -0.045em;
        color: #24362a;
      }

      .privacy-banner-lead {
        max-width: 580px;
        margin: 12px 0 0;
        color: #58665c;
        font-size: 15px;
        line-height: 1.72;
      }

      .privacy-banner-meta {
        margin: 8px 0 0;
        color: #758078;
        font-size: 12px;
      }

      .privacy-layout {
        display: grid;
        grid-template-columns: 208px minmax(0, 1fr);
        gap: clamp(36px, 6vw, 72px);
        align-items: start;
      }

      .privacy-aside {
        position: sticky;
        top: 96px;
      }

      .privacy-aside-label {
        margin: 0 0 14px;
        color: #8a938d;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .privacy-aside-status {
        width: fit-content;
        margin-bottom: 24px;
        padding: 6px 9px;
        border: 1px solid #dce6df;
        border-radius: 7px;
        background: var(--privacy-green-soft);
        color: var(--privacy-green);
        font-size: 12px;
        font-weight: 700;
      }

      .privacy-meta-list {
        margin: 0;
        display: grid;
        gap: 17px;
      }

      .privacy-meta-list div {
        display: grid;
        gap: 4px;
      }

      .privacy-meta-list dt {
        color: #8a938d;
        font-size: 11px;
        letter-spacing: 0.04em;
      }

      .privacy-meta-list dd {
        margin: 0;
        color: #435047;
        font-size: 13px;
        line-height: 1.55;
      }

      .privacy-aside-links {
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid var(--privacy-line);
        display: grid;
        gap: 12px;
      }

      .privacy-aside-link {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #657168;
        font-size: 13px;
        text-decoration: none;
      }

      .privacy-aside-link:hover {
        color: var(--privacy-green);
      }

      .privacy-paper {
        min-width: 0;
        padding-bottom: 24px;
      }

      .privacy-doc-intro {
        margin-bottom: 42px;
        padding-bottom: 32px;
        border-bottom: 1px solid var(--privacy-line);
      }

      .privacy-doc-intro p {
        margin: 0;
        color: #4f5d54;
        font-size: clamp(17px, 2.3vw, 20px);
        line-height: 1.72;
        letter-spacing: -0.012em;
      }

      .privacy-markdown {
        color: var(--privacy-muted);
        font-size: 15px;
        line-height: 1.86;
      }

      .privacy-markdown h2,
      .privacy-markdown h3 {
        color: var(--privacy-text);
        scroll-margin-top: 96px;
      }

      .privacy-markdown h2 {
        margin: 52px 0 18px;
        padding-top: 42px;
        border-top: 1px solid var(--privacy-line);
        font-size: clamp(23px, 3vw, 28px);
        font-weight: 650;
        line-height: 1.3;
        letter-spacing: -0.032em;
      }

      .privacy-markdown h2:first-child {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
      }

      .privacy-markdown h3 {
        margin: 30px 0 10px;
        font-size: 17px;
        font-weight: 650;
        line-height: 1.45;
        letter-spacing: -0.015em;
      }

      .privacy-markdown p {
        margin: 0 0 16px;
      }

      .privacy-markdown ul,
      .privacy-markdown ol {
        margin: 10px 0 20px;
        padding-left: 1.35em;
      }

      .privacy-markdown li {
        margin: 8px 0;
        padding-left: 4px;
      }

      .privacy-markdown li::marker {
        color: #849589;
      }

      .privacy-markdown strong {
        color: #334238;
        font-weight: 650;
      }

      .privacy-markdown a {
        color: #38654a;
        text-decoration-color: rgba(56, 101, 74, 0.32);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      .privacy-markdown a:hover {
        text-decoration-color: currentColor;
      }

      .privacy-markdown code {
        padding: 0.16em 0.42em;
        border: 1px solid #e1e6e2;
        border-radius: 5px;
        background: #f5f7f5;
        color: #3d5545;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 0.88em;
      }

      .privacy-markdown blockquote {
        margin: 24px 0;
        padding: 18px 20px;
        border: 1px solid #dbe6de;
        border-left: 3px solid #6d8a75;
        border-radius: 0 10px 10px 0;
        background: #f5f8f5;
      }

      .privacy-markdown blockquote p:last-child {
        margin-bottom: 0;
      }

      .privacy-doc-footer {
        margin-top: 52px;
        padding: 24px;
        border: 1px solid #dfe6e1;
        border-radius: 14px;
        background: linear-gradient(135deg, #f7faf7, #ffffff);
        color: #657168;
        font-size: 13px;
        line-height: 1.7;
      }

      .privacy-doc-footer strong {
        display: block;
        margin-bottom: 4px;
        color: #334238;
        font-size: 14px;
      }

      .privacy-doc-footer a {
        color: #38654a;
      }

      @media (max-width: 760px) {
        .privacy-main {
          padding: 20px 12px max(48px, var(--safe-area-bottom));
        }

        .privacy-banner {
          min-height: 330px;
          margin-bottom: 34px;
          aspect-ratio: auto;
        }

        .privacy-banner::after {
          background: linear-gradient(90deg, rgba(247, 249, 245, 0.97) 0%, rgba(247, 249, 245, 0.82) 65%, rgba(247, 249, 245, 0.28) 100%);
        }

        .privacy-banner-copy {
          width: 92%;
          padding: 28px 24px;
        }

        .privacy-layout {
          grid-template-columns: 1fr;
          gap: 34px;
        }

        .privacy-aside {
          position: static;
          display: grid;
          grid-template-columns: auto 1fr;
          gap: 12px 24px;
          padding: 0 8px 28px;
          border-bottom: 1px solid var(--privacy-line);
        }

        .privacy-aside-label,
        .privacy-aside-status,
        .privacy-meta-list,
        .privacy-aside-links {
          grid-column: 1 / -1;
        }

        .privacy-meta-list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .privacy-aside-links {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .privacy-paper {
          padding: 0 8px;
        }
      }

      @media (max-width: 520px) {
        .privacy-header-link-release span {
          display: none;
        }

        .privacy-header-link-release {
          width: 36px;
          padding: 0;
        }

        .privacy-banner h1 {
          font-size: 38px;
        }

        .privacy-banner-lead {
          font-size: 14px;
        }

        .privacy-aside-links {
          grid-template-columns: 1fr;
        }

        .privacy-markdown {
          font-size: 14.5px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="privacy-header">
      <div class="privacy-container privacy-header-inner">
        <a class="privacy-brand" href="/" aria-label="返回 Lumno 首页">
          <img src="/assets/textlogo.svg" alt="Lumno" width="408" height="114" />
        </a>
        <nav class="privacy-header-actions" aria-label="页面导航">
          <a class="privacy-header-link privacy-header-link-release" href="/release/">
            <i class="ri-history-line" aria-hidden="true"></i>
            <span>Release</span>
          </a>
          <a class="privacy-header-link" href="/">
            <span>返回首页</span>
            <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
          </a>
        </nav>
      </div>
    </header>

    <main class="privacy-container privacy-main">
      <section class="privacy-banner" aria-labelledby="privacy-title">
        <img
          src="/resource_commited/banner.jpg"
          alt="Lumno 水彩风景横幅"
          loading="eager"
          decoding="async"
          width="2200"
          height="586"
        />
        <div class="privacy-banner-copy">
          <p class="privacy-eyebrow">Privacy Policy · 隐私政策</p>
          <h1 id="privacy-title">清楚说明，才是真正尊重。</h1>
          <p class="privacy-banner-lead">
            本地处理什么、同步什么、统计什么，以及你可以如何撤回和删除，都写在这里。
          </p>
          <p class="privacy-banner-meta">Effective &amp; last updated · 2026-08-02</p>
        </div>
      </section>

      <section class="privacy-layout" aria-label="隐私政策正文">
        <aside class="privacy-aside" aria-label="文档信息">
          <p class="privacy-aside-label">Document</p>
          <div class="privacy-aside-status">Current · 当前有效</div>
          <dl class="privacy-meta-list">
            <div>
              <dt>Last updated</dt>
              <dd>2026-08-02</dd>
            </div>
            <div>
              <dt>Developer</dt>
              <dd>枯白啃设计<br />Kubai087</dd>
            </div>
            <div>
              <dt>Applies to</dt>
              <dd>Lumno Extension<br />Lumno Account</dd>
            </div>
          </dl>
          <div class="privacy-aside-links">
            <a class="privacy-aside-link" href="mailto:i@kubai.design">
              <i class="ri-mail-line" aria-hidden="true"></i>
              联系隐私团队
            </a>
            <a class="privacy-aside-link" href="/release/">
              <i class="ri-history-line" aria-hidden="true"></i>
              查看更新日志
            </a>
          </div>
        </aside>

        <article class="privacy-paper">
          <div class="privacy-doc-intro">
            <p>
              Lumno 默认尽量在浏览器本地处理历史、书签和标签页。登录后，你可以选择跨设备同步配置与自定义媒体；产品使用统计保持关闭，只有你主动开启后才会上传明确列出的数字和配置属性。
            </p>
          </div>
          <div class="privacy-markdown" set:html={privacyPolicyHtml}></div>
          <footer class="privacy-doc-footer">
            <strong>对这份说明有疑问？</strong>
            请通过 <a href="mailto:i@kubai.design">i@kubai.design</a> 联系我们，或返回 <a href={SITE_URL}>Lumno 官网</a>。
          </footer>
        </article>
      </section>
    </main>
  </body>
</html>
