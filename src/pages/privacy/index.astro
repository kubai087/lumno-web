---
import { marked } from "marked";
import SitePage from "../../layouts/SitePage.astro";
import { DEFAULT_LOCALE, buildLocalizedPath, buildRouteLanguageMap, type SupportedLocale } from "../../lib/locales";
import {
  PRIVACY_LAST_UPDATED,
  PRIVACY_POLICY_VERSION,
  PRIVACY_SECTION_IDS,
  getPrivacyContent,
} from "../../lib/privacy-content";
import { SITE_NAME, buildBreadcrumbListSchema, buildKeywords, buildWebPageSchema } from "../../lib/seo";

interface Props {
  forcedLocale?: SupportedLocale | null;
  seoPath?: string;
  routeLanguageMap?: Record<string, string>;
}

const forcedLocale = Astro.props.forcedLocale ?? null;
const seoPath = Astro.props.seoPath || "/privacy/";
const routeLanguageMap = Astro.props.routeLanguageMap || buildRouteLanguageMap("/privacy/");
const uiLocale: SupportedLocale = forcedLocale || DEFAULT_LOCALE;
const content = getPrivacyContent(uiLocale);
const homeHref = buildLocalizedPath(uiLocale, "/");
const displayLastUpdated = new Intl.DateTimeFormat(uiLocale, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(new Date(`${PRIVACY_LAST_UPDATED}T00:00:00Z`));
const appliesTo = content.appliesToLabel.replace("{version}", PRIVACY_POLICY_VERSION);
const structuredData = [
  {
    ...buildWebPageSchema({
      name: content.pageTitle,
      description: content.pageDescription,
      path: seoPath,
      language: uiLocale,
    }),
    dateModified: PRIVACY_LAST_UPDATED,
  },
  buildBreadcrumbListSchema({
    items: [
      { name: SITE_NAME, path: homeHref },
      { name: content.breadcrumbLabel, path: seoPath },
    ],
  }),
];

const sectionTitles = Array.from(content.policySource.matchAll(/^##\s+(.+)$/gm), (match) => match[1].trim());
if (sectionTitles.length !== PRIVACY_SECTION_IDS.length) {
  throw new Error(
    `privacy-policy (${uiLocale}) has ${sectionTitles.length} sections but PRIVACY_SECTION_IDS lists ${PRIVACY_SECTION_IDS.length}.`,
  );
}
const sections = PRIVACY_SECTION_IDS.map((id, index) => ({ id, title: sectionTitles[index] }));

// Only repository-owned static Markdown is rendered here. User-provided input
// must never be passed to this renderer without an explicit sanitization step.
const renderer = new marked.Renderer();
let sectionIndex = 0;
renderer.heading = function ({ tokens, depth }) {
  const headingContent = this.parser.parseInline(tokens);
  if (depth !== 2) return `<h${depth}>${headingContent}</h${depth}>\n`;
  const id = sections[sectionIndex].id;
  sectionIndex += 1;
  return `<h2 id="${id}">${headingContent}</h2>\n`;
};
const policyHtml = marked
  .parse(content.policySource, { async: false, gfm: true, renderer })
  // Wide tables scroll inside their own frame on narrow screens.
  .replaceAll("<table>", '<div class="doc__table"><table>')
  .replaceAll("</table>", "</table></div>");
---

<SitePage
  locale={uiLocale}
  forcedLocale={forcedLocale}
  basePath="/privacy/"
  seoPath={seoPath}
  routeLanguageMap={routeLanguageMap}
  title={content.pageTitle}
  description={content.pageDescription}
  keywords={buildKeywords(content.pageKeywords)}
  type="article"
  structuredData={structuredData}
  analyticsScope="privacy"
>
  <div class="doc">
    <header class="doc__head">
      <h1>{content.title}</h1>
      <p class="doc__meta">
        {content.lastUpdatedLabel}: <time datetime={PRIVACY_LAST_UPDATED}>{displayLastUpdated}</time> · {appliesTo}
      </p>
    </header>

    <nav class="doc__toc" aria-label={content.tocLabel}>
      <p class="doc__toc-title">{content.tocLabel}</p>
      <ol>
        {sections.map((section) => (
          <li><a href={`#${section.id}`}>{section.title}</a></li>
        ))}
      </ol>
    </nav>

    <article class="doc__body">
      <Fragment set:html={policyHtml} />
    </article>
  </div>
</SitePage>

<style is:global>
  /* Desktop: contents on the left, title and document on the right. Phones: title, contents, document. */
  .doc {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    justify-content: center;
    gap: 0 56px;
    width: var(--home-column);
    margin-inline: auto;
    padding: 128px 0 96px;
  }

  .doc__head {
    grid-column: 2;
    grid-row: 1;
  }

  .doc__toc {
    grid-column: 1;
    grid-row: 1 / span 2;
    position: sticky;
    top: 104px;
    align-self: start;
    max-height: calc(100vh - 128px);
    overflow-y: auto;
    font-size: 14px;
    line-height: 1.5;
  }

  .doc__toc-title {
    margin: 0 0 12px;
    color: var(--text-main);
    font-weight: 650;
  }

  .doc__toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doc__toc li + li {
    margin-top: 8px;
  }

  .doc__toc a {
    color: var(--text-sub);
    text-decoration: none;
  }

  .doc__toc a:hover {
    color: var(--text-main);
  }

  .doc__body {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    color: #3d434a;
    font-size: 16px;
    line-height: 1.75;
  }

  .doc__head h1 {
    margin: 0;
    color: var(--text-main);
    font-size: 32px;
    font-weight: 650;
    line-height: 1.3;
  }

  .doc__meta {
    margin: 8px 0 8px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    color: var(--text-soft);
    font-size: 14px;
  }

  .doc__body h2 {
    margin: 48px 0 16px;
    color: var(--text-main);
    font-size: 22px;
    font-weight: 650;
    line-height: 1.4;
    scroll-margin-top: 104px;
  }

  .doc__body h3 {
    margin: 28px 0 12px;
    color: var(--text-main);
    font-size: 17px;
    font-weight: 650;
  }

  .doc__body p,
  .doc__body ul,
  .doc__body ol {
    margin: 0 0 16px;
  }

  /* Tailwind's preflight strips list markers; the document wants them back. */
  .doc__body ul {
    padding-left: 1.4em;
    list-style: disc;
  }

  .doc__body ol {
    padding-left: 1.4em;
    list-style: decimal;
  }

  .doc__body li + li {
    margin-top: 6px;
  }

  .doc__body strong {
    color: var(--text-main);
    font-weight: 650;
  }

  .doc__body a {
    color: var(--blue-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .doc__body code {
    padding: 1px 5px;
    border-radius: 4px;
    background: #eef0f2;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86em;
  }

  .doc__table {
    margin: 0 0 16px;
    overflow-x: auto;
  }

  .doc__table table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.6;
  }

  .doc__table th,
  .doc__table td {
    padding: 10px 12px;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .doc__table th {
    background: var(--surface-soft);
    color: var(--text-main);
    font-weight: 650;
  }

  .doc__table code {
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 112px;
    }

    .doc__head,
    .doc__toc,
    .doc__body {
      grid-column: 1;
      grid-row: auto;
    }

    .doc__toc {
      position: static;
      max-height: none;
      padding: 24px 0;
      border-bottom: 1px solid var(--line);
    }

    .doc__head h1 {
      font-size: 28px;
    }
  }
</style>
