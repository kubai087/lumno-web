---
import { marked } from "marked";
import OptionsFeedbackSupportLink from "../../components/privacy/OptionsFeedbackSupportLink.astro";
import SeoHead from "../../components/SeoHead.astro";
import { COMMUNITY_LINKS } from "../../lib/community";
import { DEFAULT_LOCALE, buildLocalizedPath, buildRouteLanguageMap, type SupportedLocale } from "../../lib/locales";
import { PRIVACY_LAST_UPDATED, getPrivacyContent } from "../../lib/privacy-content";
import {
  CHROME_STORE_URL,
  SITE_NAME,
  buildAlternateLinks,
  buildBreadcrumbListSchema,
  buildKeywords,
  buildWebPageSchema,
  getOpenGraphLocale,
} from "../../lib/seo";

const forcedLocale = (Astro.props.forcedLocale ?? null) as SupportedLocale | null;
const seoPath = Astro.props.seoPath || "/privacy/";
const routeLanguageMap = Astro.props.routeLanguageMap || buildRouteLanguageMap("/privacy/");
const uiLocale: SupportedLocale = forcedLocale || DEFAULT_LOCALE;
const content = getPrivacyContent(uiLocale);
const displayLastUpdated = new Intl.DateTimeFormat(uiLocale, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(new Date(`${PRIVACY_LAST_UPDATED}T00:00:00Z`));
const homeHref = buildLocalizedPath(uiLocale, "/");
const alternateLinks = buildAlternateLinks(routeLanguageMap, "/privacy/");
const ogLocale = getOpenGraphLocale(uiLocale);
const chromeReviewUrl = `${CHROME_STORE_URL}/reviews?utm_source=item-share-cb`;
const githubIssueUrl = "https://github.com/kubai087/lumno-extension/issues/new";
const communityUsesDiscord = uiLocale === "en";
const communityHref = communityUsesDiscord
  ? COMMUNITY_LINKS.discordUrl
  : COMMUNITY_LINKS.wechatQrImagePath;
const communityIconClass = communityUsesDiscord ? "ri-discord-fill" : "ri-wechat-line";
const pageKeywords = buildKeywords(content.pageKeywords);
const PRIVACY_SECTION_IDS = [
  "scope-and-controller",
  "summary",
  "local-data-and-permissions",
  "data-leaving-device",
  "purposes-and-recipients",
  "retention-and-deletion",
  "choices-and-rights",
  "security-and-responsibility",
  "international-processing-and-children",
  "limited-use-and-policy-changes",
] as const;
const privacySectionTitles = Array.from(content.policySource.matchAll(/^##\s+(.+)$/gm), (match) => match[1].trim());
const privacySections = PRIVACY_SECTION_IDS.map((id, index) => ({
  id,
  title: privacySectionTitles[index] || `${index + 1}`,
  navigationTitle: (privacySectionTitles[index] || `${index + 1}`).replace(/^\d+\.\s*/, ""),
}));
const structuredData = [
  buildWebPageSchema({
    name: content.pageTitle,
    description: content.pageDescription,
    path: seoPath,
    language: uiLocale,
  }),
  buildBreadcrumbListSchema({
    items: [
      { name: SITE_NAME, path: homeHref },
      { name: content.breadcrumbLabel, path: seoPath },
    ],
  }),
];

// Only repository-owned static Markdown is rendered here. User-provided input
// must never be passed to this renderer without an explicit sanitization step.
const privacyRenderer = new marked.Renderer();
let privacySectionIndex = 0;
privacyRenderer.heading = function ({ tokens, depth }) {
  const headingContent = this.parser.parseInline(tokens);
  if (depth !== 2) return `<h${depth}>${headingContent}</h${depth}>\n`;

  const sectionId = privacySections[privacySectionIndex]?.id || `section-${privacySectionIndex + 1}`;
  privacySectionIndex += 1;
  return `<h2 id="${sectionId}" data-privacy-section>${headingContent}</h2>\n`;
};
const privacyPolicyHtml = marked.parse(content.policySource, {
  async: false,
  gfm: true,
  renderer: privacyRenderer,
});
---

<html lang={uiLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script is:inline>
      (() => {
        const autoAnchorStateKey = "__lumnoPrivacyAutoAnchor";
        const navigationEntry = performance.getEntriesByType("navigation")[0];
        const isReload = navigationEntry && navigationEntry.type === "reload";
        const currentState = window.history.state;
        const hasAutoAnchor = Boolean(
          currentState
          && typeof currentState === "object"
          && currentState[autoAnchorStateKey] === true,
        );

        if (!isReload || !window.location.hash || !hasAutoAnchor) return;

        const nextState = { ...currentState };
        delete nextState[autoAnchorStateKey];
        window.history.scrollRestoration = "manual";
        window.history.replaceState(
          nextState,
          "",
          `${window.location.pathname}${window.location.search}`,
        );
        window.addEventListener("DOMContentLoaded", () => window.scrollTo(0, 0), { once: true });
      })();
    </script>
    {
      !forcedLocale && (
        <script is:inline define:vars={{ routeLanguageMap }}>
          (() => {
            const languageStorageKey = "_x_extension_language_2024_unique_";
            const routeMap = routeLanguageMap;

            const normalizeLocale = (locale) => {
              const raw = String(locale || "").trim().toLowerCase();
              if (raw.startsWith("zh")) {
                return raw.includes("tw") || raw.includes("hk") || raw.includes("mo") || raw.includes("hant")
                  ? "zh-TW"
                  : "zh-CN";
              }
              return "en";
            };

            let storedMode = "";
            try {
              storedMode = String(window.localStorage.getItem(languageStorageKey) || "").trim();
            } catch (_error) {
              // Private browsing or blocked storage keeps the default route stable.
            }

            // Keep the x-default URL stable for first-time visitors and crawlers.
            // A previously saved, explicit language choice is still honored before paint.
            if (!storedMode) return;

            const resolvedLocale = storedMode.toLowerCase() === "system"
              ? normalizeLocale(
                  (Array.isArray(navigator.languages) && navigator.languages[0]) || navigator.language || "en",
                )
              : normalizeLocale(storedMode);
            const targetPath = routeMap[resolvedLocale];

            if (targetPath && window.location.pathname !== targetPath) {
              window.location.replace(`${targetPath}${window.location.search}${window.location.hash}`);
            }
          })();
        </script>
      )
    }
    <SeoHead
      title={content.pageTitle}
      description={content.pageDescription}
      path={seoPath}
      keywords={pageKeywords}
      alternates={alternateLinks}
      locale={ogLocale}
      type="article"
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/onboarding/assets/remixicon.css" />
    <link rel="stylesheet" href="/onboarding/assets/fonts/open-sans/open-sans.css" />
    <style is:global>
      :root {
        --privacy-bg: #ffffff;
        --privacy-text: #17211b;
        --privacy-muted: #667069;
        --privacy-line: #e5e9e6;
        --privacy-green: #45634f;
        --privacy-header-line: #eaecf0;
        --privacy-shell-gutter: 12px;
        --privacy-type-caption: 12px;
        --privacy-type-small: 14px;
        --privacy-type-intro: 15px;
        --privacy-type-body: 16px;
        --privacy-type-subheading: 18px;
        --privacy-type-section: clamp(22px, 2.4vw, 24px);
        --privacy-type-title: clamp(30px, 3vw, 32px);
        --safe-area-bottom: 0px;
        --safe-area-bottom: env(safe-area-inset-bottom, 0px);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--privacy-bg);
      }

      body {
        margin: 0;
        min-height: 100%;
        background: var(--privacy-bg);
        color: var(--privacy-text);
        font-family: "Open Sans", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      .privacy-container {
        width: min(1024px, 100%);
        margin: 0 auto;
      }

      .privacy-header {
        position: sticky;
        top: 0;
        z-index: 30;
        border-bottom: 1px solid var(--privacy-header-line);
        background: #ffffff;
      }

      .privacy-header-inner {
        padding: 12px var(--privacy-shell-gutter);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .privacy-brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }

      .privacy-brand img {
        display: block;
        width: 136px;
        height: auto;
      }

      .privacy-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .privacy-header-cta {
        position: relative;
        min-height: 36px;
        padding: 0 14px;
        border: none;
        border-radius: 999px;
        background: linear-gradient(180deg, #404859 0%, #273042 100%);
        color: #ffffff;
        box-shadow:
          0 10px 3px rgba(0, 0, 0, 0),
          0 6px 2px rgba(0, 0, 0, 0.008),
          0 3px 2px rgba(0, 0, 0, 0.035),
          0 2px 2px rgba(0, 0, 0, 0.065),
          0 0 1px rgba(0, 0, 0, 0.075);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: var(--privacy-type-small);
        font-weight: 500;
        line-height: 1;
        text-decoration: none;
        transition:
          transform 180ms ease,
          box-shadow 180ms ease,
          background 180ms ease;
      }

      .privacy-header-cta::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        box-shadow:
          inset 0 0 0 1px #040404,
          inset 0 1px 0 rgba(255, 255, 255, 0.52),
          inset 0 1px 2.4px rgba(255, 255, 255, 0.36);
      }

      .privacy-header-cta i {
        font-size: 18px;
      }

      .privacy-header-cta:focus-visible {
        outline: 2px solid rgba(75, 84, 95, 0.35);
        outline-offset: 2px;
      }

      .privacy-markdown a:focus-visible,
      .privacy-toc-link:focus-visible {
        outline: 2px solid rgba(69, 99, 79, 0.42);
        outline-offset: 3px;
      }

      @media (hover: hover) and (pointer: fine) {
        .privacy-header-cta:hover {
          transform: translateY(-1px);
          background: linear-gradient(180deg, #4a5467 0%, #2f3a4f 100%);
          box-shadow:
            0 12px 4px rgba(0, 0, 0, 0),
            0 7px 3px rgba(0, 0, 0, 0.015),
            0 4px 3px rgba(0, 0, 0, 0.045),
            0 2px 2px rgba(0, 0, 0, 0.075),
            0 0 1px rgba(0, 0, 0, 0.09);
        }
      }

      .privacy-header-cta:active {
        transform: translateY(1px);
        background: linear-gradient(180deg, #3a4353 0%, #232b3b 100%);
        box-shadow:
          0 10px 3px rgba(0, 0, 0, 0),
          0 6px 2px rgba(0, 0, 0, 0.008),
          0 3px 2px rgba(0, 0, 0, 0.035),
          0 2px 2px rgba(0, 0, 0, 0.065),
          0 0 1px rgba(0, 0, 0, 0.075);
      }

      .privacy-main {
        padding: 30px var(--privacy-shell-gutter) max(72px, var(--safe-area-bottom));
      }

      .privacy-layout {
        width: 100%;
        margin-left: 0;
        transform: none;
        display: grid;
        grid-template-columns: minmax(180px, 230px) minmax(0, 1fr);
        column-gap: clamp(24px, 2.8vw, 40px);
        align-items: start;
      }

      .privacy-aside {
        grid-column: 1;
        justify-self: start;
        width: 100%;
        max-width: 230px;
        margin-left: 0;
        min-width: 0;
        position: sticky;
        top: 96px;
        max-height: calc(100vh - 116px);
        padding-left: 0;
        padding-right: 8px;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: #d8ded9 transparent;
      }

      .privacy-meta-list {
        margin: 0;
        display: grid;
        gap: 17px;
      }

      .privacy-meta-list div {
        display: grid;
        gap: 4px;
      }

      .privacy-meta-list dt {
        color: #8a938d;
        font-size: var(--privacy-type-caption);
        line-height: 1.4;
        letter-spacing: 0.04em;
      }

      .privacy-meta-list dd {
        margin: 0;
        color: #435047;
        font-size: var(--privacy-type-small);
        line-height: 1.55;
      }

      .privacy-toc {
        margin-top: 24px;
        padding-top: 18px;
        border-top: 1px solid var(--privacy-line);
      }

      .privacy-toc-title {
        margin: 0 0 8px;
        color: #8a938d;
        font-size: var(--privacy-type-caption);
        font-weight: 650;
        line-height: 1.4;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .privacy-toc-list {
        margin: 0;
        padding: 0;
        display: grid;
        gap: 2px;
        list-style: none;
      }

      .privacy-toc-link {
        display: grid;
        grid-template-columns: 22px minmax(0, 1fr);
        gap: 7px;
        align-items: start;
        padding: 7px 8px;
        border-radius: 8px;
        color: #68736b;
        font-size: var(--privacy-type-small);
        line-height: 1.4;
        text-decoration: none;
        transition: color 160ms ease, background-color 160ms ease;
      }

      .privacy-toc-number {
        color: #a0a9a2;
        font-variant-numeric: tabular-nums;
      }

      .privacy-toc-link:hover {
        background: #f3f6f4;
        color: #3f5f4a;
      }

      .privacy-toc-link[aria-current="location"] {
        background: #edf4ef;
        color: #345640;
        font-weight: 650;
      }

      .privacy-toc-link[aria-current="location"] .privacy-toc-number {
        color: #557763;
      }

      .privacy-aside-links {
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid var(--privacy-line);
        display: grid;
        justify-items: start;
        gap: 4px;
        margin-left: 0;
      }

      .privacy-paper {
        grid-column: 2;
        justify-self: center;
        width: 100%;
        max-width: 780px;
        min-width: 0;
        padding-bottom: 24px;
      }

      .privacy-doc-title {
        margin: 0 0 20px;
        color: var(--privacy-text);
        font-size: var(--privacy-type-title);
        font-weight: 650;
        line-height: 1.22;
        letter-spacing: -0.025em;
      }

      .privacy-doc-intro {
        margin: 0 0 42px;
        padding: 20px 22px;
        border: 1px solid #dbe6de;
        border-left: 3px solid #6d8a75;
        border-radius: 0 12px 12px 0;
        background: linear-gradient(135deg, #f5f8f5 0%, #fafcfa 100%);
      }

      .privacy-doc-intro p {
        margin: 0;
        color: #4f5d54;
        font-size: var(--privacy-type-intro);
        line-height: 1.72;
        letter-spacing: -0.012em;
      }

      .privacy-markdown {
        color: var(--privacy-muted);
        font-size: var(--privacy-type-body);
        line-height: 1.78;
      }

      .privacy-markdown h2,
      .privacy-markdown h3 {
        color: var(--privacy-text);
        scroll-margin-top: 96px;
      }

      .privacy-markdown h2 {
        margin: 52px 0 18px;
        padding-top: 42px;
        border-top: 1px solid var(--privacy-line);
        font-size: var(--privacy-type-section);
        font-weight: 650;
        line-height: 1.32;
        letter-spacing: -0.022em;
      }

      .privacy-markdown h2:first-child {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
      }

      .privacy-markdown h3 {
        margin: 30px 0 10px;
        font-size: var(--privacy-type-subheading);
        font-weight: 650;
        line-height: 1.42;
        letter-spacing: -0.01em;
      }

      .privacy-markdown p {
        margin: 0 0 16px;
      }

      .privacy-markdown ul,
      .privacy-markdown ol {
        margin: 10px 0 20px;
        padding-left: 1.35em;
      }

      .privacy-markdown li {
        margin: 8px 0;
        padding-left: 4px;
      }

      .privacy-markdown li::marker {
        color: #849589;
      }

      .privacy-markdown strong {
        color: #334238;
        font-weight: 650;
      }

      .privacy-markdown a {
        color: #38654a;
        text-decoration-color: rgba(56, 101, 74, 0.32);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      .privacy-markdown a:hover {
        text-decoration-color: currentColor;
      }

      .privacy-markdown code {
        padding: 0.16em 0.42em;
        border: 1px solid #e1e6e2;
        border-radius: 5px;
        background: #f5f7f5;
        color: #3d5545;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 0.88em;
      }

      .privacy-markdown blockquote {
        margin: 24px 0;
        padding: 18px 20px;
        border: 1px solid #dbe6de;
        border-left: 3px solid #6d8a75;
        border-radius: 0 10px 10px 0;
        background: #f5f8f5;
      }

      .privacy-markdown blockquote p:last-child {
        margin-bottom: 0;
      }

      .privacy-markdown table {
        display: block;
        width: 100%;
        margin: 18px 0 26px;
        overflow-x: auto;
        border: 1px solid #e1e6e2;
        border-radius: 10px;
        border-collapse: separate;
        border-spacing: 0;
        background: #ffffff;
        font-size: var(--privacy-type-small);
        line-height: 1.6;
        -webkit-overflow-scrolling: touch;
      }

      .privacy-markdown thead,
      .privacy-markdown tbody,
      .privacy-markdown tr {
        width: 100%;
      }

      .privacy-markdown th,
      .privacy-markdown td {
        min-width: 140px;
        padding: 12px 14px;
        border-right: 1px solid #e7ebe8;
        border-bottom: 1px solid #e7ebe8;
        text-align: left;
        vertical-align: top;
      }

      .privacy-markdown th {
        background: #f5f8f5;
        color: #334238;
        font-weight: 650;
      }

      .privacy-markdown th:last-child,
      .privacy-markdown td:last-child {
        border-right: 0;
      }

      .privacy-markdown tr:last-child td {
        border-bottom: 0;
      }

      .privacy-doc-footer {
        margin-top: 52px;
        padding: 24px;
        border: 1px solid #dfe6e1;
        border-radius: 14px;
        background: linear-gradient(135deg, #f7faf7, #ffffff);
        color: #657168;
        font-size: var(--privacy-type-small);
        line-height: 1.65;
      }

      .privacy-doc-footer strong {
        display: block;
        margin-bottom: 4px;
        color: #334238;
        font-size: var(--privacy-type-body);
      }

      .privacy-doc-footer a {
        color: #38654a;
      }

      .lang-control {
        position: fixed;
        right: 24px;
        bottom: calc(24px + var(--safe-area-bottom));
        z-index: 22;
        width: 38px;
      }

      .lang-toggle {
        width: 38px;
        min-width: 38px;
        height: 38px;
        padding: 0;
        border: 1px solid transparent;
        border-radius: 999px;
        appearance: none;
        -webkit-appearance: none;
        background: transparent;
        box-shadow: none;
        color: #4b545f;
        -webkit-text-fill-color: currentColor;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        font: inherit;
        font-size: 16px;
        transition: border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
      }

      .lang-toggle,
      .lang-toggle i,
      .lang-select-prefix,
      .lang-select-arrow {
        color: inherit;
        -webkit-text-fill-color: currentColor;
      }

      .lang-toggle i {
        font-size: 16px;
        line-height: 1;
      }

      .lang-toggle:focus-visible {
        outline: 2px solid rgba(75, 84, 95, 0.35);
        outline-offset: 2px;
      }

      .lang-select-prefix {
        width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .lang-current-label {
        display: none;
        flex: 1 1 auto;
        min-width: 0;
        color: #4b545f;
        font-size: var(--privacy-type-small);
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .lang-select-arrow {
        display: none;
        width: 16px;
        height: 16px;
        align-items: center;
        justify-content: center;
        color: #768095;
      }

      @media (hover: hover) and (pointer: fine) {
        .lang-toggle:hover {
          border-color: #d2d8df;
          background: rgba(255, 255, 255, 0.72);
          box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }
      }

      .lang-toggle:active {
        border-color: #ccd3db;
        background: rgba(255, 255, 255, 0.78);
        box-shadow: none;
      }

      .lang-menu {
        --language-menu-radius: 12px;
        --language-menu-border-width: 1px;
        --language-menu-padding: 6px;
        --language-option-radius: max(
          0px,
          calc(
            var(--language-menu-radius) -
            var(--language-menu-border-width) -
            var(--language-menu-padding)
          )
        );
        position: absolute;
        right: 0;
        bottom: calc(100% + 8px);
        z-index: 36;
        min-width: 180px;
        padding: var(--language-menu-padding);
        border: var(--language-menu-border-width) solid #e2e2e2;
        border-radius: var(--language-menu-radius);
        background: #ffffff;
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.12);
        display: flex;
        flex-direction: column;
        gap: 4px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(6px) scale(0.97);
        transform-origin: bottom right;
        pointer-events: none;
        transition: opacity 180ms ease, transform 180ms ease;
      }

      .lang-menu[data-open="true"] {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
        pointer-events: auto;
      }

      .lang-option {
        width: 100%;
        padding: 7px 9px;
        border: 0;
        border-radius: var(--language-option-radius, 8px);
        background: transparent;
        color: #3f4650;
        cursor: pointer;
        font: inherit;
        font-size: var(--privacy-type-small);
        text-align: left;
      }

      .lang-option:hover {
        background: #f3f5f7;
      }

      .lang-option.is-active {
        background: #eaf3ff;
        color: #2a5da7;
        font-weight: 600;
      }

      @media (max-width: 760px) {
        .privacy-header-inner {
          padding: 14px var(--privacy-shell-gutter);
          gap: 10px;
        }

        .privacy-brand {
          flex: 0 1 auto;
          min-width: 0;
        }

        .privacy-brand img {
          width: clamp(90px, 28vw, 136px);
        }

        .privacy-header-actions {
          margin-left: auto;
          gap: 6px;
          min-width: 0;
        }

        .lang-control {
          left: 16px;
          right: 16px;
          bottom: calc(16px + var(--safe-area-bottom));
          width: auto;
        }

        .lang-toggle {
          width: 100%;
          min-width: 0;
          min-height: 40px;
          padding: 0 12px;
          border: 1px solid #dbe1e8;
          border-radius: 10px;
          background: #ffffff;
          box-shadow: 0 6px 18px rgba(14, 24, 38, 0.08);
          display: grid;
          grid-template-columns: 1fr auto 1fr;
          align-items: center;
          gap: 10px;
        }

        .lang-current-label,
        .lang-select-arrow {
          display: inline-flex;
        }

        .lang-current-label {
          display: block;
          flex: none;
          justify-self: center;
          max-width: 100%;
          padding: 0 6px;
          text-align: center;
        }

        .lang-select-prefix {
          width: 18px;
          justify-self: start;
        }

        .lang-select-arrow {
          width: 18px;
          justify-self: end;
        }

        .lang-menu {
          left: 0;
          right: auto;
          width: 100%;
          min-width: 0;
          transform-origin: bottom center;
        }

        .privacy-main {
          padding: 20px var(--privacy-shell-gutter) max(96px, var(--safe-area-bottom));
        }

        .privacy-layout {
          width: 100%;
          margin-left: 0;
          transform: none;
          grid-template-columns: 1fr;
          gap: 34px;
        }

        .privacy-aside {
          grid-column: 1;
          width: 100%;
          max-width: none;
          margin-left: 0;
          position: static;
          max-height: none;
          display: grid;
          grid-template-columns: auto 1fr;
          gap: 12px 24px;
          padding: 0 8px 28px;
          overflow: visible;
          border-bottom: 1px solid var(--privacy-line);
        }

        .privacy-meta-list,
        .privacy-toc,
        .privacy-aside-links {
          grid-column: 1 / -1;
        }

        .privacy-meta-list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .privacy-aside-links {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .privacy-toc {
          display: none;
          margin-top: 6px;
          padding-top: 18px;
        }

        .privacy-toc-list {
          margin: 0 -8px;
          padding: 0 8px 8px;
          display: flex;
          gap: 8px;
          overflow-x: auto;
          scroll-snap-type: x proximity;
          scrollbar-width: none;
          -webkit-overflow-scrolling: touch;
        }

        .privacy-toc-list::-webkit-scrollbar {
          display: none;
        }

        .privacy-toc-item {
          flex: 0 0 auto;
          scroll-snap-align: start;
        }

        .privacy-toc-link {
          width: min(72vw, 280px);
          height: 100%;
          padding: 10px 11px;
          border: 1px solid #e3e8e4;
          background: #ffffff;
        }

        .privacy-paper {
          grid-column: 1;
          width: 100%;
          max-width: none;
          padding: 0 8px;
        }

        .privacy-doc-title {
          margin-bottom: 16px;
        }

        .privacy-doc-intro {
          padding: 18px;
        }
      }

      @media (max-width: 520px) {
        .privacy-aside-links {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </head>
  <body data-privacy-locale={uiLocale}>
    <header class="privacy-header">
      <div class="privacy-container privacy-header-inner">
        <a class="privacy-brand" href={homeHref} aria-label={content.brandHomeAria}>
          <img src="/resource_commited/logo.png" alt="Lumno" draggable="false" />
        </a>
        <nav class="privacy-header-actions" aria-label={content.pageNavigationAria}>
          <a class="privacy-header-cta" href={homeHref} aria-label={content.officialSiteAria}>
            <span>{content.officialSiteLabel}</span>
            <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
          </a>
        </nav>
      </div>
    </header>

    <main class="privacy-container privacy-main">
      <section class="privacy-layout" aria-label={content.policySectionAria}>
        <aside class="privacy-aside" aria-label={content.metadataAria}>
          <dl class="privacy-meta-list">
            <div>
              <dt>{content.lastUpdatedLabel}</dt>
              <dd>{displayLastUpdated}</dd>
            </div>
          </dl>
          <nav class="privacy-toc" aria-label={content.tocLabel}>
            <p class="privacy-toc-title">{content.tocLabel}</p>
            <ol class="privacy-toc-list">
              {privacySections.map((section, index) => (
                <li class="privacy-toc-item">
                  <a
                    class="privacy-toc-link"
                    href={`#${section.id}`}
                    data-privacy-toc-link
                    data-section-id={section.id}
                  >
                    <span class="privacy-toc-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <span>{section.navigationTitle}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
          <div class="privacy-aside-links">
            <OptionsFeedbackSupportLink
              feedbackKey="community"
              href={communityHref}
              iconClass={communityIconClass}
              label={content.communityLabel}
            />
            <OptionsFeedbackSupportLink
              feedbackKey="chrome-review"
              href={chromeReviewUrl}
              iconClass="ri-star-line"
              label={content.reviewLabel}
            />
            <OptionsFeedbackSupportLink
              feedbackKey="github-issue"
              href={githubIssueUrl}
              iconClass="ri-github-line"
              label={content.issueLabel}
            />
            <OptionsFeedbackSupportLink
              feedbackKey="contact-author"
              href={COMMUNITY_LINKS.xUrl}
              iconClass="ri-twitter-x-line"
              label={content.authorLabel}
            />
          </div>
        </aside>

        <article class="privacy-paper">
          <h1 class="privacy-doc-title">{content.articleTitle}</h1>
          <blockquote class="privacy-doc-intro">
            <p>{content.intro}</p>
          </blockquote>
          <div class="privacy-markdown" set:html={privacyPolicyHtml}></div>
          <footer class="privacy-doc-footer">
            <strong>{content.footerTitle}</strong>
            {content.footerBeforeEmail} <a href="mailto:i@kubai.design">i@kubai.design</a> {content.footerAfterEmail} <a href={homeHref}>{content.footerHomeLabel}</a>{uiLocale === "en" ? "." : "。"}
          </footer>
        </article>
      </section>
    </main>
    <div class="lang-control">
      <button
        id="language-toggle"
        class="lang-toggle"
        type="button"
        aria-label={content.languageSelectAria}
        aria-haspopup="menu"
        aria-expanded="false"
      >
        <span class="lang-select-prefix">
          <i class="ri-global-line" aria-hidden="true"></i>
        </span>
        <span id="language-current-label" class="lang-current-label">{content.languageLabel}</span>
        <span class="lang-select-arrow" aria-hidden="true">
          <i class="ri-arrow-down-s-line"></i>
        </span>
      </button>
      <div id="language-menu" class="lang-menu" role="menu" data-open="false">
        <button class="lang-option" type="button" role="menuitemradio" data-lang-value="zh-CN">简体中文</button>
        <button class="lang-option" type="button" role="menuitemradio" data-lang-value="zh-TW">繁體中文</button>
        <button class="lang-option" type="button" role="menuitemradio" data-lang-value="en">English</button>
      </div>
    </div>
    <script>
      import "../../scripts/language-preference";
      import "../../scripts/language-runtime";
    </script>
    <script is:inline>
      (() => {
        const sections = Array.from(document.querySelectorAll("[data-privacy-section]"));
        const tocLinks = Array.from(document.querySelectorAll("[data-privacy-toc-link]"));
        if (!sections.length || !tocLinks.length) return;

        const tocLinksById = new Map(
          tocLinks.map((link) => [link.getAttribute("data-section-id") || "", link]),
        );
        const autoAnchorStateKey = "__lumnoPrivacyAutoAnchor";
        let activeSectionId = "";
        let scrollFrame = 0;
        let navigationTargetId = "";
        let navigationUnlockTimer = 0;

        function replaceCurrentAnchor(sectionId) {
          const nextHash = sectionId ? `#${encodeURIComponent(sectionId)}` : "";
          if (window.location.hash === nextHash) return;
          const currentState = window.history.state;
          const nextState = currentState && typeof currentState === "object"
            ? { ...currentState }
            : {};
          nextState[autoAnchorStateKey] = true;
          window.history.replaceState(
            nextState,
            "",
            `${window.location.pathname}${window.location.search}${nextHash}`,
          );
        }

        function clearAutoAnchorState() {
          const currentState = window.history.state;
          if (
            !currentState
            || typeof currentState !== "object"
            || currentState[autoAnchorStateKey] !== true
          ) return;

          const nextState = { ...currentState };
          delete nextState[autoAnchorStateKey];
          window.history.replaceState(nextState, "", window.location.href);
        }

        function setActiveSection(sectionId, syncAnchor = true) {
          if (activeSectionId === sectionId) return;
          activeSectionId = sectionId;
          tocLinksById.forEach((link, id) => {
            if (id === sectionId) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          });
          if (syncAnchor) replaceCurrentAnchor(sectionId);
        }

        function readCurrentSection() {
          if (navigationTargetId) return;
          const anchorOffset = 112;
          let currentSectionId = "";
          for (const section of sections) {
            if (section.getBoundingClientRect().top > anchorOffset) break;
            currentSectionId = section.id;
          }
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24) {
            currentSectionId = sections[sections.length - 1].id;
          }
          setActiveSection(currentSectionId);
        }

        function scheduleCurrentSectionRead() {
          if (scrollFrame) return;
          scrollFrame = window.requestAnimationFrame(() => {
            scrollFrame = 0;
            readCurrentSection();
          });
        }

        tocLinks.forEach((link) => {
          link.addEventListener("click", () => {
            const sectionId = link.getAttribute("data-section-id") || "";
            if (!sectionId) return;
            clearAutoAnchorState();
            navigationTargetId = sectionId;
            setActiveSection(sectionId, false);
            window.clearTimeout(navigationUnlockTimer);
            navigationUnlockTimer = window.setTimeout(() => {
              navigationTargetId = "";
              readCurrentSection();
            }, 900);
          });
        });

        window.addEventListener("scroll", scheduleCurrentSectionRead, { passive: true });
        window.addEventListener("resize", scheduleCurrentSectionRead);
        window.addEventListener("hashchange", scheduleCurrentSectionRead);
        const initialSectionId = window.location.hash.slice(1);
        if (tocLinksById.has(initialSectionId)) {
          navigationTargetId = initialSectionId;
          setActiveSection(initialSectionId, false);
          navigationUnlockTimer = window.setTimeout(() => {
            navigationTargetId = "";
            readCurrentSection();
          }, 900);
        } else {
          readCurrentSection();
        }
      })();
    </script>
    <script is:inline define:vars={{ forcedLocale, routeLanguageMap }}>
      const LANGUAGE_STORAGE_KEY = "_x_extension_language_2024_unique_";
      const FORCED_LOCALE = forcedLocale;
      const DEFAULT_PRIVACY_LOCALE = "zh-CN";
      const ROUTE_LANGUAGE_MAP = routeLanguageMap;

      function normalizeLocale(locale) {
        const raw = String(locale || "").trim().toLowerCase();
        if (!raw) return "en";
        if (raw.startsWith("zh")) {
          return raw.includes("tw") || raw.includes("hk") || raw.includes("mo") || raw.includes("hant")
            ? "zh-TW"
            : "zh-CN";
        }
        return "en";
      }

      function getSystemLocale() {
        const preferred = Array.isArray(navigator.languages) && navigator.languages.length
          ? navigator.languages[0]
          : navigator.language;
        return normalizeLocale(preferred || "en");
      }

      function normalizeLanguageMode(mode) {
        const raw = String(mode || "").trim();
        if (!raw || raw.toLowerCase() === "system") return getSystemLocale();
        return normalizeLocale(raw);
      }

      function updateLanguageOptionState(locale) {
        let activeLabel = "";
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const value = node.getAttribute("data-lang-value") || getSystemLocale();
          const isActive = value === locale;
          node.classList.toggle("is-active", isActive);
          node.setAttribute("aria-checked", isActive ? "true" : "false");
          if (isActive) activeLabel = (node.textContent || "").trim();
        });
        const currentLabel = document.getElementById("language-current-label");
        if (currentLabel && activeLabel) currentLabel.textContent = activeLabel;
      }

      function applyResolvedLanguage(locale) {
        document.documentElement.lang = locale;
        document.body.setAttribute("data-privacy-locale", locale);
        updateLanguageOptionState(locale);
      }

      function initLanguageRuntime() {
        if (!window.__lumnoLanguagePreference || !window.__lumnoLanguageRuntime) return null;
        const storedMode = window.__lumnoLanguagePreference.getStoredLanguageMode(LANGUAGE_STORAGE_KEY);
        const initialForcedLocale = FORCED_LOCALE || (!storedMode ? DEFAULT_PRIVACY_LOCALE : null);
        return window.__lumnoLanguageRuntime.setupLanguageRuntime({
          forcedLocale: initialForcedLocale,
          getSystemLocale,
          normalizeLanguageMode,
          routeLanguageMap: ROUTE_LANGUAGE_MAP,
          languageStorageKey: LANGUAGE_STORAGE_KEY,
          applyResolvedLanguage,
        });
      }

      function bootLanguageRuntime() {
        const languageRuntime = initLanguageRuntime();
        if (!languageRuntime) return false;
        languageRuntime.applyLanguageMode(languageRuntime.getInitialLanguageMode());
        return true;
      }

      if (!bootLanguageRuntime()) {
        const retryBootLanguageRuntime = () => {
          if (!bootLanguageRuntime()) return;
          window.removeEventListener("lumno:language-runtime-ready", retryBootLanguageRuntime);
          window.removeEventListener("lumno:language-preference-ready", retryBootLanguageRuntime);
        };
        window.addEventListener("lumno:language-runtime-ready", retryBootLanguageRuntime);
        window.addEventListener("lumno:language-preference-ready", retryBootLanguageRuntime);
      }
    </script>
  </body>
</html>
