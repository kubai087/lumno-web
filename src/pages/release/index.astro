---
import SeoHead from "../../components/SeoHead.astro";
import PageFooter from "../../components/site/PageFooter.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import "../../styles/globals.css";
import "../../styles/home.css";
import "../../styles/locale-fonts.css";
import { fetchReleases, formatDate, isReleaseNoteLocale, parseReleaseBody } from "../../lib/releases";
import { getStoreVersions } from "../../lib/store-versions";
import { marked } from "marked";
import {
  SITE_NAME,
  buildAlternateLinks,
  buildBreadcrumbListSchema,
  buildItemListSchema,
  buildKeywords,
  buildSoftwareApplicationSchema,
  buildWebPageSchema,
  getOpenGraphLocale,
} from "../../lib/seo";
import { buildEntryContextConfig } from "../../lib/entry-context";
import LocaleNormalizer from "../../components/LocaleNormalizer.astro";
import {
  DEFAULT_LOCALE,
  LOCALE_CONFIG,
  SUPPORTED_UI_LANGUAGES,
  buildLocalizedPath,
  buildRouteLanguageMap,
  getLocaleScript,
  type SupportedLocale,
} from "../../lib/locales";
import { CHROME_STORE_URL, GITHUB_URL } from "../../lib/site-links";

interface Props {
  forcedLocale?: SupportedLocale | null;
  seoPath?: string;
  routeLanguageMap?: Record<string, string>;
}

const releases = (await fetchReleases()).map((item) => ({
  ...item,
  parsed: parseReleaseBody(item.body),
}));
const latestReleaseVersion = String(releases[0]?.tag || "").trim();
const forcedLocale = Astro.props.forcedLocale ?? null;
const seoPath = Astro.props.seoPath || "/release/";
const routeLanguageMap = Astro.props.routeLanguageMap || buildRouteLanguageMap("/release/");
const entryContextConfig = buildEntryContextConfig(latestReleaseVersion);
const uiLocale = forcedLocale || DEFAULT_LOCALE;
const homeHref = buildLocalizedPath(uiLocale, "/");
// GitHub Releases carry notes in Simplified Chinese and English (Traditional is converted);
// other languages read the English notes under their own interface.
const releaseContentLocale = isReleaseNoteLocale(uiLocale) ? uiLocale : "en";
// A page whose notes are another language's would only duplicate that page in search,
// so those routes stay out of the index and out of every page's hreflang list.
const indexedReleaseLanguageMap = Object.fromEntries(
  Object.entries(routeLanguageMap).filter(([locale]) => isReleaseNoteLocale(locale)),
);
const alternateLinks = buildAlternateLinks(indexedReleaseLanguageMap, "/release/");
const ogLocale = getOpenGraphLocale(uiLocale);
const v = latestReleaseVersion ? `v${latestReleaseVersion}` : "";
const pageTitleByLocale: Record<SupportedLocale, string> = {
  "zh-CN": v ? `Lumno 更新日志｜${v} 与浏览器命令栏发布记录` : "Lumno 更新日志｜浏览器命令栏与新标签页发布记录",
  "zh-TW": v ? `Lumno 更新日誌｜${v} 與瀏覽器命令列發布紀錄` : "Lumno 更新日誌｜瀏覽器命令列與新分頁發布紀錄",
  en: v ? `Lumno Changelog | ${v} Browser Command Bar Release Notes` : "Lumno Changelog | Browser Command Bar Release Notes",
  ja: v ? `Lumno 更新履歴｜${v} とこれまでのリリースノート` : "Lumno 更新履歴｜コマンドバーと新しいタブのリリースノート",
  ko: v ? `Lumno 업데이트 내역 | ${v} 릴리스 노트` : "Lumno 업데이트 내역 | 커맨드 바와 새 탭 릴리스 노트",
  de: v ? `Lumno-Versionshinweise | ${v} und alle Updates` : "Lumno-Versionshinweise | Befehlsleiste und neuer Tab",
  fr: v ? `Notes de version de Lumno | ${v} et mises à jour` : "Notes de version de Lumno | Barre de commande et nouvel onglet",
  es: v ? `Notas de la versión de Lumno | ${v} y novedades` : "Notas de la versión de Lumno | Barra de comandos y nueva pestaña",
  "pt-BR": v ? `Notas de versão do Lumno | ${v} e novidades` : "Notas de versão do Lumno | Barra de comandos e nova aba",
  ru: v ? `История изменений Lumno — ${v} и все обновления` : "История изменений Lumno — командная панель и новая вкладка",
