---
import SeoHead from "../../components/SeoHead.astro";
import { fetchReleases, formatDate, parseReleaseBody, type ParsedReleaseBody, type ReleaseLocaleContent } from "../../lib/releases";
import { getStoreVersions } from "../../lib/store-versions";
import { marked } from "marked";
import {
  SITE_NAME,
  buildAlternateLinks,
  buildBreadcrumbListSchema,
  buildItemListSchema,
  buildKeywords,
  buildSoftwareApplicationSchema,
  buildWebPageSchema,
  getOpenGraphLocale,
} from "../../lib/seo";
import { buildEntryContextConfig } from "../../lib/entry-context";
import { DEFAULT_LOCALE, buildLocalizedPath, buildRouteLanguageMap, type SupportedLocale } from "../../lib/locales";
import { COMMUNITY_LINKS } from "../../lib/community";

interface Props {
  forcedLocale?: SupportedLocale | null;
  seoPath?: string;
  routeLanguageMap?: Record<string, string>;
}

const releases = (await fetchReleases()).map((item) => ({
  ...item,
  parsed: parseReleaseBody(item.body),
}));
const latestReleaseVersion = String(releases[0]?.tag || "").trim();
const forcedLocale = Astro.props.forcedLocale ?? null;
const seoPath = Astro.props.seoPath || "/release/";
const routeLanguageMap = Astro.props.routeLanguageMap || buildRouteLanguageMap("/release/");
const entryContextConfig = buildEntryContextConfig(latestReleaseVersion);
const uiLocale = forcedLocale || DEFAULT_LOCALE;
const homeHref = buildLocalizedPath(uiLocale, "/");
const releaseContentLocale = uiLocale === "zh-TW" ? "zh-TW" : uiLocale === "zh-CN" ? "zh-CN" : "en";
const alternateLinks = buildAlternateLinks(routeLanguageMap, "/release/");
const ogLocale = getOpenGraphLocale(uiLocale);
const pageTitleByLocale = {
  "zh-CN": latestReleaseVersion
    ? `Lumno 更新日志｜v${latestReleaseVersion} 与浏览器命令栏发布记录`
    : "Lumno 更新日志｜浏览器命令栏与新标签页发布记录",
  "zh-TW": latestReleaseVersion
    ? `Lumno 更新日誌｜v${latestReleaseVersion} 與瀏覽器命令欄發布記錄`
    : "Lumno 更新日誌｜瀏覽器命令欄與新分頁發布記錄",
  en: latestReleaseVersion
    ? `Lumno Changelog | v${latestReleaseVersion} Browser Command Bar Release Notes`
    : "Lumno Changelog | Browser Command Bar Release Notes",
};
const pageDescriptionByLocale = {
  "zh-CN": latestReleaseVersion
    ? `查看 Lumno 浏览器命令栏、聚焦搜索与极简新标签页的版本更新、功能发布与问题修复。当前最新版本为 v${latestReleaseVersion}。`
    : "查看 Lumno 浏览器命令栏、聚焦搜索与极简新标签页的版本更新、功能发布与问题修复。",
  "zh-TW": latestReleaseVersion
    ? `查看 Lumno 瀏覽器命令欄、聚焦搜尋與極簡新分頁的版本更新、功能發布與問題修復。目前最新版本為 v${latestReleaseVersion}。`
    : "查看 Lumno 瀏覽器命令欄、聚焦搜尋與極簡新分頁的版本更新、功能發布與問題修復。",
  en: latestReleaseVersion
    ? `Follow Lumno release notes for focus search, browser command bar, and minimalist new tab updates. The latest version is v${latestReleaseVersion}.`
    : "Follow Lumno release notes for focus search, browser command bar, and minimalist new tab updates.",
};
const pageTitle = pageTitleByLocale[uiLocale] || pageTitleByLocale[DEFAULT_LOCALE];
const pageDescription = pageDescriptionByLocale[uiLocale] || pageDescriptionByLocale[DEFAULT_LOCALE];
const pageKeywords = buildKeywords([
  "Lumno 更新日志",
  "Lumno changelog",
  "浏览器命令栏更新",
  "新标签页更新",
  "Dia 支持",
  "Arc 浏览器迁移",
]);
const initialUi = {
  "zh-CN": {
    joinDiscord: "反馈 & 提需",
    bannerTitle: "Lumno 更新日志",
    brandHomeAria: "回到 Lumno 首页",
    brandLogoAlt: "Lumno",
    githubRepoAria: "访问 Lumno GitHub 仓库",
    xAria: "访问 Lumno X 主页",
    discordAria: "反馈与提需",
    bannerAlt: "Lumno 横幅",
    languageSelectAria: "语言",
    readOnGithub: "在 GitHub 查看",
    languageLabel: "简体中文",
    noReleasesTitle: "暂无发布记录",
    noReleasesDesc: "创建 GitHub Release 后，将在下一次部署时自动显示。",
    qrcodeTitle: "微信群二维码",
    qrcodeImageAlt: "Lumno 微信群二维码",
    qrcodeCloseAria: "关闭二维码弹窗",
  },
  "zh-TW": {
    joinDiscord: "反饋 & 提需",
    bannerTitle: "Lumno 更新日誌",
    brandHomeAria: "回到 Lumno 首頁",
    brandLogoAlt: "Lumno",
    githubRepoAria: "造訪 Lumno GitHub 倉庫",
    xAria: "造訪 Lumno X 主頁",
    discordAria: "反饋與提需",
    bannerAlt: "Lumno 橫幅",
    languageSelectAria: "語言",
    readOnGithub: "在 GitHub 查看",
    languageLabel: "繁體中文",
    noReleasesTitle: "暫無發布記錄",
    noReleasesDesc: "建立 GitHub Release 後，將在下一次部署時自動顯示。",
    qrcodeTitle: "微信群二維碼",
    qrcodeImageAlt: "Lumno 微信群二維碼",
    qrcodeCloseAria: "關閉二維碼彈窗",
  },
  en: {
    joinDiscord: "Feedback & Requests",
    bannerTitle: "Lumno Release Notes",
    brandHomeAria: "Back to the Lumno homepage",
    brandLogoAlt: "Lumno",
    githubRepoAria: "Open the Lumno GitHub repository",
    xAria: "Visit Lumno on X",
    discordAria: "Feedback and requests",
    bannerAlt: "Lumno banner",
    languageSelectAria: "Language",
    readOnGithub: "View on GitHub",
    languageLabel: "English",
    noReleasesTitle: "No releases yet",
    noReleasesDesc: "Publish a GitHub Release and it will appear here after the next deploy.",
    qrcodeTitle: "WeChat group QR code",
    qrcodeImageAlt: "Lumno WeChat group QR code",
    qrcodeCloseAria: "Close QR code dialog",
  },
}[uiLocale];
const releaseItemListSchema = releases.length
  ? buildItemListSchema({
      name: pageTitle,
      description: pageDescription,
      path: seoPath,
      language: uiLocale,
      items: releases.map((item) => {
        const localeContent = item.parsed.locales[releaseContentLocale];
        const description =
          localeContent.summary ||
          localeContent.features[0] ||
          localeContent.bugFixes[0] ||
          item.name;

        return {
          name: item.name,
          description,
          url: item.url,
          type: "CreativeWork",
          datePublished: item.date || undefined,
        };
      }),
    })
  : null;
const structuredData = [
  buildSoftwareApplicationSchema({
    description: pageDescription,
    version: latestReleaseVersion || undefined,
  }),
  buildWebPageSchema({
    name: pageTitle,
    description: pageDescription,
    path: seoPath,
    language: uiLocale,
    mainEntity: releaseItemListSchema || undefined,
  }),
  ...(releaseItemListSchema ? [releaseItemListSchema] : []),
  buildBreadcrumbListSchema({
    items: [
      { name: SITE_NAME, path: homeHref },
      { name: pageTitle, path: seoPath },
    ],
  }),
];

const { chrome: chromeStoreVersion } = await getStoreVersions({
  chrome: import.meta.env.PUBLIC_CHROME_STORE_VERSION || import.meta.env.CHROME_STORE_VERSION,
  edge: import.meta.env.PUBLIC_EDGE_STORE_VERSION || import.meta.env.EDGE_STORE_VERSION,
});

function renderMdInline(markdown: string): string {
  return marked.parseInline(markdown || "", { async: false });
}

function renderMdBlock(markdown: string): string {
  return marked.parse(markdown || "", { async: false });
}

function hasLocaleContent(content: ReleaseLocaleContent): boolean {
  return Boolean(content.summary || content.features.length > 0 || content.bugFixes.length > 0);
}

function normalizeVersion(raw: string): number[] {
  const parts = String(raw || "")
    .replace(/^[^\d]*/, "")
    .match(/\d+/g);
  return (parts || []).map((part) => Number(part));
}

function compareVersion(a: string, b: string): number {
  const pa = normalizeVersion(a);
  const pb = normalizeVersion(b);
  const length = Math.max(pa.length, pb.length);
  for (let i = 0; i < length; i += 1) {
    const va = pa[i] || 0;
    const vb = pb[i] || 0;
    if (va > vb) return 1;
    if (va < vb) return -1;
  }
  return 0;
}

function getChromeStatusI18nKey(tag: string): "chrome_published" | "chrome_reviewing" | null {
  if (!chromeStoreVersion) return null;
  return compareVersion(chromeStoreVersion, tag) >= 0
    ? "chrome_published"
    : "chrome_reviewing";
}
---

<html lang={uiLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      path={seoPath}
      keywords={pageKeywords}
      alternates={alternateLinks}
      locale={ogLocale}
      type="article"
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/onboarding/assets/remixicon.css" />
    <link rel="stylesheet" href="/onboarding/assets/fonts/open-sans/open-sans.css" />
    <style>
      :root {
        --bg: #ffffff;
        --text: #101828;
        --muted: #667085;
        --line: #eaecf0;
        --border-soft: #d8dde3;
        --card: #ffffff;
        --chip-bg: #f9fafb;
        --chip-text: #475467;
        --release-header-offset: 88px;
        --safe-area-bottom: 0px;
        --safe-area-bottom: env(safe-area-inset-bottom, 0px);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", "SF Pro Text", "Segoe UI", system-ui, sans-serif;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      body[data-release-locale="en"] {
        font-family: "Open Sans", "Segoe UI", system-ui, sans-serif;
      }

      body[data-release-locale="zh-CN"],
      body[data-release-locale="zh-TW"] {
        font-family: "Open Sans", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
      }

      .header {
        position: sticky;
        top: 0;
        z-index: 30;
        background: rgba(255, 255, 255, 0.86);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
      }

      .container {
        max-width: 1024px;
        margin: 0 auto;
      }

      .header-inner {
        padding: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }

      .brand-logo {
        width: 136px;
        height: auto;
        display: block;
      }

      .header-controls {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .social-btn {
        min-height: 36px;
        border-radius: 999px;
        border: 1px solid var(--border-soft);
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02), inset 0 -4px 3px rgba(255, 255, 255, 0.59);
        color: #4b545f;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          border-color 0.18s ease,
          background 0.18s ease;
      }

      .social-btn:focus-visible {
        outline: 2px solid rgba(75, 84, 95, 0.35);
        outline-offset: 2px;
      }

      @media (hover: hover) and (pointer: fine) {
        .social-btn:hover {
          transform: translateY(-1px);
          border-color: #d2d8df;
          background: linear-gradient(180deg, #ffffff 0%, #e8ebef 100%);
          box-shadow:
            0 14px 18px rgba(0, 0, 0, 0.04),
            0 2px 3px rgba(0, 0, 0, 0.04),
            inset 0 -4px 3px rgba(255, 255, 255, 0.65);
        }

        .social-btn-discord:hover {
          border-color: transparent;
          background: linear-gradient(180deg, #4a5467 0%, #2f3a4f 100%);
          box-shadow:
            0 12px 4px rgba(0, 0, 0, 0),
            0 7px 3px rgba(0, 0, 0, 0.015),
            0 4px 3px rgba(0, 0, 0, 0.045),
            0 2px 2px rgba(0, 0, 0, 0.075),
            0 0 1px rgba(0, 0, 0, 0.09);
        }
      }

      .social-btn:active {
        transform: translateY(1px);
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow:
          0 2px 5px rgba(0, 0, 0, 0.06),
          inset 0 -4px 3px rgba(255, 255, 255, 0.59);
      }

      .social-btn-discord:active {
        background: linear-gradient(180deg, #3a4353 0%, #232b3b 100%);
        box-shadow:
          0 10px 3px rgba(0, 0, 0, 0),
          0 6px 2px rgba(0, 0, 0, 0.008),
          0 3px 2px rgba(0, 0, 0, 0.035),
          0 2px 2px rgba(0, 0, 0, 0.065),
          0 0 1px rgba(0, 0, 0, 0.075);
      }

      .social-btn-icon {
        width: 36px;
        min-width: 36px;
        padding: 0;
        font-size: 18px;
      }

      .social-btn-discord {
        position: relative;
        padding: 0 14px;
        gap: 8px;
        font-size: 14px;
        line-height: 1;
        font-weight: 500;
        border: none;
        color: #ffffff;
        background: linear-gradient(180deg, #404859 0%, #273042 100%);
        box-shadow:
          0 10px 3px rgba(0, 0, 0, 0),
          0 6px 2px rgba(0, 0, 0, 0.008),
          0 3px 2px rgba(0, 0, 0, 0.035),
          0 2px 2px rgba(0, 0, 0, 0.065),
          0 0 1px rgba(0, 0, 0, 0.075);
      }

      .social-btn-discord i {
        font-size: 18px;
      }

      .social-btn-discord::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        box-shadow:
          inset 0 0 0 1px #040404,
          inset 0 1px 0 rgba(255, 255, 255, 0.52),
          inset 0 1px 2.4px rgba(255, 255, 255, 0.36);
      }

      .lang-control {
        position: fixed;
        right: 24px;
        bottom: calc(24px + var(--safe-area-bottom));
        z-index: 22;
        width: 38px;
      }

      .lang-toggle {
        width: 38px;
        min-width: 38px;
        height: 38px;
        border-radius: 999px;
        border: 1px solid transparent;
        appearance: none;
        -webkit-appearance: none;
        background: transparent;
        box-shadow: none;
        color: #4b545f;
        -webkit-text-fill-color: currentColor;
        cursor: pointer;
        font-size: 16px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
      }

      .lang-toggle,
      .lang-toggle i,
      .lang-select-prefix,
      .lang-select-arrow {
        color: inherit;
        -webkit-text-fill-color: currentColor;
      }

      .lang-toggle i {
        font-size: 16px;
        line-height: 1;
      }

      .lang-select-prefix {
        width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .lang-current-label {
        display: none;
        flex: 1 1 auto;
        min-width: 0;
        font-size: 14px;
        color: #4b545f;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .lang-select-arrow {
        display: none;
        width: 16px;
        height: 16px;
        align-items: center;
        justify-content: center;
        color: #768095;
      }

      @media (hover: hover) and (pointer: fine) {
        .lang-toggle:hover {
          border-color: #d2d8df;
          background: rgba(255, 255, 255, 0.72);
          box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }
      }

      .lang-toggle:active {
        border-color: #ccd3db;
        background: rgba(255, 255, 255, 0.78);
        box-shadow: none;
      }

      .lang-menu {
        --language-menu-radius: 12px;
        --language-menu-border-width: 1px;
        --language-menu-padding: 6px;
        --language-option-radius: max(
          0px,
          calc(
            var(--language-menu-radius) -
            var(--language-menu-border-width) -
            var(--language-menu-padding)
          )
        );
        position: absolute;
        right: 0;
        bottom: calc(100% + 8px);
        top: auto;
        z-index: 36;
        min-width: 180px;
        background: #fff;
        border: var(--language-menu-border-width) solid #e2e2e2;
        border-radius: var(--language-menu-radius);
        padding: var(--language-menu-padding);
        display: flex;
        flex-direction: column;
        gap: 4px;
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.12);
        opacity: 0;
        visibility: hidden;
        transform: translateY(6px) scale(0.97);
        transform-origin: bottom right;
        pointer-events: none;
        transition: opacity 180ms ease, transform 180ms ease;
      }

      .lang-menu[data-open="true"] {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
        visibility: visible;
      }

      .lang-option {
        display: block;
        box-sizing: border-box;
        width: 100%;
        text-decoration: none;
        border: 0;
        background: transparent;
        border-radius: var(--language-option-radius, 8px);
        text-align: left;
        padding: 7px 9px;
        color: #3f4650;
        font-family: inherit;
        font-size: 13px;
        cursor: pointer;
      }

      .lang-option:hover {
        background: #f3f5f7;
      }

      .lang-option.is-active {
        background: #eaf3ff;
        color: #2a5da7;
        font-weight: 600;
      }

      .qrcode-modal {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .qrcode-modal[hidden] {
        display: none;
      }

      .qrcode-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(8, 12, 20, 0.6);
      }

      .qrcode-modal-panel {
        --qrcode-panel-radius: 16px;
        --qrcode-panel-border-width: 0px;
        --qrcode-panel-padding: 20px;
        --qrcode-panel-content-radius: max(
          0px,
          calc(
            var(--qrcode-panel-radius) -
            var(--qrcode-panel-border-width) -
            var(--qrcode-panel-padding)
          )
        );
        position: relative;
        width: min(92vw, 380px);
        border-radius: var(--qrcode-panel-radius);
        background: #ffffff;
        box-shadow: 0 24px 42px rgba(16, 23, 38, 0.26);
        padding: var(--qrcode-panel-padding);
      }

      .qrcode-modal-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 999px;
        background: #f2f4f8;
        color: #212733;
        cursor: pointer;
      }

      .qrcode-modal-title {
        margin: 0 34px 12px 0;
        font-size: 16px;
        line-height: 1.35;
        font-weight: 600;
        color: #0f1725;
      }

      .qrcode-modal-image {
        display: block;
        width: 100%;
        border-radius: var(--qrcode-panel-content-radius);
      }

      main {
        padding: 30px 24px 60px;
        padding: 30px 24px max(60px, var(--safe-area-bottom));
      }

      .top-banner {
        margin: 0 0 24px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        border-radius: 16px;
        overflow: hidden;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        position: relative;
        aspect-ratio: 2200 / 586;
        min-height: 132px;
      }

      .top-banner img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .banner-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        pointer-events: none;
      }

      body:not([data-release-entry="ext"]) .banner-overlay {
        inset: auto;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      body:not([data-release-entry="ext"]) .banner-title-emoji {
        display: none;
      }

      .banner-title {
        margin: 0;
        font-family: "Open Sans", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
        font-size: clamp(32px, 5.2vw, 40px);
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0;
        color: #111827;
        text-shadow: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }

      .banner-title-text {
        background-image:
          linear-gradient(180deg, #45563c 0%, #7a8c71 100%),
          linear-gradient(180deg, #000000 0%, #888888 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .banner-title-emoji {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        font-size: 0.95em;
        color: initial;
      }

      .banner-title {
        transform: translateY(10px) scale(0.94);
        opacity: 0;
        animation: banner-pop 620ms cubic-bezier(0.22, 1, 0.36, 1) 120ms forwards;
      }

      @keyframes banner-pop {
        from {
          opacity: 0;
          transform: translateY(10px) scale(0.94);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .timeline {
        position: relative;
      }

      .entry {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .entry-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .entry-side {
        flex-shrink: 0;
      }

      .entry-side-sticky {
        padding-bottom: 36px;
      }

      .entry-date {
        display: block;
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
      }

      .entry-version {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--card);
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
      }

      .entry-main {
        flex: 1;
        position: relative;
        padding-bottom: 40px;
      }

      .entry-main::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 1px;
        height: calc(100% - 9px);
        background: var(--line);
      }

      .entry-dot {
        position: absolute;
        left: -5px;
        top: 8px;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #111827;
      }

      .entry-content {
        padding-left: 30px;
      }

      .entry-title {
        margin: 0;
        font-size: 30px;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 600;
        text-wrap: balance;
      }

      .chip-row {
        margin-top: 12px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 24px;
        padding: 0 10px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--chip-bg);
        color: var(--chip-text);
        font-size: 12px;
        font-weight: 500;
      }

      .chip-status {
        gap: 5px;
        padding-left: 8px;
      }

      .chip-status i {
        font-size: 13px;
      }

      .chip-link {
        text-decoration: none;
        cursor: pointer;
      }

      .chip-github {
        border-color: #d0d5dd;
        background: #f8fafc;
        color: #334155;
      }

      .chip-chrome.is-published {
        border-color: #a3e5c8;
        background: #ecfdf3;
        color: #027a48;
      }

      .chip-chrome.is-reviewing {
        border-color: #ffd19a;
        background: #fff8eb;
        color: #b54708;
        cursor: default;
      }

      .entry-localized {
        display: none;
      }

      body[data-release-content-locale="zh-CN"] .entry-localized[data-release-locale="zh-CN"] {
        display: block;
      }

      body[data-release-content-locale="zh-TW"] .entry-localized[data-release-locale="zh-TW"] {
        display: block;
      }

      body[data-release-content-locale="en"] .entry-localized[data-release-locale="en"] {
        display: block;
      }

      body:not([data-release-content-locale]) .entry-localized[data-release-locale="zh-CN"] {
        display: block;
      }

      .entry-summary {
        margin-top: 16px;
        color: #344054;
        line-height: 1.7;
        font-size: 15px;
      }

      :global(.entry-summary p) {
        margin: 0 0 10px;
      }

      :global(.entry-summary p:last-child) {
        margin-bottom: 0;
      }

      :global(.entry-summary a) {
        color: #175cd3;
        text-decoration: none;
      }

      :global(.entry-summary a:hover) {
        text-decoration: underline;
      }

      :global(.entry-summary code) {
        font-size: 0.95em;
        font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
        border-radius: 6px;
        padding: 1px 5px;
      }

      :global(.entry-summary pre) {
        margin: 12px 0;
        padding: 10px 12px;
        background: #f8fafc;
        border: 1px solid #e4e7ec;
        border-radius: 10px;
        overflow-x: auto;
      }

      :global(.entry-summary pre code) {
        display: block;
        padding: 0;
        border: 0;
        background: transparent;
      }

      .accordion-group {
        margin-top: 14px;
        display: grid;
        gap: 10px;
      }

      .accordion {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
      }

      .accordion > summary {
        cursor: pointer;
        padding: 10px 12px;
        font-size: 14px;
        font-weight: 600;
        color: #1d2939;
        background: #f9fafb;
        list-style: none;
      }

      .accordion > summary::-webkit-details-marker {
        display: none;
      }

      .accordion > summary::after {
        content: "+";
        float: right;
        color: #667085;
        transition: transform 220ms ease;
      }

      .accordion[open] > summary::after {
        content: "−";
        transform: rotate(180deg);
      }

      .accordion-panel {
        overflow: hidden;
        height: auto;
        opacity: 1;
      }

      .accordion-list {
        overflow: hidden;
        margin: 0;
        padding: 10px 16px 14px 30px;
        color: #344054;
        font-size: 14px;
        line-height: 1.65;
      }

      .accordion-list li + li {
        margin-top: 8px;
      }

      :global(.accordion-list a) {
        color: #175cd3;
        text-decoration: none;
      }

      :global(.accordion-list a:hover) {
        text-decoration: underline;
      }

      :global(.accordion-list code) {
        font-size: 12px;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
        border-radius: 6px;
        padding: 1px 5px;
      }

      .entry-link {
        margin-top: 12px;
      }

      .entry-link-btn {
        min-height: 36px;
        padding: 9px 14px;
        border-radius: 999px;
        border: 1px solid #d0d5dd;
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02), inset 0 -4px 3px rgba(255, 255, 255, 0.59);
        color: #4b545f;
        text-decoration: none;
        font-size: 14px;
        line-height: 1;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition:
          transform 180ms ease,
          box-shadow 180ms ease,
          border-color 180ms ease,
          background 180ms ease;
      }

      .entry-link-btn i {
        font-size: 14px;
      }

      @media (hover: hover) and (pointer: fine) {
        .entry-link-btn:hover {
          transform: translateY(-1px);
          border-color: #d2d8df;
          background: linear-gradient(180deg, #ffffff 0%, #e8ebef 100%);
          box-shadow:
            0 14px 18px rgba(0, 0, 0, 0.04),
            0 2px 3px rgba(0, 0, 0, 0.04),
            inset 0 -4px 3px rgba(255, 255, 255, 0.65);
        }
      }

      .entry-link-btn:active {
        transform: translateY(1px);
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow:
          0 2px 5px rgba(0, 0, 0, 0.06),
          inset 0 -4px 3px rgba(255, 255, 255, 0.59);
      }

      .entry-link-btn:focus-visible {
        outline: 2px solid rgba(75, 84, 95, 0.35);
        outline-offset: 2px;
      }

      .empty .entry-main::before,
      .empty .entry-dot {
        display: none;
      }

      @media (min-width: 768px) {
        .entry-wrap {
          flex-direction: row;
          gap: 0;
        }

        .entry-side {
          width: 192px;
        }

        .entry-side-sticky {
          position: sticky;
          top: calc(var(--release-header-offset) + 24px);
        }

        .entry-main {
          padding-left: 32px;
        }

        .entry-content {
          padding-left: 0;
        }
      }

      @media (max-width: 767px) {
        :root {
          --release-header-offset: 76px;
        }

        .header-inner {
          padding: 14px 16px;
          align-items: center;
          justify-content: space-between;
          flex-direction: row;
          gap: 10px;
        }

        .brand {
          flex: 0 1 auto;
          min-width: 0;
        }

        .brand-logo {
          width: clamp(90px, 28vw, 136px);
        }

        .header-controls {
          width: auto;
          margin-left: auto;
          align-items: center;
          justify-content: flex-end;
          gap: 6px;
          flex-wrap: nowrap;
        }

        .lang-control {
          position: fixed;
          left: 16px;
          right: 16px;
          bottom: calc(16px + var(--safe-area-bottom));
          width: auto;
        }

        .lang-toggle {
          width: 100%;
          min-width: 0;
          min-height: 40px;
          border-radius: 10px;
          border: 1px solid #dbe1e8;
          background: #ffffff;
          box-shadow: 0 6px 18px rgba(14, 24, 38, 0.08);
          padding: 0 12px;
          display: grid;
          grid-template-columns: 1fr auto 1fr;
          align-items: center;
          gap: 10px;
        }

        .lang-current-label,
        .lang-select-arrow {
          display: inline-flex;
        }

        .lang-current-label {
          display: block;
          flex: none;
          justify-self: center;
          text-align: center;
          padding: 0 6px;
          max-width: 100%;
        }

        .lang-select-prefix {
          justify-self: start;
          width: 18px;
        }

        .lang-select-arrow {
          justify-self: end;
          width: 18px;
        }

        .lang-menu {
          width: 100%;
          min-width: 0;
          left: 0;
          right: auto;
          transform: translateY(6px) scale(0.97);
          transform-origin: bottom center;
        }

        .lang-menu[data-open="true"] {
          transform: translateY(0) scale(1);
        }

        .header-actions {
          margin-left: 0;
          gap: 6px;
          min-width: 0;
        }

        .social-btn-icon {
          width: 36px;
          min-width: 36px;
          padding: 0;
        }

        .social-btn-discord {
          width: 36px;
          min-width: 36px;
          max-width: 36px;
          padding: 0;
          gap: 0;
        }

        .social-btn-discord i {
          flex: 0 0 auto;
        }

        .social-btn-discord span {
          display: none;
        }

        main {
          padding: 22px 16px 96px;
          padding: 22px 16px max(96px, var(--safe-area-bottom));
        }

        .top-banner {
          min-height: 0;
        }

        .entry-main::before,
        .entry-dot {
          display: none;
        }

        .entry-main {
          padding-bottom: 34px;
        }

        .entry-content {
          padding-left: 0;
        }

        .entry-title {
          font-size: 25px;
        }
      }
    </style>
  </head>
  <body data-release-locale={uiLocale} data-release-content-locale={releaseContentLocale}>
    <header class="header">
      <div class="container">
        <div class="header-inner">
          <a class="brand" href={homeHref} data-i18n-aria-label="brand_home_aria" aria-label={initialUi.brandHomeAria} data-analytics-event="select_home_brand" data-analytics-category="navigation" data-analytics-label="release_brand">
            <img class="brand-logo" src="/resource_commited/logo.png" alt={initialUi.brandLogoAlt} draggable="false" />
          </a>
          <div class="header-controls">
            <nav class="header-actions">
              <a class="social-btn social-btn-icon" href="https://github.com/kubai087/lumno-extension" target="_blank" rel="noreferrer noopener" aria-label={initialUi.githubRepoAria} data-i18n-aria-label="github_repo_aria" data-analytics-event="open_github_repo" data-analytics-category="cta" data-analytics-label="release_header_github">
                <i class="ri-github-fill" aria-hidden="true"></i>
              </a>
              <a class="social-btn social-btn-icon" href={COMMUNITY_LINKS.xUrl} target="_blank" rel="noreferrer noopener" aria-label={initialUi.xAria} data-i18n-aria-label="x_aria" data-analytics-event="open_x_profile" data-analytics-category="cta" data-analytics-label="release_header_x">
                <i class="ri-twitter-x-fill" aria-hidden="true"></i>
              </a>
              <a
                class="social-btn social-btn-discord"
                href={COMMUNITY_LINKS.discordUrl}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={initialUi.discordAria}
                data-i18n-aria-label="discord_aria"
                data-community-entry
                data-discord-href={COMMUNITY_LINKS.discordUrl}
                data-analytics-event="join_community"
                data-analytics-category="cta"
                data-analytics-label="release_header_discord"
              >
                <i class="ri-discord-fill" aria-hidden="true" data-community-icon></i>
                <span data-i18n="join_discord">{initialUi.joinDiscord}</span>
              </a>
            </nav>
          </div>
        </div>
      </div>
    </header>

    <main class="container">
      <div class="top-banner">
        <img
          src="/resource_commited/banner.jpg"
          alt={initialUi.bannerAlt}
          loading="eager"
          decoding="async"
          width="2200"
          height="586"
        />
        <div class="banner-overlay">
          <h1 class="banner-title">
            <span class="banner-title-emoji" aria-hidden="true">🎉</span>
            <span class="banner-title-text" data-i18n="banner_title">{initialUi.bannerTitle}</span>
          </h1>
        </div>
      </div>
      <section class="timeline">
        {
          releases.length > 0 ? (
            releases.map((item) => {
              const zhContent = item.parsed.locales["zh-CN"];
              const zhTwContent = item.parsed.locales["zh-TW"];
              const enContent = item.parsed.locales.en;
              const chromeStatusKey = getChromeStatusI18nKey(item.tag);

              return (
                <article class="entry">
                  <div class="entry-wrap">
                    <aside class="entry-side">
                      <div class="entry-side-sticky">
                        <time class="entry-date">{formatDate(item.date)}</time>
                        <div class="entry-version">{item.tag}</div>
                      </div>
                    </aside>

                    <div class="entry-main">
                      <span class="entry-dot" aria-hidden="true"></span>
                      <div class="entry-content">
                        <h2 class="entry-title">{item.name}</h2>

                        <div class="chip-row">
                          {item.parsed.tags.map((releaseTag) => (
                            <span class="chip">{releaseTag}</span>
                          ))}
                          <span class="chip chip-status chip-github">
                            <i class="ri-github-fill" aria-hidden="true"></i>
                            <span data-i18n="github_published">Published</span>
                          </span>
                          {chromeStatusKey === "chrome_published" ? (
                            <a
                              class="chip chip-status chip-chrome is-published chip-link"
                              href="https://chromewebstore.google.com/detail/nggfkkbmogmadfoikakkfegkoilfcfao"
                              target="_blank"
                              rel="noreferrer"
                              data-analytics-event="open_chrome_web_store"
                              data-analytics-category="cta"
                              data-analytics-label={`release_chrome_status_${item.tag}`}
                            >
                              <i class="ri-chrome-fill" aria-hidden="true"></i>
                              <span data-i18n={chromeStatusKey}>Published</span>
                            </a>
                          ) : chromeStatusKey ? (
                            <span class="chip chip-status chip-chrome is-reviewing">
                              <i class="ri-chrome-fill" aria-hidden="true"></i>
                              <span data-i18n={chromeStatusKey}>{uiLocale === "en" ? "Awaiting store update" : "商店待更新"}</span>
                            </span>
                          ) : null}
                        </div>

                        <div class="entry-localized" data-release-locale="zh-CN">
                          {zhContent.summary && <div class="entry-summary" set:html={renderMdBlock(zhContent.summary)}></div>}

                          {(zhContent.features.length > 0 || zhContent.bugFixes.length > 0) && (
                            <div class="accordion-group">
                              {zhContent.features.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="features_label" data-count={zhContent.features.length}>Features ({zhContent.features.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {zhContent.features.map((feature) => (
                                        <li set:html={renderMdInline(feature)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}

                              {zhContent.bugFixes.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="bug_fixes_label" data-count={zhContent.bugFixes.length}>Bug Fixes ({zhContent.bugFixes.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {zhContent.bugFixes.map((fix) => (
                                        <li set:html={renderMdInline(fix)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}
                            </div>
                          )}
                        </div>

                        <div class="entry-localized" data-release-locale="zh-TW">
                          {zhTwContent.summary && <div class="entry-summary" set:html={renderMdBlock(zhTwContent.summary)}></div>}

                          {(zhTwContent.features.length > 0 || zhTwContent.bugFixes.length > 0) && (
                            <div class="accordion-group">
                              {zhTwContent.features.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="features_label" data-count={zhTwContent.features.length}>Features ({zhTwContent.features.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {zhTwContent.features.map((feature) => (
                                        <li set:html={renderMdInline(feature)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}

                              {zhTwContent.bugFixes.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="bug_fixes_label" data-count={zhTwContent.bugFixes.length}>Bug Fixes ({zhTwContent.bugFixes.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {zhTwContent.bugFixes.map((fix) => (
                                        <li set:html={renderMdInline(fix)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}
                            </div>
                          )}
                        </div>

                        <div class="entry-localized" data-release-locale="en">
                          {enContent.summary && <div class="entry-summary" set:html={renderMdBlock(enContent.summary)}></div>}

                          {(enContent.features.length > 0 || enContent.bugFixes.length > 0) && (
                            <div class="accordion-group">
                              {enContent.features.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="features_label" data-count={enContent.features.length}>Features ({enContent.features.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {enContent.features.map((feature) => (
                                        <li set:html={renderMdInline(feature)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}

                              {enContent.bugFixes.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="bug_fixes_label" data-count={enContent.bugFixes.length}>Bug Fixes ({enContent.bugFixes.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {enContent.bugFixes.map((fix) => (
                                        <li set:html={renderMdInline(fix)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}
                            </div>
                          )}
                        </div>

                        <div class="entry-link">
                          <a class="entry-link-btn" href={item.url} target="_blank" rel="noreferrer noopener" data-analytics-event="open_github_release" data-analytics-category="cta" data-analytics-label={`release_notes_${item.tag}`}>
                            <span data-i18n="read_on_github">{initialUi.readOnGithub}</span>
                            <i class="ri-external-link-line" aria-hidden="true"></i>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })
          ) : (
            <article class="entry empty">
              <div class="entry-wrap">
                <div class="entry-main">
                  <div class="entry-content">
                    <h2 class="entry-title" data-i18n="no_releases_title">{initialUi.noReleasesTitle}</h2>
                    <div class="entry-summary" data-i18n="no_releases_desc">{initialUi.noReleasesDesc}</div>
                  </div>
                </div>
              </div>
            </article>
          )
        }
      </section>
    </main>
    <div class="lang-control">
