        <button class="qrcode-modal-close" type="button" aria-label={initialUi.qrcodeCloseAria} data-i18n-aria-label="qrcode_close_aria" data-close-qrcode-modal>
          <i class="ri-close-line" aria-hidden="true"></i>
        </button>
        <h2 id="community-qrcode-title" class="qrcode-modal-title" data-i18n="qrcode_title">{initialUi.qrcodeTitle}</h2>
        <img class="qrcode-modal-image" src={COMMUNITY_LINKS.wechatQrImagePath} alt={initialUi.qrcodeImageAlt} data-i18n-alt="qrcode_image_alt" loading="lazy" />
      </div>
    </div>
    <script>
      import "../../scripts/language-preference";
      import "../../scripts/language-runtime";
    </script>
    <script define:vars={{ forcedLocale, routeLanguageMap, pageTitleByLocale, entryContextConfig, communityLinks: COMMUNITY_LINKS }}>
      const LANGUAGE_STORAGE_KEY = "_x_extension_language_2024_unique_";
      const FORCED_LOCALE = forcedLocale;
      const ROUTE_LANGUAGE_MAP = routeLanguageMap;
      const ENTRY_CONTEXT_CONFIG = entryContextConfig;
