---
import { fetchReleases, formatDate, parseReleaseBody } from "../../lib/releases";
import { marked } from "marked";

const releases = (await fetchReleases()).map((item) => ({
  ...item,
  parsed: parseReleaseBody(item.body),
}));

function renderMdInline(markdown: string): string {
  return marked.parseInline(markdown || "");
}

function renderMdBlock(markdown: string): string {
  return marked.parse(markdown || "");
}

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-i18n="page_title">Lumno Changelog</title>
    <meta name="description" content="Lumno changelog synced from GitHub Releases." />
    <link rel="icon" type="image/svg+xml" href="/onboarding/assets/logo.svg" />
    <style>
      :root {
        --bg: #ffffff;
        --text: #101828;
        --muted: #667085;
        --line: #eaecf0;
        --card: #ffffff;
        --chip-bg: #f9fafb;
        --chip-text: #475467;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", "SF Pro Text", "Segoe UI", system-ui, sans-serif;
      }

      .header {
        border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
      }

      .container {
        max-width: 1024px;
        margin: 0 auto;
      }

      .header-inner {
        padding: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }

      .brand-logo {
        width: 136px;
        height: auto;
        display: block;
      }

      .header-controls {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      .lang-control {
        position: relative;
      }

      .lang-toggle {
        border: 1px solid var(--line);
        background: #fff;
        color: #344054;
        border-radius: 8px;
        height: 32px;
        min-width: 32px;
        padding: 0 9px;
        cursor: pointer;
        font-size: 14px;
      }

      .lang-menu {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        min-width: 132px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 10px 20px rgba(16, 24, 40, 0.09);
        padding: 6px;
        z-index: 20;
      }

      .lang-menu[hidden] {
        display: none;
      }

      .lang-option {
        width: 100%;
        border: 0;
        background: transparent;
        border-radius: 8px;
        text-align: left;
        padding: 7px 9px;
        color: #3f4650;
        font-family: inherit;
        font-size: 13px;
        cursor: pointer;
      }

      .lang-option:hover {
        background: #f3f5f7;
      }

      .lang-option.is-active {
        background: #eaf3ff;
        color: #2a5da7;
        font-weight: 600;
      }

      .header-links {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .header-link {
        text-decoration: none;
        color: var(--muted);
        font-size: 14px;
      }

      .header-link:hover {
        color: var(--text);
      }

      main {
        padding: 30px 24px 60px;
      }

      .timeline {
        position: relative;
      }

      .entry {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .entry-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .entry-side {
        flex-shrink: 0;
      }

      .entry-side-sticky {
        padding-bottom: 36px;
      }

      .entry-date {
        display: block;
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
      }

      .entry-version {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--card);
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
      }

      .entry-main {
        flex: 1;
        position: relative;
        padding-bottom: 40px;
      }

      .entry-main::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 1px;
        height: calc(100% - 9px);
        background: var(--line);
      }

      .entry-dot {
        position: absolute;
        left: -5px;
        top: 8px;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #111827;
      }

      .entry-content {
        padding-left: 30px;
      }

      .entry-title {
        margin: 0;
        font-size: 30px;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 600;
        text-wrap: balance;
      }

      .chip-row {
        margin-top: 12px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 24px;
        padding: 0 10px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--chip-bg);
        color: var(--chip-text);
        font-size: 12px;
        font-weight: 500;
      }

      .entry-summary {
        margin-top: 16px;
        color: #344054;
        line-height: 1.7;
        font-size: 15px;
      }

      :global(.entry-summary p) {
        margin: 0 0 10px;
      }

      :global(.entry-summary p:last-child) {
        margin-bottom: 0;
      }

      :global(.entry-summary a) {
        color: #175cd3;
        text-decoration: none;
      }

      :global(.entry-summary a:hover) {
        text-decoration: underline;
      }

      .accordion-group {
        margin-top: 14px;
        display: grid;
        gap: 10px;
      }

      .accordion {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
      }

      .accordion > summary {
        cursor: pointer;
        padding: 10px 12px;
        font-size: 14px;
        font-weight: 600;
        color: #1d2939;
        background: #f9fafb;
        list-style: none;
      }

      .accordion > summary::-webkit-details-marker {
        display: none;
      }

      .accordion > summary::after {
        content: "+";
        float: right;
        color: #667085;
      }

      .accordion[open] > summary::after {
        content: "−";
      }

      .accordion-list {
        margin: 0;
        padding: 10px 16px 14px 30px;
        color: #344054;
        font-size: 14px;
        line-height: 1.65;
      }

      .accordion-list li + li {
        margin-top: 8px;
      }

      :global(.accordion-list a) {
        color: #175cd3;
        text-decoration: none;
      }

      :global(.accordion-list a:hover) {
        text-decoration: underline;
      }

      :global(.accordion-list code) {
        font-size: 12px;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
        border-radius: 6px;
        padding: 1px 5px;
      }

      .entry-link {
        margin-top: 12px;
      }

      .entry-link a {
        color: #175cd3;
        text-decoration: none;
        font-size: 14px;
      }

      .entry-link a:hover {
        text-decoration: underline;
      }

      .empty .entry-main::before,
      .empty .entry-dot {
        display: none;
      }

      @media (min-width: 768px) {
        .entry-wrap {
          flex-direction: row;
          gap: 0;
        }

        .entry-side {
          width: 192px;
        }

        .entry-side-sticky {
          position: sticky;
          top: 32px;
        }

        .entry-main {
          padding-left: 32px;
        }

        .entry-content {
          padding-left: 0;
        }
      }

      @media (max-width: 767px) {
        .header-inner {
          padding: 14px 16px;
          align-items: center;
          flex-direction: column;
        }

        .header-controls {
          width: 100%;
          justify-content: space-between;
          align-items: flex-start;
          gap: 8px;
          flex-wrap: wrap;
        }

        main {
          padding: 22px 16px 44px;
        }

        .entry-main::before,
        .entry-dot {
          display: none;
        }

        .entry-main {
          padding-bottom: 34px;
        }

        .entry-content {
          padding-left: 0;
        }

        .entry-title {
          font-size: 25px;
        }
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <div class="header-inner">
          <a class="brand" href="/" data-i18n-aria-label="brand_home_aria" aria-label="Lumno home">
            <img class="brand-logo" src="/resource_commited/logo.png" alt="Lumno" draggable="false" />
          </a>
          <div class="header-controls">
            <nav class="header-links" data-i18n-aria-label="changelog_links_aria" aria-label="Changelog links">
              <a class="header-link" href="/" data-i18n="nav_home">Home</a>
              <a class="header-link" href="/onboarding/" data-i18n="nav_onboarding">Onboarding</a>
              <a class="header-link" href="https://github.com/kubai087/lumno-extension/releases" target="_blank" rel="noreferrer" data-i18n="nav_github_releases">GitHub Releases</a>
            </nav>
            <div class="lang-control">
              <button
                id="language-toggle"
                class="lang-toggle"
                type="button"
                data-i18n-aria-label="language_select_aria"
                aria-label="Language"
                aria-haspopup="menu"
                aria-expanded="false"
              >
                🌐
              </button>
              <div id="language-menu" class="lang-menu" role="menu" hidden>
                <button class="lang-option" type="button" role="menuitemradio" data-lang-value="zh-CN" data-i18n="language_zh_cn">
                  简体中文
                </button>
                <button class="lang-option" type="button" role="menuitemradio" data-lang-value="zh-TW" data-i18n="language_zh_tw">
                  繁體中文
                </button>
                <button class="lang-option" type="button" role="menuitemradio" data-lang-value="en" data-i18n="language_en">
                  English
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="container">
      <section class="timeline">
        {
          releases.length > 0 ? (
            releases.map((item) => (
              <article class="entry">
                <div class="entry-wrap">
                  <aside class="entry-side">
                    <div class="entry-side-sticky">
                      <time class="entry-date">{formatDate(item.date)}</time>
                      <div class="entry-version">{item.tag}</div>
                    </div>
                  </aside>

                  <div class="entry-main">
                    <span class="entry-dot" aria-hidden="true"></span>
                    <div class="entry-content">
                      <h2 class="entry-title">{item.name}</h2>

                      <div class="chip-row">
                        {item.parsed.tags.map((releaseTag) => (
                          <span class="chip">{releaseTag}</span>
                        ))}
                      </div>

                      {item.parsed.summary && <div class="entry-summary" set:html={renderMdBlock(item.parsed.summary)}></div>}

                      {(item.parsed.features.length > 0 || item.parsed.bugFixes.length > 0) && (
                        <div class="accordion-group">
                          {item.parsed.features.length > 0 && (
                            <details class="accordion" open>
                              <summary data-i18n="features_label" data-count={item.parsed.features.length}>Features ({item.parsed.features.length})</summary>
                              <ul class="accordion-list">
                                {item.parsed.features.map((feature) => (
                                  <li set:html={renderMdInline(feature)}></li>
                                ))}
                              </ul>
                            </details>
                          )}

                          {item.parsed.bugFixes.length > 0 && (
                            <details class="accordion" open>
                              <summary data-i18n="bug_fixes_label" data-count={item.parsed.bugFixes.length}>Bug Fixes ({item.parsed.bugFixes.length})</summary>
                              <ul class="accordion-list">
                                {item.parsed.bugFixes.map((fix) => (
                                  <li set:html={renderMdInline(fix)}></li>
                                ))}
                              </ul>
                            </details>
                          )}
                        </div>
                      )}

                      <div class="entry-link">
                        <a href={item.url} target="_blank" rel="noreferrer" data-i18n="read_on_github">Read on GitHub</a>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            ))
          ) : (
            <article class="entry empty">
              <div class="entry-wrap">
                <div class="entry-main">
                  <div class="entry-content">
                    <h2 class="entry-title" data-i18n="no_releases_title">No releases yet</h2>
                    <div class="entry-summary" data-i18n="no_releases_desc">Create a GitHub Release and it will appear here on next deploy.</div>
                  </div>
                </div>
              </div>
            </article>
          )
        }
      </section>
    </main>
    <script>
      const LANGUAGE_STORAGE_KEY = "_x_extension_language_2024_unique_";
      const FALLBACK_LOCALE = "zh-CN";
      const I18N_MESSAGES = {
        "zh-CN": {
          page_title: "Lumno 更新日志",
          nav_home: "首页",
          nav_onboarding: "引导页",
          nav_github_releases: "GitHub Releases",
          changelog_links_aria: "更新日志链接",
          brand_home_aria: "回到 Lumno 首页",
          language_select_aria: "语言",
          language_zh_cn: "简体中文",
          language_zh_tw: "繁體中文",
          language_en: "English",
          features_label: "新功能",
          bug_fixes_label: "问题修复",
          read_on_github: "在 GitHub 查看",
          no_releases_title: "暂无发布记录",
          no_releases_desc: "创建 GitHub Release 后，将在下一次部署时自动显示。"
        },
        "zh-TW": {
          page_title: "Lumno 更新日誌",
          nav_home: "首頁",
          nav_onboarding: "引導頁",
          nav_github_releases: "GitHub Releases",
          changelog_links_aria: "更新日誌連結",
          brand_home_aria: "回到 Lumno 首頁",
          language_select_aria: "語言",
          language_zh_cn: "简体中文",
          language_zh_tw: "繁體中文",
          language_en: "English",
          features_label: "新功能",
          bug_fixes_label: "問題修復",
          read_on_github: "在 GitHub 查看",
          no_releases_title: "暫無發佈記錄",
          no_releases_desc: "建立 GitHub Release 後，將在下一次部署時自動顯示。"
        },
        en: {
          page_title: "Lumno Changelog",
          nav_home: "Home",
          nav_onboarding: "Onboarding",
          nav_github_releases: "GitHub Releases",
          changelog_links_aria: "Changelog links",
          brand_home_aria: "Back to Lumno home",
          language_select_aria: "Language",
          language_zh_cn: "简体中文",
          language_zh_tw: "繁體中文",
          language_en: "English",
          features_label: "Features",
          bug_fixes_label: "Bug Fixes",
          read_on_github: "Read on GitHub",
          no_releases_title: "No releases yet",
          no_releases_desc: "Create a GitHub Release and it will appear here on next deploy."
        }
      };

      function setLanguageMenuOpen(open) {
        const languageMenu = document.getElementById("language-menu");
        const languageToggle = document.getElementById("language-toggle");
        if (!languageMenu || !languageToggle) return;
        languageMenu.hidden = !open;
        languageToggle.setAttribute("aria-expanded", open ? "true" : "false");
      }

      function normalizeLocale(locale) {
        const raw = String(locale || "").trim();
        if (!raw) return "en";
        const lower = raw.toLowerCase();
        if (lower.startsWith("zh")) {
          if (lower.includes("tw") || lower.includes("hk") || lower.includes("mo") || lower.includes("hant")) {
            return "zh-TW";
          }
          return "zh-CN";
        }
        return "en";
      }

      function getSystemLocale() {
        const firstPreferred = Array.isArray(navigator.languages) && navigator.languages.length ? navigator.languages[0] : navigator.language;
        return normalizeLocale(firstPreferred || "en");
      }

      function normalizeLanguageMode(mode) {
        const raw = String(mode || "").trim();
        if (!raw) return getSystemLocale();
        if (raw.toLowerCase() === "system") return getSystemLocale();
        return normalizeLocale(raw);
      }

      function getMessage(locale, key) {
        return (
          (I18N_MESSAGES[locale] && I18N_MESSAGES[locale][key]) ||
          (I18N_MESSAGES[FALLBACK_LOCALE] && I18N_MESSAGES[FALLBACK_LOCALE][key]) ||
          key
        );
      }

      function updateLanguageOptionState(mode) {
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const value = node.getAttribute("data-lang-value") || getSystemLocale();
          const isActive = value === mode;
          node.classList.toggle("is-active", isActive);
          node.setAttribute("aria-checked", isActive ? "true" : "false");
        });
      }

      function applyI18n(locale) {
        const resolvedLocale = I18N_MESSAGES[locale] ? locale : FALLBACK_LOCALE;
        document.documentElement.lang = resolvedLocale;
        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (!key) return;
          const value = getMessage(resolvedLocale, key);
          if (node.tagName === "TITLE") {
            document.title = value;
            return;
          }

          const count = node.getAttribute("data-count");
          if (count && (key === "features_label" || key === "bug_fixes_label")) {
            node.textContent = `${value} (${count})`;
            return;
          }

          node.textContent = value;
        });

        document.querySelectorAll("[data-i18n-aria-label]").forEach((node) => {
          const key = node.getAttribute("data-i18n-aria-label");
          if (!key) return;
          node.setAttribute("aria-label", getMessage(resolvedLocale, key));
        });
      }

      function applyLanguageMode(mode, options) {
        const normalizedMode = normalizeLanguageMode(mode);
        applyI18n(normalizedMode);
        updateLanguageOptionState(normalizedMode);
        if (options && options.persist) {
          localStorage.setItem(LANGUAGE_STORAGE_KEY, normalizedMode);
        }
      }

      const languageToggle = document.getElementById("language-toggle");
      const languageMenu = document.getElementById("language-menu");
      if (languageToggle && languageMenu) {
        languageToggle.addEventListener("click", (event) => {
          event.stopPropagation();
          setLanguageMenuOpen(languageMenu.hidden);
        });
        languageMenu.addEventListener("click", (event) => {
          const target = event.target instanceof HTMLElement ? event.target.closest("[data-lang-value]") : null;
          if (!target) return;
          const next = target.getAttribute("data-lang-value") || getSystemLocale();
          applyLanguageMode(next, { persist: true });
          setLanguageMenuOpen(false);
        });
        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Node)) return;
          if (!languageMenu.contains(event.target) && !languageToggle.contains(event.target)) {
            setLanguageMenuOpen(false);
          }
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            setLanguageMenuOpen(false);
          }
        });
      }

      applyLanguageMode(localStorage.getItem(LANGUAGE_STORAGE_KEY) || getSystemLocale());
    </script>
  </body>
</html>
