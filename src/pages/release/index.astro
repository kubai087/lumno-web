      function setLanguageMenuOpen(open) {
        const languageMenu = document.getElementById("language-menu");
        const languageToggle = document.getElementById("language-toggle");
        if (!languageMenu || !languageToggle) return;
        languageMenu.setAttribute("data-open", open ? "true" : "false");
        languageToggle.setAttribute("aria-expanded", open ? "true" : "false");
      }

      function normalizeLocale(locale) {
        const raw = String(locale || "").trim().toLowerCase();
        if (!raw) return "en";
        if (raw.startsWith("zh")) {
          if (raw.includes("tw") || raw.includes("hk") || raw.includes("mo") || raw.includes("hant")) {
            return "zh-TW";
          }
          return "zh-CN";
        }
        return "en";
      }

      function getSystemLocale() {
        const firstPreferred = Array.isArray(navigator.languages) && navigator.languages.length ? navigator.languages[0] : navigator.language;
        return normalizeLocale(firstPreferred || "en");
      }

      function normalizeLanguageMode(mode) {
        const raw = String(mode || "").trim();
        if (!raw) return getSystemLocale();
        if (raw.toLowerCase() === "system") return getSystemLocale();
        return normalizeLocale(raw);
      }

      function getMessage(locale, key) {
        return (
          (I18N_MESSAGES[locale] && I18N_MESSAGES[locale][key]) ||
          (I18N_MESSAGES[FALLBACK_LOCALE] && I18N_MESSAGES[FALLBACK_LOCALE][key]) ||
          key
        );
      }

      function formatVersionToken(raw) {
        const value = String(raw || "").trim();
        if (!value) return "";
        return /^v/i.test(value) ? value : `v${value}`;
      }

      function getEntryContext() {
        const params = new URLSearchParams(window.location.search);
        const entry = (params.get("entry") || "").trim().toLowerCase();
        const reason = (params.get("reason") || "").trim().toLowerCase();
        const versionFromParam = formatVersionToken(params.get("version") || "");
        const fallbackVersion = formatVersionToken(latestReleaseVersion || "");
        const version = versionFromParam || fallbackVersion;
        const isExtensionEntry = entry === "ext" || Boolean(reason) || Boolean(versionFromParam);
        return { isExtensionEntry, reason, version };
      }

      function withVersion(template, version) {
        return String(template || "").replace("{version}", version || "");
      }

      const INITIAL_ENTRY_CONTEXT = getEntryContext();

      function updateLanguageOptionState(mode) {
        let activeLabel = "";
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const value = node.getAttribute("data-lang-value") || getSystemLocale();
          const isActive = value === mode;
          node.classList.toggle("is-active", isActive);
          node.setAttribute("aria-checked", isActive ? "true" : "false");
          if (isActive) {
            activeLabel = (node.textContent || "").trim();
          }
        });
        const currentLabel = document.getElementById("language-current-label");
        if (currentLabel && activeLabel) {
          currentLabel.textContent = activeLabel;
        }
      }

      function applyI18n(locale) {
        const resolvedLocale = I18N_MESSAGES[locale] ? locale : FALLBACK_LOCALE;
        document.documentElement.lang = resolvedLocale;
        document.body.setAttribute("data-release-locale", resolvedLocale);
        const entryContext = INITIAL_ENTRY_CONTEXT;
        document.body.setAttribute("data-release-entry", entryContext.isExtensionEntry ? "ext" : "web");

        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (!key) return;
          let value = getMessage(resolvedLocale, key);
          if (key === "page_title_ui" && entryContext.isExtensionEntry) {
            value = withVersion(getMessage(resolvedLocale, "page_title_ui_ext"), entryContext.version);
          }
          if (key === "banner_title") {
            value =
              entryContext.isExtensionEntry && entryContext.version
                ? withVersion(getMessage(resolvedLocale, "banner_title_ext"), entryContext.version)
                : getMessage(resolvedLocale, "banner_title");
          }
          if (node.tagName === "TITLE") {
            document.title = value;
            return;
          }

          const count = node.getAttribute("data-count");
          if (count && (key === "features_label" || key === "bug_fixes_label")) {
            node.textContent = `${value} (${count})`;
            return;
          }

          node.textContent = value;
        });

        document.querySelectorAll("[data-i18n-aria-label]").forEach((node) => {
          const key = node.getAttribute("data-i18n-aria-label");
          if (!key) return;
          node.setAttribute("aria-label", getMessage(resolvedLocale, key));
        });

        document.querySelectorAll("[data-i18n-alt]").forEach((node) => {
          const key = node.getAttribute("data-i18n-alt");
          if (!key) return;
          node.setAttribute("alt", getMessage(resolvedLocale, key));
        });
      }

      function syncCommunityAction(locale) {
        const entry = document.querySelector("[data-community-entry]");
        if (!(entry instanceof HTMLAnchorElement)) return;
        const icon = entry.querySelector("[data-community-icon]");
        const discordHref = entry.dataset.discordHref || "https://discord.gg/2u9sg7ZNkJ";
        const isZhCn = locale === ZH_CN_LOCALE;

        entry.href = isZhCn ? "#" : discordHref;
        if (isZhCn) {
          entry.removeAttribute("target");
          entry.removeAttribute("rel");
        } else {
          entry.setAttribute("target", "_blank");
          entry.setAttribute("rel", "noreferrer noopener");
        }

        if (icon instanceof HTMLElement) {
          icon.classList.toggle("ri-wechat-fill", isZhCn);
          icon.classList.toggle("ri-discord-fill", !isZhCn);
        }
      }

      function applyLanguageMode(mode, options) {
        const normalizedMode = normalizeLanguageMode(mode);
        const targetPath = ROUTE_LANGUAGE_MAP[normalizedMode];
        const currentPath = window.location.pathname;
        if (targetPath && currentPath !== targetPath) {
          if (options && options.persist) {
            try {
              localStorage.setItem(LANGUAGE_STORAGE_KEY, normalizedMode);
            } catch (_error) {
              // Ignore storage write errors (private mode / blocked storage).
            }
          }
          const nextUrl = `${targetPath}${window.location.search}${window.location.hash}`;
          window.location.assign(nextUrl);
          return;
        }
        applyI18n(normalizedMode);
        syncCommunityAction(normalizedMode);
        updateLanguageOptionState(normalizedMode);
        if (options && options.persist) {
          try {
            localStorage.setItem(LANGUAGE_STORAGE_KEY, normalizedMode);
          } catch (_error) {
            // Ignore storage write errors (private mode / blocked storage).
          }
        }
      }

      function getInitialLanguageMode() {
        if (FORCED_LOCALE) return FORCED_LOCALE;
        return getSystemLocale();
      }

      function setupQrcodeModal() {
        const entry = document.querySelector("[data-community-entry]");
        const modal = document.getElementById("community-qrcode-modal");
        if (!(entry instanceof HTMLAnchorElement) || !(modal instanceof HTMLDivElement)) return;

        const close = () => {
          modal.hidden = true;
          document.body.style.removeProperty("overflow");
        };

        const open = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
        };

        entry.addEventListener("click", (event) => {
          const currentLocale = document.body.getAttribute("data-release-locale") || FALLBACK_LOCALE;
          if (currentLocale !== ZH_CN_LOCALE) return;
          event.preventDefault();
          open();
        });

        modal.addEventListener("click", (event) => {
          const target = event.target instanceof HTMLElement ? event.target.closest("[data-close-qrcode-modal]") : null;
          if (target) close();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) close();
        });
      }

      const initialLanguageMenu = document.getElementById("language-menu");
      if (initialLanguageMenu) {
        initialLanguageMenu.setAttribute("data-open", "false");
      }
      document.addEventListener("click", (event) => {
        const target = event.target instanceof HTMLElement ? event.target : null;
        if (!target) return;
        const languageToggle = target.closest("#language-toggle");
        const languageMenu = document.getElementById("language-menu");
        if (languageToggle) {
          event.stopPropagation();
          const expanded = languageToggle.getAttribute("aria-expanded") === "true";
          setLanguageMenuOpen(!expanded);
          return;
        }
        const languageOption = target.closest("#language-menu [data-lang-value]");
        if (languageOption) {
          const next = languageOption.getAttribute("data-lang-value") || getSystemLocale();
          applyLanguageMode(next, { persist: true });
          setLanguageMenuOpen(false);
          return;
        }
        const activeLanguageToggle = document.getElementById("language-toggle");
        if (!languageMenu || !activeLanguageToggle) return;
        if (!languageMenu.contains(target) && !activeLanguageToggle.contains(target)) {
          setLanguageMenuOpen(false);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setLanguageMenuOpen(false);
        }
      });

      applyLanguageMode(getInitialLanguageMode());
      window.addEventListener("load", () => {
        applyLanguageMode(getInitialLanguageMode());
      }, { once: true });
      setupQrcodeModal();

      function setupAccordionAnimations() {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const accordions = document.querySelectorAll(".accordion");
        accordions.forEach((accordion) => {
          if (!(accordion instanceof HTMLDetailsElement)) return;
          const summary = accordion.querySelector("summary");
          const panel = accordion.querySelector(".accordion-panel");
          if (!(summary instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

          panel.style.overflow = "hidden";
          panel.style.height = accordion.open ? "auto" : "0px";
          panel.style.opacity = accordion.open ? "1" : "0";

          summary.addEventListener("click", (event) => {
            event.preventDefault();
            if (accordion.dataset.animating === "true") return;

            const isOpen = accordion.open;
            if (reduceMotion) {
              accordion.open = !isOpen;
              panel.style.height = accordion.open ? "auto" : "0px";
              panel.style.opacity = accordion.open ? "1" : "0";
              return;
            }

            accordion.dataset.animating = "true";
            panel.style.transition = "height 260ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease";

            if (isOpen) {
              const startHeight = panel.scrollHeight;
              panel.style.height = `${startHeight}px`;
              panel.style.opacity = "1";

              requestAnimationFrame(() => {
                panel.style.height = "0px";
                panel.style.opacity = "0";
              });

              const onCloseEnd = (transitionEvent) => {
                if (transitionEvent.propertyName !== "height") return;
                panel.removeEventListener("transitionend", onCloseEnd);
                accordion.open = false;
                panel.style.transition = "";
                panel.style.height = "0px";
                panel.style.opacity = "0";
                delete accordion.dataset.animating;
              };
              panel.addEventListener("transitionend", onCloseEnd);
              return;
            }

            accordion.open = true;
            panel.style.height = "0px";
            panel.style.opacity = "0";
            const endHeight = panel.scrollHeight;

            requestAnimationFrame(() => {
              panel.style.height = `${endHeight}px`;
              panel.style.opacity = "1";
            });

            const onOpenEnd = (transitionEvent) => {
              if (transitionEvent.propertyName !== "height") return;
              panel.removeEventListener("transitionend", onOpenEnd);
              panel.style.transition = "";
              panel.style.height = "auto";
              panel.style.opacity = "1";
              delete accordion.dataset.animating;
            };
            panel.addEventListener("transitionend", onOpenEnd);
          });
        });
      }

      setupAccordionAnimations();

      function fireIntroConfetti() {
        const canvas = document.createElement("canvas");
        canvas.style.position = "fixed";
        canvas.style.inset = "0";
        canvas.style.width = "100%";
        canvas.style.height = "100%";
        canvas.style.pointerEvents = "none";
        canvas.style.zIndex = "9999";
        document.body.appendChild(canvas);
        const ctx = canvas.getContext("2d");
        if (!ctx) {
          canvas.remove();
          return;
        }
        const dpr = Math.max(1, window.devicePixelRatio || 1);
        const width = window.innerWidth;
        const height = window.innerHeight;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.scale(dpr, dpr);

        const colors = ["#60A5FA", "#22C55E", "#F59E0B", "#F43F5E", "#A78BFA"];
        const particles = Array.from({ length: 120 }).map(() => {
          const left = Math.random() > 0.5;
          const x = left ? width * 0.3 : width * 0.7;
          return {
            x,
            y: height * 0.32,
            vx: (Math.random() * 6 + 2) * (left ? -1 : 1),
            vy: -(Math.random() * 8 + 5),
            size: Math.random() * 6 + 4,
            color: colors[Math.floor(Math.random() * colors.length)],
            rotate: Math.random() * Math.PI,
            spin: (Math.random() - 0.5) * 0.25,
          };
        });

        const gravity = 0.24;
        const drag = 0.992;
        const endAt = performance.now() + 1500;

        function frame(now) {
          ctx.clearRect(0, 0, width, height);
          particles.forEach((p) => {
            p.vx *= drag;
            p.vy = p.vy * drag + gravity;
            p.x += p.vx;
            p.y += p.vy;
            p.rotate += p.spin;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rotate);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.65);
            ctx.restore();
          });
          if (now < endAt) {
            requestAnimationFrame(frame);
          } else {
            canvas.remove();
          }
        }
        requestAnimationFrame(frame);
      }

      const entryContext = INITIAL_ENTRY_CONTEXT;
      if (entryContext.isExtensionEntry) {
        window.setTimeout(() => fireIntroConfetti(), 280);
        if (window.history && typeof window.history.replaceState === "function") {
          window.history.replaceState({}, "", "/release/");
        }
      }
    </script>
  </body>
</html>
