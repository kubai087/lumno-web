          github_published: "Published",
          github_unpublished: "Not published",
          chrome_published: "Published",
          chrome_reviewing: "Awaiting store update",
          read_on_github: "View on GitHub",
          no_releases_title: "No releases yet",
          no_releases_desc: "Publish a GitHub Release and it will appear here after the next deploy."
