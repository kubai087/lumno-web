const pageDescriptionByLocale: Record<SupportedLocale, string> = {
  "zh-CN": `查看 Lumno 浏览器命令栏、聚焦搜索与极简新标签页的版本更新、新功能与问题修复。${v ? `当前最新版本为 ${v}。` : ""}`,
  "zh-TW": `查看 Lumno 瀏覽器命令列、聚焦搜尋與極簡新分頁的版本更新、新功能與錯誤修正。${v ? `目前最新版本為 ${v}。` : ""}`,
  en: `Follow Lumno release notes for focus search, browser command bar, and minimalist new tab updates.${v ? ` The latest version is ${v}.` : ""}`,
  ja: `Lumno のコマンドバー、タブ検索、新しいタブの新機能と不具合の修正をまとめています。${v ? `最新バージョンは ${v} です。` : ""}`,
  ko: `Lumno 커맨드 바, 탭 검색, 새 탭의 새 기능과 버그 수정 내역입니다.${v ? ` 최신 버전은 ${v}입니다.` : ""}`,
  de: `Neue Funktionen und Fehlerbehebungen für Lumnos Befehlsleiste, Tab-Suche und neuen Tab.${v ? ` Aktuelle Version: ${v}.` : ""}`,
  fr: `Nouveautés et corrections de la barre de commande, de la recherche d’onglets et du nouvel onglet de Lumno.${v ? ` Dernière version : ${v}.` : ""}`,
  es: `Novedades y correcciones de la barra de comandos, la búsqueda de pestañas y la nueva pestaña de Lumno.${v ? ` Última versión: ${v}.` : ""}`,
  "pt-BR": `Novidades e correções da barra de comandos, da pesquisa de abas e da nova aba do Lumno.${v ? ` Versão mais recente: ${v}.` : ""}`,
  ru: `Новые функции и исправления командной панели, поиска по вкладкам и новой вкладки Lumno.${v ? ` Последняя версия — ${v}.` : ""}`,
