---
import { fetchReleases, formatDate, parseReleaseBody } from "../../lib/releases";

const releases = (await fetchReleases()).map((item) => ({
  ...item,
  parsed: parseReleaseBody(item.body),
}));

function getVersionLabel(tag: string): string {
  const normalized = tag.replace(/^v/i, "");
  return normalized.length > 10 ? normalized.slice(0, 10) : normalized;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lumno Changelog</title>
    <meta name="description" content="Lumno changelog synced from GitHub Releases." />
    <style>
      :root {
        --bg: #ffffff;
        --text: #101828;
        --muted: #667085;
        --line: #eaecf0;
        --card: #ffffff;
        --chip-bg: #f9fafb;
        --chip-text: #475467;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", "SF Pro Text", "Segoe UI", system-ui, sans-serif;
      }

      .header {
        border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
      }

      .container {
        max-width: 1024px;
        margin: 0 auto;
      }

      .header-inner {
        padding: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .header-title {
        margin: 0;
        font-size: 32px;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 600;
      }

      .header-links {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .header-link {
        text-decoration: none;
        color: var(--muted);
        font-size: 14px;
      }

      .header-link:hover {
        color: var(--text);
      }

      main {
        padding: 30px 24px 60px;
      }

      .template-note {
        margin: 0 0 26px;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-radius: 10px;
        color: #344054;
        font-size: 14px;
        background: #fcfcfd;
      }

      .template-note a {
        color: #175cd3;
        text-decoration: none;
      }

      .template-note a:hover {
        text-decoration: underline;
      }

      .timeline {
        position: relative;
      }

      .entry {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .entry-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .entry-side {
        flex-shrink: 0;
      }

      .entry-side-sticky {
        padding-bottom: 36px;
      }

      .entry-date {
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
      }

      .entry-version {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--card);
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
      }

      .entry-main {
        flex: 1;
        position: relative;
        padding-bottom: 40px;
      }

      .entry-main::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 1px;
        height: calc(100% - 9px);
        background: var(--line);
      }

      .entry-dot {
        position: absolute;
        left: -5px;
        top: 8px;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #111827;
      }

      .entry-content {
        padding-left: 30px;
      }

      .entry-title {
        margin: 0;
        font-size: 30px;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 600;
        text-wrap: balance;
      }

      .chip-row {
        margin-top: 12px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 24px;
        padding: 0 10px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--chip-bg);
        color: var(--chip-text);
        font-size: 12px;
        font-weight: 500;
      }

      .entry-summary {
        margin-top: 16px;
        color: #344054;
        line-height: 1.7;
        font-size: 15px;
      }

      .accordion-group {
        margin-top: 14px;
        display: grid;
        gap: 10px;
      }

      .accordion {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
      }

      .accordion > summary {
        cursor: pointer;
        padding: 10px 12px;
        font-size: 14px;
        font-weight: 600;
        color: #1d2939;
        background: #f9fafb;
        list-style: none;
      }

      .accordion > summary::-webkit-details-marker {
        display: none;
      }

      .accordion > summary::after {
        content: "+";
        float: right;
        color: #667085;
      }

      .accordion[open] > summary::after {
        content: "−";
      }

      .accordion-list {
        margin: 0;
        padding: 10px 16px 14px 30px;
        color: #344054;
        font-size: 14px;
        line-height: 1.65;
      }

      .accordion-list li + li {
        margin-top: 8px;
      }

      .entry-notes {
        margin-top: 12px;
        color: #344054;
        line-height: 1.72;
        font-size: 15px;
        white-space: pre-wrap;
      }

      .entry-link {
        margin-top: 12px;
      }

      .entry-link a {
        color: #175cd3;
        text-decoration: none;
        font-size: 14px;
      }

      .entry-link a:hover {
        text-decoration: underline;
      }

      .empty .entry-main::before,
      .empty .entry-dot {
        display: none;
      }

      @media (min-width: 768px) {
        .entry-wrap {
          flex-direction: row;
          gap: 0;
        }

        .entry-side {
          width: 192px;
        }

        .entry-side-sticky {
          position: sticky;
          top: 32px;
        }

        .entry-main {
          padding-left: 32px;
        }

        .entry-content {
          padding-left: 0;
        }
      }

      @media (max-width: 767px) {
        .header-inner {
          padding: 14px 16px;
          align-items: flex-start;
          flex-direction: column;
        }

        .header-title {
          font-size: 28px;
        }

        main {
          padding: 22px 16px 44px;
        }

        .entry-main::before,
        .entry-dot {
          display: none;
        }

        .entry-main {
          padding-bottom: 34px;
        }

        .entry-content {
          padding-left: 0;
        }

        .entry-title {
          font-size: 25px;
        }
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <div class="header-inner">
          <h1 class="header-title">Changelog</h1>
          <nav class="header-links" aria-label="Changelog links">
            <a class="header-link" href="/">Home</a>
            <a class="header-link" href="/onboarding/">Onboarding</a>
            <a class="header-link" href="https://github.com/kubai087/lumno-extension/releases" target="_blank" rel="noreferrer">GitHub Releases</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="container">
      <p class="template-note">
        Use release template: <a href="https://github.com/kubai087/lumno-web/blob/main/.github/RELEASE_TEMPLATE.md" target="_blank" rel="noreferrer">.github/RELEASE_TEMPLATE.md</a>
      </p>

      <section class="timeline">
        {
          releases.length > 0 ? (
            releases.map((item) => (
              <article class="entry">
                <div class="entry-wrap">
                  <aside class="entry-side">
                    <div class="entry-side-sticky">
                      <time class="entry-date">{formatDate(item.date)}</time>
                      <div class="entry-version">{getVersionLabel(item.tag)}</div>
                    </div>
                  </aside>

                  <div class="entry-main">
                    <span class="entry-dot" aria-hidden="true"></span>
                    <div class="entry-content">
                      <h2 class="entry-title">{item.name}</h2>

                      <div class="chip-row">
                        <span class="chip">{item.tag}</span>
                        {item.prerelease && <span class="chip">Pre-release</span>}
                        {item.parsed.tags.map((releaseTag) => (
                          <span class="chip">{releaseTag}</span>
                        ))}
                      </div>

                      {item.parsed.summary && <div class="entry-summary">{item.parsed.summary}</div>}

                      {(item.parsed.features.length > 0 || item.parsed.bugFixes.length > 0) && (
                        <div class="accordion-group">
                          {item.parsed.features.length > 0 && (
                            <details class="accordion" open>
                              <summary>Features ({item.parsed.features.length})</summary>
                              <ul class="accordion-list">
                                {item.parsed.features.map((feature) => (
                                  <li>{feature}</li>
                                ))}
                              </ul>
                            </details>
                          )}

                          {item.parsed.bugFixes.length > 0 && (
                            <details class="accordion" open>
                              <summary>Bug Fixes ({item.parsed.bugFixes.length})</summary>
                              <ul class="accordion-list">
                                {item.parsed.bugFixes.map((fix) => (
                                  <li>{fix}</li>
                                ))}
                              </ul>
                            </details>
                          )}
                        </div>
                      )}

                      {item.parsed.notes && <div class="entry-notes">{item.parsed.notes}</div>}

                      <div class="entry-link">
                        <a href={item.url} target="_blank" rel="noreferrer">Read on GitHub</a>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            ))
          ) : (
            <article class="entry empty">
              <div class="entry-wrap">
                <div class="entry-main">
                  <div class="entry-content">
                    <h2 class="entry-title">No releases yet</h2>
                    <div class="entry-summary">Create a GitHub Release and it will appear here on next deploy.</div>
                  </div>
                </div>
              </div>
            </article>
          )
        }
      </section>
    </main>
  </body>
</html>
