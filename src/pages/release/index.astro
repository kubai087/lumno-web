// Language names are the same everywhere (each in its own language), so every locale shares them.
const languageMessages = Object.fromEntries(
  LOCALE_CONFIG.map((item) => [`language_${item.code.toLowerCase().replace("-", "_")}`, item.label]),
);
const i18nMessages = Object.fromEntries(
  SUPPORTED_UI_LANGUAGES.map((locale) => [locale, { ...languageMessages, ...RELEASE_MESSAGES[locale] }]),
);
const uiMessages = RELEASE_MESSAGES[uiLocale];
const initialUi = {
  bannerTitle: uiMessages.banner_title_web,
  readOnGithub: uiMessages.read_on_github,
  noReleasesTitle: uiMessages.no_releases_title,
  noReleasesDesc: uiMessages.no_releases_desc,
  featuresLabel: uiMessages.features_label,
  bugFixesLabel: uiMessages.bug_fixes_label,
  githubPublished: uiMessages.github_published,
  chromePublished: uiMessages.chrome_published,
  chromeReviewing: uiMessages.chrome_reviewing,
};
const releaseItemListSchema = releases.length
  ? buildItemListSchema({
      name: pageTitle,
      description: pageDescription,
      path: seoPath,
      language: uiLocale,
      items: releases.map((item) => {
        const localeContent = item.parsed.locales[releaseContentLocale];
        const description =
          localeContent.summary ||
          localeContent.features[0] ||
          localeContent.bugFixes[0] ||
          item.name;

        return {
          name: item.name,
          description,
          url: item.url,
          type: "CreativeWork",
          datePublished: item.date || undefined,
        };
      }),
    })
  : null;
const structuredData = [
  buildSoftwareApplicationSchema({
    description: pageDescription,
    version: latestReleaseVersion || undefined,
  }),
  buildWebPageSchema({
    name: pageTitle,
    description: pageDescription,
    path: seoPath,
    language: uiLocale,
    mainEntity: releaseItemListSchema || undefined,
  }),
  ...(releaseItemListSchema ? [releaseItemListSchema] : []),
  buildBreadcrumbListSchema({
    items: [
      { name: SITE_NAME, path: homeHref },
      { name: initialUi.bannerTitle, path: seoPath },
    ],
  }),
];

const { chrome: chromeStoreVersion } = await getStoreVersions({
  chrome: import.meta.env.PUBLIC_CHROME_STORE_VERSION || import.meta.env.CHROME_STORE_VERSION,
  edge: import.meta.env.PUBLIC_EDGE_STORE_VERSION || import.meta.env.EDGE_STORE_VERSION,
});

function renderMdInline(markdown: string): string {
  return marked.parseInline(markdown || "", { async: false });
}

function renderMdBlock(markdown: string): string {
  return marked.parse(markdown || "", { async: false });
}

function normalizeVersion(raw: string): number[] {
  const parts = String(raw || "")
    .replace(/^[^\d]*/, "")
    .match(/\d+/g);
  return (parts || []).map((part) => Number(part));
}

function compareVersion(a: string, b: string): number {
  const pa = normalizeVersion(a);
  const pb = normalizeVersion(b);
  const length = Math.max(pa.length, pb.length);
  for (let i = 0; i < length; i += 1) {
    const va = pa[i] || 0;
    const vb = pb[i] || 0;
    if (va > vb) return 1;
    if (va < vb) return -1;
  }
  return 0;
}

function getChromeStatusI18nKey(tag: string): "chrome_published" | "chrome_reviewing" | null {
  if (!chromeStoreVersion) return null;
  return compareVersion(chromeStoreVersion, tag) >= 0
    ? "chrome_published"
    : "chrome_reviewing";
}
---

<html lang={uiLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <LocaleNormalizer />
    {
      !forcedLocale && (
        <script is:inline define:vars={{ routeLanguageMap, entryKeys: entryContextConfig.extensionEntryKeys }}>
          (() => {
            // Each route renders only its own language. The default route stays on zh-CN for
            // first-time web visitors and crawlers; a saved choice, or the browser language when
            // the extension opens this page after an update, moves to the localized route before paint.
            let storedMode = "";
            try {
              storedMode = String(window.localStorage.getItem("_x_extension_language_2024_unique_") || "").trim();
            } catch (_error) {
              // Private browsing or blocked storage keeps the default route.
            }

            const params = new URLSearchParams(window.location.search);
            const isExtensionEntry = entryKeys.some((key) => params.has(key));
            if (!storedMode && !isExtensionEntry) return;

            const browserLanguage = (Array.isArray(navigator.languages) && navigator.languages[0]) || navigator.language || "en";
            const mode = storedMode && storedMode.toLowerCase() !== "system" ? storedMode : browserLanguage;
            const targetPath = routeLanguageMap[window.__lumnoNormalizeLocale(mode, "en")];
            if (targetPath && window.location.pathname !== targetPath) {
              window.location.replace(`${targetPath}${window.location.search}${window.location.hash}`);
            }
          })();
        </script>
      )
    }
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      path={seoPath}
      keywords={pageKeywords}
      alternates={alternateLinks}
      locale={ogLocale}
      noindex={!isReleaseNoteLocale(uiLocale)}
      type="article"
      structuredData={structuredData}
    />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/assets/remixicon.css" />
    <link rel="stylesheet" href="/assets/fonts/open-sans/open-sans.css" />
    <style>
      :root {
        --bg: #ffffff;
        --text: #101828;
        --muted: #667085;
        --line: #eaecf0;
        --border-soft: #d8dde3;
        --card: #ffffff;
        --chip-bg: #f9fafb;
        --chip-text: #475467;
        /* The shared top bar: a 58px pill, 6px from the top. */
        --release-header-offset: 64px;
        --text-main: #15171a;
        --safe-area-bottom: 0px;
        --safe-area-bottom: env(safe-area-inset-bottom, 0px);
      }

      * {
        box-sizing: border-box;
      }

      /* The same scrollbar as the other pages, so the top bar lines up across them. */
      html {
        scrollbar-gutter: stable;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, #15171a 18%, transparent) transparent;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", "SF Pro Text", "Segoe UI", system-ui, sans-serif;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      body[data-release-locale] {
        font-family: "Open Sans", var(--font-cjk, "PingFang SC", "Microsoft YaHei"), "Segoe UI", system-ui, sans-serif;
      }

      .container {
        max-width: 1024px;
        margin: 0 auto;
      }

      /*
       * Clear the fixed top bar, then the original 30px breathing room. The bar
       * brings Tailwind's preflight (line-height 1.5); the notes keep the browser
       * default they were designed with, without touching the bar itself.
       */
      main {
        line-height: normal;
        padding: calc(var(--release-header-offset) + 30px) 24px 60px;
        padding: calc(var(--release-header-offset) + 30px) 24px max(60px, var(--safe-area-bottom));
      }

      .top-banner {
        margin: 0 0 24px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        border-radius: 16px;
        overflow: hidden;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        position: relative;
        aspect-ratio: 2200 / 586;
        min-height: 132px;
      }

      .top-banner img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .banner-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        pointer-events: none;
      }

      body:not([data-release-entry="ext"]) .banner-overlay {
        inset: auto;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      body:not([data-release-entry="ext"]) .banner-title-emoji {
        display: none;
      }

      .banner-title {
        margin: 0;
        font-family: "Open Sans", var(--font-cjk, "PingFang SC", "Microsoft YaHei"), sans-serif;
        font-size: clamp(32px, 5.2vw, 40px);
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0;
        color: #111827;
        text-shadow: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }

      .banner-title-text {
        background-image:
          linear-gradient(180deg, #45563c 0%, #7a8c71 100%),
          linear-gradient(180deg, #000000 0%, #888888 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .banner-title-emoji {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        font-size: 0.95em;
        color: initial;
      }

      .banner-title {
        transform: translateY(10px) scale(0.94);
        opacity: 0;
        animation: banner-pop 620ms cubic-bezier(0.22, 1, 0.36, 1) 120ms forwards;
      }

      @keyframes banner-pop {
        from {
          opacity: 0;
          transform: translateY(10px) scale(0.94);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .timeline {
        position: relative;
      }

      .entry {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .entry-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .entry-side {
        flex-shrink: 0;
      }

      .entry-side-sticky {
        padding-bottom: 36px;
      }

      .entry-date {
        display: block;
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
      }

      .entry-version {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--card);
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
      }

      .entry-main {
        flex: 1;
        position: relative;
        padding-bottom: 40px;
      }

      .entry-main::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 1px;
        height: calc(100% - 9px);
        background: var(--line);
      }

      .entry-dot {
        position: absolute;
        left: -5px;
        top: 8px;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        --lumno-corner-shape: round;
        background: #111827;
      }

      .entry-content {
        padding-left: 30px;
      }

      .entry-title {
        margin: 0;
        font-size: 30px;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 600;
        text-wrap: balance;
      }

      .chip-row {
        margin-top: 12px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 24px;
        padding: 0 10px;
        border-radius: 999px;
        --lumno-corner-shape: round;
        border: 1px solid var(--line);
        background: var(--chip-bg);
        color: var(--chip-text);
        font-size: 12px;
        font-weight: 500;
      }

      .chip-status {
        gap: 5px;
        padding-left: 8px;
      }

      .chip-status i {
        font-size: 13px;
      }

      .chip-link {
        text-decoration: none;
        cursor: pointer;
      }

      .chip-github {
        border-color: #d0d5dd;
        background: #f8fafc;
        color: #334155;
      }

      .chip-chrome.is-published {
        border-color: #a3e5c8;
        background: #ecfdf3;
        color: #027a48;
      }

      .chip-chrome.is-reviewing {
        border-color: #ffd19a;
        background: #fff8eb;
        color: #b54708;
        cursor: default;
      }

      .entry-summary {
        margin-top: 16px;
        color: #344054;
        line-height: 1.7;
        font-size: 15px;
      }

      :global(.entry-summary ul) {
        list-style: disc;
      }

      :global(.entry-summary ol) {
        list-style: decimal;
      }

      :global(.entry-summary p) {
        margin: 0 0 10px;
      }

      :global(.entry-summary p:last-child) {
        margin-bottom: 0;
      }

      :global(.entry-summary a) {
        color: #175cd3;
        text-decoration: none;
      }

      :global(.entry-summary a:hover) {
        text-decoration: underline;
      }

      :global(.entry-summary code) {
        font-size: 0.95em;
        font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
        border-radius: 6px;
        padding: 1px 5px;
      }

      :global(.entry-summary pre) {
        margin: 12px 0;
        padding: 10px 12px;
        background: #f8fafc;
        border: 1px solid #e4e7ec;
        border-radius: 10px;
        overflow-x: auto;
      }

      :global(.entry-summary pre code) {
        display: block;
        padding: 0;
        border: 0;
        background: transparent;
      }

      .accordion-group {
        margin-top: 14px;
        display: grid;
        gap: 10px;
      }

      .accordion {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
      }

      .accordion > summary {
        cursor: pointer;
        padding: 10px 12px;
        font-size: 14px;
        font-weight: 600;
        color: #1d2939;
        background: #f9fafb;
        list-style: none;
      }

      .accordion > summary::-webkit-details-marker {
        display: none;
      }

      .accordion > summary::after {
        content: "+";
        float: right;
        color: #667085;
        transition: transform 220ms ease;
      }

      .accordion[open] > summary::after {
        content: "−";
        transform: rotate(180deg);
      }

      .accordion-panel {
        overflow: hidden;
        height: auto;
        opacity: 1;
      }

      .accordion-list {
        overflow: hidden;
        margin: 0;
        padding: 10px 16px 14px 30px;
        color: #344054;
        font-size: 14px;
        line-height: 1.65;
        list-style: disc;
      }

      .accordion-list li + li {
        margin-top: 8px;
      }

      :global(.accordion-list a) {
        color: #175cd3;
        text-decoration: none;
      }

      :global(.accordion-list a:hover) {
        text-decoration: underline;
      }

      :global(.accordion-list code) {
        font-size: 12px;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
        border-radius: 6px;
        padding: 1px 5px;
      }

      .entry-link {
        margin-top: 12px;
      }

      .entry-link-btn {
        min-height: 36px;
        padding: 9px 14px;
        border-radius: 999px;
        --lumno-corner-shape: round;
        border: 1px solid #d0d5dd;
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02), inset 0 -4px 3px rgba(255, 255, 255, 0.59);
        color: #4b545f;
        text-decoration: none;
        font-size: 14px;
        line-height: 1;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition:
          transform 180ms ease,
          box-shadow 180ms ease,
          border-color 180ms ease,
          background 180ms ease;
      }

      .entry-link-btn i {
        font-size: 14px;
      }

      @media (hover: hover) and (pointer: fine) {
        .entry-link-btn:hover {
          transform: translateY(-1px);
          border-color: #d2d8df;
          background: linear-gradient(180deg, #ffffff 0%, #e8ebef 100%);
          box-shadow:
            0 14px 18px rgba(0, 0, 0, 0.04),
            0 2px 3px rgba(0, 0, 0, 0.04),
            inset 0 -4px 3px rgba(255, 255, 255, 0.65);
        }
      }

      .entry-link-btn:active {
        transform: translateY(1px);
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow:
          0 2px 5px rgba(0, 0, 0, 0.06),
          inset 0 -4px 3px rgba(255, 255, 255, 0.59);
      }

      .entry-link-btn:focus-visible {
        outline: 2px solid rgba(75, 84, 95, 0.35);
        outline-offset: 2px;
      }

      .empty .entry-main::before,
      .empty .entry-dot {
        display: none;
      }

      @media (min-width: 768px) {
        .entry-wrap {
          flex-direction: row;
          gap: 0;
        }

        .entry-side {
          width: 192px;
        }

        .entry-side-sticky {
          position: sticky;
          top: calc(var(--release-header-offset) + 24px);
        }

        .entry-main {
          padding-left: 32px;
        }

        .entry-content {
          padding-left: 0;
        }
      }

      @media (max-width: 767px) {
        main {
          padding: calc(var(--release-header-offset) + 22px) 16px 60px;
          padding: calc(var(--release-header-offset) + 22px) 16px max(60px, var(--safe-area-bottom));
        }

        .top-banner {
          min-height: 0;
        }

        .entry-main::before,
        .entry-dot {
          display: none;
        }

        .entry-main {
          padding-bottom: 34px;
        }

        .entry-content {
          padding-left: 0;
        }

        .entry-title {
          font-size: 25px;
        }
      }
    </style>
  </head>
  <body class="has-nav-install is-nav-install-settled" data-locale={uiLocale} data-script={getLocaleScript(uiLocale)} data-release-locale={uiLocale} data-release-content-locale={releaseContentLocale}>
    <SiteHeader locale={uiLocale} routeLanguageMap={routeLanguageMap} analyticsScope="release" handoff=".top-banner" keepInstall />

    <main class="container">
      <div class="top-banner">
        <img
          src="/resource_commited/banner.jpg"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="2200"
          height="586"
        />
        <div class="banner-overlay">
          <h1 class="banner-title">
            <span class="banner-title-emoji" aria-hidden="true">🎉</span>
            <span class="banner-title-text" data-i18n="banner_title">{initialUi.bannerTitle}</span>
          </h1>
        </div>
      </div>
      <section class="timeline">
        {
          releases.length > 0 ? (
            releases.map((item) => {
              const localeContent = item.parsed.locales[releaseContentLocale];
              const chromeStatusKey = getChromeStatusI18nKey(item.tag);
              const anchor = item.tag.startsWith("v") ? item.tag : `v${item.tag}`;

              return (
                <article class="entry" id={anchor}>
                  <div class="entry-wrap">
                    <aside class="entry-side">
                      <div class="entry-side-sticky">
                        <time class="entry-date" datetime={item.date || undefined}>{formatDate(item.date, uiLocale)}</time>
                        <div class="entry-version">{item.tag}</div>
                      </div>
                    </aside>

                    <div class="entry-main">
                      <span class="entry-dot" aria-hidden="true"></span>
                      <div class="entry-content">
                        <h2 class="entry-title">{item.name}</h2>

                        <div class="chip-row">
                          {item.parsed.tags.map((releaseTag) => (
                            <span class="chip">{releaseTag}</span>
                          ))}
                          <span class="chip chip-status chip-github">
                            <i class="ri-github-fill" aria-hidden="true"></i>
                            <span data-i18n="github_published">{initialUi.githubPublished}</span>
                          </span>
                          {chromeStatusKey === "chrome_published" ? (
                            <a
                              class="chip chip-status chip-chrome is-published chip-link"
                              href={CHROME_STORE_URL}
                              target="_blank"
                              rel="noreferrer"
                              data-analytics-event="open_chrome_web_store"
                              data-analytics-category="cta"
                              data-analytics-label={`release_chrome_status_${item.tag}`}
                            >
                              <i class="ri-chrome-fill" aria-hidden="true"></i>
                              <span data-i18n={chromeStatusKey}>{initialUi.chromePublished}</span>
                            </a>
                          ) : chromeStatusKey ? (
                            <span class="chip chip-status chip-chrome is-reviewing">
                              <i class="ri-chrome-fill" aria-hidden="true"></i>
                              <span data-i18n={chromeStatusKey}>{initialUi.chromeReviewing}</span>
                            </span>
                          ) : null}
                        </div>

                        <div class="entry-localized" data-release-locale={releaseContentLocale}>
                          {localeContent.summary && <div class="entry-summary" set:html={renderMdBlock(localeContent.summary)}></div>}

                          {(localeContent.features.length > 0 || localeContent.bugFixes.length > 0) && (
                            <div class="accordion-group">
                              {localeContent.features.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="features_label" data-count={localeContent.features.length}>{initialUi.featuresLabel} ({localeContent.features.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {localeContent.features.map((feature) => (
                                        <li set:html={renderMdInline(feature)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}

                              {localeContent.bugFixes.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="bug_fixes_label" data-count={localeContent.bugFixes.length}>{initialUi.bugFixesLabel} ({localeContent.bugFixes.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {localeContent.bugFixes.map((fix) => (
                                        <li set:html={renderMdInline(fix)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}
                            </div>
                          )}
                        </div>

                        <div class="entry-link">
                          <a class="entry-link-btn" href={item.url} target="_blank" rel="noreferrer noopener" data-analytics-event="open_github_release" data-analytics-category="cta" data-analytics-label={`release_notes_${item.tag}`}>
                            <span data-i18n="read_on_github">{initialUi.readOnGithub}</span>
                            <i class="ri-external-link-line" aria-hidden="true"></i>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })
          ) : (
            <article class="entry empty">
              <div class="entry-wrap">
                <div class="entry-main">
                  <div class="entry-content">
                    <h2 class="entry-title" data-i18n="no_releases_title">{initialUi.noReleasesTitle}</h2>
                    <div class="entry-summary" data-i18n="no_releases_desc">{initialUi.noReleasesDesc}</div>
                  </div>
                </div>
              </div>
            </article>
          )
        }
      </section>
    </main>
    <!-- The homepage footer: crawlable links to every page and language. -->
    <PageFooter locale={uiLocale} routeLanguageMap={routeLanguageMap} analyticsScope="release" />
    <script>
      import "../../scripts/language-preference";
      import "../../scripts/language-runtime";
    </script>
    <script is:inline define:vars={{ forcedLocale, routeLanguageMap, pageTitleByLocale, entryContextConfig, i18nMessages }}>
      const LANGUAGE_STORAGE_KEY = "_x_extension_language_2024_unique_";
      const FORCED_LOCALE = forcedLocale;
      const ROUTE_LANGUAGE_MAP = routeLanguageMap;
      const ENTRY_CONTEXT_CONFIG = entryContextConfig;
      const FALLBACK_LOCALE = "zh-CN";
      const I18N_MESSAGES = i18nMessages;

      function getSystemLocale() {
        const firstPreferred = Array.isArray(navigator.languages) && navigator.languages.length ? navigator.languages[0] : navigator.language;
        return window.__lumnoNormalizeLocale(firstPreferred, "en");
      }

      function normalizeLanguageMode(mode) {
        const raw = String(mode || "").trim();
        if (!raw) return getSystemLocale();
        if (raw.toLowerCase() === "system") return getSystemLocale();
        return window.__lumnoNormalizeLocale(raw, "en");
      }

      function getReleaseContentLocale(locale) {
        return locale === "zh-CN" || locale === "zh-TW" ? locale : "en";
      }

      function getMessage(locale, key) {
        return (
          (I18N_MESSAGES[locale] && I18N_MESSAGES[locale][key]) ||
          (I18N_MESSAGES[FALLBACK_LOCALE] && I18N_MESSAGES[FALLBACK_LOCALE][key]) ||
          key
        );
      }

      function getEntryContext() {
        const params = new URLSearchParams(window.location.search);
        const entry = (params.get("entry") || "").trim().toLowerCase();
        const source = (params.get("source") || "").trim().toLowerCase();
        const reason = (params.get("reason") || "").trim().toLowerCase();
        const rawVersion = String(params.get("version") || "").trim();
        const versionFromParam = rawVersion ? (/^v/i.test(rawVersion) ? rawVersion : `v${rawVersion}`) : "";
        const fallbackVersion = ENTRY_CONTEXT_CONFIG.latestVersion || "";
        const version = versionFromParam || fallbackVersion;
        const hasExtensionEntryKey = ENTRY_CONTEXT_CONFIG.extensionEntryKeys.some((key) => params.has(key));
        const isExtensionEntry =
          ENTRY_CONTEXT_CONFIG.extensionEntryValues.includes(entry) ||
          ENTRY_CONTEXT_CONFIG.extensionEntryValues.includes(source) ||
          Boolean(reason) ||
          Boolean(versionFromParam) ||
          hasExtensionEntryKey;
        return { isExtensionEntry, reason, version };
      }

      function withVersion(template, version) {
        return String(template || "").replace("{version}", version || "");
      }

      const INITIAL_ENTRY_CONTEXT = getEntryContext();

      function updateLanguageOptionState(mode) {
        let activeLabel = "";
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const value = node.getAttribute("data-lang-value") || getSystemLocale();
          const isActive = value === mode;
          node.classList.toggle("is-active", isActive);
          node.setAttribute("aria-checked", isActive ? "true" : "false");
          if (isActive) {
            activeLabel = (node.textContent || "").trim();
          }
        });
        const currentLabel = document.getElementById("language-current-label");
        if (currentLabel && activeLabel) {
          currentLabel.textContent = activeLabel;
        }
      }

      function applyI18n(locale) {
        const resolvedLocale = I18N_MESSAGES[locale] ? locale : FALLBACK_LOCALE;
        document.title = pageTitleByLocale[resolvedLocale] || pageTitleByLocale[FALLBACK_LOCALE];
        document.documentElement.lang = resolvedLocale;
        document.body.setAttribute("data-release-locale", resolvedLocale);
        document.body.setAttribute("data-release-content-locale", getReleaseContentLocale(resolvedLocale));
        const entryContext = INITIAL_ENTRY_CONTEXT;
        document.body.setAttribute("data-release-entry", entryContext.isExtensionEntry ? "ext" : "web");

        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (!key) return;
          let value = getMessage(resolvedLocale, key);
          if (key === "banner_title") {
            // Web visitors (and crawlers) get a descriptive heading; the celebratory copy is only for update entries.
            value = !entryContext.isExtensionEntry
              ? getMessage(resolvedLocale, "banner_title_web")
              : entryContext.version
                ? withVersion(getMessage(resolvedLocale, "banner_title_ext"), entryContext.version)
                : getMessage(resolvedLocale, "banner_title");
          }
          if (node.tagName === "TITLE") {
            document.title = value;
            return;
          }

          const count = node.getAttribute("data-count");
          if (count && (key === "features_label" || key === "bug_fixes_label")) {
            node.textContent = `${value} (${count})`;
            return;
          }

          node.textContent = value;
        });

        document.querySelectorAll("[data-i18n-aria-label]").forEach((node) => {
          const key = node.getAttribute("data-i18n-aria-label");
          if (!key) return;
          node.setAttribute("aria-label", getMessage(resolvedLocale, key));
        });

        document.querySelectorAll("[data-i18n-alt]").forEach((node) => {
          const key = node.getAttribute("data-i18n-alt");
          if (!key) return;
          node.setAttribute("alt", getMessage(resolvedLocale, key));
        });
      }

      function applyResolvedLanguage(normalizedMode) {
        if (!I18N_MESSAGES[normalizedMode]) {
          document.documentElement.lang = normalizedMode;
          document.body.setAttribute("data-release-locale", normalizedMode);
          document.body.setAttribute("data-release-content-locale", getReleaseContentLocale(normalizedMode));
          updateLanguageOptionState(normalizedMode);
          return;
        }
        applyI18n(normalizedMode);
        updateLanguageOptionState(normalizedMode);
      }

      function initLanguageRuntime() {
        if (!window.__lumnoLanguagePreference || !window.__lumnoLanguageRuntime) return null;
        const storedMode = window.__lumnoLanguagePreference.getStoredLanguageMode(LANGUAGE_STORAGE_KEY);
        // Public canonical routes stay stable; extension entries follow the browser language (the head
        // script has already moved them to that route, since each route renders a single language).
        const initialForcedLocale = FORCED_LOCALE ||
          (!INITIAL_ENTRY_CONTEXT.isExtensionEntry && !storedMode ? FALLBACK_LOCALE : null);
        return window.__lumnoLanguageRuntime.setupLanguageRuntime({
          forcedLocale: initialForcedLocale,
          getSystemLocale,
          normalizeLanguageMode,
          routeLanguageMap: ROUTE_LANGUAGE_MAP,
          languageStorageKey: LANGUAGE_STORAGE_KEY,
          applyResolvedLanguage,
        });
      }

      function bootLanguageRuntime() {
        const languageRuntime = initLanguageRuntime();
        if (!languageRuntime) return false;
        languageRuntime.applyLanguageMode(languageRuntime.getInitialLanguageMode());
        window.addEventListener("load", () => {
          languageRuntime.applyLanguageMode(languageRuntime.getInitialLanguageMode());
        }, { once: true });
        return true;
      }

      if (!bootLanguageRuntime()) {
        const retryBootLanguageRuntime = () => {
          if (bootLanguageRuntime()) {
            window.removeEventListener("lumno:language-runtime-ready", retryBootLanguageRuntime);
            window.removeEventListener("lumno:language-preference-ready", retryBootLanguageRuntime);
          }
        };
        window.addEventListener("lumno:language-runtime-ready", retryBootLanguageRuntime);
        window.addEventListener("lumno:language-preference-ready", retryBootLanguageRuntime);
      }

      function setupAccordionAnimations() {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const accordions = document.querySelectorAll(".accordion");
        accordions.forEach((accordion) => {
          if (!(accordion instanceof HTMLDetailsElement)) return;
          const summary = accordion.querySelector("summary");
          const panel = accordion.querySelector(".accordion-panel");
          if (!(summary instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

          panel.style.overflow = "hidden";
          panel.style.height = accordion.open ? "auto" : "0px";
          panel.style.opacity = accordion.open ? "1" : "0";

          summary.addEventListener("click", (event) => {
            event.preventDefault();
            if (accordion.dataset.animating === "true") return;

            const isOpen = accordion.open;
            if (reduceMotion) {
              accordion.open = !isOpen;
              panel.style.height = accordion.open ? "auto" : "0px";
              panel.style.opacity = accordion.open ? "1" : "0";
              return;
            }

            accordion.dataset.animating = "true";
            panel.style.transition = "height 260ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease";

            if (isOpen) {
              const startHeight = panel.scrollHeight;
              panel.style.height = `${startHeight}px`;
              panel.style.opacity = "1";

              requestAnimationFrame(() => {
                panel.style.height = "0px";
                panel.style.opacity = "0";
              });

              const onCloseEnd = (transitionEvent) => {
                if (transitionEvent.propertyName !== "height") return;
                panel.removeEventListener("transitionend", onCloseEnd);
                accordion.open = false;
                panel.style.transition = "";
                panel.style.height = "0px";
                panel.style.opacity = "0";
                delete accordion.dataset.animating;
              };
              panel.addEventListener("transitionend", onCloseEnd);
              return;
            }

            accordion.open = true;
            panel.style.height = "0px";
            panel.style.opacity = "0";
            const endHeight = panel.scrollHeight;

            requestAnimationFrame(() => {
              panel.style.height = `${endHeight}px`;
              panel.style.opacity = "1";
            });

            const onOpenEnd = (transitionEvent) => {
              if (transitionEvent.propertyName !== "height") return;
              panel.removeEventListener("transitionend", onOpenEnd);
              panel.style.transition = "";
              panel.style.height = "auto";
              panel.style.opacity = "1";
              delete accordion.dataset.animating;
            };
            panel.addEventListener("transitionend", onOpenEnd);
          });
        });
      }

      setupAccordionAnimations();

      function fireIntroConfetti() {
        const canvas = document.createElement("canvas");
        canvas.style.position = "fixed";
        canvas.style.inset = "0";
        canvas.style.width = "100%";
        canvas.style.height = "100%";
        canvas.style.pointerEvents = "none";
        canvas.style.zIndex = "9999";
        document.body.appendChild(canvas);
        const ctx = canvas.getContext("2d");
        if (!ctx) {
          canvas.remove();
          return;
        }
        const dpr = Math.max(1, window.devicePixelRatio || 1);
        const width = window.innerWidth;
        const height = window.innerHeight;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.scale(dpr, dpr);

        const colors = ["#60A5FA", "#22C55E", "#F59E0B", "#F43F5E", "#A78BFA"];
        const particles = Array.from({ length: 120 }).map(() => {
          const left = Math.random() > 0.5;
          const x = left ? width * 0.3 : width * 0.7;
          return {
            x,
            y: height * 0.32,
            vx: (Math.random() * 6 + 2) * (left ? -1 : 1),
            vy: -(Math.random() * 8 + 5),
            size: Math.random() * 6 + 4,
            color: colors[Math.floor(Math.random() * colors.length)],
            rotate: Math.random() * Math.PI,
            spin: (Math.random() - 0.5) * 0.25,
          };
        });

        const gravity = 0.24;
        const drag = 0.992;
        const endAt = performance.now() + 1500;

        function frame(now) {
          ctx.clearRect(0, 0, width, height);
          particles.forEach((p) => {
            p.vx *= drag;
            p.vy = p.vy * drag + gravity;
            p.x += p.vx;
            p.y += p.vy;
            p.rotate += p.spin;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rotate);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.65);
            ctx.restore();
          });
          if (now < endAt) {
            requestAnimationFrame(frame);
          } else {
            canvas.remove();
          }
        }
        requestAnimationFrame(frame);
      }

      const entryContext = INITIAL_ENTRY_CONTEXT;
      if (entryContext.isExtensionEntry) {
        window.setTimeout(() => fireIntroConfetti(), 280);
        if (window.history && typeof window.history.replaceState === "function") {
          window.history.replaceState({}, "", window.location.pathname);
        }
      }
    </script>
  </body>
</html>
