---
import { fetchReleases, formatDate, parseReleaseBody, type ParsedReleaseBody, type ReleaseLocaleContent } from "../../lib/releases";
import { marked } from "marked";

const releases = (await fetchReleases()).map((item) => ({
  ...item,
  parsed: parseReleaseBody(item.body),
}));
const latestReleaseVersion = String(releases[0]?.tag || "").trim();

const chromeStoreVersion = String(
  import.meta.env.PUBLIC_CHROME_STORE_VERSION ||
    import.meta.env.CHROME_STORE_VERSION ||
    "",
).trim();

function renderMdInline(markdown: string): string {
  return marked.parseInline(markdown || "");
}

function renderMdBlock(markdown: string): string {
  return marked.parse(markdown || "");
}

function hasLocaleContent(content: ReleaseLocaleContent): boolean {
  return Boolean(content.summary || content.features.length > 0 || content.bugFixes.length > 0);
}

function normalizeVersion(raw: string): number[] {
  const parts = String(raw || "")
    .replace(/^[^\d]*/, "")
    .match(/\d+/g);
  return (parts || []).map((part) => Number(part));
}

function compareVersion(a: string, b: string): number {
  const pa = normalizeVersion(a);
  const pb = normalizeVersion(b);
  const length = Math.max(pa.length, pb.length);
  for (let i = 0; i < length; i += 1) {
    const va = pa[i] || 0;
    const vb = pb[i] || 0;
    if (va > vb) return 1;
    if (va < vb) return -1;
  }
  return 0;
}

function getChromeStatusI18nKey(tag: string): "chrome_published" | "chrome_reviewing" {
  if (!chromeStoreVersion) return "chrome_reviewing";
  return compareVersion(chromeStoreVersion, tag) >= 0
    ? "chrome_published"
    : "chrome_reviewing";
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-i18n="page_title">更新日志｜Lumno 聚焦搜索&新标签页</title>
    <meta name="description" content="Lumno changelog synced from GitHub Releases." />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/onboarding/assets/remixicon.css" />
    <link rel="stylesheet" href="/onboarding/assets/fonts/open-sans/open-sans.css" />
    <style>
      :root {
        --bg: #ffffff;
        --text: #101828;
        --muted: #667085;
        --line: #eaecf0;
        --border-soft: #d8dde3;
        --card: #ffffff;
        --chip-bg: #f9fafb;
        --chip-text: #475467;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", "SF Pro Text", "Segoe UI", system-ui, sans-serif;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      body[data-release-locale="en"] {
        font-family: "Open Sans", "Segoe UI", system-ui, sans-serif;
      }

      body[data-release-locale="zh-CN"] {
        font-family: "Open Sans", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
      }

      .header {
        border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
      }

      .container {
        max-width: 1024px;
        margin: 0 auto;
      }

      .header-inner {
        padding: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }

      .brand-logo {
        width: 136px;
        height: auto;
        display: block;
      }

      .header-controls {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .social-btn {
        min-height: 36px;
        border-radius: 999px;
        border: 1px solid var(--border-soft);
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02), inset 0 -4px 3px rgba(255, 255, 255, 0.59);
        color: #4b545f;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          border-color 0.18s ease,
          background 0.18s ease;
      }

      .social-btn:focus-visible {
        outline: 2px solid rgba(75, 84, 95, 0.35);
        outline-offset: 2px;
      }

      @media (hover: hover) and (pointer: fine) {
        .social-btn:hover {
          transform: translateY(-1px);
          border-color: #d2d8df;
          background: linear-gradient(180deg, #ffffff 0%, #e8ebef 100%);
          box-shadow:
            0 14px 18px rgba(0, 0, 0, 0.04),
            0 2px 3px rgba(0, 0, 0, 0.04),
            inset 0 -4px 3px rgba(255, 255, 255, 0.65);
        }

        .social-btn-discord:hover {
          border-color: transparent;
          background: linear-gradient(180deg, #4a5467 0%, #2f3a4f 100%);
          box-shadow:
            0 12px 4px rgba(0, 0, 0, 0),
            0 7px 3px rgba(0, 0, 0, 0.015),
            0 4px 3px rgba(0, 0, 0, 0.045),
            0 2px 2px rgba(0, 0, 0, 0.075),
            0 0 1px rgba(0, 0, 0, 0.09);
        }
      }

      .social-btn:active {
        transform: translateY(1px);
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow:
          0 2px 5px rgba(0, 0, 0, 0.06),
          inset 0 -4px 3px rgba(255, 255, 255, 0.59);
      }

      .social-btn-discord:active {
        background: linear-gradient(180deg, #3a4353 0%, #232b3b 100%);
        box-shadow:
          0 10px 3px rgba(0, 0, 0, 0),
          0 6px 2px rgba(0, 0, 0, 0.008),
          0 3px 2px rgba(0, 0, 0, 0.035),
          0 2px 2px rgba(0, 0, 0, 0.065),
          0 0 1px rgba(0, 0, 0, 0.075);
      }

      .social-btn-icon {
        width: 36px;
        min-width: 36px;
        padding: 0;
        font-size: 18px;
      }

      .social-btn-discord {
        position: relative;
        padding: 0 14px;
        gap: 8px;
        font-size: 14px;
        line-height: 1;
        font-weight: 500;
        border: none;
        color: #ffffff;
        background: linear-gradient(180deg, #404859 0%, #273042 100%);
        box-shadow:
          0 10px 3px rgba(0, 0, 0, 0),
          0 6px 2px rgba(0, 0, 0, 0.008),
          0 3px 2px rgba(0, 0, 0, 0.035),
          0 2px 2px rgba(0, 0, 0, 0.065),
          0 0 1px rgba(0, 0, 0, 0.075);
      }

      .social-btn-discord i {
        font-size: 18px;
      }

      .social-btn-discord::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        box-shadow:
          inset 0 0 0 1px #040404,
          inset 0 1px 0 rgba(255, 255, 255, 0.52),
          inset 0 1px 2.4px rgba(255, 255, 255, 0.36);
      }

      .lang-control {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 22;
        width: 38px;
      }

      .lang-toggle {
        width: 38px;
        min-width: 38px;
        height: 38px;
        border-radius: 999px;
        border: 1px solid transparent;
        background: transparent;
        box-shadow: none;
        color: #4b545f;
        cursor: pointer;
        font-size: 16px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
      }

      .lang-toggle i {
        font-size: 16px;
        line-height: 1;
      }

      .lang-select-prefix {
        width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .lang-current-label {
        display: none;
        flex: 1 1 auto;
        min-width: 0;
        font-size: 14px;
        color: #4b545f;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .lang-select-arrow {
        display: none;
        width: 16px;
        height: 16px;
        align-items: center;
        justify-content: center;
        color: #768095;
      }

      @media (hover: hover) and (pointer: fine) {
        .lang-toggle:hover {
          border-color: #d2d8df;
          background: rgba(255, 255, 255, 0.72);
          box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }
      }

      .lang-toggle:active {
        border-color: #ccd3db;
        background: rgba(255, 255, 255, 0.78);
        box-shadow: none;
      }

      .lang-menu {
        position: absolute;
        right: 0;
        bottom: calc(100% + 8px);
        top: auto;
        z-index: 36;
        min-width: 180px;
        background: #fff;
        border: 1px solid #e2e2e2;
        border-radius: 12px;
        padding: 6px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.12);
        opacity: 0;
        visibility: hidden;
        transform: translateY(6px) scale(0.97);
        transform-origin: bottom right;
        pointer-events: none;
        transition: opacity 180ms ease, transform 180ms ease;
      }

      .lang-menu[data-open="true"] {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
        visibility: visible;
      }

      .lang-option {
        width: 100%;
        border: 0;
        background: transparent;
        border-radius: 8px;
        text-align: left;
        padding: 7px 9px;
        color: #3f4650;
        font-family: inherit;
        font-size: 13px;
        cursor: pointer;
      }

      .lang-option:hover {
        background: #f3f5f7;
      }

      .lang-option.is-active {
        background: #eaf3ff;
        color: #2a5da7;
        font-weight: 600;
      }

      .qrcode-modal {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .qrcode-modal[hidden] {
        display: none;
      }

      .qrcode-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(8, 12, 20, 0.6);
      }

      .qrcode-modal-panel {
        position: relative;
        width: min(92vw, 380px);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 24px 42px rgba(16, 23, 38, 0.26);
        padding: 20px;
      }

      .qrcode-modal-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 999px;
        background: #f2f4f8;
        color: #212733;
        cursor: pointer;
      }

      .qrcode-modal-title {
        margin: 0 34px 12px 0;
        font-size: 16px;
        line-height: 1.35;
        font-weight: 600;
        color: #0f1725;
      }

      .qrcode-modal-image {
        display: block;
        width: 100%;
        border-radius: 12px;
      }

      main {
        padding: 30px 24px 60px;
      }

      .top-banner {
        margin: 0 0 24px;
        border-radius: 16px;
        overflow: hidden;
        background: #f8fafc;
        position: relative;
      }

      .top-banner img {
        display: block;
        width: 100%;
        height: auto;
      }

      .banner-overlay {
        position: absolute;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 12px;
        pointer-events: none;
      }

      body[data-release-entry="ext"] .banner-overlay {
        display: flex;
      }

      .banner-title {
        margin: 0;
        font-family: "Open Sans", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
        font-size: clamp(32px, 5.2vw, 40px);
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0;
        color: #111827;
        text-shadow: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }

      .banner-title-text {
        background-image:
          linear-gradient(180deg, #45563c 0%, #7a8c71 100%),
          linear-gradient(180deg, #000000 0%, #888888 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .banner-title-emoji {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        font-size: 0.95em;
        color: initial;
      }

      .banner-title {
        transform: translateY(10px) scale(0.94);
        opacity: 0;
        animation: banner-pop 620ms cubic-bezier(0.22, 1, 0.36, 1) 120ms forwards;
      }

      @keyframes banner-pop {
        from {
          opacity: 0;
          transform: translateY(10px) scale(0.94);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .timeline {
        position: relative;
      }

      .entry {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .entry-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .entry-side {
        flex-shrink: 0;
      }

      .entry-side-sticky {
        padding-bottom: 36px;
      }

      .entry-date {
        display: block;
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
      }

      .entry-version {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--card);
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
      }

      .entry-main {
        flex: 1;
        position: relative;
        padding-bottom: 40px;
      }

      .entry-main::before {
        content: "";
        position: absolute;
        left: 0;
        top: 9px;
        width: 1px;
        height: calc(100% - 9px);
        background: var(--line);
      }

      .entry-dot {
        position: absolute;
        left: -5px;
        top: 8px;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #111827;
      }

      .entry-content {
        padding-left: 30px;
      }

      .entry-title {
        margin: 0;
        font-size: 30px;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 600;
        text-wrap: balance;
      }

      .chip-row {
        margin-top: 12px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 24px;
        padding: 0 10px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--chip-bg);
        color: var(--chip-text);
        font-size: 12px;
        font-weight: 500;
      }

      .chip-status {
        gap: 5px;
        padding-left: 8px;
      }

      .chip-status i {
        font-size: 13px;
      }

      .chip-link {
        text-decoration: none;
        cursor: pointer;
      }

      .chip-github {
        border-color: #d0d5dd;
        background: #f8fafc;
        color: #334155;
      }

      .chip-chrome.is-published {
        border-color: #a3e5c8;
        background: #ecfdf3;
        color: #027a48;
      }

      .chip-chrome.is-reviewing {
        border-color: #ffd19a;
        background: #fff8eb;
        color: #b54708;
        cursor: default;
      }

      .entry-localized {
        display: none;
      }

      body[data-release-locale="zh-CN"] .entry-localized[data-release-locale="zh-CN"] {
        display: block;
      }

      body[data-release-locale="en"] .entry-localized[data-release-locale="en"] {
        display: block;
      }

      body:not([data-release-locale]) .entry-localized[data-release-locale="zh-CN"] {
        display: block;
      }

      .entry-summary {
        margin-top: 16px;
        color: #344054;
        line-height: 1.7;
        font-size: 15px;
      }

      :global(.entry-summary p) {
        margin: 0 0 10px;
      }

      :global(.entry-summary p:last-child) {
        margin-bottom: 0;
      }

      :global(.entry-summary a) {
        color: #175cd3;
        text-decoration: none;
      }

      :global(.entry-summary a:hover) {
        text-decoration: underline;
      }

      .accordion-group {
        margin-top: 14px;
        display: grid;
        gap: 10px;
      }

      .accordion {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
      }

      .accordion > summary {
        cursor: pointer;
        padding: 10px 12px;
        font-size: 14px;
        font-weight: 600;
        color: #1d2939;
        background: #f9fafb;
        list-style: none;
      }

      .accordion > summary::-webkit-details-marker {
        display: none;
      }

      .accordion > summary::after {
        content: "+";
        float: right;
        color: #667085;
        transition: transform 220ms ease;
      }

      .accordion[open] > summary::after {
        content: "−";
        transform: rotate(180deg);
      }

      .accordion-panel {
        overflow: hidden;
        height: auto;
        opacity: 1;
      }

      .accordion-list {
        overflow: hidden;
        margin: 0;
        padding: 10px 16px 14px 30px;
        color: #344054;
        font-size: 14px;
        line-height: 1.65;
      }

      .accordion-list li + li {
        margin-top: 8px;
      }

      :global(.accordion-list a) {
        color: #175cd3;
        text-decoration: none;
      }

      :global(.accordion-list a:hover) {
        text-decoration: underline;
      }

      :global(.accordion-list code) {
        font-size: 12px;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
        border-radius: 6px;
        padding: 1px 5px;
      }

      .entry-link {
        margin-top: 12px;
      }

      .entry-link-btn {
        min-height: 36px;
        padding: 9px 14px;
        border-radius: 999px;
        border: 1px solid #d0d5dd;
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02), inset 0 -4px 3px rgba(255, 255, 255, 0.59);
        color: #4b545f;
        text-decoration: none;
        font-size: 14px;
        line-height: 1;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition:
          transform 180ms ease,
          box-shadow 180ms ease,
          border-color 180ms ease,
          background 180ms ease;
      }

      .entry-link-btn i {
        font-size: 14px;
      }

      @media (hover: hover) and (pointer: fine) {
        .entry-link-btn:hover {
          transform: translateY(-1px);
          border-color: #d2d8df;
          background: linear-gradient(180deg, #ffffff 0%, #e8ebef 100%);
          box-shadow:
            0 14px 18px rgba(0, 0, 0, 0.04),
            0 2px 3px rgba(0, 0, 0, 0.04),
            inset 0 -4px 3px rgba(255, 255, 255, 0.65);
        }
      }

      .entry-link-btn:active {
        transform: translateY(1px);
        background: linear-gradient(180deg, #ffffff 0%, #ecedef 100%);
        box-shadow:
          0 2px 5px rgba(0, 0, 0, 0.06),
          inset 0 -4px 3px rgba(255, 255, 255, 0.59);
      }

      .entry-link-btn:focus-visible {
        outline: 2px solid rgba(75, 84, 95, 0.35);
        outline-offset: 2px;
      }

      .empty .entry-main::before,
      .empty .entry-dot {
        display: none;
      }

      @media (min-width: 768px) {
        .entry-wrap {
          flex-direction: row;
          gap: 0;
        }

        .entry-side {
          width: 192px;
        }

        .entry-side-sticky {
          position: sticky;
          top: 32px;
        }

        .entry-main {
          padding-left: 32px;
        }

        .entry-content {
          padding-left: 0;
        }
      }

      @media (max-width: 767px) {
        .header-inner {
          padding: 14px 16px;
          align-items: center;
          justify-content: space-between;
          flex-direction: row;
          gap: 10px;
        }

        .header-controls {
          width: auto;
          margin-left: auto;
          align-items: center;
          justify-content: flex-end;
          gap: 6px;
          flex-wrap: nowrap;
        }

        .lang-control {
          position: fixed;
          left: 16px;
          right: 16px;
          bottom: 16px;
          width: auto;
        }

        .lang-toggle {
          width: 100%;
          min-width: 0;
          min-height: 40px;
          border-radius: 10px;
          border: 1px solid #dbe1e8;
          background: #ffffff;
          box-shadow: 0 6px 18px rgba(14, 24, 38, 0.08);
          padding: 0 12px;
          display: grid;
          grid-template-columns: 1fr auto 1fr;
          align-items: center;
          gap: 10px;
        }

        .lang-current-label,
        .lang-select-arrow {
          display: inline-flex;
        }

        .lang-current-label {
          display: block;
          flex: none;
          justify-self: center;
          text-align: center;
          padding: 0 6px;
          max-width: 100%;
        }

        .lang-select-prefix {
          justify-self: start;
          width: 18px;
        }

        .lang-select-arrow {
          justify-self: end;
          width: 18px;
        }

        .lang-menu {
          width: 100%;
          min-width: 0;
          left: 0;
          right: auto;
          transform: translateY(6px) scale(0.97);
          transform-origin: bottom center;
        }

        .lang-menu[data-open="true"] {
          transform: translateY(0) scale(1);
        }

        .header-actions {
          margin-left: 0;
          gap: 6px;
        }

        .social-btn-icon,
        .social-btn-discord {
          width: 36px;
          min-width: 36px;
          padding: 0;
        }

        .social-btn-discord span {
          display: none;
        }

        main {
          padding: 22px 16px 96px;
        }

        .entry-main::before,
        .entry-dot {
          display: none;
        }

        .entry-main {
          padding-bottom: 34px;
        }

        .entry-content {
          padding-left: 0;
        }

        .entry-title {
          font-size: 25px;
        }
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <div class="header-inner">
          <a class="brand" href="/" data-i18n-aria-label="brand_home_aria" aria-label="Lumno home">
            <img class="brand-logo" src="/resource_commited/logo.png" alt="Lumno" draggable="false" />
          </a>
          <div class="header-controls">
            <nav class="header-actions">
              <a class="social-btn social-btn-icon" href="https://github.com/kubai087/lumno-extension" target="_blank" rel="noreferrer noopener" aria-label="Visit GitHub repository" data-i18n-aria-label="github_repo_aria">
                <i class="ri-github-fill" aria-hidden="true"></i>
              </a>
              <a class="social-btn social-btn-icon" href="https://x.com/kubai087" target="_blank" rel="noreferrer noopener" aria-label="Visit X profile" data-i18n-aria-label="x_aria">
                <i class="ri-twitter-x-fill" aria-hidden="true"></i>
              </a>
              <a
                class="social-btn social-btn-discord"
                href="https://discord.gg/2u9sg7ZNkJ"
                target="_blank"
                rel="noreferrer noopener"
                aria-label="Feedback & Requests"
                data-i18n-aria-label="discord_aria"
                data-community-entry
                data-discord-href="https://discord.gg/2u9sg7ZNkJ"
              >
                <i class="ri-discord-fill" aria-hidden="true" data-community-icon></i>
                <span data-i18n="join_discord">Feedback & Requests</span>
              </a>
            </nav>
          </div>
        </div>
      </div>
    </header>

    <main class="container">
      <div class="top-banner">
        <img src="/resource_commited/banner.jpg" alt="Lumno banner" loading="lazy" />
        <div class="banner-overlay">
          <h1 class="banner-title">
            <span class="banner-title-emoji" aria-hidden="true">🎉</span>
            <span class="banner-title-text" data-i18n="banner_title">已更新至新版本！</span>
          </h1>
        </div>
      </div>
      <section class="timeline">
        {
          releases.length > 0 ? (
            releases.map((item) => {
              const zhContent = item.parsed.locales["zh-CN"];
              const enContent = item.parsed.locales.en;
              const chromeStatusKey = getChromeStatusI18nKey(item.tag);

              return (
                <article class="entry">
                  <div class="entry-wrap">
                    <aside class="entry-side">
                      <div class="entry-side-sticky">
                        <time class="entry-date">{formatDate(item.date)}</time>
                        <div class="entry-version">{item.tag}</div>
                      </div>
                    </aside>

                    <div class="entry-main">
                      <span class="entry-dot" aria-hidden="true"></span>
                      <div class="entry-content">
                        <h2 class="entry-title">{item.name}</h2>

                        <div class="chip-row">
                          {item.parsed.tags.map((releaseTag) => (
                            <span class="chip">{releaseTag}</span>
                          ))}
                          <span class="chip chip-status chip-github">
                            <i class="ri-github-fill" aria-hidden="true"></i>
                            <span data-i18n="github_published">Published</span>
                          </span>
                          {chromeStatusKey === "chrome_published" ? (
                            <a
                              class="chip chip-status chip-chrome is-published chip-link"
                              href="https://chromewebstore.google.com/detail/nggfkkbmogmadfoikakkfegkoilfcfao"
                              target="_blank"
                              rel="noreferrer"
                            >
                              <i class="ri-chrome-fill" aria-hidden="true"></i>
                              <span data-i18n={chromeStatusKey}>Published</span>
                            </a>
                          ) : (
                            <span class="chip chip-status chip-chrome is-reviewing">
                              <i class="ri-chrome-fill" aria-hidden="true"></i>
                              <span data-i18n={chromeStatusKey}>In Review</span>
                            </span>
                          )}
                        </div>

                        <div class="entry-localized" data-release-locale="zh-CN">
                          {zhContent.summary && <div class="entry-summary" set:html={renderMdBlock(zhContent.summary)}></div>}

                          {(zhContent.features.length > 0 || zhContent.bugFixes.length > 0) && (
                            <div class="accordion-group">
                              {zhContent.features.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="features_label" data-count={zhContent.features.length}>Features ({zhContent.features.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {zhContent.features.map((feature) => (
                                        <li set:html={renderMdInline(feature)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}

                              {zhContent.bugFixes.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="bug_fixes_label" data-count={zhContent.bugFixes.length}>Bug Fixes ({zhContent.bugFixes.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {zhContent.bugFixes.map((fix) => (
                                        <li set:html={renderMdInline(fix)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}
                            </div>
                          )}
                        </div>

                        <div class="entry-localized" data-release-locale="en">
                          {enContent.summary && <div class="entry-summary" set:html={renderMdBlock(enContent.summary)}></div>}

                          {(enContent.features.length > 0 || enContent.bugFixes.length > 0) && (
                            <div class="accordion-group">
                              {enContent.features.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="features_label" data-count={enContent.features.length}>Features ({enContent.features.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {enContent.features.map((feature) => (
                                        <li set:html={renderMdInline(feature)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}

                              {enContent.bugFixes.length > 0 && (
                                <details class="accordion" open>
                                  <summary data-i18n="bug_fixes_label" data-count={enContent.bugFixes.length}>Bug Fixes ({enContent.bugFixes.length})</summary>
                                  <div class="accordion-panel">
                                    <ul class="accordion-list">
                                      {enContent.bugFixes.map((fix) => (
                                        <li set:html={renderMdInline(fix)}></li>
                                      ))}
                                    </ul>
                                  </div>
                                </details>
                              )}
                            </div>
                          )}
                        </div>

                        <div class="entry-link">
                          <a class="entry-link-btn" href={item.url} target="_blank" rel="noreferrer noopener">
                            <span data-i18n="read_on_github">Read on GitHub</span>
                            <i class="ri-external-link-line" aria-hidden="true"></i>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })
          ) : (
            <article class="entry empty">
              <div class="entry-wrap">
                <div class="entry-main">
                  <div class="entry-content">
                    <h2 class="entry-title" data-i18n="no_releases_title">No releases yet</h2>
                    <div class="entry-summary" data-i18n="no_releases_desc">Create a GitHub Release and it will appear here on next deploy.</div>
                  </div>
                </div>
              </div>
            </article>
          )
        }
      </section>
    </main>
    <div class="lang-control">
      <button
        id="language-toggle"
        class="lang-toggle"
        type="button"
        data-i18n-aria-label="language_select_aria"
        aria-label="Language"
        aria-haspopup="menu"
        aria-expanded="false"
      >
        <span class="lang-select-prefix">
          <i class="ri-global-line" aria-hidden="true"></i>
        </span>
        <span id="language-current-label" class="lang-current-label" data-i18n="language_zh_cn">简体中文</span>
        <span class="lang-select-arrow" aria-hidden="true">
          <i class="ri-arrow-down-s-line"></i>
        </span>
      </button>
      <div id="language-menu" class="lang-menu" role="menu" data-open="false">
        <button class="lang-option" type="button" role="menuitemradio" data-lang-value="zh-CN" data-i18n="language_zh_cn">
          简体中文
        </button>
        <button class="lang-option" type="button" role="menuitemradio" data-lang-value="en" data-i18n="language_en">
          English
        </button>
      </div>
    </div>
    <div id="community-qrcode-modal" class="qrcode-modal" hidden>
      <div class="qrcode-modal-backdrop" data-close-qrcode-modal></div>
      <div class="qrcode-modal-panel" role="dialog" aria-modal="true" aria-labelledby="community-qrcode-title">
        <button class="qrcode-modal-close" type="button" aria-label="关闭" data-i18n-aria-label="qrcode_close_aria" data-close-qrcode-modal>
          <i class="ri-close-line" aria-hidden="true"></i>
        </button>
        <h2 id="community-qrcode-title" class="qrcode-modal-title" data-i18n="qrcode_title">微信群二维码</h2>
        <img class="qrcode-modal-image" src="/qrcode.JPG" alt="微信群二维码" data-i18n-alt="qrcode_image_alt" loading="lazy" />
      </div>
    </div>
    <script define:vars={{ latestReleaseVersion }}>
      const LANGUAGE_STORAGE_KEY = "_x_extension_language_2024_unique_";
      const FALLBACK_LOCALE = "zh-CN";
      const ZH_CN_LOCALE = "zh-CN";
      const I18N_MESSAGES = {
        "zh-CN": {
          page_title: "更新日志｜Lumno 聚焦搜索&新标签页",
          page_title_ext: "Lumno 已更新至 {version}",
          banner_title: "已更新至新版本！",
          banner_title_ext: "您已更新至 {version}",
          brand_home_aria: "回到 Lumno 首页",
          join_discord: "反馈 & 提需",
          discord_aria: "反馈与提需",
          qrcode_title: "微信群二维码",
          qrcode_image_alt: "Lumno 微信群二维码",
          qrcode_close_aria: "关闭二维码弹窗",
          github_repo_aria: "访问 Lumno GitHub 仓库",
          x_aria: "访问 Lumno X 主页",
          language_select_aria: "语言",
          language_zh_cn: "简体中文",
          language_en: "English",
          features_label: "新功能",
          bug_fixes_label: "问题修复",
          github_published: "已发布",
          github_unpublished: "未发布",
          chrome_published: "已发布",
          chrome_reviewing: "审核中",
          read_on_github: "在 GitHub 查看",
          no_releases_title: "暂无发布记录",
          no_releases_desc: "创建 GitHub Release 后，将在下一次部署时自动显示。"
        },
        en: {
          page_title: "Changelog｜Lumno - The Ultimate Browser Command Bar",
          page_title_ext: "Lumno Updated to {version}",
          banner_title: "You're on the latest version!",
          banner_title_ext: "Updated to {version}",
          brand_home_aria: "Back to Lumno home",
          join_discord: "Feedback & Requests",
          discord_aria: "Feedback and requests",
          qrcode_title: "WeChat Group QR Code",
          qrcode_image_alt: "Lumno WeChat group QR code",
          qrcode_close_aria: "Close QR code dialog",
          github_repo_aria: "Visit Lumno GitHub repository",
          x_aria: "Visit Lumno X profile",
          language_select_aria: "Language",
          language_zh_cn: "简体中文",
          language_en: "English",
          features_label: "Features",
          bug_fixes_label: "Bug Fixes",
          github_published: "Published",
          github_unpublished: "Not Published",
          chrome_published: "Published",
          chrome_reviewing: "In Review",
          read_on_github: "Read on GitHub",
          no_releases_title: "No releases yet",
          no_releases_desc: "Create a GitHub Release and it will appear here on next deploy."
        }
      };

      function setLanguageMenuOpen(open) {
        const languageMenu = document.getElementById("language-menu");
        const languageToggle = document.getElementById("language-toggle");
        if (!languageMenu || !languageToggle) return;
        languageMenu.setAttribute("data-open", open ? "true" : "false");
        languageToggle.setAttribute("aria-expanded", open ? "true" : "false");
      }

      function normalizeLocale(locale) {
        const raw = String(locale || "").trim().toLowerCase();
        if (!raw) return "en";
        if (raw.startsWith("zh")) return "zh-CN";
        return "en";
      }

      function getSystemLocale() {
        const firstPreferred = Array.isArray(navigator.languages) && navigator.languages.length ? navigator.languages[0] : navigator.language;
        return normalizeLocale(firstPreferred || "en");
      }

      function normalizeLanguageMode(mode) {
        const raw = String(mode || "").trim();
        if (!raw) return getSystemLocale();
        if (raw.toLowerCase() === "system") return getSystemLocale();
        return normalizeLocale(raw);
      }

      function getMessage(locale, key) {
        return (
          (I18N_MESSAGES[locale] && I18N_MESSAGES[locale][key]) ||
          (I18N_MESSAGES[FALLBACK_LOCALE] && I18N_MESSAGES[FALLBACK_LOCALE][key]) ||
          key
        );
      }

      function formatVersionToken(raw) {
        const value = String(raw || "").trim();
        if (!value) return "";
        return /^v/i.test(value) ? value : `v${value}`;
      }

      function getEntryContext() {
        const params = new URLSearchParams(window.location.search);
        const entry = (params.get("entry") || "").trim().toLowerCase();
        const reason = (params.get("reason") || "").trim().toLowerCase();
        const versionFromParam = formatVersionToken(params.get("version") || "");
        const fallbackVersion = formatVersionToken(latestReleaseVersion || "");
        const version = versionFromParam || fallbackVersion;
        const isExtensionEntry = entry === "ext";
        return { isExtensionEntry, reason, version };
      }

      function withVersion(template, version) {
        return String(template || "").replace("{version}", version || "");
      }

      const INITIAL_ENTRY_CONTEXT = getEntryContext();

      function updateLanguageOptionState(mode) {
        let activeLabel = "";
        document.querySelectorAll("[data-lang-value]").forEach((node) => {
          const value = node.getAttribute("data-lang-value") || getSystemLocale();
          const isActive = value === mode;
          node.classList.toggle("is-active", isActive);
          node.setAttribute("aria-checked", isActive ? "true" : "false");
          if (isActive) {
            activeLabel = (node.textContent || "").trim();
          }
        });
        const currentLabel = document.getElementById("language-current-label");
        if (currentLabel && activeLabel) {
          currentLabel.textContent = activeLabel;
        }
      }

      function applyI18n(locale) {
        const resolvedLocale = I18N_MESSAGES[locale] ? locale : FALLBACK_LOCALE;
        document.documentElement.lang = resolvedLocale;
        document.body.setAttribute("data-release-locale", resolvedLocale);
        const entryContext = INITIAL_ENTRY_CONTEXT;
        document.body.setAttribute("data-release-entry", entryContext.isExtensionEntry ? "ext" : "web");

        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          if (!key) return;
          let value = getMessage(resolvedLocale, key);
          if (key === "page_title" && entryContext.isExtensionEntry) {
            value = withVersion(getMessage(resolvedLocale, "page_title_ext"), entryContext.version);
          }
          if (key === "banner_title") {
            value =
              entryContext.isExtensionEntry && entryContext.version
                ? withVersion(getMessage(resolvedLocale, "banner_title_ext"), entryContext.version)
                : getMessage(resolvedLocale, "banner_title");
          }
          if (node.tagName === "TITLE") {
            document.title = value;
            return;
          }

          const count = node.getAttribute("data-count");
          if (count && (key === "features_label" || key === "bug_fixes_label")) {
            node.textContent = `${value} (${count})`;
            return;
          }

          node.textContent = value;
        });

        document.querySelectorAll("[data-i18n-aria-label]").forEach((node) => {
          const key = node.getAttribute("data-i18n-aria-label");
          if (!key) return;
          node.setAttribute("aria-label", getMessage(resolvedLocale, key));
        });

        document.querySelectorAll("[data-i18n-alt]").forEach((node) => {
          const key = node.getAttribute("data-i18n-alt");
          if (!key) return;
          node.setAttribute("alt", getMessage(resolvedLocale, key));
        });
      }

      function syncCommunityAction(locale) {
        const entry = document.querySelector("[data-community-entry]");
        if (!(entry instanceof HTMLAnchorElement)) return;
        const icon = entry.querySelector("[data-community-icon]");
        const discordHref = entry.dataset.discordHref || "https://discord.gg/2u9sg7ZNkJ";
        const isZhCn = locale === ZH_CN_LOCALE;

        entry.href = isZhCn ? "#" : discordHref;
        if (isZhCn) {
          entry.removeAttribute("target");
          entry.removeAttribute("rel");
        } else {
          entry.setAttribute("target", "_blank");
          entry.setAttribute("rel", "noreferrer noopener");
        }

        if (icon instanceof HTMLElement) {
          icon.classList.toggle("ri-wechat-fill", isZhCn);
          icon.classList.toggle("ri-discord-fill", !isZhCn);
        }
      }

      function applyLanguageMode(mode, options) {
        const normalizedMode = normalizeLanguageMode(mode);
        applyI18n(normalizedMode);
        syncCommunityAction(normalizedMode);
        updateLanguageOptionState(normalizedMode);
        if (options && options.persist) {
          try {
            localStorage.setItem(LANGUAGE_STORAGE_KEY, normalizedMode);
          } catch (_error) {
            // Ignore storage write errors (private mode / blocked storage).
          }
        }
      }

      function getInitialLanguageMode() {
        try {
          return localStorage.getItem(LANGUAGE_STORAGE_KEY) || getSystemLocale();
        } catch (_error) {
          return getSystemLocale();
        }
      }

      function setupQrcodeModal() {
        const entry = document.querySelector("[data-community-entry]");
        const modal = document.getElementById("community-qrcode-modal");
        if (!(entry instanceof HTMLAnchorElement) || !(modal instanceof HTMLDivElement)) return;

        const close = () => {
          modal.hidden = true;
          document.body.style.removeProperty("overflow");
        };

        const open = () => {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
        };

        entry.addEventListener("click", (event) => {
          const currentLocale = document.body.getAttribute("data-release-locale") || FALLBACK_LOCALE;
          if (currentLocale !== ZH_CN_LOCALE) return;
          event.preventDefault();
          open();
        });

        modal.addEventListener("click", (event) => {
          const target = event.target instanceof HTMLElement ? event.target.closest("[data-close-qrcode-modal]") : null;
          if (target) close();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) close();
        });
      }

      const initialLanguageMenu = document.getElementById("language-menu");
      if (initialLanguageMenu) {
        initialLanguageMenu.setAttribute("data-open", "false");
      }
      document.addEventListener("click", (event) => {
        const target = event.target instanceof HTMLElement ? event.target : null;
        if (!target) return;
        const languageToggle = target.closest("#language-toggle");
        const languageMenu = document.getElementById("language-menu");
        if (languageToggle) {
          event.stopPropagation();
          const expanded = languageToggle.getAttribute("aria-expanded") === "true";
          setLanguageMenuOpen(!expanded);
          return;
        }
        const languageOption = target.closest("#language-menu [data-lang-value]");
        if (languageOption) {
          const next = languageOption.getAttribute("data-lang-value") || getSystemLocale();
          applyLanguageMode(next, { persist: true });
          setLanguageMenuOpen(false);
          return;
        }
        const activeLanguageToggle = document.getElementById("language-toggle");
        if (!languageMenu || !activeLanguageToggle) return;
        if (!languageMenu.contains(target) && !activeLanguageToggle.contains(target)) {
          setLanguageMenuOpen(false);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setLanguageMenuOpen(false);
        }
      });

      applyLanguageMode(getInitialLanguageMode());
      window.addEventListener("load", () => {
        applyLanguageMode(getInitialLanguageMode());
      }, { once: true });
      setupQrcodeModal();

      function setupAccordionAnimations() {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const accordions = document.querySelectorAll(".accordion");
        accordions.forEach((accordion) => {
          if (!(accordion instanceof HTMLDetailsElement)) return;
          const summary = accordion.querySelector("summary");
          const panel = accordion.querySelector(".accordion-panel");
          if (!(summary instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

          panel.style.overflow = "hidden";
          panel.style.height = accordion.open ? "auto" : "0px";
          panel.style.opacity = accordion.open ? "1" : "0";

          summary.addEventListener("click", (event) => {
            event.preventDefault();
            if (accordion.dataset.animating === "true") return;

            const isOpen = accordion.open;
            if (reduceMotion) {
              accordion.open = !isOpen;
              panel.style.height = accordion.open ? "auto" : "0px";
              panel.style.opacity = accordion.open ? "1" : "0";
              return;
            }

            accordion.dataset.animating = "true";
            panel.style.transition = "height 260ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease";

            if (isOpen) {
              const startHeight = panel.scrollHeight;
              panel.style.height = `${startHeight}px`;
              panel.style.opacity = "1";

              requestAnimationFrame(() => {
                panel.style.height = "0px";
                panel.style.opacity = "0";
              });

              const onCloseEnd = (transitionEvent) => {
                if (transitionEvent.propertyName !== "height") return;
                panel.removeEventListener("transitionend", onCloseEnd);
                accordion.open = false;
                panel.style.transition = "";
                panel.style.height = "0px";
                panel.style.opacity = "0";
                delete accordion.dataset.animating;
              };
              panel.addEventListener("transitionend", onCloseEnd);
              return;
            }

            accordion.open = true;
            panel.style.height = "0px";
            panel.style.opacity = "0";
            const endHeight = panel.scrollHeight;

            requestAnimationFrame(() => {
              panel.style.height = `${endHeight}px`;
              panel.style.opacity = "1";
            });

            const onOpenEnd = (transitionEvent) => {
              if (transitionEvent.propertyName !== "height") return;
              panel.removeEventListener("transitionend", onOpenEnd);
              panel.style.transition = "";
              panel.style.height = "auto";
              panel.style.opacity = "1";
              delete accordion.dataset.animating;
            };
            panel.addEventListener("transitionend", onOpenEnd);
          });
        });
      }

      setupAccordionAnimations();

      function fireIntroConfetti() {
        const canvas = document.createElement("canvas");
        canvas.style.position = "fixed";
        canvas.style.inset = "0";
        canvas.style.width = "100%";
        canvas.style.height = "100%";
        canvas.style.pointerEvents = "none";
        canvas.style.zIndex = "9999";
        document.body.appendChild(canvas);
        const ctx = canvas.getContext("2d");
        if (!ctx) {
          canvas.remove();
          return;
        }
        const dpr = Math.max(1, window.devicePixelRatio || 1);
        const width = window.innerWidth;
        const height = window.innerHeight;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.scale(dpr, dpr);

        const colors = ["#60A5FA", "#22C55E", "#F59E0B", "#F43F5E", "#A78BFA"];
        const particles = Array.from({ length: 120 }).map(() => {
          const left = Math.random() > 0.5;
          const x = left ? width * 0.3 : width * 0.7;
          return {
            x,
            y: height * 0.32,
            vx: (Math.random() * 6 + 2) * (left ? -1 : 1),
            vy: -(Math.random() * 8 + 5),
            size: Math.random() * 6 + 4,
            color: colors[Math.floor(Math.random() * colors.length)],
            rotate: Math.random() * Math.PI,
            spin: (Math.random() - 0.5) * 0.25,
          };
        });

        const gravity = 0.24;
        const drag = 0.992;
        const endAt = performance.now() + 1500;

        function frame(now) {
          ctx.clearRect(0, 0, width, height);
          particles.forEach((p) => {
            p.vx *= drag;
            p.vy = p.vy * drag + gravity;
            p.x += p.vx;
            p.y += p.vy;
            p.rotate += p.spin;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rotate);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.65);
            ctx.restore();
          });
          if (now < endAt) {
            requestAnimationFrame(frame);
          } else {
            canvas.remove();
          }
        }
        requestAnimationFrame(frame);
      }

      const entryContext = INITIAL_ENTRY_CONTEXT;
      if (entryContext.isExtensionEntry) {
        window.setTimeout(() => fireIntroConfetti(), 280);
        if (window.history && typeof window.history.replaceState === "function") {
          window.history.replaceState({}, "", "/release/");
        }
      }
    </script>
  </body>
</html>
